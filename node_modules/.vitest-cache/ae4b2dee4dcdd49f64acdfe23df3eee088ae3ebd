// QGIS styles (QML) of the exported layers: plants as circles of their canopy
// size (map units = metres in the project's UTM CRS), coloured by layer;
// areas filled with their own colour; the outline as a line. The same
// renderer/labeling XML goes into the stored project's map layers.
const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const opt = (name, value, type = 'QString') => `<Option name="${name}" type="${type}" value="${esc(value)}"/>`;
const rgba = (hex, a = 255) => { const n = parseInt(hex.slice(1), 16); return `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a}`; };

function dd(props) {
  return `<data_defined_properties><Option type="Map">${opt('name', '')}<Option name="properties" type="Map">${Object.entries(props).map(([k, expr]) =>
    `<Option name="${k}" type="Map"><Option name="active" type="bool" value="true"/>${opt('expression', expr)}<Option name="type" type="int" value="3"/></Option>`).join('')}</Option>${opt('type', 'collection')}</Option></data_defined_properties>`;
}
const symbol = (type, name, alpha, layerXml) =>
  `<symbol type="${type}" name="${name}" alpha="${alpha}" clip_to_extent="1" force_rhr="0" frame_rate="10" is_animated="0">${layerXml}</symbol>`;

/** Plant layers (PlantLayer of plant-layer.ts) with their planner colours. */
const PLANT_CATS = [
  ['tree', 'Baum', '#166534', '#14532d'], ['shrub', 'Strauch', '#65a30d', '#4d7c0f'], ['climber', 'Kletterpflanze', '#0d9488', '#0f766e'],
  ['herb', 'Kraut/Bodendecker', '#a3e635', '#65a30d'], ['rhizo', 'Rhizom/Wurzel', '#a16207', '#854d0e'], ['', 'ohne Angabe', '#78716c', '#57534e'],
];
const plantMarker = (fill, stroke) => `<layer class="SimpleMarker" enabled="1" locked="0" pass="0"><Option type="Map">${opt('color', rgba(fill, 170))}${opt('name', 'circle')}${opt('outline_color', rgba(stroke))}${opt('outline_style', 'solid')}${opt('outline_width', '0.3')}${opt('outline_width_unit', 'MM')}${opt('size', '2')}${opt('size_unit', 'MapUnit')}${opt('scale_method', 'diameter')}</Option>${dd({ size: 'coalesce("canopy_radius_m", 0.5) * 2' })}</layer>`;

function labeling(field, size, color, maxScale) {
  return `<labeling type="simple"><settings calloutType="simple"><text-style fieldName="${esc(field)}" isExpression="1" fontFamily="Sans Serif" fontSize="${size}" fontSizeUnit="Point" textColor="${color}" textOpacity="1" fontWeight="50" fontItalic="0" namedStyle="Regular" multilineHeight="1" previewBkgrdColor="255,255,255,255" allowHtml="0" capitalization="0" blendMode="0"><text-buffer bufferDraw="1" bufferSize="0.8" bufferSizeUnits="MM" bufferColor="255,255,255,255" bufferOpacity="1" bufferNoFill="1" bufferJoinStyle="128" bufferBlendMode="0"/></text-style><text-format wrapChar="" multilineAlign="0" autoWrapLength="0" useMaxLineLengthForAutoWrap="1" placeDirectionSymbol="0" plussign="0" leftDirectionSymbol="&lt;" rightDirectionSymbol="&gt;" reverseDirectionSymbol="0" decimals="3" formatNumbers="0" addDirectionSymbol="0"/><placement placement="1" dist="0" priority="5" offsetType="0" quadOffset="4" xOffset="0" yOffset="0"/><rendering scaleVisibility="${maxScale ? 1 : 0}" scaleMin="0" scaleMax="${maxScale || 0}" obstacle="1" drawLabels="1" limitNumLabels="0" fontLimitPixelSize="0" displayAll="0" upsidedownLabels="0" labelPerPart="0" mergeLines="0"/></settings></labeling>`;
}

const RENDERERS = {
  pflanzen: `<renderer-v2 type="categorizedSymbol" attr="layer" forceraster="0" enableorderby="0" symbollevels="0" referencescale="-1"><categories>${PLANT_CATS.map(([v, label], i) =>
      `<category value="${v}" symbol="${i}" label="${esc(label)}" render="true" type="string" uuid="pdk-${v || 'none'}"/>`).join('')}</categories><symbols>${PLANT_CATS.map(([, , f, s], i) =>
      symbol('marker', String(i), '1', plantMarker(f, s))).join('')}</symbols></renderer-v2>`,
  flaechen: `<renderer-v2 type="singleSymbol" forceraster="0" enableorderby="0" symbollevels="0" referencescale="-1"><symbols>${symbol('fill', '0', '1',
      `<layer class="SimpleFill" enabled="1" locked="0" pass="0"><Option type="Map">${opt('color', '34,197,94,90')}${opt('outline_color', '22,101,52,255')}${opt('outline_style', 'solid')}${opt('outline_width', '0.5')}${opt('outline_width_unit', 'MM')}${opt('style', 'solid')}</Option>${dd({
        fillColor: `set_color_part(coalesce("color", '#22c55e'), 'alpha', 90)`, outlineColor: `coalesce("color", '#166534')` })}</layer>`)}</symbols></renderer-v2>`,
  grenze: `<renderer-v2 type="singleSymbol" forceraster="0" enableorderby="0" symbollevels="0" referencescale="-1"><symbols>${symbol('fill', '0', '1',
      `<layer class="SimpleFill" enabled="1" locked="0" pass="0"><Option type="Map">${opt('color', '0,0,0,0')}${opt('outline_color', '109,40,217,255')}${opt('outline_style', 'solid')}${opt('outline_width', '0.8')}${opt('outline_width_unit', 'MM')}${opt('style', 'no')}</Option></layer>`)}</symbols></renderer-v2>`,
};
const LABELING = {
  pflanzen: labeling(`coalesce("common_name", "latin_name")`, 7, '50,50,50,255', 2500),
  flaechen: labeling('"name"', 9, '20,83,45,255', 0),
  grenze: '',
};

const qml = (t) => `<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>\n<qgis version="3.40.0-Bratislava" styleCategories="Symbology|Labeling" labelsEnabled="${LABELING[t] ? 1 : 0}">${RENDERERS[t]}${LABELING[t]}</qgis>\n`;
const STYLES = Object.fromEntries(Object.keys(RENDERERS).map(t => [t, { qml: qml(t) }]));

