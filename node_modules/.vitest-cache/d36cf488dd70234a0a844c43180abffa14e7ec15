 from 'vitest';\nimport { DatabaseSync } from 'node:sqlite';\nimport { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { inflateRawSync } from 'node:zlib';\nimport { buildGpkg, readGpkg, utmEpsg } from '../server/qgis/gpkg.mjs';\nimport { toUtm } from '../server/qgis/project.mjs';\nimport { planFromGeoJson } from '../../lib/gartenplan-geojson';\nimport { exportFc } from '../qgis/ui';\nimport { createEmptyGardenPlan, createEmptyPlant } from '../../lib/types';\n\nconst fc = {\n  type: 'FeatureCollection', name: 'Testgarten', pdk: { version: 1, planId: 'plan-1', gridSpacingM: 1, yearsSincePlanting: 10 },\n  features: [\n    { type: 'Feature', geometry: { type: 'Polygon', coordinates: [[[11.5, 48.1], [11.501, 48.1], [11.501, 48.1006], [11.5, 48.1006], [11.5, 48.1]]] }, properties: { pdk_type: 'boundary', name: 'Testgarten', description: 'd', notes: 'n' } },\n    { type: 'Feature', geometry: { type: 'Polygon', coordinates: [[[11.5002, 48.1001], [11.5004, 48.1001], [11.5004, 48.1002], [11.5002, 48.1001]]] }, properties: { pdk_type: 'area', pdk_id: 'a1', name: 'Beet', color: '#3b82f6', ebene: 'Gemüse' } },\n    { type: 'Feature', geometry: { type: 'Point', coordinates: [11.5005, 48.1003] }, properties: { pdk_type: 'plant', pdk_id: 'pl1', plant_id: 'apfel', latin_name: 'Malus domestica', common_name: 'Apfel', layer: 'tree', canopy_radius_m: 2.5, planting_year_offset: 2 } },\n  ],\n};\n\ndescribe('GeoPackage for QGIS', () => {\n  it('writes a valid GeoPackage with layers, styles and a stored project', () => {\n    const bytes = buildGpkg(fc as any, { fileName: 'testgarten.gpkg' });\n    expect(bytes.subarray(0, 15).toString()).toBe('SQLite format 3');\n    const file = join(mkdtempSync(join(tmpdir(), 'gpkg-')), 't.gpkg');\n    writeFileSync(file, bytes);\n    const db = new DatabaseSync(file, { readOnly: true });\n    expect((db.prepare('PRAGMA application_id').get() as any).application_id).toBe(0x47504b47);\n    expect(db.prepare('SELECT table_name FROM gpkg_contents ORDER BY table_name').all().map((r: any) => r.table_name)).toEqual(['flaechen', 'grenze', 'pflanzen']);\n    expect(db.prepare('SELECT f_table_name, useAsDefault FROM layer_styles').all()).toHaveLength(3);\n    const proj = db.prepare('SELECT name, content FROM qgis_projects').get() as any;\n    expect(proj.name).toBe('Waldgarten');\n    const zip = Buffer.from(proj.content, 'hex');\n    expect(zip.subarray(0, 4).toString('hex')).toBe('504b0304');\n    // first (only) entry: deflated project.qgs\n    const nameLen = zip.readUInt16LE(26), compLen = zip.readUInt32LE(18);\n    const qgs = inflateRawSync(zip.subarray(30 + nameLen, 30 + nameLen + compLen)).toString();\n    expect(qgs).toContain('./testgarten.gpkg|layername=pflanzen');\n    expect(qgs).toContain('EPSG:25832');\n  });\n  it('reads it back into a plan with the same ids', () => {\n    const back = readGpkg(buildGpkg(fc as any));\n    expect(back.pdk?.planId).toBe('plan-1');\n    expect(back.features.map((f: any) => f.properties.pdk_type)).toEqual(['boundary', 'area', 'plant']);\n    const apple = { ...createEmptyPlant(), id: 'apfel', latinName: 'Malus domestica' };\n    const r = planFromGeoJson(back, [apple]);\n    expect(r.sourcePlanId).toBe('plan-1');\n    expect(r.plan.areas[0]).toMatchObject({ id: 'a1', name: 'Beet', color: '#3b82f6' });\n    expect(r.plan.placements[0]).toMatchObject({ id: 'pl1', plantId: 'apfel' });\n    expect(r.newPlants).toHaveLength(0);\n  });\n  it('refuses GeoPackages whose layers are views or carry triggers', () => {\n    const tamper = (sql: string) => {\n      const file = join(mkdtempSync(join(tmpdir(), 'gpkg-')), 't.gpkg');\n      writeFileSync(file, buildGpkg(fc as any));\n      const db = new DatabaseSync(file);\n      db.exec(sql);\n      db.close();\n      return readFileSync(file);\n    };\n    expect(() => readGpkg(tamper('DROP TABLE pflanzen; CREATE VIEW pflanzen AS SELECT * FROM flaechen'))).toThrow(/view or trigger/);\n    expect(() => readGpkg(tamper(\"CREATE TRIGGER t AFTER DELETE ON grenze BEGIN SELECT 1; END\"))).toThrow(/view or trigger/);\n    expect(readGpkg(tamper(\"CREATE TRIGGER rtree_grenze_geom_delete AFTER DELETE ON grenze BEGIN SELECT 1; END\")).features).toHaveLength(3);\n    // layers in metres (e.g. UTM from the cadastre) are not read as degrees\n    expect(() => readGpkg(tamper(\"UPDATE gpkg_geometry_columns SET srs_id = 25832\"))).toThrow(/crs/);\n  });\n  it('UTM zone and projection', () => {\n    expect(utmEpsg(11.5, 48.1)).toBe(25832);\n    expect(utmEpsg(11.5, 48.1, 'wgs84')).toBe(32632);\n    expect(utmEpsg(14, 52, 'etrs89')).toBe(25833);\n    expect(utmEpsg(-122.3, 47.6)).toBe(32610);\n    const [x, y] = toUtm(9, 48, 32632); // central meridian of zone 32\n    expect(x).toBeCloseTo(500000, 0);\n    expect(y).toBeGreaterThan(5316000); expect(y).toBeLessThan(5318000);\n  });\n  it('adds the overlay (Ebene) name to plants and areas', () => {\n    const plan = { ...createEmptyGardenPlan(), geo: { lat: 48.1, lon: 11.5, rotationDeg: 0, basemap: 'osm', opacity: 1 },\n      boundary: [{ xM: 0, yM: 0 }, { xM: 10, yM: 0 }, { xM: 10, yM: 10 }], placements: [{ id: 'p1', plantId: 'x', xM: 1, yM: 1, notes: '' }],\n      ext: { gruppen: { groups: [{ id: 'g1', name: 'Obst', color: '#000', visible: true, placementIds: ['p1'], areaIds: [] }] } } } as any;\n    const out = exportFc(plan, new Map());\n    expect(out.features.find(f => f.properties?.pdk_id === 'p1')!.properties!.ebene).toBe('Obst');\n  });\n});\n"],"file":"/pwa/src/expert/test/qgis.test.ts"}