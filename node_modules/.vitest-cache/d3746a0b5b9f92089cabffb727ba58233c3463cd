an the plants). */\n  fixed?: true;\n}\n/** How much bigger than normal names may get when zooming in. */\nexport const GROW_MAX = 2;\nexport interface GruppenData {\n  groups: Gruppe[]; restHidden?: boolean; hiddenAreas?: string[]; hiddenShapes?: string[];\n  /** Per layer id (or REST_ID for \"Ohne Ebene\"); absent = names as usual. */\n  labels?: Record<string, LabelStyle>;\n  /** How see-through the trees are drawn, percent (0 = solid, the default). */\n  treeTransparency?: number;\n}\nexport const REST_ID = '__rest';\n/** Key in `labels` for all plants of the plan, whatever layer (combined with the layer's own style). */\nexport const ALL_ID = '__all';\nexport const LABEL_SCALE_MIN = 0.5, LABEL_SCALE_MAX = 3;\n\n/** A label style cleaned up; null when it is the normal one. */\nexport function cleanLabelStyle(raw: unknown): LabelStyle | null {\n  if (!isObj(raw)) return null;\n  const out: LabelStyle = {};\n  if (raw.hidden === true) out.hidden = true;\n  if (raw.fixed === true) out.fixed = true;\n  const n = typeof raw.scale === 'number' && Number.isFinite(raw.scale) ? Math.round(Math.min(LABEL_SCALE_MAX, Math.max(LABEL_SCALE_MIN, raw.scale)) * 20) / 20 : 1;\n  if (n !== 1) out.scale = n;\n  return out.hidden || out.scale || out.fixed ? out : null;\n}\n\n/** Sets (or with null resets) the name style of a layer or of \"Ohne Ebene\". */\nexport function setLabels(data: GruppenData, id: string, style: LabelStyle | null): GruppenData {\n  const labels = { ...(data.labels ?? {}) };\n  const st = cleanLabelStyle(style);\n  if (st) labels[id] = st; else delete labels[id];\n  const { labels: _old, ...rest } = data;\n  return Object.keys(labels).length ? { ...rest, labels } : rest;\n}\nexport interface Selection { placementIds: string[]; areaIds: string[] }\n\nexport const COLORS = ['#7c3aed', '#0891b2', '#ea580c', '#16a34a', '#db2777', '#ca8a04', '#2563eb', '#57534e'];\nconst MAX_GROUPS = 50;\n\nconst isObj = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object' && !Array.isArray(v);\nconst strs = (v: unknown) => (Array.isArray(v) ? v.filter((x): x is string => typeof x === 'string') : []);\n\n/** Stored data checked against the plan: unknown members dropped, each member in one group only. */\nexport function cleanData(raw: unknown, plan: Pick<GardenPlan, 'placements' | 'areas'>): GruppenData {\n  const placements = new Set(plan.placements.map(p => p.id));\n  const areas = new Set((plan.areas ?? []).map(a => a.id));\n  const taken = new Set<string>();\n  const own = (ids: string[], known: Set<string>) => ids.filter(id => known.has(id) && !taken.has(id) && (taken.add(id), true));\n  const groups = (isObj(raw) && Array.isArray(raw.groups) ? raw.groups : []).filter(isObj).slice(0, MAX_GROUPS).map((g, i): Gruppe => ({\n    id: typeof g.id === 'string' && g.id ? g.id : `g${i + 1}`,\n    name: typeof g.name === 'string' ? g.name.slice(0, 60) : '',\n    color: typeof g.color === 'string' && /^#[0-9a-f]{6}$/i.test(g.color) ? g.color.toLowerCase() : COLORS[i % COLORS.length],\n    visible: g.visible !== false,\n    placementIds: own(strs(g.placementIds), placements),\n    areaIds: own(strs(g.areaIds), areas),\n  }));\n  const hiddenAreas = isObj(raw) ? strs(raw.hiddenAreas).filter(id => areas.has(id)) : [];\n  const hiddenShapes = isObj(raw) ? strs(raw.hiddenShapes).filter(id => areas.has(id)) : [];\n  const labels: Record<string, LabelStyle> = {};\n  if (isObj(raw) && isObj(raw.labels)) {\n    // Areas carry names like layers, under 'a:<area id>' (AREA in ui.ts).\n    const ids = new Set([...groups.map(g => g.id), REST_ID, ALL_ID, ...[...areas].map(id => `a:${id}`)]);\n    for (const [k, v] of Object.entries(raw.labels)) { const st = cleanLabelStyle(v); if (st && ids.has(k)) labels[k] = st; }\n  }\n  const tt = isObj(raw) && typeof raw.treeTransparency === 'number' && Number.isFinite(raw.treeTransparency) ? Math.min(100, Math.max(0, Math.round(raw.treeTransparency))) : 0;\n  return { groups, ...(tt ? { treeTransparenc