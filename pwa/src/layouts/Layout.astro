---
import BetaPitch from './BetaPitch.astro';
import '../styles/global.css';
import { featureDefaults } from '../lib/features';
interface Props {
  title: string;
  /** Widens the header/main/footer container beyond the default max-w-6xl —
   *  for pages whose content (e.g. the plant table's many dot/filter
   *  columns) needs more horizontal room than prose pages do. */
  wide?: boolean;
  /** No max width at all — the Gartenplan map grows with the window. */
  full?: boolean;
  /** A page for outside visitors (e.g. /baumschule7l): the header shows only the logo (link to the start page), no menus, no feedback button. */
  bare?: boolean;
}
const { title, wide = false, full = false, bare = false } = Astro.props;
const containerMaxW = full ? 'max-w-none' : wide ? 'max-w-[1600px]' : 'max-w-6xl';
// Header and footer always use the wide container, so the menu doesn't
// shift sideways when switching between wide and narrow pages.
const barMaxW = 'max-w-[1600px]';
// Default modes per feature for public/boot.js (hides panels before first paint).
const featureDefaultsJson = JSON.stringify(featureDefaults());
// The feedback menu: the same entries behind the Feedback button (bottom right) and the Beta shield (header); hrefs get ?from= in the script.
const fbItems = [
  { fb: 'bug', href: '/fehler-melden/', label: 'feedbackBug', de: 'Fehler melden', hint: 'feedbackBugHint', deHint: 'Etwas geht nicht oder sieht falsch aus' },
  { fb: 'pick', href: '', label: 'feedbackPick', de: 'Stelle markieren', hint: 'feedbackPickHint', deHint: 'Anklicken, wo es nicht stimmt' },
  { fb: 'idea', href: '/fehler-melden/?art=idee', label: 'feedbackIdea', de: 'Idee einreichen', hint: 'feedbackIdeaHint', deHint: 'Was fehlt, was wäre besser?' },
  { fb: 'mail', href: 'mailto:info@permadesignkit.org', label: 'feedbackMail', de: 'Mail ans Team', hint: 'feedbackMailHint', deHint: 'info@permadesignkit.org' },
];
// The start page keeps the big tree line; every other page gets a narrow strip (global.css, data-home).
const home = Astro.url.pathname.replace(/\/$/, '') === '';
const fbItem = 'block w-full rounded-lg px-2 py-2 text-left hover:bg-stone-100 dark:hover:bg-stone-800';
---
<!doctype html>
<html lang="de" class="h-full" data-design="horizont" data-feature-defaults={featureDefaultsJson} data-bare={bare ? '' : undefined} data-home={home ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#166534" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- iOS takes its home-screen icon from here, not from the manifest. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Raleway: matches the Baumscheibe template's own "COMMON NAME" placeholder
         font (see baumscheibe-render.ts NAME_BOXES). OFL-licensed, self-hosted (see global.css) — not loaded from Google Fonts, to avoid IP transfer to Google. -->
    <title>{title}</title>
    <!-- Blocking on purpose: sets lang + dark mode before first paint. -->
    <script is:inline src="/boot.js"></script>
    <!-- Umami Analytics — self-hosted (own VPS, Docker), cookieless, no
         personal data, no IP storage. Replaced Plausible Cloud 2026-09-22
         (see CHANGELOG.md) to keep all data on our own server instead of a
         third-party's. data-domains restricts tracking to the real domain,
         same effect as Plausible's own localhost auto-skip. -->
    <script defer data-website-id="dd0aef9b-00ce-4126-83f8-3bf21e9830c4" data-domains="permadesignkit.org" data-do-not-track="true" src="https://stats.permadesignkit.org/script.js"></script>
  </head>
  <body class="flex min-h-full flex-col bg-stone-50 dark:bg-stone-950 text-stone-800 dark:text-stone-100 antialiased">
    <!-- First tab stop on every page (WCAG 2.4.1). -->
    <a href="#main" data-i18n="skipToContent" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-green-800 focus:shadow-lg">Zum Inhalt springen</a>
    <!-- Android / Chrome install banner (top of page, non-sticky) -->
    <div id="install-banner" hidden class="flex items-center justify-between gap-3 bg-green-700 px-4 py-2 text-sm text-white sm:px-6">
      <span class="flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
        <span data-i18n="installBannerText">Perma Design Kit auf den Startbildschirm legen?</span>
      </span>
      <div class="flex items-center gap-2">
        <button id="install-accept" type="button" data-i18n="installBtn" class="rounded-md bg-white px-3 py-1 text-xs font-semibold text-green-800 transition hover:bg-stone-100">Installieren</button>
        <button id="install-dismiss" type="button" data-i18n-aria-label="closeBtn" aria-label="Schließen" class="text-lg leading-none text-white/80 transition hover:text-white">×</button>
      </div>
    </div>

    <!-- Neue Version: der Service Worker hat einen neuen Build geladen und wartet (public/sw.js) -->
    <div id="update-banner" hidden role="status" class="flex items-center justify-between gap-3 bg-green-700 px-4 py-2 text-sm text-white sm:px-6">
      <span data-i18n="updateBannerText">Eine neue Version von Perma Design Kit ist da.</span>
      <button id="update-reload" type="button" data-i18n="updateBannerReload" class="shrink-0 rounded-md bg-white px-3 py-1 text-xs font-semibold text-green-800 transition hover:bg-stone-100">Neu laden</button>
    </div>

    <!-- Daten in einem anderen Tab geändert (lib/data-channel.ts) -->
    <div id="stale-banner" hidden role="status" class="flex items-center justify-between gap-3 bg-amber-100 dark:bg-amber-900/40 px-4 py-2 text-sm text-amber-900 dark:text-amber-100 sm:px-6">
      <span data-i18n="staleBannerText">Deine Daten wurden in einem anderen Tab geändert. Lade neu, bevor du hier weiterarbeitest.</span>
      <button id="stale-reload" type="button" data-i18n="updateBannerReload" class="shrink-0 rounded-md bg-white dark:bg-stone-800 px-3 py-1 text-xs font-semibold text-amber-900 dark:text-amber-100 ring-1 ring-amber-300 dark:ring-amber-800 hover:bg-amber-50 dark:hover:bg-stone-700">Neu laden</button>
    </div>

    <!-- Dauerhafter Speicher: erklärt, bevor der Browser (Firefox) fragt -->
    <div id="persist-banner" hidden class="flex flex-wrap items-center justify-between gap-3 bg-green-100 dark:bg-green-900/40 px-4 py-2 text-sm text-green-950 dark:text-green-50 sm:px-6">
      <span id="persist-banner-text" class="min-w-0 flex-1" data-i18n="persistBannerText">Deine Pflanzen und Pläne liegen nur in diesem Browser. Damit er sie bei Speichermangel nicht löscht, bitte ihn um dauerhaften Speicher – manche Browser fragen dann nach.</span>
      <div class="flex items-center gap-2">
        <button id="persist-banner-ok" type="button" data-i18n="persistBannerOk" class="rounded-md bg-green-700 px-3 py-1 text-xs font-semibold text-white hover:bg-green-800">Dauerhaft speichern</button>
        <button id="persist-banner-later" type="button" data-i18n="persistBannerLater" class="rounded-md px-2 py-1 text-xs font-medium text-green-900 dark:text-green-100 hover:underline">Später</button>
      </div>
    </div>

    <!-- Auto-Sync-Hinweis: Fehler oder fremder Stand auf dem Server (lib/sync.ts → getSyncProblem) -->
    <div id="sync-problem" hidden role="status" class="flex items-center justify-between gap-3 bg-red-100 dark:bg-red-900/40 px-4 py-2 text-sm text-red-900 dark:text-red-100 sm:px-6">
      <span id="sync-problem-text"></span>
      <a href="/settings#sync-section" data-i18n="syncProblemGoto" class="shrink-0 rounded-md bg-white dark:bg-stone-800 px-3 py-1 text-xs font-semibold text-red-900 dark:text-red-100 ring-1 ring-red-300 dark:ring-red-800 hover:bg-red-50 dark:hover:bg-stone-700">Zum Sync</a>
    </div>

    <!-- Backup-Reminder-Banner: stale-Zustand wird im Skript bestimmt -->
    <div id="backup-reminder" hidden class="flex items-center justify-between gap-3 bg-amber-100 dark:bg-amber-900/40 px-4 py-2 text-sm text-amber-900 dark:text-amber-100 sm:px-6">
      <span class="flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
        <span id="backup-reminder-text" data-i18n="backupReminderDefault">Letztes Backup ist eine Weile her — jetzt sichern?</span>
      </span>
      <div class="flex items-center gap-2">
        <a href="/settings#daten-section" data-i18n="backupReminderGoto" class="rounded-md bg-white dark:bg-stone-800 px-3 py-1 text-xs font-semibold text-amber-900 dark:text-amber-100 ring-1 ring-amber-300 dark:ring-amber-800 hover:bg-amber-50 dark:hover:bg-stone-700">Zu den Daten</a>
        <button id="backup-reminder-dismiss" type="button" data-i18n-aria-label="backupReminderDismiss" aria-label="Heute ausblenden" class="text-lg leading-none text-amber-900/60 dark:text-amber-100/60 transition hover:text-amber-900 dark:hover:text-amber-100">×</button>
      </div>
    </div>

    <!-- Horizont design only: sky + tree line behind the header (and the
         search on the plant page). Height set by the script below. -->
    <div class="hz-anchor" aria-hidden="true"><div class="hz-sky"></div></div>
    <!-- Screen-reader announcements (search results, filter counts, status); see announce() in html.ts. -->
    <div id="a11y-status" class="sr-only" role="status" aria-live="polite"></div>

    <header class="site-header sticky top-0 z-50 bg-green-900 dark:bg-green-950 shadow-lg">
      <!-- On phones the page links get their own (swipeable) second row, so the
           header never makes the page wider than the screen. Wider windows get
           the same layout (data-compact, set below) whenever one row does not fit. -->
      <nav class={`mx-auto flex ${barMaxW} flex-wrap items-center gap-x-2 gap-y-1 px-4 py-3 sm:flex-nowrap sm:px-6`}>
        <a href="/" data-i18n-aria-label="homeLink" aria-label="Perma Design Kit – Startseite" class="flex shrink-0 items-center gap-2 whitespace-nowrap text-lg font-bold tracking-tight text-white">
          <span class="hz-wordmark" aria-hidden="true">PERMA<br />DESIGN<br />KIT</span>
          <svg class="hz-std h-7 w-7" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <polyline points="16,11 20.1,14 16,19.2 9.7,14 16,6.6 24.5,14 16,23.6 16,27"
              fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="16" cy="11" r="1.2" fill="white"/>
          </svg>
          <span class="hz-std hidden sm:inline">Perma Design Kit</span>
        </a>
        <div id="nav-links" class="order-last -mx-2.5 flex w-[calc(100%+1.25rem)] items-center gap-1 overflow-x-auto text-sm font-medium sm:order-none sm:mx-0 sm:ml-3 sm:w-auto sm:overflow-visible">
          <!-- On phones this row is the fixed bar at the bottom of the screen (global.css, "Bottom bar"); the icons show only there. -->
          <a href="/" data-nav="/" class="rounded-md px-2.5 py-1 text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21V11"/><path d="M12 11C12 6 8 4 4 4c0 5 3 7 8 7z"/><path d="M12 13c0-4 3-6 8-6 0 4-3 6-8 6z"/></svg><span data-i18n="navPlants">Pflanzen</span></a>
          <a href="/kalender" data-nav="/kalender" class="rounded-md px-2.5 py-1 text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><span data-i18n="navCalendar">Kalender</span></a>
          <a href="/polykulturen" data-nav="/polykulturen" class="rounded-md px-2.5 py-1 text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="3"/><circle cx="5" cy="7" r="2"/><circle cx="19" cy="7" r="2"/><circle cx="12" cy="20" r="2"/></svg><span data-i18n="navGuilds">Polykulturen</span></a>
          <a href="/gartenplan" data-nav="/gartenplan" class="rounded-md px-2.5 py-1 text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z"/></svg><span data-i18n="navPlanner">Planer</span></a>
        </div>

        <!-- Right side: module menus, Beta, help and one account menu that holds everything else (sign-in, view, language, text size, contrast, light/dark, settings). -->
        <div class="ml-auto flex items-center gap-1.5">
          <!-- Menus added by expert modules (lib/expert-api.ts, LayoutApi.addHeaderMenu) -->
          <div id="header-extra" class="contents"></div>
          <!-- Beta, not signed in: leads to the beta signup (too narrow below 390 px, the footer has it) -->
          <a id="header-beta" href="/beta/" data-i18n-title="betaJoinTitle" title="Beta-Test: jetzt anmelden" class="hdr-pill hdr-beta max-[389px]:hidden"><span data-i18n="betaBadge">Beta</span></a>
          <!-- Beta, signed in: shows that the beta is on; opens feedback and the info about the beta access -->
          <details id="beta-badge" hidden class="relative">
            <summary data-i18n-title="betaBadgeTitle" title="Beta-Test: Wir brauchen deine Meinung" class="hdr-pill hdr-beta hdr-beta-on cursor-pointer list-none [&::-webkit-details-marker]:hidden"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg><span data-i18n="betaBadge">Beta</span></summary>
            <div class="absolute right-0 top-full z-50 mt-2 w-64 rounded-xl bg-white dark:bg-stone-900 p-2 text-sm normal-case tracking-normal shadow-2xl ring-1 ring-stone-200 dark:ring-stone-700">
              <p class="px-2 pb-1.5 pt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="feedbackIntro">Was sollen wir wissen?</p>
              {fbItems.map(i => i.href
          ? <a data-fb={i.fb} href={i.href} class={fbItem}><span class="font-semibold text-stone-800 dark:text-stone-100" data-i18n={i.label}>{i.de}</span><span class="block text-xs text-stone-500 dark:text-stone-400" data-i18n={i.hint}>{i.deHint}</span></a>
          : <button data-fb={i.fb} type="button" class={fbItem}><span class="font-semibold text-stone-800 dark:text-stone-100" data-i18n={i.label}>{i.de}</span><span class="block text-xs text-stone-500 dark:text-stone-400" data-i18n={i.hint}>{i.deHint}</span></button>)}
              <a href="/beta/" class={`${fbItem} mt-1 border-t border-stone-200 dark:border-stone-700`}><span class="font-semibold text-stone-800 dark:text-stone-100" data-i18n="betaInfoLink">Über deinen Beta-Zugang</span></a>
            </div>
          </details>
          <!-- Help: one place for tour, guide, example project, shortcuts and bug reports -->
          <div class="relative">
            <button id="help-toggle" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="help-menu" data-i18n-aria-label="helpMenuLabel" data-i18n-title="helpMenuLabel" aria-label="Hilfe" title="Hilfe" class="hdr-round">?</button>
            <div id="help-menu" hidden class="hdr-panel absolute right-0 z-50 mt-1 w-64">
              <button id="help-intro" type="button" class="hdr-item" data-i18n="helpIntro">Einführung und Rundgang</button>
              <a href="/hilfe" class="hdr-item" data-i18n="footerHelp">Anleitung</a>
              <a href="/hilfe#quellen" class="hdr-item" data-i18n="helpSources">Quellen und Methode</a>
              <a href="/beispiel" class="hdr-item" data-i18n="welcomeExample">Beispielprojekt ansehen</a>
              <button id="help-shortcuts" type="button" class="hdr-item" data-i18n="shortcutsTitle">Tastatur-Shortcuts</button>
              <div class="hdr-sep"><a data-fb="bug" href="/fehler-melden/" class="hdr-item" data-i18n="feedbackBug">Fehler melden</a></div>
            </div>
          </div>
          <!-- Account and everything about the display: one button at the far right -->
          <div class="relative">
            <button id="user-toggle" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="user-menu" data-i18n-aria-label="userMenuLabel" data-i18n-title="userMenuLabel" aria-label="Konto, Sprache und Darstellung" title="Konto, Sprache und Darstellung" class="hdr-account">
              <span id="user-initial" hidden class="hdr-initial"></span>
              <svg id="user-icon" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path stroke-linecap="round" d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
              <span id="user-label" class="hidden sm:inline" data-i18n="modeLogin">Anmelden</span>
              <svg class="hidden h-3 w-3 sm:block" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7.5l5 5 5-5"/></svg>
            </button>
            <div id="user-menu" hidden class="hdr-panel absolute right-0 z-50 mt-1 w-72 max-h-[calc(100dvh-5rem)] overflow-y-auto">
              <p id="user-who" class="px-2 pb-1 text-xs font-semibold text-stone-500 dark:text-stone-400"></p>
              <a id="user-login" href="/anmelden/" class="hdr-item font-semibold text-green-700 dark:text-green-400"><span data-i18n="modeLogin">Anmelden</span></a>
              <a id="user-phone" href="/settings#login-section" hidden class="hdr-item"><span data-i18n="userPhone">Auf dem Handy anmelden (QR)</span></a>
              <button id="user-logout" type="button" hidden class="hdr-item"><span data-i18n="modeLogout">Abmelden</span></button>
              <!-- Ansicht: Einfach / Klassisch / Beta-Test / Team (src/lib/ui-mode.ts) -->
              <div id="mode-menu" role="group" aria-labelledby="mode-menu-heading" class="hdr-sep">
                <p id="mode-menu-heading" class="hdr-head" data-i18n="modeMenuHeading">Ansicht</p>
                <button type="button" data-mode-opt="simple" aria-pressed="false" class="hdr-item hdr-opt">
                  <span class="block font-medium" data-i18n="modeSimple">Einfach</span>
                  <span class="block text-xs text-stone-500 dark:text-stone-400" data-i18n="modeSimpleDesc">Fläche zeichnen, Pflanzen setzen, in 3D ansehen</span>
                </button>
                <button type="button" data-mode-opt="classic" aria-pressed="false" class="hdr-item hdr-opt">
                  <span class="block font-medium" data-i18n="modeClassic">Klassisch</span>
                  <span class="block text-xs text-stone-500 dark:text-stone-400" data-i18n="modeClassicDesc">Alle Werkzeuge, wie bisher</span>
                </button>
                <button type="button" data-mode-opt="expert" aria-pressed="false" class="hdr-item hdr-opt">
                  <span class="flex items-center gap-1.5 font-medium"><span data-i18n="modeExpert">Beta-Test</span><svg id="mode-expert-lock" class="h-3.5 w-3.5 text-stone-500 dark:text-stone-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="9" width="12" height="8" rx="1.5"/><path d="M7 9V6.5a3 3 0 0 1 6 0V9"/></svg></span>
                  <span class="block text-xs text-stone-500 dark:text-stone-400" data-i18n="modeExpertDesc">Klassisch plus Funktionen in Erprobung (mit Zugang)</span>
                </button>
                <button type="button" data-mode-opt="team" hidden aria-pressed="false" class="hdr-item hdr-opt">
                  <span class="block font-medium" data-i18n="modeTeam">Team</span>
                  <span class="block text-xs text-stone-500 dark:text-stone-400" data-i18n="modeTeamDesc">Alle Funktionen zum Testen (nur Team)</span>
                </button>
              </div>
              <div class="hdr-sep space-y-2 px-2 pb-1">
                <div role="group" aria-labelledby="lang-menu-label">
                  <p id="lang-menu-label" class="hdr-head px-0" data-i18n="langLabel">Sprache</p>
                  <div id="lang-menu" class="flex gap-1.5">
                    <button type="button" data-lang="de" aria-pressed="false" class="lang-option display-opt hdr-seg">Deutsch</button>
                    <button type="button" data-lang="en" aria-pressed="false" class="lang-option display-opt hdr-seg">English</button>
                    <button type="button" data-lang="es" aria-pressed="false" class="lang-option display-opt hdr-seg">Español</button>
                  </div>
                </div>
                <div role="group" aria-labelledby="display-font-label">
                  <p id="display-font-label" class="hdr-head px-0" data-i18n="fontSizeLabel">Schriftgröße</p>
                  <div class="flex gap-1.5">
                    <button type="button" class="display-opt hdr-seg" data-font-opt="100" aria-pressed="false" data-i18n-aria-label="fontSize100">A</button>
                    <button type="button" class="display-opt hdr-seg" data-font-opt="115" aria-pressed="false" data-i18n-aria-label="fontSize115">A+</button>
                    <button type="button" class="display-opt hdr-seg" data-font-opt="130" aria-pressed="false" data-i18n-aria-label="fontSize130">A++</button>
                  </div>
                </div>
                <div role="group" aria-labelledby="display-contrast-label">
                  <p id="display-contrast-label" class="hdr-head px-0" data-i18n="contrastLabel">Kontrast</p>
                  <div class="flex gap-1.5">
                    <button type="button" class="display-opt hdr-seg" data-contrast-opt="system" aria-pressed="false" data-i18n="contrastSystem">System</button>
                    <button type="button" class="display-opt hdr-seg" data-contrast-opt="normal" aria-pressed="false" data-i18n="contrastNormal">Normal</button>
                    <button type="button" class="display-opt hdr-seg" data-contrast-opt="more" aria-pressed="false" data-i18n="contrastMore">Hoch</button>
                  </div>
                </div>
                <div role="group" aria-labelledby="theme-label">
                  <p id="theme-label" class="hdr-head px-0" data-i18n="themeLabel">Hell / Dunkel</p>
                  <div class="flex gap-1.5">
                    <button type="button" class="display-opt hdr-seg" data-theme-opt="auto" aria-pressed="false" data-i18n="themeOptAuto">System</button>
                    <button type="button" class="display-opt hdr-seg" data-theme-opt="light" aria-pressed="false" data-i18n="themeOptLight">Hell</button>
                    <button type="button" class="display-opt hdr-seg" data-theme-opt="dark" aria-pressed="false" data-i18n="themeOptDark">Dunkel</button>
                  </div>
                </div>
