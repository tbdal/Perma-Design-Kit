    <script>
      // First-visit intro: a storage explainer dialog, then a spotlight tour
      // over the real page. Skipped on the legal/help pages so they stay
      // readable; "Einführung" in the footer replays it.
      import { createT, getLang } from '../lib/i18n/core';
      import { layoutDict } from '../lib/i18n/dict-layout';
      import { currentMode } from '../lib/ui-mode';
      const tt = createT(layoutDict);
      const WELCOME_KEY = 'pdk-welcome-seen';
      const markSeen = () => { try { localStorage.setItem(WELCOME_KEY, '1'); } catch {} };
      // "Womit möchtest du anfangen?" — once per device, after the welcome (or its tour); a link or × ends it for good.
      const START_KEY = 'pdk-start-seen';
      function showStart() {
        const dlg = document.getElementById('start-modal') as HTMLDialogElement | null;
        if (!dlg || dlg.open) return;
        try { if (localStorage.getItem(START_KEY)) return; localStorage.setItem(START_KEY, '1'); } catch { return; }
        dlg.showModal();
      }
      {
        const dlg = document.getElementById('start-modal') as HTMLDialogElement | null;
        dlg?.addEventListener('click', e => { if (e.target === dlg || (e.target as Element).closest('a, #start-close')) dlg.close(); });
      }

      type TourStep = { selector: string; closest?: string; dummy?: boolean; fallback?: string; title: string; text: string; fallbackText?: string; link?: { href: string; label: string } }; // link: i18n keys (URL differs per language)
      const TOUR_STEPS: TourStep[] = [
        { selector: '#plant-search', closest: 'div', title: 'tourSearchTitle', text: 'tourSearchText' },
        { selector: '#tour-dummy .btn-edit', dummy: true, title: 'tourEditTitle', text: 'tourEditText' },
        { selector: '#btn-view-list', title: 'tourListTitle', text: 'tourListText' },
        { selector: '#btn-view-cards', title: 'tourCardsTitle', text: 'tourCardsText' },
        { selector: 'a[data-nav="/polykulturen"]', title: 'tourGuildsTitle', text: 'tourGuildsText' },
        // the planner people actually have: the new one (team, beta) comes first in the menu, else the old one (#613)
        { selector: 'a[href="/gartenplan/#neu"], a[data-nav="/gartenplan"]', title: 'tourPlanTitle', text: 'tourPlanText' },
        // Start from an example — the loaders sit in the empty plant list ("Womit starten?").
        { selector: '#btn-load-samples-crawford', title: 'tourSamplesTitle', text: 'tourSamplesText',
          link: { href: 'tourSamplesHref', label: 'tourSamplesLink' } },
        // Last, where the menu has them: the Vorbilder, real forest gardens to learn from (#613).
        { selector: 'a[href="/intern/#vorbilder"]', title: 'tourVorbilderTitle', text: 'tourVorbilderText' },
      ];
      const visible = (el: Element | null): el is HTMLElement => {
        if (!el) return false;
        const r = (el as HTMLElement).getBoundingClientRect();
        return r.width > 0 && r.height > 0;
      };

      function runTour() {
        const block = document.getElementById('tour-block')!;
        const spot = document.getElementById('tour-spot')!;
        const card = document.getElementById('tour-card')!;
        const prev = document.getElementById('tour-prev') as HTMLButtonElement;
        const next = document.getElementById('tour-next') as HTMLButtonElement;
        // Step 2 points at the edit button of an example plant (not saved), so
        // it works even on an empty list and while the real button is hover-only.
        let dummy: HTMLElement | null = null;
        const list = document.getElementById('plant-list');
        if (list) {
          dummy = document.createElement('div');
          dummy.id = 'tour-dummy';
          dummy.className = 'flex items-center justify-between gap-3 rounded-xl bg-white dark:bg-stone-800 px-4 py-3 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700';
          dummy.innerHTML = '<div><p class="text-sm font-bold text-stone-800 dark:text-stone-100"></p><p class="text-xs italic text-stone-500 dark:text-stone-400">Exemplum plantus</p></div>'
            + '<button type="button" class="btn-edit rounded-md bg-stone-100 dark:bg-stone-700 px-2.5 py-1 text-xs font-medium text-stone-700 dark:text-stone-200"></button>';
          dummy.querySelector('p')!.textContent = tt('tourDummyName');
          dummy.querySelector('button')!.textContent = '✎ ' + tt('tourDummyEdit');
          list.prepend(dummy);
        }
        // Only steps whose target exists on this page (nav links are hidden on small screens, etc.)
        const steps = TOUR_STEPS.map(s => {
          const main = Array.from(document.querySelectorAll(s.selector)).find(visible);
          const box = main && s.closest ? (main.closest(s.closest) as HTMLElement | null) : null;
          if (main) return { el: box && visible(box) ? box : main, title: s.title, text: s.text, link: s.link };
          const fb = s.fallback ? Array.from(document.querySelectorAll(s.fallback)).find(visible) : null;
          return fb ? { el: fb, title: s.title, text: s.fallbackText ?? s.text, link: s.link } : null;
        }).filter((s): s is { el: HTMLElement; title: string; text: string; link: TourStep['link'] } => !!s);
        if (dummy) dummy.hidden = true;
        if (steps.length === 0) return;
        let idx = 0;
        const place = () => {
          const cur = steps[idx];
          const r = cur.el.getBoundingClientRect();
          const pad = 6;
          Object.assign(spot.style, { left: `${r.left - pad}px`, top: `${r.top - pad}px`, width: `${r.width + 2 * pad}px`, height: `${r.height + 2 * pad}px` });
          const cw = card.offsetWidth, ch = card.offsetHeight, vw = window.innerWidth, vh = window.innerHeight;
          const below = r.bottom + pad + 12 + ch <= vh;
          const top = below ? r.bottom + pad + 12 : Math.max(8, r.top - pad - 12 - ch);
          const left = Math.min(Math.max(8, r.left + r.width / 2 - cw / 2), vw - cw - 8);
          Object.assign(card.style, { top: `${top}px`, left: `${left}px` });
        };
        const show = () => {
          const cur = steps[idx];
          if (dummy) dummy.hidden = !dummy.contains(cur.el);
          cur.el.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
          document.getElementById('tour-title')!.textContent = tt(cur.title);
          const textEl = document.getElementById('tour-text')!;
          textEl.textContent = tt(cur.text);
          if (cur.link) {
            const a = document.createElement('a');
            a.href = tt(cur.link.href); a.target = '_blank'; a.rel = 'noopener';
            a.className = 'mt-1 block text-green-700 dark:text-green-400 underline underline-offset-2 hover:no-underline';
            a.textContent = tt(cur.link.label);
            textEl.append(a);
          }
          document.getElementById('tour-progress')!.textContent = `${idx + 1} / ${steps.length}`;
          prev.style.visibility = idx === 0 ? 'hidden' : 'visible';
          next.textContent = tt(idx === steps.length - 1 ? 'welcomeDone' : 'welcomeNext');
          place();
        };
        const end = () => {
          markSeen();
          showStart();
          for (const el of [block, spot, card]) el.hidden = true;
          dummy?.remove();
          window.removeEventListener('resize', place);
          document.removeEventListener('keydown', onKey, true);
        };
        const onKey = (e: KeyboardEvent) => {
          if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); end(); }
          else if (e.key === 'ArrowRight' || e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); next.click(); }
          else if (e.key === 'ArrowLeft') { e.preventDefault(); e.stopPropagation(); prev.click(); }
        };
        prev.onclick = () => { if (idx > 0) { idx--; show(); } };
        next.onclick = () => { if (idx >= steps.length - 1) end(); else { idx++; show(); } };
        (document.getElementById('tour-skip') as HTMLButtonElement).onclick = end;
        for (const el of [block, spot, card]) el.hidden = false;
        window.addEventListener('resize', place);
        document.addEventListener('keydown', onKey, true);
        show();
      }


      /** The beta block of the welcome page: in beta mode only with news (up to four tiles from the private server), otherwise always, tiles when there are some. */
      async function fillBeta() {
        const box = document.getElementById('welcome-beta')!;
        const jump = document.getElementById('welcome-beta-jump')!;
        const inBeta = currentMode() === 'expert';
        let items: { title: string; text: string; bild?: string }[] = [];
        try {
          const res = await fetch(`/api/beta/vorschau?lang=${getLang()}`, { cache: 'no-store', signal: AbortSignal.timeout(2500) });
          items = res.ok ? (await res.json()).items ?? [] : [];
        } catch { /* offline or no server: no tiles */ }
        jump.hidden = box.hidden = inBeta && !items.length;
        if (inBeta) {
          const line = document.getElementById('welcome-beta-text')!;
          line.textContent = tt('welcomeBetaTextIn');
          line.hidden = false;
          document.getElementById('welcome-beta-pitch')!.hidden = true;
          jump.hidden = true;
        }
        document.getElementById('welcome-beta-items')!.replaceChildren(...items.slice(0, 4).map(item => {
          const tile = document.createElement('div');
          tile.className = 'w-beta-item';
          if (item.bild) { const img = document.createElement('img'); img.src = item.bild; img.alt = ''; img.loading = 'lazy'; tile.append(img); }
          const h = document.createElement('h4'); h.textContent = item.title;
          const p = document.createElement('p'); p.textContent = item.text;
          tile.append(h, p);
          return tile;
        }));
      }
      document.getElementById('welcome-beta-jump')?.addEventListener('click', () => document.getElementById('welcome-beta')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
      const modal = document.getElementById('welcome-modal') as HTMLDialogElement | null;
      if (modal) {
        void fillBeta();
        const startTour = () => { markSeen(); modal.close(); runTour(); };
        document.getElementById('welcome-next')?.addEventListener('click', startTour);
        document.getElementById('welcome-skip')?.addEventListener('click', () => { markSeen(); modal.close(); showStart(); });
        document.getElementById('welcome-close')?.addEventListener('click', () => { markSeen(); modal.close(); showStart(); });
        for (const id of ['welcome-example', 'welcome-support']) document.getElementById(id)?.addEventListener('click', markSeen);
        modal.addEventListener('cancel', () => { markSeen(); setTimeout(showStart); });
        const open = () => { if (!modal.open) modal.showModal(); };
        document.getElementById('open-welcome')?.addEventListener('click', open);
        document.getElementById('help-intro')?.addEventListener('click', open);
        let seen = false;
        try { seen = !!localStorage.getItem(WELCOME_KEY); } catch {}
        const legal = /^\/(impressum|datenschutz|hilfe|anmelden|admin|beta)\/?$/.test(location.pathname) || document.documentElement.hasAttribute('data-bare');
        if (!seen && !legal) open();
      }
    </script>
    <script>
      import { onFeaturesChange } from '../lib/ui-mode';
      // Horizont design: the sky band must end exactly where the tree line
      // meets the content, which depends on the rendered header height and,
      // on the plant page, the search block in the sky ([data-hz-sky]).
      const root = document.documentElement;
      const anchor = document.querySelector<HTMLElement>('.hz-anchor');
      const header = document.querySelector<HTMLElement>('.site-header');
      const main = document.querySelector<HTMLElement>('.site-main');
      const sky = main?.querySelector<HTMLElement>('[data-hz-sky]') ?? null;
      const pageY = (el: Element) => el.getBoundingClientRect().top + scrollY;
      function layoutHorizon() {
        if (root.dataset.design !== 'horizont' || !anchor || !main) return;
        // --hz-trees scales with the viewport (vw), so read its rendered size.
        const probe = document.createElement('div');
        probe.style.cssText = 'position:absolute;visibility:hidden;height:var(--hz-trees)';
        anchor.appendChild(probe);
        const trees = probe.getBoundingClientRect().height;
        probe.remove();
        const skyShown = sky && sky.offsetParent !== null ? sky : null; // e.g. the plan page's search, only while placing
        const ground = (skyShown ? skyShown.getBoundingClientRect().bottom + scrollY : pageY(main)) + trees;
        root.style.setProperty('--hz-band-h', `${Math.round(ground - pageY(anchor))}px`);
        root.style.setProperty('--hz-ground', `${Math.round(ground - pageY(main))}px`);
      }
      // One header row only while it fits: the links (and module menus) vary by
      // mode and language, so measure in the one-row layout instead of using a
      // fixed breakpoint; otherwise the controls were pushed out of the window.
      const nav = header?.querySelector<HTMLElement>('nav');
      let fitQueued = false;
      function fitHeader() {
        fitQueued = false;
        if (!header || !nav) return;
        delete header.dataset.compact;
        if (nav.scrollWidth > nav.clientWidth + 1) header.dataset.compact = '';
      }
      // Deferred to the next frame: toggling the layout inside a ResizeObserver callback would loop.
      const queueFit = () => { if (!fitQueued) { fitQueued = true; requestAnimationFrame(fitHeader); } };
      fitHeader();
      if (nav) {
        const fitRo = new ResizeObserver(queueFit);
        for (const el of nav.querySelectorAll(':scope > *')) fitRo.observe(el);
        new MutationObserver(queueFit).observe(nav, { childList: true, subtree: true, characterData: true });
      }
      window.addEventListener('resize', queueFit);
      onFeaturesChange(queueFit); // links hidden or shown by the feature table
      document.fonts?.ready.then(queueFit);

      layoutHorizon();
      const ro = new ResizeObserver(layoutHorizon);
      if (header) ro.observe(header);
      if (sky) ro.observe(sky);
      window.addEventListener('resize', layoutHorizon);
      window.addEventListener('pdk-design-change', layoutHorizon);
      document.fonts?.ready.then(layoutHorizon);
      const onScroll = () => header?.classList.toggle('hz-scrolled', scrollY > 4);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
    <script>
      // Filter dropdowns open below their chip, left-aligned; near the right
      // edge of a phone screen that would cut the panel off. Shift it left.
      document.addEventListener('toggle', (e) => {
        const details = e.target as HTMLDetailsElement;
        if (!details.classList?.contains('filter-dropdown')) return;
        const panel = details.querySelector<HTMLElement>(':scope > div');
        if (!panel) return;
        panel.style.translate = '';
        if (!details.open) return;
        const overflow = panel.getBoundingClientRect().right - (document.documentElement.clientWidth - 8);
        if (overflow > 0) panel.style.translate = `-${Math.ceil(overflow)}px 0`;
      }, true);
    </script>
    <script>
      import { autoSyncIfConfigured, getSyncProblem, syncProviderLabel, SYNC_PROBLEM_EVENT } from '../lib/sync';
      import { createT } from '../lib/i18n/core';
      import { layoutDict } from '../lib/i18n/dict-layout';
      // Auto-sync runs while the tab is hidden, so a failure or a foreign
      // backup on the server is shown when the user comes back.
      function renderSyncProblem() {
        const banner = document.getElementById('sync-problem');
        const text = document.getElementById('sync-problem-text');
        if (!banner || !text) return;
        const problem = getSyncProblem();
        banner.hidden = !problem;
        if (!problem) return;
        const t = createT(layoutDict);
        const provider = syncProviderLabel(problem.provider) || problem.provider;
        text.textContent = problem.kind === 'conflict'
          ? t('syncProblemConflict', { provider })
          : t('syncProblemError', { provider, msg: problem.message });
      }
      renderSyncProblem();
      window.addEventListener(SYNC_PROBLEM_EVENT, renderSyncProblem);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) autoSyncIfConfigured().then(renderSyncProblem, () => {});
        else renderSyncProblem();
      });
    </script>
    <script>
      import { getLang, getUiLang, setLang, createT, applyStaticI18n, type UiLang } from '../lib/i18n/core';
      import { onForeignChange, staleAction } from '../lib/data-channel';
      import { getContrast, setContrast, applyContrast, getFontSize, setFontSize, applyFontSize, getTheme, setTheme, applyTheme, type ContrastPref, type FontSizePref, type ThemePref } from '../lib/settings';
      import { layoutDict } from '../lib/i18n/dict-layout';
      import { installBrokenImageCleanup } from '../lib/html';
      import { installImageZoom } from '../lib/image-zoom';
      import { installCommandPalette } from '../lib/command-palette';

      const t = createT(layoutDict);
      applyStaticI18n(layoutDict);
      installBrokenImageCleanup();
      installImageZoom(t('closeBtn'));
      installCommandPalette(t);

      // Display options in the account menu: contrast + text size, applied at once.
      const syncDisplayButtons = () => {
        const c = getContrast(), f = getFontSize();
        document.querySelectorAll<HTMLElement>('[data-contrast-opt]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.contrastOpt === c)));
        document.querySelectorAll<HTMLElement>('[data-font-opt]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.fontOpt === f)));
      };
      syncDisplayButtons();
      window.addEventListener('pdk-display-change', syncDisplayButtons);
      document.querySelectorAll<HTMLElement>('[data-contrast-opt]').forEach(b => b.addEventListener('click', () => {
        const c = b.dataset.contrastOpt as ContrastPref;
        setContrast(c); applyContrast(c);
      }));
      document.querySelectorAll<HTMLElement>('[data-font-opt]').forEach(b => b.addEventListener('click', () => {
        const f = b.dataset.fontOpt as FontSizePref;
        setFontSize(f); applyFontSize(f);
      }));
      // "System" contrast follows OS changes while the page is open.
      window.matchMedia('(prefers-contrast: more)').addEventListener('change', () => {
        if (getContrast() === 'system') applyContrast('system');
      });

      // Only one header menu open at a time: opening one closes the others (the toggles stop the
      // click from bubbling to the "click anywhere closes" listeners, hence capture phase).
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLElement>('.site-header .relative > button');
        if (!btn?.nextElementSibling?.matches('div.absolute')) return;
        document.querySelectorAll<HTMLElement>('.site-header .relative > button + div.absolute').forEach(panel => {
          if (panel === btn.nextElementSibling) return;
          panel.hidden = true;
          panel.previousElementSibling?.setAttribute('aria-expanded', 'false');
        });
      }, true);

      // Language: three buttons in the account menu; a change reloads the page.
      document.querySelectorAll<HTMLButtonElement>('#lang-menu .lang-option').forEach(btn => {
        btn.setAttribute('aria-pressed', String(btn.dataset.lang === getUiLang()));
        btn.addEventListener('click', () => {
          const lang = btn.dataset.lang as UiLang;
          if (lang && lang !== getUiLang()) {
            setLang(lang);
            location.reload();
          }
        });
      });

      // Another tab changed the data: this tab's copy in memory is old, and
      // saving from it would overwrite the newer state (lib/data-channel.ts).
      (function () {
        const banner = document.getElementById('stale-banner');
        let reloadOnReturn = false;
        onForeignChange(() => {
          // The page's own editor frame (Steckbriefe: the plant form over the page) saved; the page reloads its data itself.
          if (document.querySelector('iframe[name="pdk-edit"]')) return;
          if (staleAction(document.hidden, !!document.querySelector('dialog[open]')) === 'reload-on-return') reloadOnReturn = true;
          else if (banner) banner.hidden = false;
        });
        document.addEventListener('visibilitychange', () => { if (!document.hidden && reloadOnReturn) location.reload(); });
        document.getElementById('stale-reload')?.addEventListener('click', () => location.reload());
        // back/forward cache: a frozen page missed every change message and would save its old copy (#7)
        window.addEventListener('pageshow', e => { if (e.persisted) location.reload(); });
      })();

      // Service worker (public/sw.js): keeps the whole build for offline use.
      // A new build installs in the background and waits; the banner lets the
      // user switch when it suits them — otherwise it takes over once every
      // tab is closed. Not in `astro dev`: a cached shell would hide edits.
      if ('serviceWorker' in navigator) {
        if (import.meta.env.DEV) {
          navigator.serviceWorker.getRegistrations().then(rs => rs.forEach(r => r.unregister())).catch(() => {});
        } else {
          const updateBanner = document.getElementById('update-banner');
          let reloading = false;
          const offerUpdate = (reg: ServiceWorkerRegistration) => {
            // Without a controller this is the very first install — nothing to update from.
            if (!reg.waiting || !navigator.serviceWorker.controller || !updateBanner) return;
            updateBanner.hidden = false;
            document.getElementById('update-reload')!.onclick = () => {
              reloading = true;
              reg.waiting?.postMessage('SKIP_WAITING');
            };
          };
          navigator.serviceWorker.addEventListener('controllerchange', () => { if (reloading) location.reload(); });
          navigator.serviceWorker.register('/sw.js').then(reg => {
            offerUpdate(reg);
            reg.addEventListener('updatefound', () => {
              const next = reg.installing;
              next?.addEventListener('statechange', () => { if (next.state === 'installed') offerUpdate(reg); });
            });
            // An installed app can stay open for days: look for a new build when it comes back to the front.
            document.addEventListener('visibilitychange', () => { if (!document.hidden) reg.update().catch(() => {}); });
          }).catch(() => {});
        }
      }

      // (a) Dauerhafter Speicher: nicht mehr still bei jedem Aufruf anfragen
      //     (Firefox zeigt dann ein unerklärtes Berechtigungsfenster), sondern
      //     erst, wenn es Daten gibt, mit einem erklärenden Banner. "Später"
      //     oder eine Ablehnung fragt nach 14 Tagen erneut.
      (async function () {
        const PERSIST_LATER_KEY = 'pdk-persist-later';
        const banner = document.getElementById('persist-banner');
        if (!banner || !navigator.storage?.persist || !navigator.storage.persisted) return;
        try { if (await navigator.storage.persisted()) return; } catch { return; }
        let later = 0;
        try { later = Number(localStorage.getItem(PERSIST_LATER_KEY) || 0); } catch {}
        if (Date.now() - later < 14 * 86400000) return;
        if (!(await storeHasData('plants') || await storeHasData('gardenPlans'))) return;
        const text = document.getElementById('persist-banner-text')!;
        const postpone = () => { try { localStorage.setItem(PERSIST_LATER_KEY, String(Date.now())); } catch {} };
        banner.hidden = false;
        document.getElementById('persist-banner-later')?.addEventListener('click', () => { postpone(); banner.hidden = true; });
        document.getElementById('persist-banner-ok')?.addEventListener('click', async () => {
          let ok = false;
          try { ok = await navigator.storage.persist(); } catch {}
          if (!ok) postpone();
          text.textContent = t(ok ? 'persistGranted' : 'persistDenied');
          banner.querySelectorAll('button').forEach(b => (b.hidden = true));
          setTimeout(() => { banner.hidden = true; }, ok ? 4000 : 9000);
        });
      })();

      /** True when the given store of the app DB has at least one record (no import of db.ts). */
      function storeHasData(store: string): Promise<boolean> {
        return new Promise<boolean>(resolve => {
          try {
            const req = indexedDB.open('permaculture-guilds');
            req.onsuccess = () => {
              const db = req.result;
              if (!db.objectStoreNames.contains(store)) { db.close(); resolve(false); return; }
              const count = db.transaction(store, 'readonly').objectStore(store).count();
              count.onsuccess = () => { resolve(count.result > 0); db.close(); };
              count.onerror = () => { resolve(false); db.close(); };
            };
            req.onerror = () => resolve(false);
          } catch { resolve(false); }
        });
      }

      // The feedback menus (Feedback button, Beta shield) carry the current page (path + query, never the
      // #fragment — a share link keeps a whole project there).
      {
        const from = encodeURIComponent(location.pathname + location.search);
        document.querySelectorAll('[data-fb="bug"]').forEach(a => a.setAttribute('href', `/fehler-melden/?from=${from}`));
        document.querySelectorAll('[data-fb="idea"]').forEach(a => a.setAttribute('href', `/fehler-melden/?art=idee&from=${from}`));
        const menus = [...document.querySelectorAll<HTMLDetailsElement>('#feedback-fab, #beta-badge')];
        const fab = document.getElementById('feedback-fab') as HTMLDetailsElement | null;
        // Not on the report page itself. In the planner on phones the map and its bottom bar need the corner: there it is a
        // small round button a little higher up instead (#592: it was missing there altogether).
        if (fab && location.pathname.startsWith('/fehler-melden')) fab.hidden = true;
        else if (fab && location.pathname.startsWith('/gartenplan') && matchMedia('(max-width: 639px)').matches) {
          fab.classList.add('fab-compact');
          fab.style.bottom = 'max(5.5rem, calc(env(safe-area-inset-bottom, 0px) + 5rem))';
          fab.style.right = 'max(0.5rem, env(safe-area-inset-right, 0px))';
        }
        document.querySelectorAll('[data-fb="pick"]').forEach(b => b.addEventListener('click', () => {
          menus.forEach(m => { m.open = false; });
          void import('../lib/feedback-pick').then(m => m.startPick());
        }));
        document.addEventListener('click', e => menus.forEach(m => { if (m.open && !m.contains(e.target as Node)) m.open = false; }));
        document.addEventListener('keydown', e => { if (e.key === 'Escape') menus.forEach(m => { m.open = false; }); });
      }

      // Highlight active top-nav link based on the current pathname.
      (function () {
        const path = location.pathname.replace(/\/$/, '') || '/';
        document.querySelectorAll<HTMLAnchorElement>('a[data-nav]').forEach(a => {
          if (a.dataset.nav === path) { a.classList.add('bg-green-800', 'dark:bg-green-900', 'text-white'); a.setAttribute('aria-current', 'page'); }
        });
      })();

      // (b) Backup-Reminder. Zeigt einen Banner, wenn das letzte Backup länger
      //     als REMIND_AFTER_DAYS her ist (oder es nie eines gab) UND der User
      //     den Hinweis heute noch nicht weggeklickt hat. Nur, wenn überhaupt
      //     Pflanzen in der DB sind.
      (async function () {
        const REMIND_AFTER_DAYS = 30;
        const lsGet2 = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
        const lsSet2 = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
        const banner = document.getElementById('backup-reminder');
        const text = document.getElementById('backup-reminder-text');
        const dismiss = document.getElementById('backup-reminder-dismiss');
        if (!banner) return;

        const todayKey = new Date().toISOString().slice(0, 10);
        if (lsGet2('backup-reminder-dismissed-on') === todayKey) return;
        // Server storage on (Team): once dismissed, the hint stays away for good — the server holds the backup.
        if (lsGet2('speicher-auto') === '1' && lsGet2('backup-reminder-dismissed-on')) return;

        // Check IndexedDB plant count without importing — just open the existing DB.
        const hasPlants = await new Promise<boolean>(resolve => {
          try {
            const req = indexedDB.open('permaculture-guilds');
            req.onsuccess = () => {
              const db = req.result;
              if (!db.objectStoreNames.contains('plants')) { db.close(); resolve(false); return; }
              const tx = db.transaction('plants', 'readonly');
              const count = tx.objectStore('plants').count();
              count.onsuccess = () => { resolve(count.result > 0); db.close(); };
              count.onerror = () => { resolve(false); db.close(); };
            };
            req.onerror = () => resolve(false);
          } catch { resolve(false); }
        });
        if (!hasPlants) return;

        const lastBackup = lsGet2('last-backup-at');
        const days = lastBackup
          ? Math.floor((Date.now() - new Date(lastBackup).getTime()) / 86400000)
          : Infinity;
        if (days < REMIND_AFTER_DAYS) return;

        if (text) text.textContent = isFinite(days)
          ? t('backupReminderDays', { days })
          : t('backupReminderNever');
        banner.hidden = false;
        dismiss?.addEventListener('click', () => { banner.hidden = true; lsSet2('backup-reminder-dismissed-on', todayKey); });
      })();
      // ── Light / dark: three buttons in the account menu (also in Einstellungen) ──
      const syncThemeButtons = () => {
        const cur = getTheme();
        document.querySelectorAll<HTMLElement>('[data-theme-opt]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.themeOpt === cur)));
      };
      syncThemeButtons();
      document.querySelectorAll<HTMLElement>('[data-theme-opt]').forEach(b => b.addEventListener('click', () => {
        const th = b.dataset.themeOpt as ThemePref;
        setTheme(th); applyTheme(th); syncThemeButtons();
      }));

      // ── Shortcut-Cheatsheet (?, Esc, Klick auf Backdrop) ─────────────────
      const shortcutsModal = document.getElementById('shortcuts-modal') as HTMLDialogElement | null;
      document.getElementById('shortcuts-close')?.addEventListener('click', () => shortcutsModal?.close());
      shortcutsModal?.addEventListener('click', (e) => {
        // Click on backdrop (the dialog itself, not its content) closes.
        if (e.target === shortcutsModal) shortcutsModal.close();
      });
      // Alt+1…9: the main menu items in the order they are shown (e.code, so it also works with
      // macOS Option, which changes e.key). Items that modules add or hide count as they appear.
      document.addEventListener('keydown', (e) => {
        const m = /^Digit([1-9])$/.exec(e.code);
        if (!m || !e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
        if (document.querySelector('dialog[open]')) return;
        const link = [...document.querySelectorAll<HTMLAnchorElement>('#nav-links a[href]')].filter(l => l.offsetParent !== null)[Number(m[1]) - 1];
        if (!link) return;
        e.preventDefault();
        const url = new URL(link.href, location.href);
        const norm = (p: string) => p.replace(/\/$/, '') || '/';
        if (norm(url.pathname) !== norm(location.pathname) || (url.hash && location.hash !== url.hash)) location.href = url.pathname + url.search + url.hash;
        else if (!url.hash && location.hash === '#neu') { history.replaceState(null, '', location.pathname + location.search); location.reload(); }   // from a module's layout to the plain page
        else navSame();
      });
      // Nav to the page you are on: a page can take that as "back to its own
      // overview" (Waldgartenplan: from a plan to the project list) by
      // cancelling the 'pdk:nav-same' event; otherwise nothing happens.
      function navSame(): boolean {
        return !document.dispatchEvent(new CustomEvent('pdk:nav-same', { cancelable: true }));
      }
      document.querySelectorAll<HTMLAnchorElement>('a[data-nav]').forEach(a => {
        a.addEventListener('click', (e) => {
          if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;
          const here = location.pathname.replace(/\/$/, '') || '/';
          if (a.dataset.nav === here && navSame()) e.preventDefault();
        });
      });
      const showShortcuts = () => {
        // Show the shortcuts of the page you're on (garden plan vs. plant page).
        const page = location.pathname.startsWith('/gartenplan') ? 'gartenplan' : 'plants';
        shortcutsModal?.querySelectorAll<HTMLElement>('[data-shortcuts-for]').forEach(tb => { tb.hidden = tb.dataset.shortcutsFor !== page; });
        shortcutsModal?.showModal();
      };
      document.getElementById('help-shortcuts')?.addEventListener('click', showShortcuts);
      document.addEventListener('keydown', (e) => {
        if (e.key !== '?') return;
        const t = e.target as HTMLElement | null;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
        e.preventDefault();
        if (shortcutsModal?.open) { shortcutsModal.close(); return; }
        showShortcuts();
      });

      // ── PWA install prompts ──────────────────────────────────────────────
      const installBanner = document.getElementById('install-banner');
      const installAccept = document.getElementById('install-accept');
      const installDismiss = document.getElementById('install-dismiss');
      const iosPopup = document.getElementById('ios-install-popup');
      const iosDismiss = document.getElementById('ios-install-dismiss');

      const lsGet = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
      const lsSet = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

      let deferredPrompt: any = null;

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (installBanner && !lsGet('install-dismissed')) installBanner.hidden = false;
      });

      installAccept?.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        try {
          const { outcome } = await deferredPrompt.userChoice;
          if (outcome === 'dismissed') lsSet('install-dismissed', '1');
        } catch {}
        if (installBanner) installBanner.hidden = true;
        deferredPrompt = null;
      });

      installDismiss?.addEventListener('click', () => {
        if (installBanner) installBanner.hidden = true;
        lsSet('install-dismissed', '1');
      });

      window.addEventListener('appinstalled', () => {
        // An installed app is what browsers grant persistent storage to — ask right away (no prompt in Chrome).
        navigator.storage?.persist?.().catch(() => {});
        if (installBanner) installBanner.hidden = true;
        if (iosPopup) iosPopup.hidden = true;
        lsSet('install-dismissed', '1');
        lsSet('ios-install-dismissed', '1');
      });

      // iOS Safari heuristic: Apple devices (UA contains iPad/iPhone/iPod)
      // running Safari, not already in standalone mode, popup not yet dismissed.
      const ua = navigator.userAgent;
      // iPadOS reports itself as a Mac — told apart by its touch screen.
      const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      const standalone = window.matchMedia('(display-mode: standalone)').matches
        || (window.navigator as any).standalone === true;
      if (isIOS && !standalone && !lsGet('ios-install-dismissed') && iosPopup) {
        setTimeout(() => { iosPopup.hidden = false; }, 1500);
      }
      iosDismiss?.addEventListener('click', () => {
        if (iosPopup) iosPopup.hidden = true;
        lsSet('ios-install-dismissed', '1');
      });
    </script>
    <script>
      // Ansicht (Einfach / Klassisch / Experte): menu in the header, login
      // state, admin overrides, and — in expert mode — the private module.
      import { createT, getLang } from '../lib/i18n/core';
      import { layoutDict } from '../lib/i18n/dict-layout';
      import type { UiMode } from '../lib/features';
      import { modeAllowed } from '../lib/features';
      import { applyFeatures, currentMode, featureOn, getAuth, isLoginMode, logout, onFeaturesChange, refreshAuth, refreshFeatureConfig, registerFeatures, setMode } from '../lib/ui-mode';
      import { hasExpertCode, loadExpertModule } from '../lib/expert-loader';
      import { pageApi, providePageApi } from '../lib/expert-api';

      const t = createT(layoutDict);
      const menu = document.getElementById('mode-menu')!;
      const loginHref = (mode?: UiMode) =>
        `/anmelden/?next=${encodeURIComponent(location.pathname + location.search)}${mode ? `&mode=${mode}` : ''}`;

      function sync() {
        const mode = currentMode();
        const auth = getAuth();
        // Beta in the header: signed out a link to the signup, signed in a sign that the beta is on (with feedback)
        document.getElementById('beta-badge')!.hidden = !auth;
        menu.querySelectorAll<HTMLElement>('[data-mode-opt]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.modeOpt === mode)));
        document.getElementById('mode-expert-lock')!.toggleAttribute('hidden', !!auth);
        // Team: only offered to accounts that may use it.
        (menu.querySelector('[data-mode-opt="team"]') as HTMLElement).hidden = !modeAllowed('team', auth?.role ?? null);
        document.getElementById('header-beta')!.hidden = !!auth || /^\/beta\/?$/.test(location.pathname);
        // the account button: "Anmelden" when signed out, the initial and name when signed in
        const initial = document.getElementById('user-initial')!;
        initial.textContent = auth ? auth.name.slice(0, 1).toUpperCase() : '';
        initial.hidden = !auth;
        document.getElementById('user-icon')!.toggleAttribute('hidden', !!auth);
        document.getElementById('user-label')!.textContent = auth ? auth.name : t('modeLogin');
        document.getElementById('user-who')!.textContent = auth ? t('modeLoggedInAs', { name: auth.name }) : t('userLoggedOut');
        document.getElementById('user-phone')!.hidden = !auth;
        const userLogin = document.getElementById('user-login') as HTMLAnchorElement;
        userLogin.hidden = !!auth;
        userLogin.href = loginHref();
        document.getElementById('user-logout')!.hidden = !auth;
      }
      // The two header menus (help, account): a click outside or Esc closes them.
      const headerMenu = (toggleId: string, panelId: string) => {
        const btn = document.getElementById(toggleId)!, panel = document.getElementById(panelId)!;
        const setOpen = (open: boolean) => { panel.hidden = !open; btn.setAttribute('aria-expanded', String(open)); };
        btn.addEventListener('click', e => { e.stopPropagation(); setOpen(!!panel.hidden); });
        panel.addEventListener('click', e => { e.stopPropagation(); if ((e.target as Element).closest('a, #help-intro, #help-shortcuts')) setOpen(false); });
        document.addEventListener('click', () => setOpen(false));
        document.addEventListener('keydown', e => { if (e.key === 'Escape' && !panel.hidden) { setOpen(false); btn.focus(); } });
        return setOpen;
      };
      headerMenu('help-toggle', 'help-menu');
      const setUserOpen = headerMenu('user-toggle', 'user-menu');
      menu.querySelectorAll<HTMLElement>('[data-mode-opt]').forEach(b => b.addEventListener('click', () => {
        const mode = b.dataset.modeOpt as UiMode;
        if (!modeAllowed(mode, getAuth()?.role ?? null)) { location.href = loginHref(mode); return; }
        setUserOpen(false);
        setMode(mode);
      }));
      document.getElementById('user-logout')!.addEventListener('click', () => { setUserOpen(false); void logout(); });

      // Header menus for expert modules: same look as the menus here, hidden with the feature.
      const headerMenus: HTMLElement[] = [];
      document.addEventListener('click', () => headerMenus.forEach(m => { m.hidden = true; }));
      providePageApi('layout', {
        addHeaderMenu(featureId, label, opts = {}) {
          const wrap = document.createElement('div');
          wrap.className = 'relative';
          wrap.dataset.feature = featureId;
          const button = document.createElement('button');
          button.type = 'button';
          button.setAttribute('aria-haspopup', 'true');
          button.setAttribute('aria-expanded', 'false');
          button.className = opts.accent
            // Set apart from the regular menus (e.g. tools only for the team).
            ? 'header-extra-toggle header-extra-accent inline-flex items-center gap-1 rounded-full bg-amber-300 px-3 py-1 text-sm font-semibold text-amber-950 shadow-sm ring-1 ring-amber-500/60 transition hover:bg-amber-200 dark:bg-amber-400 dark:hover:bg-amber-300'
            : 'header-extra-toggle inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-sm font-medium text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900';
          button.textContent = label;
          const panel = document.createElement('div');
          panel.hidden = true;
          // ids + aria-controls: the Strg+O search offers the menu's entries (lib/command-palette.ts, menuToggle)
          panel.id = `header-extra-${featureId}-menu`;
          button.setAttribute('aria-controls', panel.id);
          panel.className = 'absolute right-0 z-50 mt-1 w-64 space-y-0.5 rounded-lg bg-white dark:bg-stone-800 p-2 text-sm text-stone-700 dark:text-stone-200 shadow-lg ring-1 ring-stone-200 dark:ring-stone-700';
          panel.addEventListener('click', e => {
            e.stopPropagation();
            // A link that only changes the #hash (same page) would leave the menu standing.
            if ((e.target as Element).closest('a')) { panel.hidden = true; button.setAttribute('aria-expanded', 'false'); }
          });
          button.addEventListener('click', e => {
            e.stopPropagation();
            const open = panel.hidden;
            headerMenus.forEach(m => { m.hidden = true; });
            panel.hidden = !open;
            button.setAttribute('aria-expanded', String(open));
          });
          headerMenus.push(panel);
          wrap.append(button, panel);
          document.getElementById('header-extra')!.appendChild(wrap);
          return panel;
        },
        addNavLink(featureId, label, href, opts = {}) {
          const ref = document.querySelector<HTMLAnchorElement>(`a[data-nav="${CSS.escape(opts.after ?? '')}"]`)
            ?? [...document.querySelectorAll<HTMLAnchorElement>('a[data-nav]')].pop()!;
          const a = document.createElement('a');
          a.href = href;
          a.dataset.feature = featureId;
          // Look of the regular links (the first one; the forest-garden link is dimmed as experimental).
          const base = document.querySelector<HTMLAnchorElement>('a[data-nav]')!;
          a.className = base.className.split(/\s+/).filter(c => !['bg-green-800', 'dark:bg-green-900', 'text-white'].includes(c)).join(' ');
          a.textContent = label;
          ref.after(a);
          const url = new URL(href, location.href);
          const mark = () => {
            const on = url.pathname.replace(/\/$/, '') === location.pathname.replace(/\/$/, '') && (!url.hash || url.hash === location.hash);
            a.classList.toggle('bg-green-800', on); a.classList.toggle('dark:bg-green-900', on); a.classList.toggle('text-white', on);
            if (on) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
          };
          mark();
          window.addEventListener('hashchange', mark);
          return a;
        },
      });

      onFeaturesChange(sync);
      applyFeatures();
      void refreshFeatureConfig();
      // Only for people who logged in on this device (no extra request for everyone else).
      if (getAuth()) void refreshAuth();

      /** The expert module did not load although logged in: most likely this
       *  tab runs an older build whose /x/ chunks are gone. Take the waiting
       *  new build (or look for one) and reload — once per session. */
      function switchToNewBuild() {
        if (!('serviceWorker' in navigator)) return;
        try { if (sessionStorage.getItem('pdk-x-update')) return; sessionStorage.setItem('pdk-x-update', '1'); } catch { return; }
        navigator.serviceWorker.getRegistration().then(reg => {
          if (!reg) return;
          const take = (w: ServiceWorker | null) => {
            if (!w) return;
            navigator.serviceWorker.addEventListener('controllerchange', () => location.reload());
            w.postMessage('SKIP_WAITING');
          };
          if (reg.waiting) { take(reg.waiting); return; }
          reg.addEventListener('updatefound', () => {
            const next = reg.installing;
            next?.addEventListener('statechange', () => { if (next.state === 'installed') take(reg.waiting); });
          });
          reg.update().catch(() => {});
        }).catch(() => {});
      }

      // Expert mode: load the private module (only in builds that contain
      // src/expert/; its chunks come from /x/, which needs the login cookie).
      if (hasExpertCode && isLoginMode(currentMode())) {
        loadExpertModule().then(async mod => {
          if (!mod) { if (getAuth()) switchToNewBuild(); return; }
          registerFeatures(mod.features);
          await mod.mount({
            page: location.pathname.replace(/\/$/, '') || '/',
            lang: getLang(),
            featureOn,
            onFeaturesChange: cb => onFeaturesChange(() => cb()),
            pageApi,
          });
        }).catch(err => console.warn('expert module failed', err));
      }
    </script>
  </body>
</html>
