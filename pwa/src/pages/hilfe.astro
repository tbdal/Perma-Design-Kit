---
import Layout from '../layouts/Layout.astro';
import { hilfeDict } from '../lib/i18n/dict-hilfe';
// Pictures from the project documentation (public/hilfe/); a click opens them full size.
const de = (k: string) => hilfeDict[k].de;
const img = 'w-full rounded-lg ring-1 ring-stone-200 dark:ring-stone-700';
const cap = 'mt-1 text-xs text-stone-500 dark:text-stone-400';
---
<Layout title="Perma Design Kit — Hilfe">
  <article class="mx-auto max-w-3xl space-y-8 text-stone-800 dark:text-stone-100 [&>section]:scroll-mt-28">
    <header>
      <h1 class="text-2xl font-bold" data-i18n="pageTitle">Hilfe & Glossar</h1>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400" data-i18n="pageSubtitle">Konzepte, Ansichten und Funktionen kurz erklärt.</p>
    </header>

    <section id="idee" class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="aboutHeading">{de('aboutHeading')}</h2>
      <p data-i18n="aboutP1">{de('aboutP1')}</p>
      <p data-i18n="aboutP2">{de('aboutP2')}</p>
      <figure class="max-w-md">
        <a href="/hilfe/ko-design.jpg" target="_blank" rel="noopener"><img src="/hilfe/ko-design.jpg" width="662" height="662" loading="lazy" decoding="async" class={img} alt={de('figCoDesignAlt')} data-i18n-alt="figCoDesignAlt" /></a>
        <figcaption class={cap} data-i18n="figCoDesign">{de('figCoDesign')}</figcaption>
      </figure>
      <h3 class="pt-1 font-semibold" data-i18n="aboutUsesHeading">{de('aboutUsesHeading')}</h3>
      <dl class="space-y-3">
        <div><dt class="font-semibold" data-i18n="aboutUse1Term">{de('aboutUse1Term')}</dt><dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="aboutUse1Desc">{de('aboutUse1Desc')}</dd></div>
        <div><dt class="font-semibold" data-i18n="aboutUse2Term">{de('aboutUse2Term')}</dt><dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="aboutUse2Desc">{de('aboutUse2Desc')}</dd></div>
        <div><dt class="font-semibold" data-i18n="aboutUse3Term">{de('aboutUse3Term')}</dt><dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="aboutUse3Desc">{de('aboutUse3Desc')}</dd></div>
      </dl>
      <figure class="max-w-md">
        <a href="/hilfe/spielidee.jpg" target="_blank" rel="noopener"><img src="/hilfe/spielidee.jpg" width="777" height="564" loading="lazy" decoding="async" class={img} alt={de('figGameAlt')} data-i18n-alt="figGameAlt" /></a>
        <figcaption class={cap} data-i18n="figGame">{de('figGame')}</figcaption>
      </figure>
    </section>

    <section id="polykulturen" class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="guildHeading">Was ist eine Permakultur-Polykultur?</h2>
      <p><span data-i18n="guildDefIntro">Eine</span> <strong data-i18n="guildDefStrong">Polykultur</strong> <span data-i18n="guildDefRest">ist eine Gruppe von Pflanzen, die sich gegenseitig fördert: Bäume,
        Sträucher, Stauden, Bodendecker und Wurzelpflanzen werden so kombiniert, dass sie sich Nährstoffe,
        Schatten, Bestäuber und Schädlingsabwehr teilen. Statt einer Monokultur entsteht ein kleines, sich
        weitgehend selbst regulierendes Ökosystem rund um eine zentrale Hauptpflanze (oft ein Obstbaum).</span></p>
      <p data-i18n="guildAppIntro">Diese App hilft dir, Pflanzen mit ihren wichtigsten Eigenschaften zu erfassen, anzureichern und
        als Karten zu drucken — als Grundlage, um eigene Polykulturen zu komponieren.</p>
      <p><span data-i18n="guildPageIntro">Auf der Seite</span> <a href="/polykulturen" data-i18n="guildPageLink" class="text-green-700 dark:text-green-400 underline underline-offset-2 hover:no-underline">Polykulturen</a> <span data-i18n="guildPageRest">kannst du eigene Polykulturen anlegen: Ankerart wählen, Mitglieder mit Rolle hinzufügen
        (Begleiter, Bodendecker, N-Fixer, Mineraliensammler, Insekten- oder Duftpflanze, Obst/Beere).
        Das Vorschlags-Panel filtert deinen Pflanzen-Bestand nach offenen Rollen und
        zeigt dir eine Sonne/Wasser/pH-Kompatibilität (0–3) zur Ankerart an.</span></p>
      <h3 class="pt-1 font-semibold" data-i18n="procHeading">{de('procHeading')}</h3>
      <p data-i18n="procP1">{de('procP1')}</p>
      <figure class="max-w-xl">
        <a href="/hilfe/designprozess.jpg" target="_blank" rel="noopener"><img src="/hilfe/designprozess.jpg" width="622" height="455" loading="lazy" decoding="async" class={img} alt={de('figProcessAlt')} data-i18n-alt="figProcessAlt" /></a>
        <figcaption class={cap} data-i18n="figProcess">{de('figProcess')}</figcaption>
      </figure>
      <p data-i18n="procP2">{de('procP2')}</p>
      <h3 class="pt-1 font-semibold" data-i18n="colorsHeading">{de('colorsHeading')}</h3>
      <p data-i18n="colorsP">{de('colorsP')}</p>
      <p data-i18n="colorsPrinciples">{de('colorsPrinciples')}</p>
    </section>

    <section class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="viewsHeading">Ansichten</h2>
      <dl class="space-y-3">
        <div>
          <dt class="font-semibold" data-i18n="viewTilesTerm">Kacheln</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="viewTilesDesc">Übersicht mit Bildvorschau, Akzentstreifen
            nach Primärnutzung und Vollständigkeitsbalken. Gut zum Stöbern.</dd>
        </div>
        <div>
          <dt class="font-semibold" data-i18n="viewListTerm">Liste</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="viewListDesc">Sortierbare Tabelle (Desktop) bzw. kompakte
            Karten (Mobil) mit Nutzungs-Dots und Vollständigkeit. Ideal für Mehrfach­auswahl und Bulk-Aktionen.</dd>
        </div>
        <div>
          <dt class="font-semibold" data-i18n="viewCardsTerm">Karten</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="viewCardsDesc">Druckansicht der Pflanzenkarten — Vorschau
            des PDF-Exports im Browser.</dd>
        </div>
      </dl>
    </section>

    <section class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="variantsHeading">Karten-Varianten</h2>
      <dl class="space-y-3">
        <div>
          <dt class="font-semibold" data-i18n="variantPolyTerm">Pflanzenkarten (Polykarte)</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="variantPolyDesc">70 × 120 mm. Eine Karte pro Pflanze mit
            Bild, Namen, Eigenschaften und Phänologie. Standardformat zum Auslegen oder Anheften.</dd>
        </div>
        <div>
          <dt class="font-semibold" data-i18n="variantStripeTerm">Streifenkarten</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="variantStripeDesc">290 × 17 mm Querformat. Kompakte Zeile pro
            Pflanze — gut für Etiketten oder Schnellübersichten.</dd>
        </div>
        <div>
          <dt class="font-semibold" data-i18n="variantBaumscheibeTerm">Baumscheibe</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="variantBaumscheibeDesc">{de('variantBaumscheibeDesc')}</dd>
        </div>
      </dl>
    </section>

    <section id="baumscheibe" class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="readHeading">{de('readHeading')}</h2>
      <p data-i18n="readIntro">{de('readIntro')}</p>
      <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,16rem)] sm:items-start">
        <dl class="min-w-0 space-y-3">
          <div><dt class="font-semibold" data-i18n="readTopTerm">{de('readTopTerm')}</dt><dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="readTopDesc">{de('readTopDesc')}</dd></div>
          <div><dt class="font-semibold" data-i18n="readNicheTerm">{de('readNicheTerm')}</dt><dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="readNicheDesc">{de('readNicheDesc')}</dd></div>
          <div><dt class="font-semibold" data-i18n="readSoilTerm">{de('readSoilTerm')}</dt><dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="readSoilDesc">{de('readSoilDesc')}</dd></div>
          <div><dt class="font-semibold" data-i18n="readMonthsTerm">{de('readMonthsTerm')}</dt><dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="readMonthsDesc">{de('readMonthsDesc')}</dd></div>
          <div><dt class="font-semibold" data-i18n="readFuncTerm">{de('readFuncTerm')}</dt><dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="readFuncDesc">{de('readFuncDesc')}</dd></div>
        </dl>
        <figure>
          <a href="/hilfe/pflanzeninformationen.jpg" target="_blank" rel="noopener"><img src="/hilfe/pflanzeninformationen.jpg" width="447" height="632" loading="lazy" decoding="async" class={img} alt={de('figLegendAlt')} data-i18n-alt="figLegendAlt" /></a>
          <figcaption class={cap} data-i18n="figLegend">{de('figLegend')}</figcaption>
        </figure>
      </div>
      <p class="text-sm text-stone-600 dark:text-stone-300" data-i18n="readNote">{de('readNote')}</p>
    </section>

    <section id="auslegen" class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="layHeading">{de('layHeading')}</h2>
      <h3 class="pt-1 font-semibold" data-i18n="layPrintHeading">{de('layPrintHeading')}</h3>
      <p data-i18n="layPrint">{de('layPrint')}</p>
      <p data-i18n="layMaterial">{de('layMaterial')}</p>
      <h3 class="pt-1 font-semibold" data-i18n="layMapHeading">{de('layMapHeading')}</h3>
      <p data-i18n="layMapIntro">{de('layMapIntro')}</p>
      <ul class="list-disc space-y-1 pl-5">
        <li data-i18n="layMap1">{de('layMap1')}</li>
        <li data-i18n="layMap2">{de('layMap2')}</li>
        <li data-i18n="layMap3">{de('layMap3')}</li>
        <li data-i18n="layMap4">{de('layMap4')}</li>
        <li data-i18n="layMap5">{de('layMap5')}</li>
      </ul>
      <p data-i18n="layMapP2">{de('layMapP2')}</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <figure class="min-w-0">
          <a href="/hilfe/infoboard.jpg" target="_blank" rel="noopener"><img src="/hilfe/infoboard.jpg" width="852" height="564" loading="lazy" decoding="async" class={img} alt={de('figBoardAlt')} data-i18n-alt="figBoardAlt" /></a>
          <figcaption class={cap} data-i18n="figBoard">{de('figBoard')}</figcaption>
        </figure>
        <figure class="min-w-0">
          <a href="/hilfe/grundkarte-infoboard.jpg" target="_blank" rel="noopener"><img src="/hilfe/grundkarte-infoboard.jpg" width="509" height="337" loading="lazy" decoding="async" class={img} alt={de('figMapBoardAlt')} data-i18n-alt="figMapBoardAlt" /></a>
          <figcaption class={cap} data-i18n="figMapBoard">{de('figMapBoard')}</figcaption>
        </figure>
      </div>
      <figure class="max-w-xs">
        <a href="/hilfe/szenario-a.jpg" target="_blank" rel="noopener"><img src="/hilfe/szenario-a.jpg" width="620" height="876" loading="lazy" decoding="async" class={img} alt={de('figScenarioAlt')} data-i18n-alt="figScenarioAlt" /></a>
        <figcaption class={cap} data-i18n="figScenario">{de('figScenario')}</figcaption>
      </figure>
      <p data-i18n="layPlanP">{de('layPlanP')}</p>
      <h3 class="pt-1 font-semibold" data-i18n="limitsHeading">{de('limitsHeading')}</h3>
      <p data-i18n="limits1">{de('limits1')}</p>
      <p data-i18n="limits2">{de('limits2')}</p>
    </section>

    <section id="quellen" class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="sourcesHeading">Datenquellen</h2>
      <p><span data-i18n="sourcesIntro">Beim Anlegen oder Anreichern werden Pflanzendaten aus verschiedenen Quellen kombiniert. Welche
        aktiv sind, stellst du in den</span> <a href="/settings" data-i18n="sourcesIntroLink" class="text-green-700 dark:text-green-400 underline underline-offset-2 hover:no-underline">Einstellungen</a> <span data-i18n="sourcesIntroEnd">ein.</span></p>
      <dl class="space-y-3">
        <div>
          <dt class="font-semibold" data-i18n="sourceWikidataTerm">Wikidata</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="sourceWikidataDesc">Lateinische und deutsche Namen, Bilder,
            Taxonomie. CORS-frei, direkter Zugriff aus dem Browser.</dd>
        </div>
        <div>
          <dt class="font-semibold" data-i18n="sourcePfafTerm">PFAF (Plants For A Future)</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="sourcePfafDesc">Nutzungs-Scores (Essbarkeit, Medizin,
            Material), Lichtbedarf, pH, Wasserbedarf, Wachstumsrate, Höhe/Breite, Frucht-/Blütemonate.
            Über Server-Proxy.</dd>
        </div>
        <div>
          <dt class="font-semibold" data-i18n="sourceEfgTerm">Edible Forest Gardens (Jacke &amp; Toensmeier)</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="sourceEfgDesc">Artentabelle aus „Edible Forest Gardens" Bd. 2.</dd>
        </div>
        <div>
          <dt class="font-semibold" data-i18n="sourceSizeTerm">Höhe und Breite</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="sourceSizeDesc">Höhe und Breite</dd>
        </div>
        <div>
          <dt class="font-semibold" data-i18n="sourcePriorityTerm">Reihenfolge</dt>
          <dd class="text-sm text-stone-600 dark:text-stone-300" data-i18n="sourcePriorityDesc">Haben mehrere Quellen Daten zu einem Feld, gewinnt die höher eingestufte.</dd>
        </div>
      </dl>
    </section>

    <section class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="vocabHeading">Visuelles Vokabular</h2>
      <ul class="list-disc space-y-1 pl-6 text-sm text-stone-600 dark:text-stone-300">
        <li><strong data-i18n="vocabBadgesTerm">Ausgefüllte Badges</strong> <span data-i18n="vocabBadgesDesc">= Nutzung der Pflanze (essbar, medizinisch, Material…).</span></li>
        <li><strong data-i18n="vocabChipsTerm">Outline-Chips</strong> <span data-i18n="vocabChipsDesc">= Datenquelle, aus der ein Wert stammt (z.B. PFAF).</span></li>
        <li><strong data-i18n="vocabAccentTerm">Akzentstreifen / -punkt</strong> <span data-i18n="vocabAccentDesc">= Primärnutzung in Kacheln (linker Rand) und Listenzeile. Bei mehreren Nutzungen gilt die erste passende Farbe dieser Reihenfolge:</span>
          <ul class="mt-1 space-y-0.5 pl-2">
            <li><span class="inline-block h-3 w-1.5 rounded-sm align-middle bg-amber-400"></span> <span data-i18n="vocabAccentEdible">essbar / Küche</span></li>
            <li><span class="inline-block h-3 w-1.5 rounded-sm align-middle bg-rose-400"></span> <span data-i18n="vocabAccentMeds">Heilpflanze</span></li>
            <li><span class="inline-block h-3 w-1.5 rounded-sm align-middle bg-lime-500"></span> <span data-i18n="vocabAccentNitrogen">Stickstofffixierer</span></li>
            <li><span class="inline-block h-3 w-1.5 rounded-sm align-middle bg-teal-400"></span> <span data-i18n="vocabAccentGround">Bodendecker</span></li>
            <li><span class="inline-block h-3 w-1.5 rounded-sm align-middle bg-cyan-400"></span> <span data-i18n="vocabAccentInsects">Insektenpflanze</span></li>
            <li><span class="inline-block h-3 w-1.5 rounded-sm align-middle bg-stone-200 dark:bg-stone-700"></span> <span data-i18n="vocabAccentNone">keine davon</span></li>
          </ul>
          <span data-i18n="vocabAccentImage">Hat die Pflanze ein Bild, ist der Streifen nur unterhalb davon zu sehen.</span>
        </li>
        <li><strong data-i18n="vocabBarTerm">Vollständigkeits­balken</strong> <span data-i18n="vocabBarDesc">= wieviele Felder gegenüber dem Maximum gefüllt sind
          (grün ≥ 80 %, gelb ≥ 50 %, rot darunter).</span></li>
      </ul>
    </section>

    <section class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="exportHeading">Daten exportieren & sichern</h2>
      <ul class="list-disc space-y-1 pl-6 text-sm text-stone-600 dark:text-stone-300">
        <li><strong data-i18n="exportBackupTerm">Backup (JSON)</strong> <span data-i18n="exportBackupDesc">in den Einstellungen: kompletter Datensatz inkl. Konfiguration —
          ideal als Sicherung oder zum Übertragen auf ein anderes Gerät.</span></li>
        <li><strong data-i18n="exportCsvTerm">CSV / JSON-Export</strong> <span data-i18n="exportCsvDesc">auf der Hauptseite: einzelne oder ausgewählte Pflanzen.</span></li>
        <li><strong data-i18n="exportPdfTerm">PDF-Export</strong> <span data-i18n="exportPdfDesc">aus der Kartenansicht: alle Karten, Streifen oder Baumscheiben.</span></li>
        <li><strong data-i18n="exportShareTerm">Projekt als Link teilen</strong> <span data-i18n="exportShareDesc">im Menü „Daten ⋮“ der Pflanzenseite oder in den Einstellungen: Pflanzen, Polykulturen und Waldgartenpläne stecken komprimiert im Link, nichts wird auf einem Server gespeichert. Wer den Link öffnet, kann das Projekt übernehmen.</span></li>
        <li><strong data-i18n="exportGroupTerm">Gruppe als Polykultur</strong> <span data-i18n="exportGroupDesc">auf der Polykulturen-Seite über „Aus Gruppe anlegen…“ — Gruppen vergibst du im Bearbeiten-Dialog einer Pflanze.</span></li>
        <li><strong data-i18n="exportManualTerm">„M“ = manuell</strong> <span data-i18n="exportManualDesc">im Bearbeiten-Dialog springt das Quellen-Kürzel eines Feldes (z. B. P für PFAF) auf M, sobald du den Wert änderst.</span></li>
      </ul>
    </section>

    <section id="gartenplan" class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="gpHeading">Waldgartenplan</h2>
      <p data-i18n="gpIntro">Im Waldgartenplan entsteht aus deinen Pflanzen ein maßstäblicher Plan des Gartens.</p>
      <h3 class="pt-1 font-semibold" data-i18n="gpModesHeading">Einfach, Klassisch, Experte</h3>
      <p data-i18n="gpModes">Oben rechts in der Kopfzeile wählst du die Ansicht.</p>
      <h3 class="pt-1 font-semibold" data-i18n="gpStartHeading">Anlegen und bepflanzen</h3>
      <ul class="list-disc space-y-1 pl-5">
        <li data-i18n="gpStart1">Neuer Waldgartenplan → Garten auf der Karte umranden.</li>
        <li data-i18n="gpStart2">Pflanzen platzieren.</li>
        <li data-i18n="gpStart3">Flächen, Reihe, Paket.</li>
        <li data-i18n="gpStart4">Jahre-Regler.</li>
      </ul>
      <h3 class="pt-1 font-semibold" data-i18n="gpMapHeading">Karte, Luftbild und Gelände</h3>
      <ul class="list-disc space-y-1 pl-5">
        <li data-i18n="gpMap1">Hintergrund.</li>
        <li data-i18n="gpMap2">Gelände.</li>
        <li data-i18n="gpMap3">Gebäude.</li>
      </ul>
      <h3 class="pt-1 font-semibold" data-i18n="gpAnalysisHeading">Auswertungen</h3>
      <ul class="list-disc space-y-1 pl-5">
        <li data-i18n="gpAna1">Funktions-Abdeckung.</li>
        <li data-i18n="gpAna2">Besonnung.</li>
        <li data-i18n="gpAna3">Hinweise.</li>
      </ul>
      <h3 class="pt-1 font-semibold" data-i18n="gpToolsHeading">Werkzeuge und Ausgaben</h3>
      <ul class="list-disc space-y-1 pl-5">
        <li data-i18n="gpTool1">3D.</li>
        <li data-i18n="gpTool2">Messen, Rückgängig.</li>
        <li data-i18n="gpTool3">Pflanzliste, Kalender.</li>
        <li data-i18n="gpTool4">Export, Teilen.</li>
      </ul>
      <p data-i18n="gpLimits">Grenzen.</p>
    </section>

    <section id="shortcuts" class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="shortcutsHeading">Tastatur-Shortcuts</h2>
      <p class="text-sm text-stone-600 dark:text-stone-300"><span data-i18n="shortcutsIntro">Greifen auf der Hauptseite — nicht
        während du in einem Eingabefeld tippst (außer</span> <kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1 text-xs">Esc</kbd><span data-i18n="shortcutsIntroEnd">, das schließt überall den offenen Dialog).</span></p>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-stone-200 dark:divide-stone-700">
          <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">/</kbd></td><td data-i18n="shortcutFocusSearch">Suche fokussieren</td></tr>
          <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">Esc</kbd></td><td data-i18n="shortcutCloseDialog">Offenen Dialog schließen</td></tr>
          <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">f</kbd></td><td data-i18n="shortcutFilterName">Liste nach Namen filtern</td></tr>
          <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">n</kbd></td><td data-i18n="shortcutNewPlant">Neue Pflanze</td></tr>
          <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">g</kbd></td><td data-i18n="shortcutTiles">Kachelansicht</td></tr>
          <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">l</kbd></td><td data-i18n="shortcutList">Listenansicht</td></tr>
          <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">c</kbd></td><td data-i18n="shortcutCards">Kartenansicht</td></tr>
          <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">Shift</kbd>+Klick</td><td data-i18n="shortcutShiftClick">In der Liste: Bereich von letzter bis aktueller Checkbox auswählen</td></tr>
          <tr><td class="py-1.5 pr-4 whitespace-nowrap"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">Alt</kbd>+<kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">1</kbd>…<kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">4</kbd></td><td data-i18n="shortcutNav">Auf allen Seiten: Pflanzen / Kalender / Polykulturen / Waldgartenplan</td></tr>
          <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">?</kbd></td><td data-i18n="shortcutOverview">Übersicht der Kürzel der aktuellen Seite — im Waldgartenplan dessen eigene (2/3, H/V/L/M, F/R/U, G, P, Strg+Z …)</td></tr>
        </tbody>
      </table>
      <p class="rounded-lg bg-green-50 dark:bg-green-900/20 px-3 py-2 text-sm text-stone-700 dark:text-stone-200 ring-1 ring-green-200 dark:ring-green-800"><span data-i18n="shortcutsMore">Je nach Seite und Ansicht gibt es weitere Kürzel – vor allem im Waldgartenplan: 2/3 für 2D/3D, H/V/L/M für Bewegen, Markieren, Lasso und Messen, F/R/U für Fläche, Reihe und Umriss, I/O für die Jahre, J/K für die Sonne in 3D, Strg+Z zum Rückgängigmachen, Alt+4 zurück zur Projektübersicht.</span> <span data-i18n="shortcutsMoreKey">Die vollständige Liste der aktuellen Seite zeigt jederzeit die Taste</span> <kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1 text-xs">?</kbd>.</p>
    </section>

    <section class="space-y-2">
      <h2 class="text-xl font-semibold" data-i18n="installHeading">App installieren</h2>
      <p><span data-i18n="installP1">Auf</span> <strong data-i18n="installAndroidChrome">Android / Chrome</strong> <span data-i18n="installP2">erscheint oben ein Banner „App installieren". Auf</span> <strong data-i18n="installIosSafari">iOS
        Safari</strong> <span data-i18n="installP3">tippe auf das Teilen-Symbol und „Zum Home-Bildschirm". Im installierten Zustand läuft
        die App offline und ohne Browser-Chrome.</span></p>
      <p data-i18n="installOffline">Nach dem ersten Besuch funktioniert die ganze App auch ohne Netz, im Browser wie installiert; nur Suche, Datenquellen und Kartenhintergrund brauchen eine Verbindung. Gibt es eine neue Version, erscheint oben ein Hinweis mit „Neu laden“ — bis dahin arbeitest du mit der bisherigen weiter.</p>
      <p data-i18n="installStorage">Wichtig auf iPhone und iPad: Die App auf dem Home-Bildschirm hat ihren eigenen, leeren Speicher. Lege vorher im Browser ein Backup an (Einstellungen → Daten) und lies es in der installierten App ein. Im Safari-Tab kann iOS deine Daten nach 7 Tagen ohne Besuch löschen, in der installierten App nicht.</p>
      <p data-i18n="installTabs">Hast du die App in mehreren Tabs offen und änderst in einem etwas, lädt der andere beim Zurückkehren neu oder zeigt einen Hinweis — so überschreibt kein Tab die Änderungen des anderen.</p>
    </section>

