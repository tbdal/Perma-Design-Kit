<script>
  // Links use the German ids; in English the same chapter has the prefix "en-".
  // A target inside folded chapters is unfolded before scrolling to it.
  const en = document.documentElement.lang === 'en';
  function reveal(): void {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(en && !id.startsWith('en-') ? `en-${id}` : id) ?? document.getElementById(id);
    if (!el) return;
    if (el instanceof HTMLDetailsElement) el.open = true;
    for (let d = el.parentElement?.closest('details'); d; d = d.parentElement?.closest('details')) d.open = true;
    el.scrollIntoView();
  }
  reveal();
  addEventListener('hashchange', reveal);
</script>
