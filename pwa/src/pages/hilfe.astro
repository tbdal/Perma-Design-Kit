<script>
  // Links use the German ids; in English the same chapter has the prefix "en-", in Spanish "es-".
  // A target inside folded chapters is unfolded before scrolling to it.
  const lang = document.documentElement.lang;
  const prefix = lang === 'es' ? 'es-' : lang === 'de' ? '' : 'en-';
  function reveal(): void {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(prefix && !/^(en|es)-/.test(id) ? `${prefix}${id}` : id) ?? document.getElementById(id);
    if (!el) return;
    if (el instanceof HTMLDetailsElement) el.open = true;
    for (let d = el.parentElement?.closest('details'); d; d = d.parentElement?.closest('details')) d.open = true;
    el.scrollIntoView();
  }
  reveal();
  addEventListener('hashchange', reveal);
</script>
