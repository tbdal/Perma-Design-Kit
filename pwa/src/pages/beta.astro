---
import Layout from '../layouts/Layout.astro';
import BetaPitch from '../layouts/BetaPitch.astro';
const field = 'mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-200';
const btn = 'rounded-lg px-3.5 py-2 text-sm font-medium shadow-sm';
const card = 'space-y-3 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700';
---
<Layout title="Perma Design Kit — Beta-Test">
  <article class="mx-auto max-w-xl space-y-5 text-stone-800 dark:text-stone-100">
    <h1 class="text-2xl font-bold" data-i18n="btTitle">Beta-Test</h1>

    <section id="view-signup" class="space-y-4">
      <section id="beta-intro" class="w-beta"><BetaPitch heading="h2" href="#signup-form" /></section>
      <p class="text-sm text-stone-600 dark:text-stone-300" data-i18n="btGift">Der Zugang ist ein Geschenk, ohne Werbung, ohne Abo und ohne Gegenleistung. Rückmeldungen sind ein Wunsch, keine Bedingung.</p>
      <p id="signup-full" hidden class="rounded-lg bg-amber-50 dark:bg-amber-900/30 px-3 py-2 text-sm text-amber-900 dark:text-amber-100 ring-1 ring-amber-200 dark:ring-amber-800" data-i18n="btFull">Im Moment sind alle Plätze vergeben. Du kommst auf die Warteliste und bekommst eine Mail, sobald ein Platz frei wird.</p>
      <form id="signup-form" class={card}>
        <label class="block text-sm font-medium"><span data-i18n="btEmail">Mailadresse</span>
          <input id="signup-email" type="email" autocomplete="email" required maxlength="254" class={field} />
        </label>
        <label class="block text-sm font-medium"><span data-i18n="btInterest">Ich plane …</span>
          <select id="signup-interest" class={field}>
            <option value="" data-i18n="btInterestNone">keine Angabe (freiwillig)</option>
            <option value="privat" data-i18n="btInterestPrivat">privat</option>
            <option value="beruflich" data-i18n="btInterestBeruflich">beruflich (Büro, Beratung, Kurse)</option>
            <option value="verein" data-i18n="btInterestVerein">im Verein oder in der Gemeinde</option>
          </select>
        </label>
        <!-- bot trap: people never see or fill it -->
        <div aria-hidden="true" style="position:absolute;left:-9999px"><label>Website <input id="signup-website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="rounded-lg bg-stone-50 dark:bg-stone-900/50 p-3 text-xs text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700">
          <p class="font-semibold" data-i18n="btTermsHead">Beta-Bedingungen</p>
          <ul class="mt-1 list-disc space-y-1 pl-4">
            <li data-i18n="btTerm1"></li><li data-i18n="btTerm2"></li><li data-i18n="btTerm3"></li><li data-i18n="btTerm4"></li><li data-i18n="btTerm5"></li>
          </ul>
        </div>
        <label class="flex items-start gap-2 text-sm"><input id="signup-accept" type="checkbox" class="mt-0.5 accent-green-700" /><span data-i18n="btAccept">Ich habe die Beta-Bedingungen gelesen und akzeptiere sie.</span></label>
        <p class="text-xs text-stone-500 dark:text-stone-400"><span data-i18n="btPrivacy">Wir speichern deine Mailadresse nur für den Beta-Test und löschen sie bei Abmeldung. Mehr dazu im</span> <a href="/datenschutz/#beta-test" data-i18n="btPrivacyLink" class="underline underline-offset-2">Datenschutz</a>.</p>
        <p id="signup-status" role="alert" class="text-sm font-medium"></p>
        <button id="signup-submit" type="submit" data-i18n="btSend" class={`${btn} bg-green-700 text-white hover:bg-green-800 disabled:opacity-60`}>Anmelden</button>
      </form>
      <p class="text-xs text-stone-600 dark:text-stone-300"><span data-i18n="btHave">Schon ein Konto?</span> <a href="/anmelden/" data-i18n="btLogin" class="underline underline-offset-2">Anmelden</a></p>
    </section>

    <section id="view-message" hidden class={card}><p id="message-text" role="status" class="text-sm"></p></section>

    <section id="view-unsub" hidden class={card}>
      <h2 class="text-lg font-semibold" data-i18n="btUnsubTitle">Vom Beta-Test abmelden</h2>
      <p class="text-sm" data-i18n="btUnsubText">Wir löschen deine Mailadresse und deine Angaben.</p>
      <label class="flex items-center gap-2 text-sm"><input id="unsub-account" type="checkbox" class="accent-green-700" /><span data-i18n="btUnsubAccount">Auch mein Beta-Konto löschen</span></label>
      <p id="unsub-status" role="alert" class="text-sm font-medium"></p>
      <button id="unsub-submit" type="button" data-i18n="btUnsubBtn" class={`${btn} bg-green-700 text-white hover:bg-green-800 disabled:opacity-60`}>Abmelden und Angaben löschen</button>
    </section>

    <form id="view-survey" hidden class={card}>
      <h2 id="survey-title" class="text-lg font-semibold"></h2>
      <p class="text-xs text-stone-500 dark:text-stone-400" data-i18n="btSurveyNote">Alles freiwillig. Die Antworten gehen als Aufgabe an das Team.</p>
      <label class="block text-sm font-medium"><span data-i18n="btQTried">Was hast du ausprobiert?</span><textarea data-q="Ausprobiert" rows="2" maxlength="600" class={field}></textarea></label>
      <label class="block text-sm font-medium"><span data-i18n="btQMissing">Was fehlt dir?</span><textarea data-q="Fehlt" rows="2" maxlength="600" class={field}></textarea></label>
      <label class="block text-sm font-medium"><span data-i18n="btQRecommend">Würdest du das Perma Design Kit weiterempfehlen?</span>
        <select data-q="Weiterempfehlen" class={field}><option value=""></option><option value="ja" data-i18n="btQYes">ja</option><option value="vielleicht" data-i18n="btQMaybe">vielleicht</option><option value="eher nicht" data-i18n="btQNo">eher nicht</option></select>
      </label>
      <label class="block text-sm font-medium"><span data-i18n="btQTools">Welche Werkzeuge nutzt du sonst?</span><input data-q="Werkzeuge" maxlength="300" class={field} /></label>
      <label class="block text-sm font-medium"><span data-i18n="btQValue">Was wäre dir eine Funktion aus dem Beta-Test im Jahr wert?</span>
        <select data-q="Wert pro Jahr" class={field}><option value=""></option><option value="nichts" data-i18n="btQValue0">nichts</option><option value="bis 20 €" data-i18n="btQValue20">bis 20 €</option><option value="bis 50 €" data-i18n="btQValue50">bis 50 €</option><option value="mehr" data-i18n="btQValueMore">mehr</option></select>
      </label>
      <label id="survey-best" hidden class="block text-sm font-medium"><span data-i18n="btQBest">Was hat dir am meisten geholfen?</span><textarea data-q="Am meisten geholfen" rows="2" maxlength="600" class={field}></textarea></label>
      <p id="survey-status" role="alert" class="text-sm font-medium"></p>
      <button type="submit" data-i18n="btSurveySend" class={`${btn} bg-green-700 text-white hover:bg-green-800 disabled:opacity-60`}>Antworten senden</button>
    </form>
  </article>

  <script>
    import { applyStaticI18n, createT, getLang } from '../lib/i18n/core';
    import { betaDict } from '../lib/i18n/dict-beta';

    applyStaticI18n(betaDict);
    const t = createT(betaDict);
    const params = new URLSearchParams(location.search);
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const post = (path: string, body: unknown) => fetch(`/api/beta/${path}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const show = (view: string) => { for (const id of ['view-signup', 'view-message', 'view-unsub', 'view-survey']) $(id).hidden = id !== view; };
    const message = (key: string) => { show('view-message'); $('message-text').textContent = t(key); };
    // Tokens stay out of the address bar and the history once read.
    const take = (key: string) => { const v = params.get(key) || ''; if (v) { params.delete(key); history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`); } return v; };

    const confirmToken = take('bestaetigen');
    const unsubToken = take('abmelden');
    const surveyKind = params.get('umfrage');
    const surveyToken = take('t');

    if (confirmToken) {
      message('btConfirming');
      post('bestaetigen', { token: confirmToken }).then(async res => {
        const r = res.ok ? await res.json() as { status?: string } : null;
        message(!r ? (res.status === 404 ? 'btConfirmInvalid' : 'btErrServer') : r.status === 'warteliste' ? 'btConfirmedWait' : 'btConfirmedInvited');
      }).catch(() => message('btErrServer'));
    } else if (unsubToken) {
      show('view-unsub');
      $('unsub-submit').addEventListener('click', async () => {
        try {
          const res = await post('abmelden', { token: unsubToken, konto: $<HTMLInputElement>('unsub-account').checked });
          message(res.ok ? 'btUnsubDone' : res.status === 404 ? 'btUnsubInvalid' : 'btErrServer');
        } catch { $('unsub-status').textContent = t('btErrServer'); }
      });
    } else if ((surveyKind === '14' || surveyKind === 'ende') && surveyToken) {
      show('view-survey');
      $('survey-title').textContent = t(surveyKind === 'ende' ? 'btSurveyEnd' : 'btSurvey14');
      $('survey-best').hidden = surveyKind !== 'ende';
      $('view-survey').addEventListener('submit', async e => {
        e.preventDefault();
        const answers: Record<string, string> = {};
        document.querySelectorAll<HTMLInputElement>('#view-survey [data-q]').forEach(el => { if (el.value.trim()) answers[el.dataset.q!] = el.value.trim(); });
        try {
          const res = await post('umfrage', { token: surveyToken, kind: surveyKind, answers });
          if (res.ok) message('btSurveyDone'); else $('survey-status').textContent = t(res.status === 429 ? 'btErrRate' : 'btSurveyInvalid');
        } catch { $('survey-status').textContent = t('btErrServer'); }
      });
    } else {
      fetch('/api/beta/status', { cache: 'no-store' }).then(r => r.ok ? r.json() : null).then((s: { frei?: boolean } | null) => { $('signup-full').hidden = !s || s.frei !== false; }).catch(() => {});
      $('signup-form').addEventListener('submit', async e => {
        e.preventDefault();
        const status = $('signup-status'), submit = $<HTMLButtonElement>('signup-submit');
        status.textContent = '';
        if (!$<HTMLInputElement>('signup-accept').checked) { status.textContent = t('btErrAccept'); return; }
        submit.disabled = true;
        try {
          const res = await post('anmeldung', {
            email: $<HTMLInputElement>('signup-email').value.trim(), interest: $<HTMLSelectElement>('signup-interest').value,
            website: $<HTMLInputElement>('signup-website').value, accepted: true, lang: getLang(),
          });
          if (res.ok) message('btSent');
          else status.textContent = t(res.status === 429 ? 'btErrRate' : res.status === 400 ? 'btErrEmail' : 'btErrServer');
        } catch { status.textContent = t('btErrServer'); } finally { submit.disabled = false; }
      });
    }
  </script>
</Layout>
