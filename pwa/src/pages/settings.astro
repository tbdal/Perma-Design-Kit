---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Perma Design Kit — Einstellungen">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-stone-900 dark:text-stone-100" data-i18n="pageTitle">Einstellungen</h1>
    <p class="mt-1 text-sm text-stone-500 dark:text-stone-400" data-i18n="pageSubtitle">Datenquellen, Ansicht, Theme und Daten verwalten.</p>
  </div>

  <!-- Datenquellen -->
  <section class="mb-8">
    <h2 class="mb-3 text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionSources">Datenquellen</h2>
    <div id="sources-list" class="space-y-4"></div>
    <div class="mt-4 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
      <h3 class="text-sm font-bold text-stone-800 dark:text-stone-100" data-i18n="priorityTitle">Reihenfolge beim Befüllen</h3>
      <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="priorityHelp">Haben mehrere Quellen Daten zu einem Feld, gewinnt die obere.</p>
      <ol id="source-priority" class="mt-3 space-y-2"></ol>
    </div>
  </section>

  <!-- Ansicht -->
  <section class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionView">Ansicht</h2>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="viewSubtitle">Welche Ansicht beim App-Start gezeigt wird.</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <label class="block text-sm">
        <span class="font-medium text-stone-700 dark:text-stone-200" data-i18n="labelDefaultView">Standard-Ansicht</span>
        <select id="default-view" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 shadow-inner focus:border-green-500 focus:outline-none">
          <option value="grid" data-i18n="optGrid">Kacheln</option>
          <option value="list" data-i18n="optList">Liste</option>
          <option value="cards" data-i18n="optCards">Karten</option>
        </select>
      </label>
      <label class="block text-sm">
        <span class="font-medium text-stone-700 dark:text-stone-200" data-i18n="labelDefaultCardVariant">Standard-Kartenvariante</span>
        <select id="default-card-variant" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 shadow-inner focus:border-green-500 focus:outline-none">
          <option value="poly" data-i18n="optPoly">Pflanzenkarten</option>
          <option value="stripe" data-i18n="optStripe">Streifenkarten</option>
          <option value="baumscheibe" data-i18n="optBaumscheibe">Baumscheibe</option>
        </select>
      </label>
      <label class="flex items-start gap-2 text-sm sm:col-span-2">
        <input type="checkbox" id="dot-codes" class="mt-0.5 accent-green-600" />
        <span>
          <span class="font-medium text-stone-700 dark:text-stone-200" data-i18n="labelDotCodes">Kürzel statt Farbpunkte</span>
          <span class="block text-xs text-stone-500 dark:text-stone-400" data-i18n="helpDotCodes">Zeigt in der Pflanzenliste und ihrer Legende Kürzel (Es, Me, N …) statt reiner Farbpunkte – hilfreich bei Farbenblindheit und im Graustufendruck.</span>
        </span>
      </label>
    </div>
  </section>

  <!-- Design -->
  <section class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionDesign">Design</h2>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="designSubtitle">Aussehen der Website. Alle Funktionen sind in beiden Designs gleich.</p>
    <div class="mt-3 flex flex-wrap gap-4 text-sm">
      <label class="inline-flex items-center gap-2"><input type="radio" name="design" value="standard" class="design-radio accent-green-600" /> <span data-i18n="designStandard">Klassisch</span></label>
      <label class="inline-flex items-center gap-2"><input type="radio" name="design" value="horizont" class="design-radio accent-green-600" /> <span data-i18n="designHorizont">Horizont</span></label>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div role="group" aria-labelledby="settings-contrast-label">
        <p id="settings-contrast-label" class="text-sm font-medium text-stone-700 dark:text-stone-200" data-i18n="contrastLabel">Kontrast</p>
        <div class="mt-1.5 flex gap-1.5">
          <button type="button" class="display-opt rounded-md px-2 py-1 text-xs font-medium ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700 aria-pressed:bg-green-700 aria-pressed:text-white aria-pressed:ring-green-700" data-contrast-opt="system" aria-pressed="false" data-i18n="contrastSystem">System</button>
          <button type="button" class="display-opt rounded-md px-2 py-1 text-xs font-medium ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700 aria-pressed:bg-green-700 aria-pressed:text-white aria-pressed:ring-green-700" data-contrast-opt="normal" aria-pressed="false" data-i18n="contrastNormal">Normal</button>
          <button type="button" class="display-opt rounded-md px-2 py-1 text-xs font-medium ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700 aria-pressed:bg-green-700 aria-pressed:text-white aria-pressed:ring-green-700" data-contrast-opt="more" aria-pressed="false" data-i18n="contrastMore">Hoch</button>
        </div>
      </div>
      <div role="group" aria-labelledby="settings-font-label">
        <p id="settings-font-label" class="text-sm font-medium text-stone-700 dark:text-stone-200" data-i18n="fontSizeLabel">Schriftgröße</p>
        <div class="mt-1.5 flex gap-1.5">
          <button type="button" class="display-opt rounded-md px-2 py-1 text-xs font-medium ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700 aria-pressed:bg-green-700 aria-pressed:text-white aria-pressed:ring-green-700" data-font-opt="100" aria-pressed="false" data-i18n-aria-label="fontSize100">A</button>
          <button type="button" class="display-opt rounded-md px-2 py-1 text-xs font-medium ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700 aria-pressed:bg-green-700 aria-pressed:text-white aria-pressed:ring-green-700" data-font-opt="115" aria-pressed="false" data-i18n-aria-label="fontSize115">A+</button>
          <button type="button" class="display-opt rounded-md px-2 py-1 text-xs font-medium ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700 aria-pressed:bg-green-700 aria-pressed:text-white aria-pressed:ring-green-700" data-font-opt="130" aria-pressed="false" data-i18n-aria-label="fontSize130">A++</button>
        </div>
      </div>
      <p class="text-xs text-stone-500 dark:text-stone-400 sm:col-span-2" data-i18n="displayHelp">„System“ folgt der Einstellung „Kontrast erhöhen“ deines Geräts. Gilt nur für dieses Gerät.</p>
    </div>
  </section>

  <!-- Theme -->
  <section class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionTheme">Theme</h2>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="themeSubtitle">"Auto" folgt der System­einstellung deines Geräts.</p>
    <div class="mt-3 flex flex-wrap gap-4 text-sm">
      <label class="inline-flex items-center gap-2"><input type="radio" name="theme" value="auto" class="theme-radio accent-green-600" /> <span data-i18n="themeAuto">Auto</span></label>
      <label class="inline-flex items-center gap-2"><input type="radio" name="theme" value="light" class="theme-radio accent-green-600" /> <span data-i18n="themeLight">Hell</span></label>
      <label class="inline-flex items-center gap-2"><input type="radio" name="theme" value="dark" class="theme-radio accent-green-600" /> <span data-i18n="themeDark">Dunkel</span></label>
    </div>
  </section>

  <!-- Privatsphäre -->
  <section class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionPrivacy">Privatsphäre</h2>
    <label class="mt-3 inline-flex items-start gap-2 text-sm">
      <input type="checkbox" id="analytics-optout" class="mt-0.5 accent-green-600" />
      <span>
        <span class="font-medium text-stone-700 dark:text-stone-200" data-i18n="privacyOptOutLabel">Reichweitenmessung deaktivieren</span>
        <span class="block text-xs text-stone-500 dark:text-stone-400"><span data-i18n="privacyOptOutDescPre">Die selbst gehostete Reichweitenmessung (Umami) erfasst keine personenbezogenen Daten — falls du trotzdem nicht gezählt werden möchtest, hier den Haken setzen. Details in der</span> <a href="/datenschutz" data-i18n="privacyOptOutDescLink" class="text-green-700 dark:text-green-400 underline underline-offset-2 hover:no-underline">Datenschutzerklärung</a>.</span>
      </span>
    </label>
  </section>

  <div class="mb-12 flex gap-3">
    <button id="btn-save" data-i18n="btnSaveSettings" class="rounded-lg bg-green-700 px-5 py-2 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">Einstellungen speichern</button>
  </div>

  <!-- Daten -->
  <section id="daten-section" class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionData">Daten</h2>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="dataSubtitle">Alle Pflanzen­daten und Polykulturen leben lokal in deinem Browser (IndexedDB).</p>

    <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="statLabelPlants">Pflanzen­datensätze</dt>
        <dd id="stats-plants" class="font-mono text-stone-800 dark:text-stone-100">…</dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="statLabelStorage">Speicherverbrauch</dt>
        <dd id="stats-storage" class="font-mono text-stone-800 dark:text-stone-100">…</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="statLabelPersist">Dauerhafter Speicher</dt>
        <dd class="flex flex-wrap items-center gap-2 text-stone-800 dark:text-stone-100">
          <span id="stats-persist">…</span>
          <button id="btn-persist" type="button" hidden data-i18n="btnPersist" class="rounded-md bg-stone-100 dark:bg-stone-700 px-2 py-0.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Jetzt anfragen</button>
        </dd>
      </div>
    </dl>

    <p id="last-backup-info" class="mt-3 text-xs text-stone-500 dark:text-stone-400"></p>

    <div class="mt-4 flex flex-wrap gap-2">
      <button id="btn-backup" data-i18n="btnBackupDownload" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Backup herunterladen (JSON)</button>
      <button id="btn-share-link" type="button" data-i18n="btnShareLink" class="rounded-lg bg-green-700 px-3 py-1.5 text-sm font-medium text-white shadow hover:bg-green-800">🔗 Projekt als Link teilen…</button>
      <button id="btn-share-backup" hidden data-i18n="btnShareBackup" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Backup teilen…</button>
      <label class="cursor-pointer rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">
        <span data-i18n="btnRestoreLabel">Backup einlesen…</span>
        <input type="file" id="restore-input" accept=".json,application/json" class="hidden" />
      </label>
      <button id="btn-reload-master" data-i18n="btnReloadMaster" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Golden Master neu laden</button>
    </div>

    <div class="mt-6 rounded-lg border border-red-300 dark:border-red-800 bg-red-50 dark:bg-red-900/20 p-4">
      <h3 class="text-sm font-semibold text-red-800 dark:text-red-200" data-i18n="dangerZoneTitle">Danger Zone</h3>
      <p class="mt-1 text-xs text-red-700 dark:text-red-300" data-i18n="dangerZoneDesc">Löscht alle Pflanzendatensätze und deine Einstellungen unwiderruflich.</p>
      <button id="btn-clear-all" data-i18n="btnClearAll" class="mt-3 rounded-lg bg-red-600 px-3 py-1.5 text-sm font-medium text-white ring-1 ring-red-700 hover:bg-red-700">Alle Daten löschen</button>
    </div>
  </section>

  <!-- Sortenlisten -->
  <section id="sortenlisten" class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionVarieties">Sortenlisten</h2>
    <p class="mt-1 text-sm text-stone-500 dark:text-stone-400" data-i18n="varietiesIntro">Sortenlisten füllen die Auswahl „Sorte“ beim Bearbeiten einer Pflanze. Obstsorten aus Wikidata (frei, CC0) lädst du mit einem Klick; eigene Listen kommen als CSV mit den Spalten „Art“ und „Sorte“.</p>
    <div class="mt-4 flex flex-wrap gap-2">
      <button id="btn-variety-wikidata" type="button" data-i18n="btnVarietyWikidata" class="rounded-lg bg-green-700 px-3 py-1.5 text-sm font-medium text-white shadow hover:bg-green-800">Obstsorten aus Wikidata laden</button>
      <label class="cursor-pointer rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">
        <span data-i18n="btnVarietyCsv">CSV-Liste importieren…</span>
        <input type="file" id="variety-csv-input" accept=".csv,text/csv,text/plain" class="hidden" />
      </label>
      <button id="btn-variety-template" type="button" data-i18n="btnVarietyTemplate" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">CSV-Vorlage ↓</button>
    </div>
    <p id="variety-status" aria-live="polite" class="mt-2 min-h-4 text-xs text-stone-500 dark:text-stone-400"></p>
    <ul id="variety-lists" class="mt-3 space-y-3"></ul>
  </section>

  <!-- Sync -->
  <section id="sync-section" class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionSync">Sync</h2>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="syncSubtitle">Pflanzen, Polykulturen, Waldgartenpläne und eigene Sortenlisten in einen externen Speicher sichern — manuell oder automatisch beim Verlassen der App.</p>

    <!-- Auto-Sync Toggle -->
    <div class="mt-5 flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p id="auto-sync-label" class="text-sm font-medium text-stone-700 dark:text-stone-200" data-i18n="autoSyncLabel">Automatisch synchronisieren</p>
        <p class="mt-0.5 text-xs text-stone-500 dark:text-stone-400" data-i18n="autoSyncDesc">
          Beim Tab-Wechsel oder Schließen automatisch zum ersten konfigurierten Anbieter hochladen, wenn sich etwas
          geändert hat (Priorität: WebDAV → GitHub Gist). Liegt dort ein Backup von einem anderen Gerät, wird
          nichts überschrieben — du bekommst einen Hinweis.
        </p>
        <p id="last-sync-info" class="mt-1 text-xs text-stone-500 dark:text-stone-400"></p>
        <p id="sync-problem-info" hidden role="status" class="mt-1 text-xs font-medium text-red-700 dark:text-red-400"></p>
      </div>
      <label class="relative inline-flex shrink-0 cursor-pointer items-center">
        <input type="checkbox" id="auto-sync-toggle" aria-labelledby="auto-sync-label" class="peer sr-only" />
        <div class="h-6 w-11 rounded-full bg-stone-300 dark:bg-stone-600 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-all peer-checked:bg-green-600 peer-checked:after:translate-x-full"></div>
      </label>
    </div>

    <!-- WebDAV -->
    <details class="mt-5 rounded-lg border border-stone-200 dark:border-stone-700 p-4">
      <summary class="cursor-pointer text-sm font-semibold text-stone-700 dark:text-stone-200" data-i18n="webdavSummary">WebDAV (z.B. Nextcloud)</summary>
      <p class="mt-2 text-xs text-stone-500 dark:text-stone-400">
        <span data-i18n="webdavDescPre">Pusht/zieht das JSON-Backup direkt in deinen WebDAV-Speicher. Zugangsdaten bleiben
        im Browser (</span><code>localStorage</code><span data-i18n="webdavDescMid">), werden nicht übertragen außer ans angegebene Ziel.
        Dein Server muss</span> <strong data-i18n="webdavDescCors">CORS</strong> <span data-i18n="webdavDescPost">für die Domain dieser App erlauben — bei Nextcloud
        z.B. via</span> <code>occ config:system:set cors.allowed-domains</code>.
      </p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <label class="block text-xs sm:col-span-2">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="webdavUrlLabel">Ziel-URL (vollständige Datei-URL)</span>
          <input id="webdav-url" type="url" placeholder="https://cloud.example.com/remote.php/dav/files/USER/perma-design-kit-backup.json" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 font-mono text-xs shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
        <label class="block text-xs">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="webdavUserLabel">Benutzername</span>
          <input id="webdav-user" type="text" autocomplete="off" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
        <label class="block text-xs">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="webdavPassLabel">Passwort / App-Token</span>
          <input id="webdav-pass" type="password" autocomplete="off" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button id="btn-webdav-save-creds" data-i18n="btnWebdavSaveCreds" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Zugang merken</button>
        <button id="btn-webdav-clear-creds" data-i18n="btnWebdavClearCreds" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Zugang vergessen</button>
        <span class="h-4 w-px bg-stone-300 dark:bg-stone-700"></span>
        <button id="btn-webdav-push" data-i18n="btnWebdavPush" class="rounded-lg bg-green-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-green-800">Backup hochladen ↑</button>
        <button id="btn-webdav-pull" data-i18n="btnWebdavPull" class="rounded-lg bg-blue-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-blue-800">Backup abrufen ↓</button>
        <span id="webdav-status" class="text-xs text-stone-500 dark:text-stone-400"></span>
      </div>
    </details>

    <!-- Lokale Datei (File System Access API, nur Chromium) -->
    <details id="details-fsa" class="mt-4 rounded-lg border border-stone-200 dark:border-stone-700 p-4" hidden>
      <summary class="cursor-pointer text-sm font-semibold text-stone-700 dark:text-stone-200" data-i18n="fsaSummary">Lokale Datei (Chrome / Edge)</summary>
      <p class="mt-2 text-xs text-stone-500 dark:text-stone-400" data-i18n="fsaDesc">
        Schreibt das Backup direkt in eine Datei auf deinem Gerät oder liest es von dort.
        Die Datei kannst du z.&nbsp;B. in einem Cloud-Ordner ablegen (iCloud Drive, Dropbox,
        Google Drive Offline-Ordner). Nur in Chromium-basierten Browsern verfügbar.
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button id="btn-fsa-write" data-i18n="btnFsaWrite" class="rounded-lg bg-green-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-green-800">In Datei speichern ↑</button>
        <button id="btn-fsa-read" data-i18n="btnFsaRead" class="rounded-lg bg-blue-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-blue-800">Aus Datei laden ↓</button>
        <span id="fsa-status" class="text-xs text-stone-500 dark:text-stone-400"></span>
      </div>
    </details>

    <!-- GitHub Gist -->
    <details class="mt-4 rounded-lg border border-stone-200 dark:border-stone-700 p-4">
      <summary class="cursor-pointer text-sm font-semibold text-stone-700 dark:text-stone-200" data-i18n="gistSummary">GitHub Gist (geräteübergreifend)</summary>
      <p class="mt-2 text-xs text-stone-500 dark:text-stone-400">
        <span data-i18n="gistDescPre">Speichert das Backup als privates GitHub Gist. Du brauchst einen GitHub-Account und ein</span> <a href="https://github.com/settings/tokens/new?scopes=gist&description=Perma+Design+Kit" target="_blank" rel="noopener" data-i18n="gistDescLink" class="text-green-700 dark:text-green-400 underline underline-offset-2 hover:no-underline">Personal Access Token</a> <span data-i18n="gistDescPost">mit dem Scope</span> <code>gist</code><span data-i18n="gistDescPost2">. Beim ersten Hochladen wird ein neues Gist angelegt
        und die ID automatisch gespeichert — danach einfach wieder drücken.</span>
      </p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <label class="block text-xs">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="gistTokenLabel">GitHub Token (PAT)</span>
          <input id="gist-token" type="password" autocomplete="off" placeholder="ghp_…" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 font-mono text-xs shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
        <label class="block text-xs">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="gistIdLabel">Gist-ID (leer = wird beim ersten Upload gesetzt)</span>
          <input id="gist-id" type="text" autocomplete="off" data-i18n-placeholder="gistIdPlaceholder" placeholder="automatisch gesetzt" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 font-mono text-xs shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button id="btn-gist-save-creds" data-i18n="btnGistSaveCreds" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Token merken</button>
        <button id="btn-gist-clear-creds" data-i18n="btnGistClearCreds" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Token vergessen</button>
        <span class="h-4 w-px bg-stone-300 dark:bg-stone-700"></span>
        <button id="btn-gist-push" data-i18n="btnGistPush" class="rounded-lg bg-green-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-green-800">Zu Gist hochladen ↑</button>
        <button id="btn-gist-pull" data-i18n="btnGistPull" class="rounded-lg bg-blue-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-blue-800">Von Gist abrufen ↓</button>
        <span id="gist-status" class="text-xs text-stone-500 dark:text-stone-400"></span>
      </div>
    </details>
  </section>

  <div id="toast" class="fixed bottom-6 right-6 hidden rounded-lg bg-green-700 px-4 py-2.5 text-sm font-medium text-white shadow-lg transition"></div>

  <!-- Projekt als Link teilen (src/lib/share.ts) -->
  <dialog id="share-dialog" aria-labelledby="share-title" class="m-auto w-[min(36rem,calc(100vw-2rem))] rounded-xl bg-white dark:bg-stone-800 p-0 text-stone-800 dark:text-stone-100 shadow-2xl backdrop:bg-black/50">
    <div class="space-y-3 p-5">
      <h2 id="share-title" class="text-base font-semibold" data-i18n="shareTitle">Projekt als Link teilen</h2>
      <p class="text-xs text-stone-600 dark:text-stone-300" data-i18n="shareIntro">Pflanzen, Polykulturen und Waldgartenpläne werden komprimiert in den Link gepackt. Es wird nichts auf einem Server gespeichert. Wer den Link hat, kann das Projekt in die eigene App übernehmen.</p>
      <fieldset class="space-y-1.5 text-sm">
        <label class="flex items-center gap-2"><input id="share-polycultures" type="checkbox" checked class="accent-green-600" /> <span data-i18n="shareIncludePolycultures">Polykulturen mitteilen</span></label>
        <label class="flex items-center gap-2"><input id="share-gardenplans" type="checkbox" checked class="accent-green-600" /> <span data-i18n="shareIncludeGardenPlans">Waldgartenpläne mitteilen</span></label>
        <label class="flex items-center gap-2"><input id="share-notes" type="checkbox" checked class="accent-green-600" /> <span data-i18n="shareIncludeNotes">Notizen mitteilen</span></label>
        <label class="flex items-start gap-2"><input id="share-views" type="checkbox" checked class="mt-1 accent-green-600" /> <span><span data-i18n="shareIncludeViews">Ansicht der Pläne mitschicken</span><br /><span class="text-xs text-stone-500 dark:text-stone-400" data-i18n="shareViewsHint">Kamera, Ausschnitt, 2D/3D, Sonnenstand und Einfärben – so, wie du die Pläne zuletzt verlassen hast.</span></span></label>
        <label class="flex flex-wrap items-center gap-2 pl-6 text-xs"><span data-i18n="shareStartPlan">Öffnet nach dem Übernehmen:</span>
          <select id="share-start" class="rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2 py-1 text-xs"></select>
        </label>
        <label class="flex items-start gap-2"><input id="share-location" type="checkbox" class="mt-1 accent-green-600" /> <span><span data-i18n="shareIncludeLocation">Standort der Waldgartenpläne mitteilen</span><br /><span class="text-xs text-stone-500 dark:text-stone-400" data-i18n="shareLocationHint">Zeigt, wo dein Garten liegt – oft deine Adresse. Ohne Standort kommen die Pläne ohne Kartenhintergrund an.</span></span></label>
      </fieldset>
      <div id="share-result" hidden class="space-y-2">
        <textarea id="share-url" readonly rows="3" data-i18n-aria-label="shareTitle" aria-label="Projekt als Link teilen" class="block w-full resize-none break-all rounded-md border border-stone-300 dark:border-stone-600 bg-stone-50 dark:bg-stone-900 px-2.5 py-1.5 font-mono text-[11px]"></textarea>
        <p id="share-size" class="text-xs text-stone-500 dark:text-stone-400"></p>
        <div class="flex flex-wrap gap-2">
          <button id="share-copy" type="button" data-i18n="shareCopy" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Link kopieren</button>
          <button id="share-native" type="button" hidden data-i18n="shareNative" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Teilen…</button>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-1">
        <button id="share-close" type="button" data-i18n="shareClose" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Schließen</button>
        <button id="share-create" type="button" data-i18n="shareCreate" class="rounded-lg bg-green-700 px-4 py-1.5 text-sm font-medium text-white shadow hover:bg-green-800">Link erstellen</button>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  import {
    loadSettings, saveSettings,
    getTheme, setTheme, applyTheme,
    getDesign, setDesign, applyDesign,
    isAnalyticsOptedOut, setAnalyticsOptOut,
    type AppSettings, type ViewMode, type CardVariant, type ThemePref, type DesignPref,
  } from '../lib/settings';
  import { getAllPlants, clearAllData, getVarietyLists, saveVarietyList, deleteVarietyList } from '../lib/db';
  import { fetchWikidataVarieties, parseVarietyCsv, varietyListToCsv, dedupeEntries, speciesKey, VARIETY_CSV_TEMPLATE, WIKIDATA_LIST_ID, type VarietyList } from '../lib/varieties';
  import { newId } from '../lib/id';
  import {
    buildBackup, buildBackupJson, parseBackup, backupIsEmpty, applyBackup, rememberBackupAt, rememberPulled, isAutoSyncEnabled,
    webdavPush, webdavPull, gistPush, gistPull, getSyncProblem, clearSyncProblem, forgetSyncState,
    GIST_FILENAME, type WebdavCreds,
  } from '../lib/sync';
  import { escapeHtml, withButtonSpinner } from '../lib/html';
  import { createT, applyStaticI18n, getLang } from '../lib/i18n/core';
  import { settingsDict } from '../lib/i18n/dict-settings';

  const t = createT(settingsDict);
  applyStaticI18n(settingsDict);

  // DEFAULT_SOURCES' name/description (src/lib/settings.ts) are German-only —
  // that file is shared runtime data, not display markup, so we translate at
  // this render call site instead of touching it. Keyed by source id.
  const SOURCE_DESC_KEY: Record<string, string> = {
    wikidata: 'sourceDescWikidata',
    pfaf: 'sourceDescPfaf',
    efg: 'sourceDescEfg',
    naturadb: 'sourceDescNaturadb',
  };

  // ── Source priority (order used when filling plant data) ────────────────
  const priorityList = document.getElementById('source-priority')!;
  function renderPriority() {
    const order = settings.sourcePriority;
    priorityList.innerHTML = order.map((id, i) => {
      const src = settings.sources.find(s => s.id === id);
      const off = !src?.enabled;
      const btn = (dir: 'up' | 'down', disabled: boolean, label: string, sym: string) =>
        `<button type="button" data-move="${dir}" data-idx="${i}" ${disabled ? 'disabled' : ''} aria-label="${escapeHtml(label)}" class="rounded-md px-2.5 py-1 text-sm ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700 disabled:opacity-30 disabled:hover:bg-transparent">${sym}</button>`;
      return `<li class="flex items-center gap-3 rounded-lg bg-stone-50 dark:bg-stone-900/40 px-3 py-2 ${off ? 'opacity-60' : ''}">
        <span class="w-5 text-sm font-bold tabular-nums text-stone-500 dark:text-stone-400">${i + 1}.</span>
        <span class="flex-1 text-sm font-medium text-stone-800 dark:text-stone-100">${escapeHtml(src?.name ?? id)}${off ? ` <span class="text-xs font-normal text-stone-500">(${escapeHtml(t('priorityDisabled'))})</span>` : ''}</span>
        ${btn('up', i === 0, t('priorityUp'), '↑')}
        ${btn('down', i === order.length - 1, t('priorityDown'), '↓')}
      </li>`;
    }).join('');
  }
  priorityList.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-move]') as HTMLButtonElement | null;
    if (!b) return;
    const i = Number(b.dataset.idx);
    const j = b.dataset.move === 'up' ? i - 1 : i + 1;
    const order = [...settings.sourcePriority];
    [order[i], order[j]] = [order[j], order[i]];
    settings.sourcePriority = order;
    renderPriority();
    (priorityList.querySelector(`button[data-idx="${j}"][data-move="${b.dataset.move}"]`) as HTMLButtonElement | null)?.focus();
  });

  const sourcesList = document.getElementById('sources-list')!;
  const toast = document.getElementById('toast')!;
  const defaultView = document.getElementById('default-view') as HTMLSelectElement;
  const defaultCardVariant = document.getElementById('default-card-variant') as HTMLSelectElement;
  const dotCodes = document.getElementById('dot-codes') as HTMLInputElement;
  const analyticsOptout = document.getElementById('analytics-optout') as HTMLInputElement;
  const statsPlants = document.getElementById('stats-plants')!;
  const statsStorage = document.getElementById('stats-storage')!;
  const autoSyncToggle = document.getElementById('auto-sync-toggle') as HTMLInputElement;

  let settings: AppSettings;

  function showToast(msg: string) {
    toast.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 2000);
  }

  function renderSources() {
    sourcesList.innerHTML = settings.sources.map((src, i) => {
      // NaturaDB is hidden from Settings — unresolved licensing (see
      // CHANGELOG.md "NaturaDB-Scraping vorerst deaktiviert"), scraping hard-disabled
      // server-side regardless of this toggle. Kept in DEFAULT_SOURCES
      // (not filtered before .map) so `i` still matches settings.sources'
      // real indices for the other cards' data-idx-based save handler.
      if (src.id === 'naturadb') return '';
      return `
      <div class="rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <label class="relative inline-flex cursor-pointer items-center">
                <input type="checkbox" class="src-enabled peer sr-only" aria-label="${escapeHtml(src.name)}" data-idx="${i}" ${src.enabled ? 'checked' : ''} />
                <div class="h-6 w-11 rounded-full bg-stone-300 dark:bg-stone-600 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-all peer-checked:bg-green-600 peer-checked:after:translate-x-full"></div>
              </label>
              <h3 class="text-sm font-bold text-stone-800 dark:text-stone-100">${src.name}</h3>
              ${src.url ? `<a href="${src.url}" target="_blank" rel="noopener" class="text-xs text-stone-500 dark:text-stone-400 hover:text-green-700 underline underline-offset-2 hover:no-underline">${new URL(src.url).hostname}</a>` : ''}
            </div>
            <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">${SOURCE_DESC_KEY[src.id] ? t(SOURCE_DESC_KEY[src.id]) : src.description}</p>
          </div>
        </div>
        ${src.needsApiKey ? `
          <div class="mt-3">
            <label class="block text-xs font-medium text-stone-500 dark:text-stone-400">${t('apiKeyLabel')}
              <input type="password" class="src-apikey mt-0.5 block w-full max-w-sm rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" data-idx="${i}" value="${escapeHtml(src.apiKey)}" placeholder="${t('apiKeyPlaceholder')}" />
            </label>
          </div>
        ` : ''}
        <div class="mt-2 flex gap-2">
          <span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium ${src.id === 'wikidata' ? 'bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300' : 'bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-200'}">
            ${src.id === 'wikidata' ? t('sourceDirectLabel') : t('sourceProxyLabel')}
          </span>
        </div>
      </div>
    `;
    }).join('');
    renderPriority();
  }

  function renderPrefs() {
    defaultView.value = settings.defaultView;
    defaultCardVariant.value = settings.defaultCardVariant;
    dotCodes.checked = settings.dotCodes;
    const t = getTheme();
    document.querySelectorAll<HTMLInputElement>('.theme-radio').forEach(r => { r.checked = r.value === t; });
    const d = getDesign();
    document.querySelectorAll<HTMLInputElement>('.design-radio').forEach(r => { r.checked = r.value === d; });
    analyticsOptout.checked = isAnalyticsOptedOut();
    autoSyncToggle.checked = isAutoSyncEnabled();
  }

  function fmtBytes(n: number): string {
    if (n < 1024) return `${n} B`;
    if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} kB`;
    return `${(n / (1024 * 1024)).toFixed(2)} MB`;
  }

  async function renderStats() {
    const plants = await getAllPlants();
    statsPlants.textContent = `${plants.length}`;
    if (navigator.storage?.estimate) {
      try {
        const est = await navigator.storage.estimate();
        const used = est.usage ?? 0;
        const quota = est.quota ?? 0;
        statsStorage.textContent = quota
          ? `${fmtBytes(used)} / ${fmtBytes(quota)}`
          : fmtBytes(used);
      } catch {
        statsStorage.textContent = '—';
      }
    } else {
      statsStorage.textContent = '—';
    }
    await renderPersist();
  }

  // Persistent storage: status + manual request (the banner in Layout asks
  // once there is data; this is the place to check or retry).
  const statsPersist = document.getElementById('stats-persist')!;
  const btnPersist = document.getElementById('btn-persist') as HTMLButtonElement;
  async function renderPersist() {
    if (!navigator.storage?.persisted) { statsPersist.textContent = t('persistUnsupported'); btnPersist.hidden = true; return; }
    const on = await navigator.storage.persisted().catch(() => false);
    statsPersist.textContent = t(on ? 'persistOn' : 'persistOff');
    btnPersist.hidden = on;
  }
  btnPersist.addEventListener('click', async () => {
    const ok = await navigator.storage.persist().catch(() => false);
    if (!ok) showToast(t('persistRequestDenied'));
    await renderPersist();
  });

  // The design switches (and is stored) on click, not via "Einstellungen
  // speichern" — far below the radios, that button was easy to miss.
  document.querySelectorAll<HTMLInputElement>('.design-radio').forEach(r => {
    r.addEventListener('change', () => {
      const d = r.value as DesignPref;
      setDesign(d);
      applyDesign(d);
    });
  });

  // ── Save handler ────────────────────────────────────────────────────────
  document.getElementById('btn-save')!.addEventListener('click', () => {
    document.querySelectorAll('.src-enabled').forEach((cb) => {
      const input = cb as HTMLInputElement;
      const idx = parseInt(input.dataset.idx!);
      settings.sources[idx].enabled = input.checked;
    });
    document.querySelectorAll('.src-apikey').forEach((inp) => {
      const input = inp as HTMLInputElement;
      const idx = parseInt(input.dataset.idx!);
      settings.sources[idx].apiKey = input.value;
    });
    settings.defaultView = defaultView.value as ViewMode;
    settings.defaultCardVariant = defaultCardVariant.value as CardVariant;
    settings.dotCodes = dotCodes.checked;
    saveSettings(settings);

    const themeChoice = (document.querySelector<HTMLInputElement>('.theme-radio:checked')?.value ?? 'auto') as ThemePref;
    setTheme(themeChoice);
    applyTheme(themeChoice);

    setAnalyticsOptOut(analyticsOptout.checked);

    try { localStorage.setItem('auto-sync-enabled', autoSyncToggle.checked ? 'true' : 'false'); } catch {}

    showToast(t('toastSettingsSaved'));
  });

  // ── Daten: Backup ───────────────────────────────────────────────────────
  async function buildBackupBlob(): Promise<{ blob: Blob; filename: string }> {
    const json = await buildBackupJson();
    const blob = new Blob([json], { type: 'application/json' });
    const filename = `perma-design-kit-backup-${new Date().toISOString().slice(0, 10)}.json`;
    return { blob, filename };
  }

  function renderLastBackup() {
    const el = document.getElementById('last-backup-info');
    if (!el) return;
    let last: string | null = null;
    try { last = localStorage.getItem('last-backup-at'); } catch {}
    el.textContent = last
      ? t('lastBackupPrefix', { date: new Date(last).toLocaleString(getLang() === 'en' ? 'en-US' : 'de-DE') })
      : t('lastBackupNone');
  }

  function renderLastSyncInfo() {
    const el = document.getElementById('last-sync-info');
    if (!el) return;
    let at: string | null = null;
    let provider: string | null = null;
    try {
      at = localStorage.getItem('last-auto-sync-at');
      provider = localStorage.getItem('last-auto-sync-provider');
    } catch {}
    const label = (p: string | null) => p === 'webdav' ? 'WebDAV' : p === 'gist' ? 'GitHub Gist' : '';
    // Older versions also stored manual downloads here — only real sync targets count.
    el.textContent = at && label(provider)
      ? t('lastSyncPrefix', { date: new Date(at).toLocaleString(getLang() === 'en' ? 'en-US' : 'de-DE') }) + t('lastSyncVia', { provider: label(provider) })
      : '';
    const problemEl = document.getElementById('sync-problem-info');
    if (!problemEl) return;
    const problem = getSyncProblem();
    problemEl.hidden = !problem;
    if (problem) problemEl.textContent = problem.kind === 'conflict'
      ? t('syncProblemConflict', { provider: label(problem.provider) })
      : t('syncProblemError', { provider: label(problem.provider), msg: problem.message });
  }

  /** Shared by every way a backup comes in (file, file access, WebDAV, Gist):
   *  checks it, asks once with what it contains, then merges it in. Returns
   *  the summary text, or null if the user cancelled. Throws on an unusable backup. */
  async function restoreFromText(text: string): Promise<string | null> {
    let backup;
    try { backup = parseBackup(text); } catch { throw new Error(t('restoreInvalid')); }
    if (backupIsEmpty(backup)) throw new Error(t('restoreEmpty'));
    const parts = {
      plants: backup.plants.length,
      guildPart: backup.polycultures.length ? t('restoreGuildPart', { n: backup.polycultures.length }) : '',
      gardenPlanPart: backup.gardenPlans.length ? t('restoreGardenPlanPart', { n: backup.gardenPlans.length }) : '',
      varietyPart: backup.varietyLists.length ? t('restoreVarietyPart', { n: backup.varietyLists.length }) : '',
    };
    if (!confirm(t('restoreConfirm', { ...parts, settingsPart: backup.settings ? t('restoreSettingsPart') : '' }))) return null;
    await applyBackup(backup);
    if (backup.settings) {
      settings = loadSettings();
      renderSources(); renderPrefs();
    }
    await renderStats();
    if (backup.varietyLists.length) await renderVarietyLists();
    return t('restoreToast', parts);
  }

  function downloadBackupBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  document.getElementById('btn-backup')!.addEventListener('click', async () => {
    try {
      const { blob, filename } = await buildBackupBlob();
      downloadBackupBlob(blob, filename);
      rememberBackupAt();
      renderLastBackup();
    } catch (err) {
      alert(t('genericError', { msg: err instanceof Error ? err.message : String(err) }));
    }
  });

  // ── Projekt als Link teilen ─────────────────────────────────────────────
  // Data goes into the link's #fragment (src/lib/share.ts), never to a server.
  // Very long links may be cut off by messengers, hence the size hint.
  const SHARE_LONG_LINK = 8000;
  const shareDialog = document.getElementById('share-dialog') as HTMLDialogElement;
  const shareUrlEl = document.getElementById('share-url') as HTMLTextAreaElement;
  const shareResult = document.getElementById('share-result')!;
  const shareNative = document.getElementById('share-native') as HTMLButtonElement;
  const shareOpts = ['share-polycultures', 'share-gardenplans', 'share-notes', 'share-location', 'share-views']
    .map(id => document.getElementById(id) as HTMLInputElement);
  const shareStart = document.getElementById('share-start') as HTMLSelectElement;
  /** Start-plan choices: none, or one of the plans (default: the last opened one). */
  async function fillShareStart() {
    const [{ getAllGardenPlans }, { LAST_PLAN_KEY }] = await Promise.all([import('../lib/db'), import('../lib/plan-view')]);
    const plans = await getAllGardenPlans();
    let last: string | null = null;
    try { last = localStorage.getItem(LAST_PLAN_KEY); } catch {}
    shareStart.innerHTML = `<option value="">${escapeHtml(t('shareStartNone'))}</option>`
      + plans.map(p => `<option value="${escapeHtml(p.id)}">${escapeHtml(p.name || '—')}</option>`).join('');
    shareStart.value = plans.some(p => p.id === last) ? last! : (plans[0]?.id ?? '');
  }
  shareStart.addEventListener('change', () => { shareResult.hidden = true; });
  document.getElementById('btn-share-link')!.addEventListener('click', () => {
    shareResult.hidden = true;
    void fillShareStart();
    shareDialog.showModal();
  });
  shareOpts.forEach(o => o.addEventListener('change', () => { shareResult.hidden = true; }));
  // Deep link from the plant page's "Daten ⋮" menu.
  if (location.hash === '#teilen') {
    history.replaceState(null, '', location.pathname);
    shareResult.hidden = true;
    void fillShareStart();
    shareDialog.showModal();
  }
  document.getElementById('share-close')!.addEventListener('click', () => shareDialog.close());
  document.getElementById('share-create')!.addEventListener('click', async (e) => {
    await withButtonSpinner(e.currentTarget as HTMLButtonElement, async () => {
      const [incPoly, incPlans, incNotes, incLoc, incViews] = shareOpts.map(o => o.checked);
      const { readPlanView } = await import('../lib/plan-view');
      const [{ encodeShare, shareUrl }, { getAllPolycultures, getAllGardenPlans }] = await Promise.all([import('../lib/share'), import('../lib/db')]);
      const [plants, polycultures, gardenPlans] = await Promise.all([
        getAllPlants(), incPoly ? getAllPolycultures() : Promise.resolve([]), incPlans ? getAllGardenPlans() : Promise.resolve([]),
      ]);
      const views = Object.fromEntries(gardenPlans.map(g => [g.id, readPlanView(g.id)]).filter(([, v]) => v));
      const start = shareStart.value ? { planId: shareStart.value } : null;
      const data = await encodeShare({ plants, polycultures, gardenPlans, views, start }, { includeNotes: incNotes, includeLocation: incLoc, includeViews: incViews });
      const url = shareUrl(location.origin, data);
      shareUrlEl.value = url;
      const kb = new Intl.NumberFormat(getLang(), { maximumFractionDigits: 1 }).format(url.length / 1024);
      document.getElementById('share-size')!.textContent = url.length > SHARE_LONG_LINK
        ? t('shareSizeLong', { kb, plants: plants.length })
        : t('shareSize', { kb, plants: plants.length });
      shareNative.hidden = !('share' in navigator);
      shareResult.hidden = false;
      shareUrlEl.select();
    });
  });
  document.getElementById('share-copy')!.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(shareUrlEl.value); showToast(t('shareCopied')); }
    catch { shareUrlEl.focus(); shareUrlEl.select(); } // clipboard blocked: leave it selected for Ctrl+C
  });
  shareNative.addEventListener('click', async () => {
    try { await navigator.share({ title: 'Perma Design Kit', url: shareUrlEl.value }); }
    catch (err) { if ((err as Error).name !== 'AbortError') alert(t('shareFailed', { err: String(err) })); }
  });

  const shareBtn = document.getElementById('btn-share-backup') as HTMLButtonElement | null;
  if (shareBtn && 'share' in navigator) {
    shareBtn.hidden = false;
    shareBtn.addEventListener('click', async () => {
      const { blob, filename } = await buildBackupBlob();
      const file = new File([blob], filename, { type: 'application/json' });
      try {
        if ((navigator as any).canShare?.({ files: [file] })) {
          await navigator.share({ files: [file], title: 'Perma Design Kit Backup' });
          rememberBackupAt();
          renderLastBackup();
        } else {
          downloadBackupBlob(blob, filename);
          rememberBackupAt();
          renderLastBackup();
        }
      } catch (err) {
        if ((err as Error).name !== 'AbortError') alert(t('shareFailed', { err: String(err) }));
      }
    });
  }

  // ── Sync: Auto-Sync Toggle ───────────────────────────────────────────────
  autoSyncToggle.addEventListener('change', () => {
    try { localStorage.setItem('auto-sync-enabled', autoSyncToggle.checked ? 'true' : 'false'); } catch {}
    if (!autoSyncToggle.checked) { clearSyncProblem(); renderLastSyncInfo(); }
  });

  // ── Sync: WebDAV ─────────────────────────────────────────────────────────
  const webdavUrl = document.getElementById('webdav-url') as HTMLInputElement;
  const webdavUser = document.getElementById('webdav-user') as HTMLInputElement;
  const webdavPass = document.getElementById('webdav-pass') as HTMLInputElement;
  const webdavStatus = document.getElementById('webdav-status')!;

  function loadWebdavCreds() {
    try {
      webdavUrl.value = localStorage.getItem('webdav-url') || '';
      webdavUser.value = localStorage.getItem('webdav-user') || '';
      webdavPass.value = localStorage.getItem('webdav-pass') || '';
    } catch {}
  }
  const webdavCreds = (): WebdavCreds => ({ url: webdavUrl.value.trim(), user: webdavUser.value.trim(), pass: webdavPass.value });

  function setWebdavStatus(msg: string, kind: 'ok' | 'err' | 'idle' = 'idle') {
    webdavStatus.textContent = msg;
    webdavStatus.className = 'text-xs ' + (
      kind === 'ok'  ? 'text-green-700 dark:text-green-400' :
      kind === 'err' ? 'text-red-700 dark:text-red-400'    :
                       'text-stone-500 dark:text-stone-400');
  }

  document.getElementById('btn-webdav-save-creds')!.addEventListener('click', () => {
    try {
      localStorage.setItem('webdav-url', webdavUrl.value.trim());
      localStorage.setItem('webdav-user', webdavUser.value);
      localStorage.setItem('webdav-pass', webdavPass.value);
      setWebdavStatus(t('webdavCredsSaved'), 'ok');
    } catch (err) { setWebdavStatus(t('webdavErrorUpload', { msg: String(err) }), 'err'); }
  });
  document.getElementById('btn-webdav-clear-creds')!.addEventListener('click', () => {
    try {
      localStorage.removeItem('webdav-url');
      localStorage.removeItem('webdav-user');
      localStorage.removeItem('webdav-pass');
      webdavUrl.value = ''; webdavUser.value = ''; webdavPass.value = '';
      forgetSyncState('webdav'); renderLastSyncInfo();
      setWebdavStatus(t('webdavCredsCleared'), 'idle');
    } catch {}
  });

  document.getElementById('btn-webdav-push')!.addEventListener('click', async () => {
    if (!webdavUrl.value || !webdavUser.value) { setWebdavStatus(t('webdavMissingFields'), 'err'); return; }
    setWebdavStatus(t('webdavUploading'));
    try {
      const status = await webdavPush(webdavCreds(), await buildBackup());
      renderLastBackup(); renderLastSyncInfo();
      setWebdavStatus(t('webdavUploaded', { status }), 'ok');
    } catch (err) {
      setWebdavStatus(t('webdavErrorUpload', { msg: (err as Error).message }), 'err');
    }
  });

  document.getElementById('btn-webdav-pull')!.addEventListener('click', async () => {
    if (!webdavUrl.value || !webdavUser.value) { setWebdavStatus(t('webdavMissingFields'), 'err'); return; }
    setWebdavStatus(t('webdavDownloading'));
    try {
      const text = await webdavPull(webdavCreds());
      const summary = await restoreFromText(text);
      if (summary === null) { setWebdavStatus(''); return; }
      rememberPulled('webdav', text);
      renderLastSyncInfo();
      setWebdavStatus(summary, 'ok');
    } catch (err) {
      setWebdavStatus(t('webdavErrorDownload', { msg: (err as Error).message }), 'err');
    }
  });

  // ── Sync: File System Access API ─────────────────────────────────────────
  const fsaDetails = document.getElementById('details-fsa') as HTMLDetailsElement | null;
  const fsaStatus = document.getElementById('fsa-status')!;

  function setFsaStatus(msg: string, kind: 'ok' | 'err' | 'idle' = 'idle') {
    fsaStatus.textContent = msg;
    fsaStatus.className = 'text-xs ' + (
      kind === 'ok'  ? 'text-green-700 dark:text-green-400' :
      kind === 'err' ? 'text-red-700 dark:text-red-400'    :
                       'text-stone-500 dark:text-stone-400');
  }

  if (fsaDetails && 'showSaveFilePicker' in window) {
    fsaDetails.hidden = false;

    document.getElementById('btn-fsa-write')!.addEventListener('click', async () => {
      try {
        const json = await buildBackupJson();
        const blob = new Blob([json], { type: 'application/json' });
        const filename = `perma-design-kit-backup-${new Date().toISOString().slice(0, 10)}.json`;
        const handle = await (window as any).showSaveFilePicker({
          suggestedName: filename,
          types: [{ description: 'JSON-Backup', accept: { 'application/json': ['.json'] } }],
        });
        const writable = await handle.createWritable();
        await writable.write(blob);
        await writable.close();
        rememberBackupAt();
        renderLastBackup();
        setFsaStatus(t('fsaSaved'), 'ok');
      } catch (err) {
        if ((err as Error).name !== 'AbortError') setFsaStatus(t('genericError', { msg: String(err) }), 'err');
      }
    });

    document.getElementById('btn-fsa-read')!.addEventListener('click', async () => {
      try {
        const [handle] = await (window as any).showOpenFilePicker({
          types: [{ description: 'JSON-Backup', accept: { 'application/json': ['.json'] } }],
          multiple: false,
        });
        const file = await handle.getFile();
        const text = await (file as File).text();
        const summary = await restoreFromText(text);
        if (summary !== null) setFsaStatus(summary, 'ok');
      } catch (err) {
        if ((err as Error).name !== 'AbortError') setFsaStatus(t('genericError', { msg: String(err) }), 'err');
      }
    });
  }

  // ── Sync: GitHub Gist ─────────────────────────────────────────────────────
  const gistTokenInput = document.getElementById('gist-token') as HTMLInputElement;
  const gistIdInput = document.getElementById('gist-id') as HTMLInputElement;
  const gistStatus = document.getElementById('gist-status')!;

  function setGistStatus(msg: string, kind: 'ok' | 'err' | 'idle' = 'idle') {
    gistStatus.textContent = msg;
    gistStatus.className = 'text-xs ' + (
      kind === 'ok'  ? 'text-green-700 dark:text-green-400' :
      kind === 'err' ? 'text-red-700 dark:text-red-400'    :
                       'text-stone-500 dark:text-stone-400');
  }

  function loadGistCreds() {
    try {
      gistTokenInput.value = localStorage.getItem('gist-token') || '';
      gistIdInput.value = localStorage.getItem('gist-id') || '';
    } catch {}
  }

  document.getElementById('btn-gist-save-creds')!.addEventListener('click', () => {
    try {
      localStorage.setItem('gist-token', gistTokenInput.value.trim());
      localStorage.setItem('gist-id', gistIdInput.value.trim());
      setGistStatus(t('gistTokenSaved'), 'ok');
    } catch (err) { setGistStatus(t('genericError', { msg: String(err) }), 'err'); }
  });

  document.getElementById('btn-gist-clear-creds')!.addEventListener('click', () => {
    try {
      localStorage.removeItem('gist-token');
      localStorage.removeItem('gist-id');
      gistTokenInput.value = ''; gistIdInput.value = '';
      forgetSyncState('gist'); renderLastSyncInfo();
      setGistStatus(t('gistTokenCleared'), 'idle');
    } catch {}
  });

  document.getElementById('btn-gist-push')!.addEventListener('click', async () => {
    const token = gistTokenInput.value.trim();
    if (!token) { setGistStatus(t('gistTokenMissing'), 'err'); return; }
    setGistStatus(t('gistUploading'));
    try {
      const id = gistIdInput.value.trim();
      const gistId = await gistPush({ token, id }, await buildBackup());
      if (!id) {
        gistIdInput.value = gistId;
        try { localStorage.setItem('gist-id', gistId); } catch {}
      }
      renderLastBackup(); renderLastSyncInfo();
      setGistStatus(t('gistUploaded', { id: gistId.slice(0, 8) }), 'ok');
    } catch (err) {
      setGistStatus(t('gistErrorUpload', { msg: (err as Error).message }), 'err');
    }
  });

  document.getElementById('btn-gist-pull')!.addEventListener('click', async () => {
    const token = gistTokenInput.value.trim();
    const id = gistIdInput.value.trim();
    if (!token || !id) { setGistStatus(t('gistTokenIdMissing'), 'err'); return; }
    setGistStatus(t('gistDownloading'));
    try {
      const text = await gistPull({ token, id });
      if (text === null) throw new Error(t('gistFileNotFound', { filename: GIST_FILENAME }));
      const summary = await restoreFromText(text);
      if (summary === null) { setGistStatus(''); return; }
      rememberPulled('gist', text);
      renderLastSyncInfo();
      setGistStatus(summary, 'ok');
    } catch (err) {
      setGistStatus(t('gistErrorDownload', { msg: (err as Error).message }), 'err');
    }
  });

  // ── Daten: Backup einlesen ──────────────────────────────────────────────
  (document.getElementById('restore-input') as HTMLInputElement | null)?.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    try {
      const summary = await restoreFromText(await file.text());
      if (summary !== null) showToast(summary);
    } catch (err) {
      alert(t('restoreFailed', { msg: err instanceof Error ? err.message : String(err) }));
    } finally {
      input.value = '';
    }
  });

  // ── Daten: Golden Master neu laden ──────────────────────────────────────
  document.getElementById('btn-reload-master')!.addEventListener('click', async () => {
    if (!confirm(t('reloadMasterConfirm'))) return;
    try {
      // plants-db.json is a name index ({latinName, commonName} only, no ids);
      // loadMasterList() normalizes the entries and skips plants already in
      // the collection — otherwise every click added duplicates.
      const { loadMasterList } = await import('../lib/master-list');
      showToast(t('reloadMasterToast', { n: await loadMasterList() }));
      await renderStats();
    } catch (err) {
      alert(t('reloadMasterFailed', { msg: err instanceof Error ? err.message : String(err) }));
    }
  });

  // ── Sortenlisten ────────────────────────────────────────────────────────
  // Lists for the "Sorte" picker in the plant editor (lib/varieties.ts):
  // load Wikidata's fruit cultivars, import CSV lists, then rename, switch
  // off, refresh, export, browse, add or remove single entries, or delete.
  const varietyListsEl = document.getElementById('variety-lists')!;
  const varietyStatus = document.getElementById('variety-status')!;
  const fmtNum = (n: number) => new Intl.NumberFormat(getLang()).format(n);
  const speciesLabel = (k: string) => k ? k[0].toUpperCase() + k.slice(1) : '—';
  const VARIETY_SHOWN = 300;
  const openVarietyLists = new Set<string>();

  function downloadText(text: string, filename: string, type: string) {
    const url = URL.createObjectURL(new Blob(['\ufeff' + text], { type }));
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
  }

  async function renderVarietyLists() {
    const lists = await getVarietyLists().catch(() => [] as VarietyList[]);
    if (lists.length === 0) {
      varietyListsEl.innerHTML = `<li class="rounded-lg border border-dashed border-stone-300 dark:border-stone-600 p-4 text-sm text-stone-500 dark:text-stone-400">${escapeHtml(t('varietiesEmpty'))}</li>`;
      return;
    }
    varietyListsEl.innerHTML = lists.map(l => {
      const species = new Map<string, number>();
      for (const e of l.entries) species.set(e.species, (species.get(e.species) ?? 0) + 1);
      const top = [...species.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6).map(([k, n]) => `${speciesLabel(k)} ${fmtNum(n)}`).join(' · ');
      const date = new Date(l.importedAt).toLocaleDateString(getLang());
      const btn = 'rounded-md bg-stone-100 dark:bg-stone-700 px-2 py-1 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600';
      return `
      <li data-list="${escapeHtml(l.id)}" class="rounded-lg p-3 ring-1 ring-stone-200 dark:ring-stone-700 ${l.enabled ? '' : 'opacity-60'}">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="font-medium text-stone-800 dark:text-stone-100">${escapeHtml(l.name)}</p>
            <p class="text-xs text-stone-500 dark:text-stone-400">${escapeHtml(t('varietyListMeta', { n: fmtNum(l.entries.length), s: fmtNum(species.size), src: l.license, date }))}</p>
            <p class="text-xs text-stone-400">${escapeHtml(top)}</p>
          </div>
          <label class="inline-flex items-center gap-1.5 text-xs text-stone-600 dark:text-stone-300"><input type="checkbox" class="vl-enabled accent-green-600" ${l.enabled ? 'checked' : ''} /> ${escapeHtml(t('varietyListActive'))}</label>
        </div>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <button type="button" class="vl-rename ${btn}">${escapeHtml(t('varietyListRename'))}</button>
          ${l.source === 'wikidata' ? `<button type="button" class="vl-refresh ${btn}">${escapeHtml(t('varietyListRefresh'))}</button>` : ''}
          <button type="button" class="vl-export ${btn}">${escapeHtml(t('varietyListExport'))}</button>
          <button type="button" class="vl-delete rounded-md bg-red-50 dark:bg-red-900/30 px-2 py-1 text-xs font-medium text-red-700 dark:text-red-300 ring-1 ring-red-200 dark:ring-red-800 hover:bg-red-100">${escapeHtml(t('varietyListDelete'))}</button>
        </div>
        <details class="vl-details mt-2" ${openVarietyLists.has(l.id) ? 'open' : ''}>
          <summary class="cursor-pointer text-xs font-medium text-green-700 dark:text-green-400">${escapeHtml(t('varietyListBrowse'))}</summary>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <input type="search" class="vl-filter min-w-0 flex-1 rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2 py-1 text-xs" placeholder="${escapeHtml(t('varietyListFilter'))}" aria-label="${escapeHtml(t('varietyListFilter'))}" />
          </div>
          <ul class="vl-entries mt-2 max-h-64 overflow-y-auto divide-y divide-stone-100 dark:divide-stone-700 text-xs"></ul>
          <form class="vl-add mt-2 flex flex-wrap items-center gap-1.5">
            <input name="species" required class="w-40 rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2 py-1 text-xs" placeholder="${escapeHtml(t('varietyAddSpecies'))}" aria-label="${escapeHtml(t('varietyAddSpecies'))}" />
            <input name="name" required class="w-40 rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2 py-1 text-xs" placeholder="${escapeHtml(t('varietyAddName'))}" aria-label="${escapeHtml(t('varietyAddName'))}" />
            <button type="submit" class="${btn}">${escapeHtml(t('varietyAdd'))}</button>
          </form>
        </details>
      </li>`;
    }).join('');

    for (const li of varietyListsEl.querySelectorAll<HTMLElement>('[data-list]')) {
      const list = lists.find(l => l.id === li.dataset.list)!;
      const save = async (msg?: string) => { await saveVarietyList(list); if (msg) varietyStatus.textContent = msg; await renderVarietyLists(); };
      li.querySelector<HTMLInputElement>('.vl-enabled')!.addEventListener('change', e => { list.enabled = (e.target as HTMLInputElement).checked; void save(); });
      li.querySelector('.vl-rename')!.addEventListener('click', () => {
        const name = prompt(t('varietyListRenamePrompt'), list.name)?.trim();
        if (name) { list.name = name; void save(); }
      });
      li.querySelector('.vl-refresh')?.addEventListener('click', e => loadWikidataList(e.currentTarget as HTMLButtonElement));
      li.querySelector('.vl-export')!.addEventListener('click', () => downloadText(varietyListToCsv(list), `${list.name.replace(/[^\p{L}\p{N}]+/gu, '-').toLowerCase()}.csv`, 'text/csv'));
      li.querySelector('.vl-delete')!.addEventListener('click', async () => {
        if (!confirm(t('varietyListDeleteConfirm', { name: list.name }))) return;
        await deleteVarietyList(list.id);
        varietyStatus.textContent = t('varietyListDeleted', { name: list.name });
        await renderVarietyLists();
      });
      const details = li.querySelector<HTMLDetailsElement>('.vl-details')!;
      const filter = li.querySelector<HTMLInputElement>('.vl-filter')!;
      const entriesEl = li.querySelector<HTMLUListElement>('.vl-entries')!;
      const renderEntries = () => {
        const q = filter.value.trim().toLowerCase();
        const hits = list.entries.filter(e => !q || e.name.toLowerCase().includes(q) || e.species.includes(q) || e.synonyms?.some(s => s.toLowerCase().includes(q)));
        entriesEl.innerHTML = hits.slice(0, VARIETY_SHOWN).map(e => `
          <li class="flex items-center justify-between gap-2 py-1" data-entry="${escapeHtml(e.species + '|' + e.name)}">
            <span class="min-w-0"><span class="text-stone-800 dark:text-stone-100">${escapeHtml(e.name)}</span> <span class="italic text-stone-400">${escapeHtml(speciesLabel(e.species))}</span>${e.synonyms?.length ? ` <span class="text-stone-400">(${escapeHtml(e.synonyms.join(', '))})</span>` : ''}</span>
            <button type="button" class="vl-remove shrink-0 rounded px-1.5 text-stone-400 hover:bg-red-50 hover:text-red-600" aria-label="${escapeHtml(t('varietyRemove', { name: e.name }))}" title="${escapeHtml(t('varietyRemove', { name: e.name }))}">×</button>
          </li>`).join('') + (hits.length > VARIETY_SHOWN ? `<li class="py-1 text-stone-500">${escapeHtml(t('varietyListMore', { n: fmtNum(hits.length - VARIETY_SHOWN) }))}</li>` : '')
          + (hits.length === 0 ? `<li class="py-1 text-stone-500">${escapeHtml(t('varietyListNoHits'))}</li>` : '');
        entriesEl.querySelectorAll<HTMLElement>('.vl-remove').forEach(b => b.addEventListener('click', async () => {
          const key = (b.closest('[data-entry]') as HTMLElement).dataset.entry!;
          list.entries = list.entries.filter(e => `${e.species}|${e.name}` !== key);
          await saveVarietyList(list);
          b.closest('li')!.remove();
          li.querySelector('.text-xs')!.textContent = t('varietyListMeta', { n: fmtNum(list.entries.length), s: fmtNum(new Set(list.entries.map(e => e.species)).size), src: list.license, date: new Date(list.importedAt).toLocaleDateString(getLang()) });
        }));
      };
      details.addEventListener('toggle', () => {
        if (details.open) { openVarietyLists.add(list.id); renderEntries(); } else openVarietyLists.delete(list.id);
      });
      if (details.open) renderEntries();
      filter.addEventListener('input', renderEntries);
      li.querySelector<HTMLFormElement>('.vl-add')!.addEventListener('submit', async e => {
        e.preventDefault();
        const f = e.currentTarget as HTMLFormElement;
        const species = speciesKey(String(new FormData(f).get('species') ?? ''));
        const name = String(new FormData(f).get('name') ?? '').trim();
        if (!species || !name) return;
        list.entries = dedupeEntries([...list.entries, { species, name }]);
        await save(t('varietyAdded', { name, list: list.name }));
      });
    }
  }

  async function loadWikidataList(btn: HTMLButtonElement) {
    await withButtonSpinner(btn, async () => {
      varietyStatus.textContent = t('varietyWikidataLoading');
      try {
        const entries = await fetchWikidataVarieties(null);
        const old = (await getVarietyLists()).find(l => l.id === WIKIDATA_LIST_ID);
        await saveVarietyList({
          id: WIKIDATA_LIST_ID, name: old?.name ?? t('varietyWikidataName'), source: 'wikidata', license: 'Wikidata, CC0',
          importedAt: new Date().toISOString(), enabled: old?.enabled ?? true, entries,
        });
        varietyStatus.textContent = t('varietyWikidataDone', { n: fmtNum(entries.length) });
      } catch (err) {
        varietyStatus.textContent = t('varietyWikidataFailed', { msg: err instanceof Error ? err.message : String(err) });
      }
      await renderVarietyLists();
    });
  }

  document.getElementById('btn-variety-wikidata')!.addEventListener('click', e => loadWikidataList(e.currentTarget as HTMLButtonElement));
  document.getElementById('btn-variety-template')!.addEventListener('click', () => downloadText(VARIETY_CSV_TEMPLATE, 'sortenliste-vorlage.csv', 'text/csv'));
  document.getElementById('variety-csv-input')!.addEventListener('change', async e => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    try {
      const entries = parseVarietyCsv(await file.text());
      if (entries.length === 0) throw new Error(t('varietyCsvEmpty'));
      const name = file.name.replace(/\.[^.]+$/, '');
      await saveVarietyList({ id: newId(), name, source: 'csv', license: t('varietyCsvLicense', { file: file.name }), importedAt: new Date().toISOString(), enabled: true, entries });
      varietyStatus.textContent = t('varietyCsvDone', { n: fmtNum(entries.length), name });
    } catch (err) {
      varietyStatus.textContent = t('varietyCsvFailed', { msg: err instanceof Error ? err.message : String(err) });
    }
    await renderVarietyLists();
  });

  // ── Daten: Alles löschen ────────────────────────────────────────────────
  document.getElementById('btn-clear-all')!.addEventListener('click', async () => {
    if (!confirm(t('clearAllConfirm1'))) return;
    if (!confirm(t('clearAllConfirm2'))) return;
    await clearAllData();
    try { localStorage.clear(); } catch {}
    location.href = '/';
  });

  // ── Init ────────────────────────────────────────────────────────────────
