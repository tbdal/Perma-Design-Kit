---
import Layout from '../layouts/Layout.astro';
const field = 'mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-200';
const btn = 'rounded-lg px-3.5 py-2 text-sm font-medium shadow-sm';
---
<Layout title="Perma Design Kit — Anmelden">
  <article class="mx-auto max-w-md space-y-5 text-stone-800 dark:text-stone-100">
    <h1 class="text-2xl font-bold" data-i18n="acLoginTitle">Experten-Zugang</h1>
    <p class="text-sm text-stone-600 dark:text-stone-300" data-i18n="acLoginIntro">Der Experten-Modus zeigt zusätzlich Funktionen, die noch in Erprobung sind. Zugänge vergibt das Team des Perma Design Kit.</p>

    <form id="invite-form" hidden class="space-y-4 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
      <h2 class="text-lg font-semibold" data-i18n="acInvTitle">Einladung</h2>
      <p id="invite-intro" class="text-sm"></p>
      <label class="block text-sm font-medium"><span data-i18n="acName">Name</span>
        <input id="invite-name" name="username" autocomplete="username" required maxlength="40" class={field} />
      </label>
      <label class="block text-sm font-medium"><span data-i18n="acPassword">Passwort</span> <span class="font-normal text-stone-500 dark:text-stone-400" data-i18n="acInvPasswordHint">mindestens 10 Zeichen</span>
        <input id="invite-password" name="password" type="password" autocomplete="new-password" required minlength="10" class={field} />
      </label>
      <p id="invite-error" role="alert" class="text-sm font-medium text-red-700 dark:text-red-300"></p>
      <button type="submit" data-i18n="acInvCreateBtn" class={`${btn} bg-green-700 text-white hover:bg-green-800 disabled:opacity-60`}>Konto anlegen</button>
    </form>
    <p id="device-status" hidden role="status" class="rounded-lg bg-stone-50 dark:bg-stone-800 px-3 py-2 text-sm ring-1 ring-stone-200 dark:ring-stone-700"></p>
    <p id="invite-invalid" hidden role="alert" class="rounded-lg bg-amber-50 dark:bg-amber-900/30 px-3 py-2 text-sm text-amber-900 dark:text-amber-100 ring-1 ring-amber-200 dark:ring-amber-800" data-i18n="acInvInvalid">Diese Einladung gilt nicht mehr.</p>

    <form id="login-form" class="space-y-4 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
      <label class="block text-sm font-medium"><span data-i18n="acName">Name</span>
        <input id="login-name" name="username" autocomplete="username" required maxlength="40" class={field} />
      </label>
      <label class="block text-sm font-medium"><span data-i18n="acPassword">Passwort</span>
        <input id="login-password" name="password" type="password" autocomplete="current-password" required class={field} />
      </label>
      <p id="login-error" role="alert" class="text-sm font-medium text-red-700 dark:text-red-300"></p>
      <button id="login-submit" type="submit" data-i18n="acLoginBtn" class={`${btn} bg-green-700 text-white hover:bg-green-800 disabled:opacity-60`}>Anmelden</button>
    </form>

    <div id="login-done" hidden class="space-y-3 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
      <p id="login-done-text" class="text-sm font-medium"></p>
      <div class="flex flex-wrap gap-2">
        <button id="btn-to-expert" type="button" data-i18n="acToExpert" class={`${btn} bg-green-700 text-white hover:bg-green-800`}>Experten-Modus einschalten</button>
        <a id="btn-to-admin" href="/admin/" hidden data-i18n="acToAdmin" class={`${btn} bg-white dark:bg-stone-800 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700`}>Funktionen verwalten</a>
        <button id="btn-logout" type="button" data-i18n="acLogout" class={`${btn} bg-white dark:bg-stone-800 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700`}>Abmelden</button>
      </div>
    </div>

    <p class="text-xs text-stone-500 dark:text-stone-400"><span data-i18n="acCookieNote">Beim Anmelden setzt der Server ein Cookie, das nur deinen Zugangsnamen enthält. Es ist für die Anmeldung technisch nötig und läuft nach 90 Tagen ab.</span> <a href="/datenschutz#experten-zugang" class="underline underline-offset-2 hover:no-underline" data-i18n="acPrivacy">Datenschutz</a></p>
  </article>

  <script>
    import { applyStaticI18n, createT } from '../lib/i18n/core';
    import { accessDict } from '../lib/i18n/dict-access';
    import { getAuth, login, logout, refreshAuth, setMode, adoptAccountMode } from '../lib/ui-mode';
    import { safeNext } from '../lib/safe-next';

    applyStaticI18n(accessDict);
    const t = createT(accessDict);
    const form = document.getElementById('login-form') as HTMLFormElement;
    const nameInput = document.getElementById('login-name') as HTMLInputElement;
    const pwInput = document.getElementById('login-password') as HTMLInputElement;
    const submit = document.getElementById('login-submit') as HTMLButtonElement;
    const error = document.getElementById('login-error')!;
    const done = document.getElementById('login-done')!;
    const params = new URLSearchParams(location.search);
    const next = safeNext(params.get('next') || '', location.origin);

    const inviteToken = params.get('einladung') || '';
    const inviteForm = document.getElementById('invite-form') as HTMLFormElement;
    let inviteOpen = false;
    let inviteRole: 'team' | 'expert' = 'expert';

    function showDone() {
      const auth = getAuth();
      if (!auth) { form.hidden = inviteOpen; inviteForm.hidden = !inviteOpen; done.hidden = true; return; }
      inviteForm.hidden = true;
      form.hidden = true;
      done.hidden = false;
      document.getElementById('login-done-text')!.textContent = t('acLoggedIn', { name: auth.name });
      document.getElementById('btn-to-admin')!.hidden = auth.role !== 'admin';
    }

    form.addEventListener('submit', async e => {
      e.preventDefault();
      error.textContent = '';
      submit.disabled = true;
      submit.textContent = t('acLoginBusy');
      const res = await login(nameInput.value.trim(), pwInput.value);
      submit.disabled = false;
      submit.textContent = t('acLoginBtn');
      pwInput.value = '';
      if (!res.ok) {
        error.textContent = t(res.reason === 'credentials' ? 'acErrCredentials' : res.reason === 'rate' ? 'acErrRate' : 'acErrServer');
        return;
      }
      const adopted = adoptAccountMode(res.auth.role);
      const wanted = params.get('mode');
      if (wanted === 'expert' || wanted === 'team') {
        // effectiveMode() falls back to expert if this account may not use team mode.
        try { localStorage.setItem('pdk-mode', wanted); } catch { /* ignore */ }
        location.href = next;
        return;
      }
      if (adopted) { location.href = next; return; } // new device: straight into the account's mode
      showDone();
    });
    document.getElementById('btn-to-expert')!.addEventListener('click', () => {
      try { localStorage.setItem('pdk-mode', 'expert'); } catch { /* ignore */ }
      if (next !== '/' || params.has('next')) location.href = next;
      else setMode('expert');
    });
    document.getElementById('btn-logout')!.addEventListener('click', () => void logout());

    // QR code from another, logged-in device (Einstellungen → Anmeldung): one-time code, no password here.
    const deviceToken = params.get('geraet') || '';
    async function redeemDevice() {
      if (!deviceToken) return;
      // the code must not stay in the address bar or the history
      params.delete('geraet');
      history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
      const status = document.getElementById('device-status')!;
      status.hidden = false;
      status.textContent = t('acDevBusy');
      try {
        const res = await fetch('/api/auth/device/redeem', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token: deviceToken }) });
        if (res.ok) {
          const who = await res.json() as { role?: string };
          await refreshAuth();
          // same as an invitation: the account's mode right away (a team account may use expert mode too)
          adoptAccountMode(who.role ?? '');
          location.href = next;
          return;
        }
        status.textContent = res.status === 429 ? t('acErrRate') : t('acDevInvalid');
      } catch {
        status.textContent = t('acErrServer');
      }
    }
    void redeemDevice();

    // Invitation link: the role is preset, the person only chooses name and password.
    async function loadInvite() {
      if (!inviteToken) return;
      let info: { role?: string; label?: string } | null = null;
      try {
        const res = await fetch(`/api/auth/invite?token=${encodeURIComponent(inviteToken)}`, { cache: 'no-store' });
        if (res.ok) info = await res.json();
      } catch { /* offline: treated as invalid */ }
      if (!info) { document.getElementById('invite-invalid')!.hidden = false; return; }
      inviteOpen = true;
      inviteRole = info.role === 'team' ? 'team' : 'expert';
      document.getElementById('invite-intro')!.textContent = t(inviteRole === 'team' ? 'acInvIntroTeam' : 'acInvIntroExpert') + (info.label ? ` ${t('acInvForLabel', { label: info.label })}` : '');
      showDone();
    }
    inviteForm.addEventListener('submit', async e => {
      e.preventDefault();
      const err = document.getElementById('invite-error')!;
      err.textContent = '';
      const btnEl = inviteForm.querySelector('button[type=submit]') as HTMLButtonElement;
      btnEl.disabled = true;
      try {
        const res = await fetch('/api/auth/invite', {
          method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: inviteToken, name: (document.getElementById('invite-name') as HTMLInputElement).value.trim(), password: (document.getElementById('invite-password') as HTMLInputElement).value }),
        });
        if (res.ok) {
          (document.getElementById('invite-password') as HTMLInputElement).value = '';
          inviteOpen = false;
          history.replaceState(null, '', location.pathname); // the token is spent: out of the address bar
          await refreshAuth();
          // The invited role's mode is switched on right away (the team may use expert mode too).
          try { localStorage.setItem('pdk-mode', inviteRole); localStorage.setItem('pdk-welcome-seen', '1'); } catch { /* ignore */ }
          location.href = next;
          return;
        }
        const data = await res.json().catch(() => ({}));
        if (res.status === 404) { inviteOpen = false; inviteForm.hidden = true; document.getElementById('invite-invalid')!.hidden = false; return; }
        const code = String(data.error || 'generic').replace(/-/g, '_');
        err.textContent = res.status === 429 ? t('acErrRate') : accessDict[`adErr_${code}`] ? t(`adErr_${code}`) : t('acErrServer');
      } catch { err.textContent = t('acErrServer'); } finally { btnEl.disabled = false; }
    });

    showDone();
    void loadInvite();
    void refreshAuth().then(showDone);
  </script>
</Layout>
