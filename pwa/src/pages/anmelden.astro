---
import Layout from '../layouts/Layout.astro';
const field = 'mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-200';
const btn = 'rounded-lg px-3.5 py-2 text-sm font-medium shadow-sm';
---
<Layout title="Perma Design Kit — Anmelden">
  <article class="mx-auto max-w-md space-y-5 text-stone-800 dark:text-stone-100">
    <h1 class="text-2xl font-bold" data-i18n="acLoginTitle">Experten-Zugang</h1>
    <p class="text-sm text-stone-600 dark:text-stone-300" data-i18n="acLoginIntro">Der Experten-Modus zeigt zusätzlich Funktionen, die noch in Erprobung sind. Zugänge vergibt das Team des Perma Design Kit.</p>

    <form id="login-form" class="space-y-4 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
      <label class="block text-sm font-medium"><span data-i18n="acName">Name</span>
        <input id="login-name" name="username" autocomplete="username" required maxlength="40" class={field} />
      </label>
      <label class="block text-sm font-medium"><span data-i18n="acPassword">Passwort</span>
        <input id="login-password" name="password" type="password" autocomplete="current-password" required class={field} />
      </label>
      <p id="login-error" role="alert" class="text-sm font-medium text-red-700 dark:text-red-300"></p>
      <button id="login-submit" type="submit" data-i18n="acLoginBtn" class={`${btn} bg-green-700 text-white hover:bg-green-800 disabled:opacity-60`}>Anmelden</button>
    </form>

    <div id="login-done" hidden class="space-y-3 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
      <p id="login-done-text" class="text-sm font-medium"></p>
      <div class="flex flex-wrap gap-2">
        <button id="btn-to-expert" type="button" data-i18n="acToExpert" class={`${btn} bg-green-700 text-white hover:bg-green-800`}>Experten-Modus einschalten</button>
        <a id="btn-to-admin" href="/admin/" hidden data-i18n="acToAdmin" class={`${btn} bg-white dark:bg-stone-800 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700`}>Funktionen verwalten</a>
        <button id="btn-logout" type="button" data-i18n="acLogout" class={`${btn} bg-white dark:bg-stone-800 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700`}>Abmelden</button>
      </div>
    </div>

    <p class="text-xs text-stone-500 dark:text-stone-400"><span data-i18n="acCookieNote">Beim Anmelden setzt der Server ein Cookie, das nur deinen Zugangsnamen enthält. Es ist für die Anmeldung technisch nötig und läuft nach 90 Tagen ab.</span> <a href="/datenschutz#experten-zugang" class="underline underline-offset-2 hover:no-underline" data-i18n="acPrivacy">Datenschutz</a></p>
  </article>

  <script>
    import { applyStaticI18n, createT } from '../lib/i18n/core';
    import { accessDict } from '../lib/i18n/dict-access';
    import { getAuth, login, logout, refreshAuth, setMode } from '../lib/ui-mode';

    applyStaticI18n(accessDict);
    const t = createT(accessDict);
    const form = document.getElementById('login-form') as HTMLFormElement;
    const nameInput = document.getElementById('login-name') as HTMLInputElement;
    const pwInput = document.getElementById('login-password') as HTMLInputElement;
    const submit = document.getElementById('login-submit') as HTMLButtonElement;
    const error = document.getElementById('login-error')!;
    const done = document.getElementById('login-done')!;
    const params = new URLSearchParams(location.search);
    // Only paths on this site (no "//host" or "https:" redirects).
    const nextRaw = params.get('next') || '';
    const next = /^\/(?!\/)/.test(nextRaw) ? nextRaw : '/';

    function showDone() {
      const auth = getAuth();
      if (!auth) { form.hidden = false; done.hidden = true; return; }
      form.hidden = true;
      done.hidden = false;
      document.getElementById('login-done-text')!.textContent = t('acLoggedIn', { name: auth.name });
      document.getElementById('btn-to-admin')!.hidden = auth.role !== 'admin';
    }

    form.addEventListener('submit', async e => {
      e.preventDefault();
      error.textContent = '';
      submit.disabled = true;
      submit.textContent = t('acLoginBusy');
      const res = await login(nameInput.value.trim(), pwInput.value);
      submit.disabled = false;
      submit.textContent = t('acLoginBtn');
      pwInput.value = '';
      if (!res.ok) {
        error.textContent = t(res.reason === 'credentials' ? 'acErrCredentials' : res.reason === 'rate' ? 'acErrRate' : 'acErrServer');
        return;
      }
      const wanted = params.get('mode');
      if (wanted === 'expert' || wanted === 'team') {
        // effectiveMode() falls back to expert if this account may not use team mode.
        try { localStorage.setItem('pdk-mode', wanted); } catch { /* ignore */ }
        location.href = next;
        return;
      }
      showDone();
    });
    document.getElementById('btn-to-expert')!.addEventListener('click', () => {
      try { localStorage.setItem('pdk-mode', 'expert'); } catch { /* ignore */ }
      if (next !== '/' || params.has('next')) location.href = next;
      else setMode('expert');
    });
    document.getElementById('btn-logout')!.addEventListener('click', () => void logout());

    showDone();
    void refreshAuth().then(showDone);
  </script>
</Layout>
