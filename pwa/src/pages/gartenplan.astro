---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Perma Design Kit — Waldgartenplan" full>
  <!-- Search hero (same as on the plant page; logic in lib/plant-search-ui.ts).
       Only shown while placing plants (phase B), not in the plan list or
       while the outline is drawn. -->
  <section id="plan-search-hero" hidden class="relative mb-8" data-hz-sky>
    <p class="hz-only hz-hero-title" data-i18n="searchHeroPlan">Pflanze für deinen Waldgarten finden</p>
    <p class="mb-3 text-center text-xs font-medium uppercase tracking-widest text-stone-500 dark:text-stone-400" data-i18n="searchSubtitle">Pflanzendatenbank durchsuchen</p>
    <div class="relative flex items-center gap-0 overflow-hidden rounded-2xl bg-white dark:bg-stone-800 shadow-md ring-1 ring-stone-200 dark:ring-stone-700 focus-within:ring-2 focus-within:ring-green-400 transition">
      <svg class="ml-4 h-5 w-5 shrink-0 text-stone-500 dark:text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/>
      </svg>
      <input type="text" id="plant-search" role="combobox" aria-controls="search-results" aria-autocomplete="list" data-i18n-placeholder="searchPlaceholder" placeholder="Pflanze suchen — lat. oder dt. Name, z.B. Sambucus nigra"
        class="min-w-0 flex-1 bg-transparent py-3.5 pl-3 pr-2 text-sm text-stone-800 dark:text-stone-100 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none" autocomplete="off" />
      <button id="btn-search" data-i18n="searchBtn" class="shrink-0 rounded-xl m-1.5 bg-green-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-green-800 active:scale-95">Suchen</button>
    </div>
    <!-- Floating dropdown -->
    <div id="search-results" role="listbox" class="absolute left-0 right-0 top-full z-50 mt-1 hidden max-h-80 overflow-y-auto rounded-xl border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 shadow-xl"></div>
  </section>

  <!-- ── Listenansicht ─────────────────────────────────────────────────── -->
  <section id="plan-list-view">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-2xl font-bold text-stone-900 dark:text-stone-100" data-i18n="pageTitle">Waldgartenplan</h1>
      <label data-feature="export" class="cursor-pointer rounded-lg bg-stone-100 dark:bg-stone-800 px-3.5 py-2 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-700 hover:bg-stone-200 dark:hover:bg-stone-700" data-i18n-title="importGeojsonTitle" title="GeoJSON aus QGIS & Co. als Waldgartenplan übernehmen">
        <span data-i18n="btnImportGeojson">⤒ GeoJSON importieren</span>
        <input id="geojson-input" type="file" accept=".geojson,.json,application/geo+json,application/json" class="hidden" />
      </label>
      <button id="btn-new-plan" data-i18n="btnNewPlan" class="rounded-lg bg-green-700 px-3.5 py-2 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">+ Neuer Waldgartenplan</button>
    </div>
    <p class="mb-4 text-sm text-stone-500 dark:text-stone-400" data-i18n="introText">Zeichne eine Fläche, platziere Pflanzen darauf und sieh mit dem Schieberegler, wie groß sie nach x Jahren ungefähr werden.</p>
    <p class="mb-4 rounded-lg bg-amber-50 dark:bg-amber-900/30 px-3 py-2 text-sm text-amber-800 dark:text-amber-200 ring-1 ring-amber-200 dark:ring-amber-800" data-i18n="experimentalNotice">Experimentell — diese Funktion befindet sich noch in der Entwicklung.</p>
    <div id="plan-sort-bar" hidden class="mb-3 flex flex-wrap items-center gap-2 text-sm">
      <label for="plan-sort-field" class="text-stone-600 dark:text-stone-300" data-i18n="planSortLabel">Sortieren</label>
      <select id="plan-sort-field" class="rounded-lg border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2 py-1.5 text-sm shadow-sm focus:border-green-500 focus:outline-none">
        <option value="created" data-i18n="planSortCreated">Neueste Planung</option>
        <option value="updated" data-i18n="planSortUpdated">Zuletzt bearbeitet</option>
        <option value="name" data-i18n="planSortName">Name</option>
        <option value="area" data-i18n="planSortArea">Größe (Fläche)</option>
        <option value="plants" data-i18n="planSortPlants">Anzahl Pflanzen</option>
      </select>
      <button id="plan-sort-dir" type="button" data-i18n-title="planSortDirTitle" data-i18n-aria-label="planSortDirTitle" aria-label="Sortierrichtung umkehren" title="Sortierrichtung umkehren" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-2.5 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition hover:bg-stone-200 dark:hover:bg-stone-700">↓</button>
    </div>
    <div id="plan-list" class="grid gap-4 sm:grid-cols-2"></div>
    <div id="plan-empty" class="hidden rounded-xl border-2 border-dashed border-stone-300 dark:border-stone-600 py-16 text-center">
      <p class="text-stone-500 dark:text-stone-400" data-i18n="emptyStateText">Noch keine Waldgartenpläne angelegt.</p>
      <button id="btn-empty-new" data-i18n="btnEmptyNew" class="mt-3 inline-block rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow hover:bg-green-800">Ersten Waldgartenplan anlegen</button>
    </div>
  </section>

  <!-- ── Editor ────────────────────────────────────────────────────────── -->
  <section id="plan-editor-view" hidden>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <button id="btn-back-to-list" data-i18n="btnBackToList" class="text-sm font-medium text-stone-600 dark:text-stone-300 hover:text-green-700 dark:hover:text-green-400">← Zurück zur Liste</button>
      <div class="flex items-center gap-2">
        <button id="btn-save-plan" data-i18n="btnSavePlan" class="rounded-lg bg-green-700 px-3 py-1.5 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">Waldgartenplan speichern</button>
        <button id="btn-delete-plan" data-i18n="btnDeletePlan" class="rounded-lg bg-red-100 dark:bg-red-900/40 px-3 py-1.5 text-sm font-medium text-red-700 dark:text-red-300 ring-1 ring-red-300 dark:ring-red-800 hover:bg-red-200 dark:hover:bg-red-900/60">Löschen</button>
      </div>
    </div>

    <!-- Karte: Standort, Ausrichtung, Hintergrund — gilt für beide Phasen -->
    <div id="map-bar" class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl bg-stone-50 dark:bg-stone-900 px-3 py-2 text-xs text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700">
      <button data-feature="location" id="btn-locate" type="button" data-i18n="mapBarLocate" class="rounded-md bg-white dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700">📍 Standort festlegen…</button>
      <label class="inline-flex items-center gap-1.5">
        <span data-i18n="mapBarBackground">Hintergrund</span>
        <select id="g-basemap" class="rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-1.5 py-0.5 text-xs disabled:opacity-50">
          <option value="none" data-i18n="mapBgNone">Kein</option>
          <option value="osm" data-i18n="mapBgOsm">Karte (OpenStreetMap)</option>
          <option data-feature="basemap-extra" value="ortho" id="g-basemap-ortho">Luftbild (amtlich)</option>
          <option data-feature="basemap-extra" value="sat" data-i18n="mapBgSat">Satellit (grob, 10 m)</option>
        </select>
      </label>
      <label data-feature="basemap-extra" class="inline-flex items-center gap-1.5">
        <span data-i18n="mapBarOpacity">Deckkraft</span>
        <input id="g-basemap-opacity" type="range" min="0.1" max="1" step="0.05" value="0.6" class="w-24 disabled:opacity-50" />
      </label>
      <label data-feature="coverage" class="inline-flex items-center gap-1.5">
        <span data-i18n="coverageLabel">Funktionen</span>
        <select id="g-coverage" class="rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-1.5 py-0.5 text-xs"></select>
      </label>
      <label class="inline-flex items-center gap-1.5" data-i18n-title="mapGridTitle" title="Meterlinien ein-/ausblenden (G)"><input id="g-grid" type="checkbox" checked class="accent-green-700" /> <span data-i18n="mapGrid">Meterlinien</span></label>
      <span class="inline-flex items-center gap-1" data-i18n-title="gridRotTitle" title="Meterlinien drehen, z. B. passend zu einem schrägen Grundstück (nur die Linien drehen sich)">
        <input id="g-grid-rot" type="number" min="-45" max="45" step="1" value="0" data-i18n-aria-label="gridRotLabel" aria-label="Drehung der Meterlinien in Grad" class="w-14 rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-1 py-0.5 text-xs" />°
        <button id="btn-grid-align" type="button" data-i18n="gridAlign" data-i18n-title="gridAlignTitle" title="Meterlinien an der längsten Kante des Umrisses ausrichten" class="rounded-md bg-stone-100 dark:bg-stone-700 px-1.5 py-0.5 text-xs ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">am Umriss</button>
      </span>
      <label data-feature="buildings" id="buildings-toggle" hidden class="inline-flex items-center gap-1.5" data-i18n-title="mapBuildingsTitle" title="Gebäude aus OpenStreetMap: in 3D und als Schattenwerfer für Besonnung und Hinweise"><input id="g-buildings" type="checkbox" checked class="accent-stone-600" /> <span data-i18n="mapBuildings">Gebäude</span></label>
      <label data-feature="terrain" id="contours-toggle" hidden class="inline-flex items-center gap-1.5"><input id="g-contours" type="checkbox" checked class="accent-amber-700" /> <span data-i18n="mapContours">Höhenlinien</span></label>
      <label data-feature="water" id="water-toggle" hidden class="inline-flex items-center gap-1.5" data-i18n-title="mapWaterTitle" title="Abflusswege, Senken, Swale-Vorschläge und Regen vom Dach"><input id="g-water" type="checkbox" class="accent-sky-600" /> <span data-i18n="mapWater">Wasser</span></label>
      <label data-feature="zones" class="inline-flex items-center gap-1.5" data-i18n-title="mapZonesTitle" title="Permakultur-Zonen um das Haus und Sektoren (Sonne, Wind, Kaltluft)"><input id="g-zones" type="checkbox" class="accent-amber-600" /> <span data-i18n="mapZones">Zonen &amp; Sektoren</span></label>
      <span id="map-status" class="text-stone-500 dark:text-stone-400"></span>
      <span data-feature="terrain" id="terrain-info" class="text-stone-600 dark:text-stone-300"></span>
    </div>

    <!-- Einfacher Modus: drei Schritte (feature 'simple-guide', lib/features.ts) -->
    <ol id="guide-steps" data-feature="simple-guide" class="mb-4 flex flex-wrap gap-2 text-sm" data-i18n-aria-label="guideStepsLabel" aria-label="Schritte">
        <li><button type="button" data-step="1" data-state="todo" class="group inline-flex items-center gap-2 rounded-full bg-white dark:bg-stone-800 py-1 pl-1 pr-3.5 font-medium text-stone-500 dark:text-stone-400 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition data-[state=done]:text-stone-800 data-[state=now]:text-stone-900 data-[state=now]:ring-2 data-[state=now]:ring-amber-400 dark:data-[state=done]:text-stone-100 dark:data-[state=now]:text-white"><span class="guide-num flex h-7 w-7 items-center justify-center rounded-full bg-stone-200 dark:bg-stone-700 text-xs font-bold group-data-[state=done]:bg-green-700 group-data-[state=done]:text-white group-data-[state=now]:bg-amber-400 group-data-[state=now]:text-stone-900">1</span><span data-i18n="guideStep1">Fläche zeichnen</span></button></li>
        <li><button type="button" data-step="2" data-state="todo" class="group inline-flex items-center gap-2 rounded-full bg-white dark:bg-stone-800 py-1 pl-1 pr-3.5 font-medium text-stone-500 dark:text-stone-400 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition data-[state=done]:text-stone-800 data-[state=now]:text-stone-900 data-[state=now]:ring-2 data-[state=now]:ring-amber-400 dark:data-[state=done]:text-stone-100 dark:data-[state=now]:text-white"><span class="guide-num flex h-7 w-7 items-center justify-center rounded-full bg-stone-200 dark:bg-stone-700 text-xs font-bold group-data-[state=done]:bg-green-700 group-data-[state=done]:text-white group-data-[state=now]:bg-amber-400 group-data-[state=now]:text-stone-900">2</span><span data-i18n="guideStep2">Pflanzen setzen</span></button></li>
        <li><button type="button" data-step="3" data-state="todo" class="group inline-flex items-center gap-2 rounded-full bg-white dark:bg-stone-800 py-1 pl-1 pr-3.5 font-medium text-stone-500 dark:text-stone-400 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition data-[state=done]:text-stone-800 data-[state=now]:text-stone-900 data-[state=now]:ring-2 data-[state=now]:ring-amber-400 dark:data-[state=done]:text-stone-100 dark:data-[state=now]:text-white"><span class="guide-num flex h-7 w-7 items-center justify-center rounded-full bg-stone-200 dark:bg-stone-700 text-xs font-bold group-data-[state=done]:bg-green-700 group-data-[state=done]:text-white group-data-[state=now]:bg-amber-400 group-data-[state=now]:text-stone-900">3</span><span data-i18n="guideStep3">In 3D ansehen</span></button></li>
    </ol>

    <!-- Phase A: Grunddaten + Fläche zeichnen -->
    <div id="phase-a">
      <div class="grid gap-6 lg:grid-cols-3 2xl:grid-cols-4">
        <div class="lg:col-span-1 space-y-4">
          <div class="rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 space-y-3">
            <label class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelName">Name</span>
              <input id="g-name" type="text" data-i18n-placeholder="placeholderName" placeholder="z.B. Vorgarten Süd" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
            </label>
            <label class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelDescription">Beschreibung</span>
              <input id="g-description" type="text" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
            </label>
            <label data-feature="polyculture" class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelLinkedPolyculture">Bestehende Polykultur verknüpfen (optional)</span>
              <select id="g-polyculture" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none"></select>
            </label>
            <fieldset>
              <legend class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelDrawOn">Fläche zeichnen auf</legend>
              <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-stone-700 dark:text-stone-200">
                <label class="inline-flex items-center gap-1.5"><input type="radio" name="draw-mode" value="map" checked class="accent-green-600" /> <span data-i18n="drawOnMap">Karte</span></label>
                <label class="inline-flex items-center gap-1.5"><input type="radio" name="draw-mode" value="grid" class="accent-green-600" /> <span data-i18n="drawOnGrid">Raster (ohne Standort)</span></label>
              </div>
              <p id="size-from-map-hint" class="mt-1 text-[11px] text-stone-500 dark:text-stone-400" data-i18n="sizeFromMapHint">Größe und Ausrichtung ergeben sich aus der gezeichneten Fläche.</p>
            </fieldset>
            <div id="size-fields" class="hidden grid grid-cols-2 gap-3">
              <label class="block">
                <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelAreaWidth">Breite (m)</span>
                <input id="g-width" type="number" min="2" max="50" step="0.5" value="10" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
              </label>
              <label class="block">
                <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelAreaHeight">Tiefe (m)</span>
                <input id="g-height" type="number" min="2" max="50" step="0.5" value="10" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
              </label>
            </div>
            <label class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelGridSpacing">Rastergröße</span>
              <select id="g-grid-spacing" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none">
                <option value="0.5">0.5 m</option>
                <option value="1" selected>1 m</option>
                <option value="2">2 m</option>
              </select>
            </label>
            <label class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelNotes">Notizen</span>
              <textarea id="g-notes" rows="2" data-i18n-placeholder="placeholderNotes" placeholder="Standort, Boden, Beobachtungen…" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none"></textarea>
            </label>
            <button id="btn-start-drawing" data-i18n="btnStartDrawing" class="w-full rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow hover:bg-green-800">Fläche zeichnen starten</button>
          </div>
        </div>

        <div class="lg:col-span-2 2xl:col-span-3 space-y-3">
          <div id="drawing-hint" class="hidden text-sm text-stone-600 dark:text-stone-300">
            <span id="drawing-hint-text" data-i18n="hintDrawing">Klicke auf die Fläche, um Eckpunkte zu setzen (mind. 3).</span>
            <span id="vertex-count" class="ml-1 font-medium"></span>
          </div>
          <div id="drawing-wrap" class="relative hidden rounded-xl bg-white dark:bg-stone-800 p-3 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
            <svg id="drawing-svg" class="w-full touch-none" style="touch-action:none"></svg>
            <div aria-hidden="true" class="cursor-readout pointer-events-none absolute hidden rounded bg-stone-900/80 px-1.5 py-0.5 font-mono text-[11px] text-white"></div>
            <div class="basemap-attrib absolute bottom-3 right-3 z-10 hidden rounded-tl bg-white/80 px-1 text-[10px] text-stone-600"></div>
          </div>
          <div id="mapdraw-wrap" class="hidden space-y-2 rounded-xl bg-white dark:bg-stone-800 p-3 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
            <div class="flex flex-wrap items-center gap-2">
              <form id="mapdraw-search-form" class="flex min-w-0 flex-1 gap-2">
                <input id="mapdraw-query" type="search" data-i18n-placeholder="locateSearchPlaceholder" data-i18n-aria-label="locateSearchPlaceholder" aria-label="Adresse oder Ort suchen…" placeholder="Adresse oder Ort suchen…" class="min-w-0 flex-1 rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
                <button id="mapdraw-search-btn" type="submit" data-i18n="locateSearchBtn" class="rounded-md bg-green-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-green-800 disabled:opacity-50">Suchen</button>
              </form>
              <button id="mapdraw-mypos" type="button" data-i18n="locateMyPosition" class="rounded-md bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Mein Standort</button>
            </div>
            <p id="mapdraw-status" class="min-h-[1rem] truncate text-xs text-stone-500 dark:text-stone-400"></p>
            <div id="mapdraw-map" class="h-[60vh] w-full rounded-lg ring-1 ring-stone-200 dark:ring-stone-700"></div>
            <div class="flex flex-wrap items-center gap-3 text-xs">
              <label class="inline-flex items-center gap-1"><input type="radio" name="mapdraw-layer" value="osm" checked /> <span data-i18n="locateLayerOsm">Karte</span></label>
              <label class="inline-flex items-center gap-1" data-i18n-title="locateSatNote" title="Satellitenbild nur zur groben Orientierung (10 m pro Pixel)."><input type="radio" name="mapdraw-layer" value="sat" /> <span data-i18n="locateLayerSat">Satellit (grob, 10 m)</span></label>
              <label class="inline-flex items-center gap-1" data-i18n-title="locateOrthoNote" title="Amtliche Luftbilder (8–40 cm) der Länder bzw. von basemap.at, swisstopo, PDOK — wo vorhanden, sonst Satellit grob."><input type="radio" name="mapdraw-layer" value="ortho" /> <span data-i18n="locateLayerOrtho">Luftbild (amtlich)</span></label>
            </div>
          </div>
          <div id="drawing-controls" class="hidden flex flex-wrap gap-2">
            <button id="btn-undo-point" data-i18n="btnUndoPoint" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-700">Letzten Punkt entfernen</button>
            <button id="btn-clear-points" data-i18n="btnClearPoints" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-700">Neu beginnen</button>
            <button id="btn-finish-boundary" data-i18n="btnFinishBoundary" disabled class="rounded-lg bg-green-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-green-800 disabled:cursor-not-allowed disabled:opacity-40">Fläche abschließen</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Phase B: Platzierung + Wachstums-Schieberegler -->
    <div id="phase-b" class="hidden">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <label class="text-sm font-medium text-stone-600 dark:text-stone-300" for="g-years" data-i18n="labelYearsSincePlanting">Jahre seit Pflanzung</label>
          <input id="g-years" type="range" min="0" max="30" step="1" value="0" class="w-48" />
