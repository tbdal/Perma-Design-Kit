      <p class="text-xs text-stone-500 dark:text-stone-400" data-i18n="locateHint">Klicke auf die Karte, um die Ecke 0,0 (oben links im Plan) zu setzen. Ziehe den runden Griff an der Ecke oben rechts, um den Plan auszurichten – z. B. entlang eines Zauns.</p>
      <div class="flex flex-wrap items-center gap-2">
        <form id="locate-search-form" class="flex min-w-0 flex-1 gap-2">
          <input id="locate-query" type="search" data-i18n-placeholder="locateSearchPlaceholder" placeholder="Adresse oder Ort suchen…" class="min-w-0 flex-1 rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
          <button id="locate-search-btn" type="submit" data-i18n="locateSearchBtn" class="rounded-md bg-green-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-green-800 disabled:opacity-50">Suchen</button>
        </form>
        <button id="locate-mypos" type="button" data-i18n="locateMyPosition" class="rounded-md bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Mein Standort</button>
      </div>
      <p id="locate-status" class="min-h-[1rem] truncate text-xs text-stone-500 dark:text-stone-400"></p>
      <div id="locate-map" class="h-[55vh] w-full rounded-lg ring-1 ring-stone-200 dark:ring-stone-700"></div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
        <span class="inline-flex items-center gap-2">
          <label class="inline-flex items-center gap-1"><input type="radio" name="locate-layer" value="osm" checked /> <span data-i18n="locateLayerOsm">Karte</span></label>
          <label class="inline-flex items-center gap-1" data-i18n-title="locateSatNote" title="Satellitenbild nur zur groben Orientierung (10 m pro Pixel)."><input type="radio" name="locate-layer" value="sat" /> <span data-i18n="locateLayerSat">Satellit (grob, 10 m)</span></label>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span data-i18n="locateRotation">Drehung</span>
          <button type="button" data-rot-step="-15" class="rounded bg-stone-100 dark:bg-stone-700 px-1.5 py-0.5 ring-1 ring-stone-300 dark:ring-stone-600">−15°</button>
          <button type="button" data-rot-step="-1" class="rounded bg-stone-100 dark:bg-stone-700 px-1.5 py-0.5 ring-1 ring-stone-300 dark:ring-stone-600">−1°</button>
          <input id="locate-rot" type="range" data-i18n-aria-label="locateRotation" aria-label="Drehung" min="0" max="359" step="1" value="0" class="w-32" />
          <button type="button" data-rot-step="1" class="rounded bg-stone-100 dark:bg-stone-700 px-1.5 py-0.5 ring-1 ring-stone-300 dark:ring-stone-600">+1°</button>
          <button type="button" data-rot-step="15" class="rounded bg-stone-100 dark:bg-stone-700 px-1.5 py-0.5 ring-1 ring-stone-300 dark:ring-stone-600">+15°</button>
          <input id="locate-rot-num" type="number" data-i18n-aria-label="locateRotation" aria-label="Drehung" min="0" max="359" step="1" value="0" class="w-16 rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-1.5 py-0.5" />°
        </span>
      </div>
      <div class="flex flex-wrap justify-end gap-2 pt-1">
        <button id="locate-remove" type="button" hidden data-i18n="locateRemove" class="mr-auto text-xs font-medium text-stone-500 dark:text-stone-400 hover:text-red-600 dark:hover:text-red-400">Standort entfernen</button>
        <button id="locate-cancel" type="button" data-i18n="locateCancel" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Abbrechen</button>
        <button id="locate-apply" type="button" data-i18n="locateApply" class="rounded-lg bg-green-700 px-4 py-1.5 text-sm font-medium text-white shadow hover:bg-green-800 disabled:cursor-not-allowed disabled:opacity-40">Übernehmen</button>
      </div>
    </div>
  </dialog>
</Layout>

