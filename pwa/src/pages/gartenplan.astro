<script>
  import { getAllPlants, getAllPolycultures, getAllGardenPlans, saveGardenPlan, deleteGardenPlan, importPlants } from '../lib/db';
  import { normalizeGardenPlan } from '../lib/plant-normalize';
  import { displayName, displayCommonName } from '../lib/plant-name';
  import { LAST_PLAN_KEY, planViewKey, readPlanView, writePlanView, type PlanView } from '../lib/plan-view';
  import { neighborHints } from '../lib/neighbors';
  import { wayTo, arrived } from '../lib/field-mode';
  import { latLonToPlan } from '../lib/gartenplan-geo';
  import { ageAt, isPlanted, phaseLabel, phaseGroups, phaseOf, MAX_PHASE } from '../lib/phases';
  import { analyzeWater, roofRainM3, type WaterAnalysis } from '../lib/water';
  import { planYield, careTasks, buildIcs, type CareTask } from '../lib/yield-care';
  import { DEFAULT_ZONE_RADII, ZONE_COLORS, bearingVector, wedgePath, solsticeSectors } from '../lib/zones-sectors';
  import { fetchSiteClimate, notHardy, blossomFrostRisk, zoneLabel, doyLabel, plantZoneRange, COMPASS16, CLIMATE_ATTRIBUTION, type SiteClimate } from '../lib/site-climate';
  import { createEmptyGardenPlan, type GardenPlan, type GardenPlanPlacement, type GardenPlanPoint, type GardenPlanArea, type Polyculture, type PlantData } from '../lib/types';
  import { displayRadiusM } from '../lib/growth-model';
  import { deriveLayer, LAYER_STYLE, LAYER_I18N, type PlantLayer } from '../lib/plant-layer';
  import { blobPathD } from '../lib/blob-shape';
  import { pointInPolygon, formatMeters, polygonAreaM2, polygonPerimeterM, pointsAlongPolyline, nearestGridPoint, gridAngleAlongOutline, normalizeGridAngle } from '../lib/gartenplan-geometry';
  import { areasSvg, AREA_PALETTE, uiScale, polygonCentroid } from '../lib/gartenplan-render';
  import { planFromLatLngPolygon, planToLatLon } from '../lib/gartenplan-geo';
  import type { MapDrawer } from '../lib/gartenplan-mapdraw';
  import { basemapSvg, basemapAttribution, sourceForGeo, FALLBACK_ATTRIBUTION, basemapSvgInline } from '../lib/gartenplan-background';
  import { growPlanToFit } from '../lib/gartenplan-extent';
  import type { PlanRect } from '../lib/gartenplan-geo';
  import { compassLabel, sunPosition } from '../lib/sun-position';
  import { COVER_FUNCS, coverageGrid, coverageSummary, findGaps, suggestPlants, hasFunc, funcCount, influenceRadius, type CoverFunc } from '../lib/function-coverage';
  import { layoutPolyculture } from '../lib/polyculture-layout';
  import { shoppingRows, shoppingTotal, shoppingCsv, exportShoppingPDF, downloadText, type ShoppingLabels } from '../lib/plan-shopping';
  import { crowdingWarnings, shadeWarnings, grownOccluders, WARN_YEARS } from '../lib/plan-warnings';
  import { fetchBuildings, BUILDINGS_ATTRIBUTION, type Building } from '../lib/osm-buildings';
  import { sunSamples, sunHoursAt, sunClass, planOccluders, planCells, SEASON_DATES, type SunScene, type SunSample, type SunClass, type Occluder } from '../lib/sun-hours';
  import type { Scene3DLayer } from '../lib/gartenplan-3d';
  import { BOOL_FIELDS } from '../lib/plant-fields';
  import { orthoFor } from '../lib/ortho-sources';
  import { dgmFor, refineWithDgm } from '../lib/dgm';
  import { fetchElevationGrid, sampleGrid, gridRange, slopeInfo, contourSegments, contourInterval, TERRAIN_ATTRIBUTION, type ElevationGrid } from '../lib/terrain';
  import { plantDetailHtml } from '../lib/plant-detail';
  import { compatScore } from '../lib/compat';
  import { newId } from '../lib/id';
  import { featureOn, onFeaturesChange } from '../lib/ui-mode';
  import { providePageApi } from '../lib/expert-api';
  import { sortPlans, defaultDir, planAreaM2, PLAN_SORT_FIELDS, type PlanSortField, type SortDir } from '../lib/plan-list-sort';
  import { escapeHtml, withButtonSpinner } from '../lib/html';
  import { exportGardenPlanPDF, planFitsPaper, type PlanPaper } from '../lib/pdf-export';
  import { createT, applyStaticI18n, getLang } from '../lib/i18n/core';
  import { searchDict } from '../lib/i18n/dict-search';
  import { initPlantSearchUi } from '../lib/plant-search-ui';
  import { gartenplanDict } from '../lib/i18n/dict-gartenplan';
  import { plantDetailDict } from '../lib/i18n/dict-plant-detail';

  const t = createT(gartenplanDict, plantDetailDict);
  applyStaticI18n(gartenplanDict, plantDetailDict, searchDict);

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const SVG_UNITS_PER_METER = 100;
  const SNAP_TOLERANCE_PX = 12;

  // ── DOM refs ────────────────────────────────────────────────────────────
  const listView = document.getElementById('plan-list-view')!;
  const editorView = document.getElementById('plan-editor-view')!;
  const listEl = document.getElementById('plan-list')!;
  const emptyEl = document.getElementById('plan-empty')!;
  const toast = document.getElementById('toast')!;

  const phaseA = document.getElementById('phase-a')!;
  const phaseB = document.getElementById('phase-b')!;

  const fName = document.getElementById('g-name') as HTMLInputElement;
  const fDescription = document.getElementById('g-description') as HTMLInputElement;
  const fPolyculture = document.getElementById('g-polyculture') as HTMLSelectElement;
  const fWidth = document.getElementById('g-width') as HTMLInputElement;
  const fHeight = document.getElementById('g-height') as HTMLInputElement;
  const fGridSpacing = document.getElementById('g-grid-spacing') as HTMLSelectElement;
  const fNotes = document.getElementById('g-notes') as HTMLTextAreaElement;

  const drawingHint = document.getElementById('drawing-hint')!;
  const drawingWrap = document.getElementById('drawing-wrap')!;
  const drawingSvg = document.getElementById('drawing-svg') as unknown as SVGSVGElement;
  const drawingControls = document.getElementById('drawing-controls')!;
  const vertexCountEl = document.getElementById('vertex-count')!;
  const btnStartDrawing = document.getElementById('btn-start-drawing') as HTMLButtonElement;
  const btnFinishBoundary = document.getElementById('btn-finish-boundary') as HTMLButtonElement;

  const planSvg = document.getElementById('plan-svg') as unknown as SVGSVGElement;

  let canvasRectCache: { width: number; height: number } | null = null;   // see canvasRect()
  const plan3dContainer = document.getElementById('plan-3d-container') as HTMLDivElement;
  const btnView2d = document.getElementById('btn-view-2d') as HTMLButtonElement;
  const btnView3d = document.getElementById('btn-view-3d') as HTMLButtonElement;
  const yearsInput = document.getElementById('g-years') as HTMLInputElement;
  const yearsLabel = document.getElementById('years-label')!;
  const pickerFilter = document.getElementById('picker-filter') as HTMLInputElement;
  const plantPickerEl = document.getElementById('plant-picker')!;
  const armedHint = document.getElementById('armed-hint')!;
  const unplacedSection = document.getElementById('unplaced-section')!;
  const unplacedListEl = document.getElementById('unplaced-list')!;
  const suggestionsSection = document.getElementById('suggestions-section')!;
  const suggestionsListEl = document.getElementById('suggestions-list')!;
  const selectedPanel = document.getElementById('selected-panel')!;
  const btnLocate = document.getElementById('btn-locate') as HTMLButtonElement;

  /** Map-bar switches that need a location (Gebäude, Höhenlinien, Wasser):
   *  without one they stay visible but greyed out — a hidden switch left
   *  people wondering where the feature went — and a click offers to set
   *  the location. */
  function geoGate(label: HTMLElement, hasGeo: boolean) {
    const input = label.querySelector('input') as HTMLInputElement;
    if (label.dataset.title === undefined) label.dataset.title = label.title;
    label.hidden = false;
    input.disabled = !hasGeo;
    label.classList.toggle('opacity-50', !hasGeo);
    label.classList.toggle('cursor-help', !hasGeo);
    label.title = hasGeo ? label.dataset.title : t('needsLocation');
    if (!label.dataset.gated) {
      label.dataset.gated = '1';
      label.addEventListener('click', (e) => {
        if (!input.disabled) return;
        e.preventDefault();
        if (!btnLocate.hidden) btnLocate.click();
        else showToast(t('needsLocation'));
      });
    }
  }
  const fBasemap = document.getElementById('g-basemap') as HTMLSelectElement;
  const fBasemapOpacity = document.getElementById('g-basemap-opacity') as HTMLInputElement;
  const fBasemapOrtho = document.getElementById('g-basemap-ortho') as HTMLOptionElement;
  const mapStatus = document.getElementById('map-status')!;
  const mapBar = document.getElementById('map-bar')!;
  const drawModeRadios = document.querySelectorAll<HTMLInputElement>('input[name="draw-mode"]');
  const sizeFields = document.getElementById('size-fields')!;
  const sizeFromMapHint = document.getElementById('size-from-map-hint')!;
  const drawingHintText = document.getElementById('drawing-hint-text')!;
  const mapdrawWrap = document.getElementById('mapdraw-wrap')!;
  const mapdrawMapEl = document.getElementById('mapdraw-map')!;
  const btnDrawArea = document.getElementById('btn-draw-area') as HTMLButtonElement;
  const areaDrawBar = document.getElementById('area-draw-bar')!;
  const btnAreaFinish = document.getElementById('btn-area-finish') as HTMLButtonElement;
  const areasList = document.getElementById('areas-list')!;
  const areasEmpty = document.getElementById('areas-empty')!;
  const areaEditHint = document.getElementById('area-edit-hint')!;
  const zoomControls = document.getElementById('zoom-controls')!;
  const btnEditBoundary = document.getElementById('btn-edit-boundary') as HTMLButtonElement;
  const boundaryEditBar = document.getElementById('boundary-edit-bar')!;
  const lang = getLang();

  // ── State ───────────────────────────────────────────────────────────────
  let plants: PlantData[] = [];
  let plantsById = new Map<string, PlantData>();
  let polycultures: Polyculture[] = [];
  let polyculturesById = new Map<string, Polyculture>();
  let plans: GardenPlan[] = [];
  let editing: GardenPlan | null = null;

  let drawingPoints: GardenPlanPoint[] = [];
  let armedPlantId: string | null = null;
  let unplacedPlantIds: string[] = []; // page-local — not persisted structurally
  let selectedPlacementId: string | null = null;
  let view3d: import('../lib/gartenplan-3d').GardenPlan3DView | null = null;
  let markerMap = new Map<string, SVGGElement>();

  // ── Autosave ────────────────────────────────────────────────────────────
  // Saving previously only happened on an explicit "Speichern" click, so a
  // reload/crash/accidental tab-close mid-edit silently lost the drawn
  // boundary or any placed plants. Debounced so rapid mutations (dragging a
  // plant, moving the years slider) don't hammer IndexedDB on every event.
  // LAST_PLAN_KEY: from lib/plan-view (also set by the share import).
  let autosaveTimer: ReturnType<typeof setTimeout> | null = null;
  function scheduleAutosave() {
    if (!editing) return;
    if (autosaveTimer) clearTimeout(autosaveTimer);
    const plan = editing;
    autosaveTimer = setTimeout(async () => {
      plan.updatedAt = new Date().toISOString();
      await saveGardenPlan(plan);
    }, 500);
    if (!restoringHistory) scheduleHistory();
    scheduleWarnings();
  }

  // ── Rückgängig / Wiederholen ───────────────────────────────────────────
  // Every edit already ends in scheduleAutosave(), so that is where states
  // are recorded: a JSON snapshot of the plan (without updatedAt), debounced
  // so a drag or a slider move becomes one step. Undo/redo write the snapshot
  // back into the same plan object (it is shared with `plans`) and re-render.
  const HISTORY_MAX = 100;
  let history: string[] = [];
  let historyIndex = -1;
  let historyTimer: ReturnType<typeof setTimeout> | null = null;
  let restoringHistory = false;
  const btnUndo = document.getElementById('btn-undo') as HTMLButtonElement;
  const btnRedo = document.getElementById('btn-redo') as HTMLButtonElement;

  function planSnapshot(): string {
    const { updatedAt: _u, ...rest } = editing!;
    return JSON.stringify(rest);
  }
  function syncUndoButtons() {
    btnUndo.disabled = historyIndex <= 0;
    btnRedo.disabled = historyIndex >= history.length - 1;
  }
  function resetHistory() {
    if (historyTimer) clearTimeout(historyTimer);
    historyTimer = null;
    history = editing ? [planSnapshot()] : [];
    historyIndex = history.length - 1;
    syncUndoButtons();
  }
  function scheduleHistory() {
    if (historyTimer) clearTimeout(historyTimer);
    historyTimer = setTimeout(recordHistory, 400);
  }
  function recordHistory() {
    historyTimer = null;
    if (!editing || historyIndex < 0) return;
    const snap = planSnapshot();
    if (snap === history[historyIndex]) return;
    history = history.slice(0, historyIndex + 1);
    history.push(snap);
    if (history.length > HISTORY_MAX) history.shift();
    historyIndex = history.length - 1;
    syncUndoButtons();
  }
  function stepHistory(dir: -1 | 1) {
    if (!editing || phaseB.classList.contains('hidden')) return;
    if (historyTimer) { clearTimeout(historyTimer); recordHistory(); } // pending edit first
    const target = historyIndex + dir;
    if (target < 0 || target >= history.length) return;
    historyIndex = target;
    const prev = editing;
    const before = { geo: JSON.stringify(prev.geo), w: prev.areaWidthM, h: prev.areaHeightM };
    const data = JSON.parse(history[historyIndex]) as GardenPlan;
    for (const k of Object.keys(prev) as (keyof GardenPlan)[]) if (k !== 'updatedAt' && !(k in data)) delete (prev as any)[k];
    Object.assign(prev, data);
    // Drop selections / tools that point at things which no longer exist.
    endAreaDraw();
    endRowDraw();
    if (editBoundary) setBoundaryEdit(false);
    if (selectedPlacementId && !prev.placements.some(p => p.id === selectedPlacementId)) selectedPlacementId = null;
    if (selectedAreaId && !(prev.areas ?? []).some(a => a.id === selectedAreaId)) selectedAreaId = null;
    for (const id of [...multiSel]) if (!prev.placements.some(p => p.id === id)) multiSel.delete(id);
    yearsInput.value = String(prev.yearsSincePlanting);
    yearsLabel.textContent = t('yearsSuffix', { years: prev.yearsSincePlanting });
    gridRotInput.value = String(prev.gridRotationDeg ?? 0);
    syncMapBar();
    renderAreasList();
    renderUnplacedList();
    renderSuggestions();
    renderSelectedPanel();
    renderPlanSvg();
    if (!plan3dContainer.hidden) btnView3d.click(); // rebuild 3D, camera kept
    if (before.geo !== JSON.stringify(prev.geo) || before.w !== prev.areaWidthM || before.h !== prev.areaHeightM) { void loadTerrain(); void loadBuildings(); }
    restoringHistory = true;
    scheduleAutosave();
    restoringHistory = false;
    syncUndoButtons();
  }
  btnUndo.addEventListener('click', () => stepHistory(-1));
  btnRedo.addEventListener('click', () => stepHistory(1));

  function showToast(msg: string) {
    toast.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 2000);
  }

  function plantLabel(p: PlantData | undefined): string {
    if (!p) return '—';
    const cn = displayCommonName(p);
    const label = cn ? `${cn} (${p.latinName})` : p.latinName || '—';
    return escapeHtml(label);
  }

  // ── Geometry helpers ────────────────────────────────────────────────────
  function clientToMeters(svg: SVGSVGElement, clientX: number, clientY: number): GardenPlanPoint {
    const pt = svg.createSVGPoint();
    pt.x = clientX; pt.y = clientY;
    const inv = svg.getScreenCTM()!.inverse();
    const p = pt.matrixTransform(inv);
    return { xM: p.x / SVG_UNITS_PER_METER, yM: p.y / SVG_UNITS_PER_METER };
  }

  function snapIfClose(svg: SVGSVGElement, pt: GardenPlanPoint, spacingM: number): GardenPlanPoint {
    const ctm = svg.getScreenCTM();
    if (!ctm) return pt;
    const screenPxPerSvgUnit = Math.sqrt(ctm.a * ctm.a + ctm.b * ctm.b);
    const toleranceM = (SNAP_TOLERANCE_PX / screenPxPerSvgUnit) / SVG_UNITS_PER_METER;
    const near = nearestGridPoint(pt, spacingM, editing?.gridRotationDeg ?? 0);
    const dist = Math.hypot(pt.xM - near.xM, pt.yM - near.yM);
    return dist <= toleranceM ? near : pt;
  }

  /** Ray-casting point-in-polygon test, coordinates in meters. */
  /** Meter tick labels along the top (X) and left (Y) edge of the grid, one
   *  per grid line — so a drawn area's real-world size is readable at a
   *  glance instead of having to count squares. `pointer-events="none"` on
   *  the whole label group keeps them from intercepting clicks/drags meant
   *  for the grid rect beneath (placing plants, drawing the boundary). */
  /** Smallest "nice" multiple (1, 2, 5, 10, 20, 50 …) of `base` that is at
   *  least `minM` — keeps grid lines and meter numbers readable at any zoom. */
  function niceStep(base: number, minM: number): number {
    for (const m of [1, 2, 5, 10, 20, 50, 100, 200, 500, 1000]) if (base * m >= minM) return base * m;
    return base * 1000;
  }

  function gridTickLabels(widthM: number, heightM: number, spacingM: number, k = 1): string {
    const round2 = (n: number) => Math.round(n * 100) / 100;
    const xSteps = Math.floor(widthM / spacingM);
    const ySteps = Math.floor(heightM / spacingM);
    const labels: string[] = [];
    for (let i = 1; i <= xSteps; i++) {
      const m = round2(i * spacingM);
      const x = m * SVG_UNITS_PER_METER;
      labels.push(`<text x="${x}" y="${11 * k}" font-size="${9 * k}" fill="#a8a29e" text-anchor="middle">${m}</text>`);
    }
    for (let i = 1; i <= ySteps; i++) {
      const m = round2(i * spacingM);
      const y = m * SVG_UNITS_PER_METER;
      labels.push(`<text x="${3 * k}" y="${y + 9 * k}" font-size="${9 * k}" fill="#a8a29e" text-anchor="start">${m}</text>`);
    }
    return `<g pointer-events="none">${labels.join('')}</g>`;
  }

  // "Meterlinien" checkbox: hides the grid lines (the meter numbers along
  // the edges and the outline stay), e.g. to see the aerial photo clearly.
  const gridInput = document.getElementById('g-grid') as HTMLInputElement;
  try { gridInput.checked = localStorage.getItem('pgd-grid') !== '0'; } catch {}
  gridInput.addEventListener('change', () => {
    try { localStorage.setItem('pgd-grid', gridInput.checked ? '1' : '0'); } catch {}
    if (editing) rescaleUi();
    renderDrawingSvg();
    refreshBasemaps();
  });

  // Turned grid ("Meterlinien drehen"): only the lines turn, the plan stays.
  const gridRotInput = document.getElementById('g-grid-rot') as HTMLInputElement;
  function setGridRotation(deg: number) {
    if (!editing) return;
    const a = normalizeGridAngle(deg);
    if (a) editing.gridRotationDeg = a; else delete editing.gridRotationDeg;
    gridRotInput.value = String(a);
    rescaleUi();
    scheduleAutosave();
  }
  gridRotInput.addEventListener('change', () => setGridRotation(Number(gridRotInput.value) || 0));
  document.getElementById('btn-grid-align')!.addEventListener('click', () => {
    if (editing) setGridRotation(gridAngleAlongOutline(editing.boundary));
  });

  function gridDefsAndBackground(widthM: number, heightM: number, spacingM: number, patternId: string, k = 1, pxPerM = 0, rotationDeg = 0, outline: GardenPlanPoint[] = []): string {
    // Zoomed out, the grid would turn into a carpet of lines and the meter
    // numbers into solid bars: thin both out to ≥ 12 px / ≥ 40 px apart.
    const labelStepM = pxPerM ? niceStep(spacingM, 40 / pxPerM) : spacingM;
    spacingM = pxPerM ? niceStep(spacingM, 12 / pxPerM) : spacingM;
    const spacingU = spacingM * SVG_UNITS_PER_METER;
    const clipped = outline.length >= 3;
    return `
      <defs>
        <pattern id="${patternId}" width="${spacingU}" height="${spacingU}" patternUnits="userSpaceOnUse"${rotationDeg ? ` patternTransform="rotate(${rotationDeg})"` : ''}>
          <path d="M ${spacingU} 0 L 0 0 0 ${spacingU}" fill="none" stroke="#d6d3d1" stroke-width="${k}"/>
        </pattern>
        ${clipped ? `<clipPath id="${patternId}-clip"><polygon points="${outline.map(p => `${p.xM * SVG_UNITS_PER_METER},${p.yM * SVG_UNITS_PER_METER}`).join(' ')}"/></clipPath>` : ''}
      </defs>
      ${clipped
        // Grid lines only inside the drawn outline; the frame around it just takes clicks.
        ? `<rect width="${widthM * SVG_UNITS_PER_METER}" height="${heightM * SVG_UNITS_PER_METER}" fill="transparent"/>
           ${gridInput.checked ? `<rect width="${widthM * SVG_UNITS_PER_METER}" height="${heightM * SVG_UNITS_PER_METER}" fill="url(#${patternId})" clip-path="url(#${patternId}-clip)"/>` : ''}`
        : `<rect width="${widthM * SVG_UNITS_PER_METER}" height="${heightM * SVG_UNITS_PER_METER}" fill="${gridInput.checked ? `url(#${patternId})` : 'transparent'}" stroke="#a8a29e" stroke-width="${2 * k}"/>`}
      ${rotationDeg ? '' : gridTickLabels(widthM, heightM, labelStepM, k)}`;
  }

  // ── Listenansicht ──────────────────────────────────────────────────────
  // Sorting of the project list (lib/plan-list-sort.ts), kept per device.
  const PLAN_SORT_KEY = 'pdk-plan-sort';
  const sortBar = document.getElementById('plan-sort-bar')!;
  const sortFieldSel = document.getElementById('plan-sort-field') as HTMLSelectElement;
  const sortDirBtn = document.getElementById('plan-sort-dir') as HTMLButtonElement;
  let planSort: { field: PlanSortField; dir: SortDir } = { field: 'created', dir: 'desc' };
  try {
    const saved = JSON.parse(localStorage.getItem(PLAN_SORT_KEY) || 'null');
    if (saved && PLAN_SORT_FIELDS.includes(saved.field) && (saved.dir === 'asc' || saved.dir === 'desc')) planSort = saved;
  } catch { /* ignore */ }
  function syncSortUi() {
    sortFieldSel.value = planSort.field;
    sortDirBtn.textContent = planSort.dir === 'asc' ? '↑' : '↓';
    try { localStorage.setItem(PLAN_SORT_KEY, JSON.stringify(planSort)); } catch { /* ignore */ }
  }
  sortFieldSel.addEventListener('change', () => {
    const field = sortFieldSel.value as PlanSortField;
    planSort = { field, dir: defaultDir(field) };
    syncSortUi();
    renderList();
  });
  sortDirBtn.addEventListener('click', () => {
    planSort = { ...planSort, dir: planSort.dir === 'asc' ? 'desc' : 'asc' };
    syncSortUi();
    renderList();
  });
  syncSortUi();
  const fmtDate = (iso?: string) => {
    const d = iso ? new Date(iso) : null;
    return d && !isNaN(+d) ? new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric' }).format(d) : '';
  };

  function renderList() {
    sortBar.hidden = plans.length < 2;
    if (plans.length === 0) {
      emptyEl.classList.remove('hidden');
      listEl.classList.add('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    listEl.classList.remove('hidden');
    listEl.innerHTML = sortPlans(plans, planSort.field, planSort.dir, lang).map(plan => {
      const poly = plan.polycultureId ? polyculturesById.get(plan.polycultureId) : undefined;
      return `
        <article data-plan-id="${plan.id}" class="flex cursor-pointer items-start gap-3 rounded-xl bg-white dark:bg-stone-800 p-4 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition hover:ring-green-300 dark:hover:ring-green-700">
          <div class="min-w-0 flex-1">
            <h3 class="text-base font-semibold text-stone-900 dark:text-stone-100">${escapeHtml(plan.name || t('planUnnamed'))}</h3>
            ${plan.description ? `<p class="mt-0.5 text-xs text-stone-500 dark:text-stone-400">${escapeHtml(plan.description)}</p>` : ''}
            ${poly ? `<p class="mt-2 text-xs text-stone-500 dark:text-stone-400">${t('linkedPolycultureLabel')} ${escapeHtml(poly.name || '—')}</p>` : ''}
            <p class="mt-2 text-sm text-stone-700 dark:text-stone-200">${t('placementCount', { count: plan.placements.length })}</p>
            <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">${t('areaSizeLabel', { w: plan.areaWidthM, h: plan.areaHeightM })} · ${new Intl.NumberFormat(lang, { maximumFractionDigits: 0 }).format(planAreaM2(plan))} m²</p>
            ${plan.updatedAt || plan.createdAt ? `<p class="mt-1 text-[11px] text-stone-400 dark:text-stone-500">${escapeHtml(t('planDates', { created: fmtDate(plan.createdAt), updated: fmtDate(plan.updatedAt || plan.createdAt) }))}</p>` : ''}
          </div>
          <div class="flex w-32 shrink-0 flex-col gap-1.5">
            <button type="button" data-plan-action="rename" class="w-full rounded-md px-2.5 py-1 text-left text-xs font-medium bg-stone-50 dark:bg-stone-700/60 text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700">✎ ${escapeHtml(t('planRename'))}</button>
            <button type="button" data-plan-action="duplicate" class="w-full rounded-md px-2.5 py-1 text-left text-xs font-medium bg-stone-50 dark:bg-stone-700/60 text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700">⧉ ${escapeHtml(t('planDuplicate'))}</button>
            <button type="button" data-plan-action="delete" class="w-full rounded-md px-2.5 py-1 text-left text-xs font-medium bg-red-600 text-white shadow-sm hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600">🗑 ${escapeHtml(t('planDelete'))}</button>
          </div>
        </article>`;
    }).join('');
    listEl.querySelectorAll<HTMLElement>('[data-plan-id]').forEach(el => {
      el.addEventListener('click', (e) => {
        const action = (e.target as HTMLElement).closest<HTMLElement>('[data-plan-action]')?.dataset.planAction;
        if (action) { e.stopPropagation(); void planTileAction(el.dataset.planId!, action); return; }
        openEditor(el.dataset.planId!);
      });
    });
  }

  /** Rename / duplicate / delete straight from a project tile. */
  async function planTileAction(id: string, action: string) {
    const plan = plans.find(p => p.id === id);
    if (!plan) return;
    const name = plan.name || t('planUnnamed');
    if (action === 'rename') {
      const next = prompt(t('planRenamePrompt'), plan.name);
      if (next === null || !next.trim() || next.trim() === plan.name) return;   // cancelled, empty or unchanged
      plan.name = next.trim();
      plan.updatedAt = new Date().toISOString();
      await saveGardenPlan(plan);
    } else if (action === 'duplicate') {
      const now = new Date().toISOString();
      const copy: GardenPlan = { ...structuredClone(plan), id: newId(), name: t('planCopyName', { name }), createdAt: now, updatedAt: now };
      await saveGardenPlan(copy);
      const view = readPlanView(plan.id);
      if (view) writePlanView(copy.id, view);   // same map section / 3D camera
      showToast(t('toastPlanDuplicated', { name: copy.name }));
    } else if (action === 'delete') {
      if (!confirm(t('confirmDeletePlan', { name }))) return;
      await deleteGardenPlan(id);
      try { localStorage.removeItem(planViewKey(id)); } catch { /* ignore */ }
      showToast(t('toastPlanDeleted'));
    } else return;
    plans = await getAllGardenPlans();
    renderList();
  }

  // ── Editor ─────────────────────────────────────────────────────────────
  function openEditor(id: string | null) {
    view3d?.dispose();
    view3d = null;
    plan3dContainer.hidden = true;
    planSvg.classList.remove('hidden');
    canvasRectCache = null;
    setViewToggleActive(true);

    editing = id ? (plans.find(p => p.id === id) ?? createEmptyGardenPlan()) : createEmptyGardenPlan();
    editing.geo ??= null; // plans saved before the map feature have no geo field
    editing.areas ??= [];
    drawingPoints = [];
    destroyMapDrawer();
    endAreaDraw();
    selectedAreaId = null;
    // Unlocated plans that were already drawn on the grid keep the grid when
    // redrawn; everything else starts on the map.
    setDrawMode(editing.geo || editing.boundary.length === 0 ? 'map' : 'grid');
    armedPlantId = null;
    unplacedPlantIds = [];
    selectedPlacementId = null;
    try { localStorage.setItem(LAST_PLAN_KEY, editing.id); } catch {}

    fName.value = editing.name;
    fDescription.value = editing.description;
    fNotes.value = editing.notes;
    fWidth.value = String(editing.areaWidthM);
    fHeight.value = String(editing.areaHeightM);
    fGridSpacing.value = String(editing.gridSpacingM);
    gridRotInput.value = String(editing.gridRotationDeg ?? 0);
    syncMapBar();
    fPolyculture.innerHTML = `<option value="">${t('linkedPolycultureNone')}</option>` + polycultures
      .map(pc => `<option value="${pc.id}" ${pc.id === editing!.polycultureId ? 'selected' : ''}>${escapeHtml(pc.name || t('planUnnamed'))}</option>`)
      .join('');

    const lockInputs = editing.boundary.length > 0;
    [fWidth, fHeight, fGridSpacing, ...drawModeRadios].forEach(el => { el.disabled = lockInputs; });
    btnStartDrawing.classList.toggle('hidden', lockInputs);
    drawingHint.classList.add('hidden');
    drawingWrap.classList.add('hidden');
    mapdrawWrap.classList.add('hidden');
    drawingControls.classList.add('hidden');
    mapBar.classList.add('hidden');

    listView.hidden = true;
    editorView.hidden = false;
    requestAnimationFrame(fitPlanHeight);
    if (editing.boundary.length > 0) {
      enterPhaseB();
    } else {
      phaseA.classList.remove('hidden');
      phaseB.classList.add('hidden');
      showDrawingUi();
    }
    renderSimpleGuide();
    window.scrollTo({ top: 0 });
  }

  function closeEditor() {
    saveViewState();
    stopSunPlay();
    destroyMapDrawer();
    endAreaDraw();
    setBoundaryEdit(false);
    view3d?.dispose();
    view3d = null;
    editing = null;
    listView.hidden = false;
    editorView.hidden = true;
    try { localStorage.removeItem(LAST_PLAN_KEY); } catch {}
    notifyPlanChange();
  }

  // ── Karte: Standort, Ausrichtung, Hintergrund ───────────────────────────
  // The map only sits *under* the plan: tiles are rendered into each SVG's
  // .basemap-layer group (gartenplan-background.ts), rotated by geo.rotationDeg,
  // while grid, boundary and placements stay in plain plan meters.
  function renderBasemap(svg: SVGSVGElement) {
    if (!editing) return;
    const layer = svg.querySelector('.basemap-layer');
    if (!layer) return;
    // Phase A (grid) draws with the not yet committed form dimensions; the
    // plan canvas covers whatever is visible after zoom/pan.
    const isPlan = svg === planSvg;
    const plan = isPlan ? editing : { ...editing, areaWidthM: areaWidthM(), areaHeightM: areaHeightM() };
    const view = isPlan ? viewRectM() : { minX: 0, minY: 0, maxX: plan.areaWidthM, maxY: plan.areaHeightM };
    const px = svg.getBoundingClientRect().width;
    const mPerPx = px > 0 ? (view.maxX - view.minX) / px / (window.devicePixelRatio || 1) : 0.02;
    layer.innerHTML = basemapSvg(plan, view, mPerPx);
    updateAttribution(svg);
  }

  // An aerial-photo service that doesn't answer (e.g. 403/500): its tiles are
  // swapped for coarse satellite / OSM (data-fallback, see basemapSvg) and the
  // user is told once per plan.
  let orthoFallbackUsed = false;
  let orthoFallbackNotified = '';
  function noteOrthoFallback() {
    orthoFallbackUsed = true;
    const src = sourceForGeo(editing?.geo);
    const key = editing?.id ?? '';
    if (orthoFallbackNotified !== key) {
      orthoFallbackNotified = key;
      showToast(t('orthoUnavailable', { region: src?.region?.[lang] ?? '' }));
      updateAttribution(planSvg);
    }
  }
  [planSvg, drawingSvg].forEach(svg => svg.addEventListener('error', e => {
    const img = e.target as SVGImageElement;
    const fb = img?.getAttribute?.('data-fallback');
    if (!fb) return;
    img.removeAttribute('data-fallback');
    img.setAttribute('href', fb);
    noteOrthoFallback();
  }, true));

  /** Source credits (map / aerial photo / satellite, elevation) — required by
   *  the licenses, so shown whenever such data is on screen, in 2D and 3D. */
  function updateAttribution(svg: SVGSVGElement) {
    if (!editing) return;
    const isPlan = svg === planSvg;
    const attrib = svg.parentElement!.querySelector<HTMLElement>('.basemap-attrib')!;
    const tilesAttr = terrain ? `${TERRAIN_ATTRIBUTION}${terrain.sources.length ? ` (${escapeHtml(terrain.sources.join(', '))})` : ''}` : '';
    const terrainAttr = isPlan && terrain ? [terrain.dgm?.attributionHtml, tilesAttr].filter(Boolean).join(' · ') : '';
    const bAttr = isPlan && showBuildings() && !basemapAttribution(editing).includes('OpenStreetMap') ? BUILDINGS_ATTRIBUTION : '';
    const fbAttr = orthoFallbackUsed ? FALLBACK_ATTRIBUTION : '';
    const climAttr = isPlan && siteClimate && siteClimateKey === climateKeyOf(editing) ? CLIMATE_ATTRIBUTION : '';
    attrib.innerHTML = [basemapAttribution(editing), fbAttr, bAttr, terrainAttr, climAttr].filter(Boolean).join(' · ');
    attrib.classList.toggle('hidden', !attrib.innerHTML);
  }

  function refreshBasemaps() {
    renderBasemap(planSvg);
    renderBasemap(drawingSvg);
  }

  function syncMapBar() {
    const geo = editing?.geo ?? null;
    fBasemap.disabled = !geo;
    fBasemapOpacity.disabled = !geo;
    fBasemap.value = geo?.basemap ?? 'none';
    // Name the service the aerial photo comes from (or that there is none).
    const ortho = geo ? orthoFor(geo.lat, geo.lon) : null;
    fBasemapOrtho.textContent = ortho
      ? t('mapBgOrtho', { region: ortho.region[lang], cm: ortho.resolutionCm })
      : t(geo ? 'mapBgOrthoNone' : 'mapBgOrthoGeneric');
    fBasemapOpacity.value = String(geo?.opacity ?? 0.6);
    mapStatus.textContent = !geo ? t('mapStatusNone')
      : geo.rotationDeg === 0 ? t('mapStatusDrawn')
      : t('mapStatusSet', { deg: Math.round(geo.rotationDeg) });
    // Locating afterwards (incl. rotating) is only needed for plans drawn on
    // the plain grid; map-drawn plans are north-up and anchored already.
    btnLocate.hidden = !!geo && geo.rotationDeg === 0;
  }

  btnLocate.addEventListener('click', async () => {
    if (!editing) return;
    const { openLocateDialog } = await import('../lib/gartenplan-locate');
    const inPhaseA = !phaseA.classList.contains('hidden');
    const res = await openLocateDialog({
      widthM: inPhaseA ? areaWidthM() : editing.areaWidthM,
      heightM: inPhaseA ? areaHeightM() : editing.areaHeightM,
      boundary: inPhaseA ? drawingPoints : editing.boundary,
      geo: editing.geo,
      lang,
      t,
    });
    if (!res || !editing) return;
    editing.geo = res.action === 'apply' ? res.geo : null;
    syncMapBar();
    refreshBasemaps();
    void loadTerrain();
    void loadBuildings();
    scheduleAutosave();
  });

  fBasemap.addEventListener('change', () => {
    if (!editing?.geo) return;
    const v = fBasemap.value;
    editing.geo.basemap = v === 'none' || v === 'sat' || v === 'ortho' ? v : 'osm';
    refreshBasemaps();
    if (!plan3dContainer.hidden) btnView3d.click(); // rebuild 3D ground, camera kept
    scheduleAutosave();
  });

  fBasemapOpacity.addEventListener('change', () => { if (!plan3dContainer.hidden) btnView3d.click(); });
  fBasemapOpacity.addEventListener('input', () => {
    if (!editing?.geo) return;
    editing.geo.opacity = Number(fBasemapOpacity.value);
    document.querySelectorAll('.basemap-layer > g').forEach(g => g.setAttribute('opacity', fBasemapOpacity.value));
    scheduleAutosave();
  });

  // Tile zoom follows the on-screen size of the canvas.
  let basemapResizeTimer: ReturnType<typeof setTimeout> | null = null;
  // and the view follows the canvas shape, so a new width/height (sidebar
  // folded, window resized) is filled with map instead of a blank strip.
  new ResizeObserver(() => {
    if (editing && planView.w && planSvg.getBoundingClientRect().width > 0) {
      const h = planView.w * canvasAspect();
      if (Math.abs(h - planView.h) > 1e-6) {
        planView = { ...planView, y: planView.y + planView.h / 2 - h / 2, h };
        planSvg.setAttribute('viewBox', `${planView.x} ${planView.y} ${planView.w} ${planView.h}`);
        if (!rescaleQueued) { rescaleQueued = true; requestAnimationFrame(rescaleUi); }
      }
    }
    if (basemapResizeTimer) clearTimeout(basemapResizeTimer);
    basemapResizeTimer = setTimeout(refreshBasemaps, 200);
  }).observe(planSvg);

  // ── Cursor position read-out (meters from 0,0) ─────────────────────────
  // Pointer capture during a marker drag retargets moves to the marker group,
  // which still bubble up to the SVG, so the read-out follows drags too.
  function wireCursorReadout(svg: SVGSVGElement) {
    const wrap = svg.parentElement!;
    const label = wrap.querySelector<HTMLElement>('.cursor-readout')!;
    const hide = () => label.classList.add('hidden');
    svg.addEventListener('pointermove', (e: PointerEvent) => {
      if (!svg.getScreenCTM()) return;
      const p = clientToMeters(svg, e.clientX, e.clientY);
      label.textContent = `x ${formatMeters(p.xM, lang)} · y ${formatMeters(p.yM, lang)}`;
      label.classList.remove('hidden');
      const r = wrap.getBoundingClientRect();
      let left = e.clientX - r.left + 14, top = e.clientY - r.top + 14;
      if (left + label.offsetWidth > r.width - 4) left = e.clientX - r.left - label.offsetWidth - 14;
      if (top + label.offsetHeight > r.height - 4) top = e.clientY - r.top - label.offsetHeight - 14;
      label.style.left = `${left}px`;
      label.style.top = `${top}px`;
    });
    svg.addEventListener('pointerleave', hide);
    svg.addEventListener('pointercancel', hide);
    svg.addEventListener('pointerup', (e: PointerEvent) => { if (e.pointerType !== 'mouse') hide(); });
  }
  wireCursorReadout(drawingSvg);
  wireCursorReadout(planSvg);

  // ── Phase A: Fläche zeichnen ────────────────────────────────────────────
  function areaWidthM(): number { return Math.max(2, Math.min(50, Number(fWidth.value) || 10)); }
  function areaHeightM(): number { return Math.max(2, Math.min(50, Number(fHeight.value) || 10)); }
  function gridSpacingM(): number { return Number(fGridSpacing.value) || 1; }

  function renderDrawingSvg() {
    const w = areaWidthM(), h = areaHeightM(), spacing = gridSpacingM();
    drawingSvg.setAttribute('viewBox', `0 0 ${w * SVG_UNITS_PER_METER} ${h * SVG_UNITS_PER_METER}`);
    const pointsAttr = drawingPoints.map(p => `${p.xM * SVG_UNITS_PER_METER},${p.yM * SVG_UNITS_PER_METER}`).join(' ');
    const markers = drawingPoints.map(p =>
      `<circle cx="${p.xM * SVG_UNITS_PER_METER}" cy="${p.yM * SVG_UNITS_PER_METER}" r="6" fill="#15803d"/>`
    ).join('');
    drawingSvg.innerHTML = `
      <g class="basemap-layer"></g>
      ${gridDefsAndBackground(w, h, spacing, 'drawing-grid', uiScale(w))}
      ${drawingPoints.length >= 2 ? `<polyline points="${pointsAttr}" fill="none" stroke="#15803d" stroke-width="3"/>` : ''}
      ${drawingPoints.length >= 3 ? `<polygon points="${pointsAttr}" fill="#15803d" fill-opacity="0.12" stroke="none"/>` : ''}
      ${markers}`;
    renderBasemap(drawingSvg);
    vertexCountEl.textContent = t('vertexCount', { count: drawingPoints.length });
    btnFinishBoundary.disabled = drawingPoints.length < 3;
  }

  // ── Zeichnen auf der Karte vs. auf dem Raster ──────────────────────────
  // Map mode: the boundary is clicked onto a Leaflet map (gartenplan-mapdraw.ts);
  // size, anchor and north-up orientation follow from the drawn corners, so
  // the width/depth fields are hidden. Grid mode keeps the old unlocated flow.
  const MAP_MARGIN_M = 1;
  let mapDrawer: MapDrawer | null = null;

  function drawMode(): 'map' | 'grid' {
    return [...drawModeRadios].find(r => r.checked)?.value === 'grid' ? 'grid' : 'map';
  }
  function setDrawMode(m: 'map' | 'grid') {
    drawModeRadios.forEach(r => { r.checked = r.value === m; });
    sizeFields.classList.toggle('hidden', m === 'map');
    sizeFromMapHint.classList.toggle('hidden', m === 'grid');
  }
  drawModeRadios.forEach(r => r.addEventListener('change', () => {
    setDrawMode(drawMode());
    if (editing && editing.boundary.length === 0) showDrawingUi();
  }));

  /** Phase A without a boundary yet: on the map, drawing starts right away
   *  (search, zoom, click corners); the grid still needs "Fläche zeichnen
   *  starten" because width/depth are chosen first. */
  function showDrawingUi() {
    if (drawMode() === 'map') { void startDrawing(); return; }
    destroyMapDrawer();
    mapdrawWrap.classList.add('hidden');
    drawingWrap.classList.add('hidden');
    drawingHint.classList.add('hidden');
    drawingControls.classList.add('hidden');
    btnStartDrawing.classList.remove('hidden');
  }

  function destroyMapDrawer() {
    mapDrawer?.destroy();
    mapDrawer = null;
  }

  function setVertexCount(n: number) {
    vertexCountEl.textContent = t('vertexCount', { count: n });
    btnFinishBoundary.disabled = n < 3;
  }

  async function startDrawing() {
    if (!editing) return;
    btnStartDrawing.classList.add('hidden');
    drawingHint.classList.remove('hidden');
    drawingControls.classList.remove('hidden');
    drawingPoints = [];
    if (drawMode() === 'map') {
      drawingWrap.classList.add('hidden');
      drawingHintText.textContent = t('hintDrawingMap');
      mapdrawWrap.classList.remove('hidden');
      setVertexCount(0);
      if (mapDrawer) { mapDrawer.clear(); mapDrawer.refresh(); return; }
      const geo = editing.geo;
      const center = geo ? planToLatLon({ xM: editing.areaWidthM / 2, yM: editing.areaHeightM / 2 }, geo) : null;
      const { createMapDrawer } = await import('../lib/gartenplan-mapdraw');
      if (mapDrawer || drawMode() !== 'map' || !editing) return; // changed meanwhile
      mapDrawer = createMapDrawer(mapdrawMapEl, { center, lang, t, onChange: setVertexCount, onClose: finishBoundary });
      requestAnimationFrame(() => mapDrawer?.refresh());
    } else {
      [fWidth, fHeight, fGridSpacing, ...drawModeRadios].forEach(el => { el.disabled = true; });
      destroyMapDrawer();
      mapdrawWrap.classList.add('hidden');
      drawingHintText.textContent = t('hintDrawing');
      drawingWrap.classList.remove('hidden');
      renderDrawingSvg();
    }
  }

  btnStartDrawing.addEventListener('click', () => {
    if (!fName.value.trim()) { alert(t('alertEnterName')); fName.focus(); return; }
    void startDrawing();
  });

  drawingSvg.addEventListener('pointerdown', (e: PointerEvent) => {
    const raw = clientToMeters(drawingSvg, e.clientX, e.clientY);
    const snapped = snapIfClose(drawingSvg, raw, gridSpacingM());
    const clamped: GardenPlanPoint = {
      xM: Math.max(0, Math.min(areaWidthM(), snapped.xM)),
      yM: Math.max(0, Math.min(areaHeightM(), snapped.yM)),
    };
    drawingPoints.push(clamped);
    renderDrawingSvg();
  });

  document.getElementById('btn-undo-point')!.addEventListener('click', () => {
    if (mapDrawer) { mapDrawer.undo(); return; }
    drawingPoints.pop();
    renderDrawingSvg();
  });
  document.getElementById('btn-clear-points')!.addEventListener('click', () => {
    if (mapDrawer) { mapDrawer.clear(); return; }
    drawingPoints = [];
    renderDrawingSvg();
  });

  function finishBoundary() {
    if (!editing) return;
    if (!fName.value.trim()) { alert(t('alertEnterName')); fName.focus(); return; }
    editing.gridSpacingM = gridSpacingM();
    if (mapDrawer) {
      const pts = mapDrawer.points();
      if (pts.length < 3) return;
      const r = planFromLatLngPolygon(pts, MAP_MARGIN_M, editing.gridSpacingM);
      if (r.widthM > 500 || r.heightM > 500) { alert(t('alertAreaTooLarge')); return; }
      editing.areaWidthM = r.widthM;
      editing.areaHeightM = r.heightM;
      editing.boundary = r.boundary;
      // Official aerial photo as background where one covers the garden.
      editing.geo = { ...r.geo, basemap: orthoFor(r.geo.lat, r.geo.lon) ? 'ortho' : 'osm', opacity: editing.geo?.opacity ?? 0.7 };
      fWidth.value = String(r.widthM);
      fHeight.value = String(r.heightM);
      destroyMapDrawer();
      mapdrawWrap.classList.add('hidden');
    } else {
      if (drawingPoints.length < 3) return;
      editing.areaWidthM = areaWidthM();
      editing.areaHeightM = areaHeightM();
      editing.boundary = drawingPoints.slice();
      editing.geo = null; // drawn without a location
    }
    syncMapBar();
    try { localStorage.removeItem(viewKey(editing.id)); } catch {} // new outline: start with the whole plan
    enterPhaseB();
  }
  btnFinishBoundary.addEventListener('click', finishBoundary);

  const VIEW_TOGGLE_ACTIVE_CLS = ['bg-white', 'dark:bg-stone-700', 'text-stone-800', 'dark:text-stone-100', 'shadow-sm'];
  const VIEW_TOGGLE_INACTIVE_CLS = ['text-stone-500', 'dark:text-stone-400'];
  function setViewToggleActive(active2d: boolean) {
    VIEW_TOGGLE_ACTIVE_CLS.forEach(c => btnView2d.classList.toggle(c, active2d));
    VIEW_TOGGLE_INACTIVE_CLS.forEach(c => btnView2d.classList.toggle(c, !active2d));
    VIEW_TOGGLE_ACTIVE_CLS.forEach(c => btnView3d.classList.toggle(c, !active2d));
    VIEW_TOGGLE_INACTIVE_CLS.forEach(c => btnView3d.classList.toggle(c, active2d));
  }

  btnView2d.addEventListener('click', () => {
    if (!editing) return;
    const rect3d = view3d?.getViewRect() ?? null;
    if (view3d) last3dCamera = view3d.getCameraState();
    const camera3dUnmoved = !!(view3d && camera3dAtEnter && sameCamera(view3d.getCameraState(), camera3dAtEnter));
    stopSunPlay();
    sunControls.hidden = true;
    view3d?.dispose();
    view3d = null;
    // Show the 2D canvas before measuring it: while hidden it has no size and
    // canvasAspect() falls back to the plan's aspect, which zoomed the map
    // out a little on every 3D → 2D switch.
    plan3dContainer.hidden = true;
    planSvg.classList.remove('hidden');
    canvasRectCache = null;
    if (rect3d && view2dAtEnter3d && camera3dUnmoved) {
      // Only looked at in 3D (camera not moved): back to exactly the 2D section from before.
      planView = { ...view2dAtEnter3d };
      last2dView = { ...planView };
    } else if (rect3d) {
      // Keep the perspective: 2D shows what the 3D camera was looking at.
      const r = rect3d;
      const aspect = canvasAspect();
      const w = Math.max((r.maxX - r.minX), (r.maxY - r.minY) / aspect) * U;
      const cxU = (r.minX + r.maxX) / 2 * U, cyU = (r.minY + r.maxY) / 2 * U;
      planView = { x: cxU - w / 2, y: cyU - w * aspect / 2, w, h: w * aspect };
      last2dView = { ...planView };
    }
    zoomControls.hidden = false;
    setViewToggleActive(true);
    renderPlanSvg();
  });

  btnView3d.addEventListener('click', async () => {
    if (!editing) return;
    planSvg.classList.add('hidden');
    canvasRectCache = null;
    plan3dContainer.hidden = false;
    setViewToggleActive(false);
    updateAttribution(planSvg); // the 3D ground shows the same map / photo tiles
    zoomControls.hidden = true;
    endAreaDraw();
    setBoundaryEdit(false);
    const { createGardenPlan3DView } = await import('../lib/gartenplan-3d');
    // Perspective carries over: rebuilds keep the live camera; coming from 2D
    // we restore the last 3D camera if 2D wasn't moved, else look straight
    // down onto the section 2D showed.
    const unchanged2d = last2dView && ['x', 'y', 'w', 'h'].every(k => Math.abs((last2dView as any)[k] - (planView as any)[k]) < 1e-6);
    const camera = view3d?.getCameraState() ?? (unchanged2d ? last3dCamera : null);
    const from2d = !view3d; // not a rebuild of an open 3D view
    if (from2d) view2dAtEnter3d = { ...planView };
    view3d?.dispose();
    const geo = editing.geo;
    view3d = createGardenPlan3DView(plan3dContainer, editing, plantsById, {
      onGroundTap(xM, yM) {
        if (!editing || !armedPlantId) return;
        const placement: GardenPlanPlacement = { id: newId(), plantId: armedPlantId, xM, yM, notes: '' };
        editing.placements.push(placement);
        unplacedPlantIds = unplacedPlantIds.filter(id => id !== armedPlantId);
        renderUnplacedList();
        renderSuggestions();
        view3d?.refreshPlacements();
        scheduleCoverage();
        scheduleAutosave();
      },
      onPlacementDragEnd(placementId, xM, yM) {
        const pl = editing?.placements.find(p => p.id === placementId);
        if (pl) { pl.xM = xM; pl.yM = yM; }
        scheduleCoverage();
        scheduleAutosave();
      },
      onAreaSelected(areaId) {
        selectedAreaId = areaId;
        markSelectedArea();
      },
      onAreaVertexDragEnd(areaId, index, xM, yM) {
        const area = editing?.areas.find(a => a.id === areaId);
        if (!area || !editing) return;
        area.points[index] = { xM, yM };
        renderAreasLayer();
        afterGeometryEdit();
      },
      onPlacementSelected(placementId) {
        if (selectedAreaId) { selectedAreaId = null; markSelectedArea(); }
        selectedPlacementId = placementId;
        view3d?.setSelectedPlacement(placementId);
        renderSelectedPanel();
      },
    }, {
      camera,
      fit: camera ? null : viewRectM(),
      latLon: geo ? { lat: geo.lat, lon: geo.lon } : DEFAULT_SUN_LATLON,
      rotationDeg: geo?.rotationDeg ?? 0,
      terrain: geo ? terrain : null,
      buildings: showBuildings() ? buildings : [],
      layers: pluginLayers.filter(l => featureOn(l.featureId)).map(l => l.layer),
      onTileFallback: noteOrthoFallback,
    });
    if (from2d) camera3dAtEnter = view3d.getCameraState();
    view3d.setArmedPlant(armedPlantId);
    view3d.refreshAreas(selectedAreaId);
    view3d.setCoverage(coverage3d);
    view3d.setWater(water3d);
    sunControls.hidden = false;
    if (!sunDateInput.value) {
      setSunNow();
      // Opened at night? Start at noon so the scene isn't just dark.
      const ll = geo ? { lat: geo.lat, lon: geo.lon } : DEFAULT_SUN_LATLON;
      if (sunPosition(new Date(), ll.lat, ll.lon).altitudeDeg <= 0) sunTimeInput.value = '720';
    }
    applySun();
  });

  // ── Sonnenstand (3D) ────────────────────────────────────────────────────
  // Date + time drive the sun in the 3D view (light direction, shadows, sky,
  // sun path) for the garden's location; unlocated plans assume 50° N.
  const DEFAULT_SUN_LATLON = { lat: 50, lon: 10 };
  const sunControls = document.getElementById('sun-controls')!;
  const sunDateInput = document.getElementById('sun-date') as HTMLInputElement;
  const sunTimeInput = document.getElementById('sun-time') as HTMLInputElement;
  const sunTimeLabel = document.getElementById('sun-time-label')!;
  const sunInfo = document.getElementById('sun-info')!;
  const sunPlayBtn = document.getElementById('sun-play') as HTMLButtonElement;
  let last3dCamera: import('../lib/gartenplan-3d').Camera3DState | null = null;
  let last2dView: { x: number; y: number; w: number; h: number } | null = null;
  /** The 2D section and the 3D camera when 3D was opened: unmoved camera → back to that section. */
  let view2dAtEnter3d: { x: number; y: number; w: number; h: number } | null = null;
  let camera3dAtEnter: import('../lib/gartenplan-3d').Camera3DState | null = null;
  const sameCamera = (a: import('../lib/gartenplan-3d').Camera3DState, b: import('../lib/gartenplan-3d').Camera3DState) =>
    [...a.position, ...a.target].every((v, i) => Math.abs(v - [...b.position, ...b.target][i]) < 1e-6);
  let sunPlayTimer: ReturnType<typeof setInterval> | null = null;

  const pad = (n: number) => String(n).padStart(2, '0');
  function setSunNow() {
    const now = new Date();
    sunDateInput.value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    sunTimeInput.value = String(Math.round((now.getHours() * 60 + now.getMinutes()) / 5) * 5);
  }
  function applySun() {
    const mins = Number(sunTimeInput.value);
    sunTimeLabel.textContent = `${pad(Math.floor(mins / 60))}:${pad(mins % 60)}`;
    if (!view3d || !sunDateInput.value) return;
    const [y, mo, d] = sunDateInput.value.split('-').map(Number);
    const p = view3d.setSunTime(new Date(y, mo - 1, d, Math.floor(mins / 60), mins % 60));
    const where = editing?.geo ? '' : ' · ' + t('sunNoLocation');
    sunInfo.textContent = (p.altitudeDeg > 0
      ? t('sunInfo', { bearing: Math.round(p.bearingDeg), dir: compassLabel(p.bearingDeg, lang), alt: Math.round(p.altitudeDeg) })
      : t('sunBelow')) + where;
  }
  function stopSunPlay() {
    if (sunPlayTimer) clearInterval(sunPlayTimer);
    sunPlayTimer = null;
    sunPlayBtn.textContent = t('sunPlay');
  }
  sunDateInput.addEventListener('input', () => { applySun(); if (coverageSelect.value === 'sun-day') scheduleCoverage(); });
  sunTimeInput.addEventListener('input', () => { stopSunPlay(); applySun(); });
  // Last chosen 3D preset, so the T shortcut can toggle between both.
  let lastPreset: 'top' | 'oblique' = 'oblique';
  function setPreset(p: 'top' | 'oblique') { lastPreset = p; view3d?.setViewPreset(p); }
  document.getElementById('view-top')!.addEventListener('click', () => setPreset('top'));
  document.getElementById('view-oblique')!.addEventListener('click', () => setPreset('oblique'));
  document.getElementById('sun-now')!.addEventListener('click', () => { stopSunPlay(); setSunNow(); applySun(); });
  sunPlayBtn.addEventListener('click', () => {
    if (sunPlayTimer) { stopSunPlay(); return; }
    sunPlayBtn.textContent = t('sunStop');
    // Day over (no further 10-min step fits) → start the day again.
    if (Number(sunTimeInput.value) + 10 > 1435) { sunTimeInput.value = '0'; applySun(); }
    sunPlayTimer = setInterval(() => {
      const next = Number(sunTimeInput.value) + 10;
      if (next > 1435) { sunTimeInput.value = '1435'; applySun(); stopSunPlay(); return; }
      sunTimeInput.value = String(next);
      applySun();
    }, 60);
  });

  // ── Plan-PDF (Papier, Maßstab, Karte, Maßstabsleiste, Nordpfeil) ──
  const pdfDialog = document.getElementById('pdf-dialog') as HTMLDialogElement;
  const pdfPaper = document.getElementById('pdf-paper') as HTMLSelectElement;
  const pdfScale = document.getElementById('pdf-scale') as HTMLSelectElement;
  const pdfBg = document.getElementById('pdf-bg') as HTMLInputElement;
  const pdfInfo = document.getElementById('pdf-info')!;
  const pdfCreate = document.getElementById('pdf-create') as HTMLButtonElement;
  function syncPdfDialog() {
    if (!editing) return;
    const hasMap = !!editing.geo && editing.geo.basemap !== 'none';
    pdfBg.disabled = !hasMap;
    if (!hasMap) pdfBg.checked = false;
    document.getElementById('pdf-bg-label')!.classList.toggle('opacity-50', !hasMap);
    const scale = pdfScale.value ? Number(pdfScale.value) : null;
    const fits = planFitsPaper(editing, pdfPaper.value as PlanPaper, scale);
    pdfCreate.disabled = !fits;
    const better = (['A4', 'A3', 'A2'] as PlanPaper[]).find(p => planFitsPaper(editing!, p, scale));
    pdfInfo.textContent = fits
      ? t('pdfFits', { w: editing.areaWidthM, h: editing.areaHeightM })
      : better ? t('pdfTooBigPaper', { paper: better }) : t('pdfTooBigScale');
  }
  [pdfPaper, pdfScale].forEach(s => s.addEventListener('change', syncPdfDialog));
  document.getElementById('btn-export-pdf')!.addEventListener('click', () => {
    if (!editing) return;
    syncFormIntoEditing();
    syncPdfDialog();
    pdfDialog.showModal();
  });
  pdfCreate.addEventListener('click', async () => {
    if (!editing) return;
    const plan = editing;
    await withButtonSpinner(pdfCreate, async () => {
      let backgroundSvg = '', backgroundCredit = '';
      if (pdfBg.checked && plan.geo) {
        // tiles at roughly print resolution (~150 dpi)
        const scale = pdfScale.value ? Number(pdfScale.value) : null;
        const mPerPx = scale ? scale / 1000 / 6 : plan.areaWidthM / 2000;
        const bg = await basemapSvgInline(plan, mPerPx);
        backgroundSvg = bg.svg;
        backgroundCredit = basemapAttribution(plan).replace(/<[^>]+>/g, '').replace(/&amp;/g, '&');
        if (bg.failed) showToast(t('pdfTilesFailed', { n: bg.failed, total: bg.total }));
      }
      await exportGardenPlanPDF(plan, plantsById, {
        paper: pdfPaper.value as PlanPaper, scale: pdfScale.value ? Number(pdfScale.value) : null,
        backgroundSvg, backgroundCredit, rotationDeg: plan.geo ? plan.geo.rotationDeg : null,
      });
    });
    pdfDialog.close();
  });

  document.getElementById('btn-redraw-area')!.addEventListener('click', () => {
    if (!editing) return;
    if (!confirm(t('confirmRedrawArea'))) return;
    view3d?.dispose();
    view3d = null;
    plan3dContainer.hidden = true;
    planSvg.classList.remove('hidden');
    canvasRectCache = null;
    endAreaDraw();
    editing.boundary = [];
    editing.placements = [];
    editing.areas = [];
    selectedAreaId = null;
    drawingPoints = [];
    [fWidth, fHeight, fGridSpacing, ...drawModeRadios].forEach(el => { el.disabled = false; });
    setDrawMode(editing.geo ? 'map' : 'grid');
    btnStartDrawing.classList.remove('hidden');
    drawingHint.classList.add('hidden');
    drawingWrap.classList.add('hidden');
    mapdrawWrap.classList.add('hidden');
    drawingControls.classList.add('hidden');
    mapBar.classList.add('hidden');
    phaseA.classList.remove('hidden');
    phaseB.classList.add('hidden');
    setBoundaryEdit(false);
    showDrawingUi();
    window.scrollTo({ top: 0 });
    scheduleAutosave();
  });

  // ── Phase B: Platzierung ────────────────────────────────────────────────
  function enterPhaseB() {
    if (!editing) return;
    phaseA.classList.add('hidden');
    phaseB.classList.remove('hidden');
    mapBar.classList.remove('hidden');
    syncMapBar();
    const savedView = restoreViewState();
    syncZonesUi();
    if (savedView?.sun) {
      sunDateInput.value = savedView.sun.date;
      sunTimeInput.value = String(savedView.sun.minutes);
    }
    if (savedView?.coverage !== undefined && [...coverageSelect.options].some(o => o.value === savedView.coverage)) {
      coverageSelect.value = savedView.coverage;
    }
    renderAreasList();
    yearsInput.value = String(editing.yearsSincePlanting);
    yearsLabel.textContent = t('yearsSuffix', { years: editing.yearsSincePlanting });
    renderPlantPicker();
    renderUnplacedList();
    renderSuggestions();
    renderSelectedPanel();
    fillPackageSelect();
    renderPlanSvg();
    if (savedView?.coverage !== undefined) scheduleCoverage();
    if (savedView?.mode === '3d' && plan3dContainer.hidden) btnView3d.click();
    void loadTerrain();
    void loadBuildings();
    resetHistory();
    scheduleWarnings();
  }

  // ── Kamera merken ───────────────────────────────────────────────────────
  // Per plan: the 2D section, the 3D camera, which view was open, the sun
  // date/time and the colouring are kept in localStorage when the map is left
  // (back to the list, reload, tab switch) and restored the next time the
  // plan is opened (lib/plan-view.ts — a share link can carry them, too).
  type SavedView = PlanView;
  const viewKey = planViewKey;

  function saveViewState() {
    if (!editing || phaseB.classList.contains('hidden')) return;
    writePlanView(editing.id, {
      view2d: planView.w ? { ...planView } : null,
      cam3d: view3d?.getCameraState() ?? last3dCamera,
      mode: plan3dContainer.hidden ? '2d' : '3d',
      sun: sunDateInput.value ? { date: sunDateInput.value, minutes: Number(sunTimeInput.value) } : null,
      coverage: coverageSelect.value,
    });
  }

  /** Restores the saved 2D section (else the whole plan) and primes the 3D
   *  camera so switching to 3D lands where it was. */
  function restoreViewState(): SavedView | null {
    applyCanvasHeight(storedPlanHeight() ?? autoPlanHeight()); // view aspect needs the final canvas shape
    resetPlanViewState();
    last3dCamera = null;
    last2dView = null;
    if (!editing) return null;
    const saved: SavedView | null = readPlanView(editing.id);
    const v = saved?.view2d;
    if (v && [v.x, v.y, v.w, v.h].every(Number.isFinite) && v.w > 0) {
      // The canvas may have another shape now: same center and width, new aspect.
      const h = v.w * canvasAspect();
      planView = { x: v.x, y: v.y + v.h / 2 - h / 2, w: v.w, h };
    }
    const c = saved?.cam3d;
    if (c && Array.isArray(c.position) && Array.isArray(c.target) && [...c.position, ...c.target].every(Number.isFinite)) {
      last3dCamera = c;
      last2dView = { ...planView }; // "2D unchanged" → 3D restores this camera
    }
    return saved;
  }

  window.addEventListener('pagehide', saveViewState);
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') saveViewState(); });

  function renderPlantPicker() {
    const q = pickerFilter.value.trim().toLowerCase();
    const filtered = q
      ? plants.filter(p => p.latinName.toLowerCase().includes(q) || [p.commonName, p.commonNameEn].some(n => n && n.toLowerCase().includes(q)))
      : plants;
    if (filtered.length === 0) {
      plantPickerEl.innerHTML = `<p class="text-xs text-stone-500 dark:text-stone-400">${t('noPlantsInCollection')}</p>`;
      return;
    }
    plantPickerEl.innerHTML = filtered.map(p => `
      <button data-picker-plant="${p.id}" class="block w-full truncate rounded px-2 py-1 text-left text-xs ${p.id === armedPlantId ? 'bg-green-700 text-white' : 'text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800'}">${plantLabel(p)}</button>
    `).join('');
    plantPickerEl.querySelectorAll<HTMLButtonElement>('[data-picker-plant]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.pickerPlant!;
        armedPlantId = armedPlantId === id ? null : id;
        armedHint.classList.toggle('hidden', !armedPlantId);
        view3d?.setArmedPlant(armedPlantId);
        renderPlantPicker();
        if (gpsPos) renderGps();   // enables „Hier setzen“
      });
    });
  }
  pickerFilter.addEventListener('input', renderPlantPicker);

  function renderUnplacedList() {
    if (unplacedPlantIds.length === 0) {
      unplacedSection.classList.add('hidden');
      unplacedListEl.innerHTML = '';
      return;
    }
    unplacedSection.classList.remove('hidden');
    unplacedListEl.innerHTML = unplacedPlantIds.map(id => {
      const p = plantsById.get(id);
      return `<button data-unplaced-plant="${id}" class="block w-full truncate rounded px-2 py-1 text-left text-xs ${id === armedPlantId ? 'bg-green-700 text-white' : 'text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800'}">${plantLabel(p)}</button>`;
    }).join('');
    unplacedListEl.querySelectorAll<HTMLButtonElement>('[data-unplaced-plant]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.unplacedPlant!;
        armedPlantId = armedPlantId === id ? null : id;
        armedHint.classList.toggle('hidden', !armedPlantId);
        view3d?.setArmedPlant(armedPlantId);
        renderUnplacedList();
      });
    });
  }

  /** Ranks unplaced/uncollected candidates by average compatScore (reused
   *  from Polykulturen — Sonne/Wasser/pH overlap) against everything already
   *  placed. Suggestions only ever land in the unplaced list — never
   *  auto-placed onto the canvas, placement stays a manual action. */
  function renderSuggestions() {
    if (!editing) return;
    const placedPlants = editing.placements
      .map(pl => plantsById.get(pl.plantId))
      .filter((p): p is PlantData => !!p);
    if (placedPlants.length === 0) {
      suggestionsSection.classList.add('hidden');
      suggestionsListEl.innerHTML = '';
      return;
    }
    const excluded = new Set([...editing.placements.map(pl => pl.plantId), ...unplacedPlantIds]);
    const climate = currentClimate();
    const candidates = plants
      .filter(p => !excluded.has(p.id) && !(climate && notHardy(p, climate)))
      .map(p => ({ p, score: placedPlants.reduce((sum, ref) => sum + compatScore(p, ref), 0) / placedPlants.length }))
      .sort((a, b) => b.score - a.score)
      .slice(0, 5);
    if (candidates.length === 0) {
      suggestionsSection.classList.add('hidden');
      suggestionsListEl.innerHTML = '';
      return;
    }
    suggestionsSection.classList.remove('hidden');
    suggestionsListEl.innerHTML = candidates.map(({ p, score }) => `
      <div class="flex items-center justify-between gap-2 rounded px-2 py-1 text-xs hover:bg-stone-100 dark:hover:bg-stone-800">
        <span class="min-w-0 flex-1 truncate text-stone-700 dark:text-stone-200" title="${plantLabel(p)}">${plantLabel(p)}</span>
        <span class="shrink-0 font-mono text-[10px] text-stone-500 dark:text-stone-400" title="${t('sunWaterPhTitle')}">${score.toFixed(1)}/3</span>
        <button data-suggest-plant="${p.id}" class="shrink-0 rounded bg-green-100 dark:bg-green-900/40 px-2 py-0.5 font-medium text-green-700 dark:text-green-300 hover:bg-green-200 dark:hover:bg-green-900/60">${t('btnAdd')}</button>
      </div>`).join('');
    suggestionsListEl.querySelectorAll<HTMLButtonElement>('[data-suggest-plant]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.suggestPlant!;
        if (!unplacedPlantIds.includes(id)) unplacedPlantIds.push(id);
        renderUnplacedList();
        renderSuggestions();
      });
    });
  }

  document.getElementById('g-polyculture')!.addEventListener('change', () => {
    if (!editing) return;
    editing.polycultureId = fPolyculture.value || null;
  });

  /** Copies a linked polyculture's members in as an unplaced list. Idempotent —
   *  safe to click more than once; only adds members not already placed or
   *  already pending, so nothing already in progress is duplicated or lost. */
  function importPolycultureMembers() {
    if (!editing || !editing.polycultureId) return;
    const poly = polyculturesById.get(editing.polycultureId);
    if (!poly) return;
    const already = new Set([...editing.placements.map(pl => pl.plantId), ...unplacedPlantIds]);
    const toAdd = poly.members.map(m => m.plantId).filter(id => !already.has(id));
    if (toAdd.length === 0) { showToast(t('toastPlanSaved')); return; }
    unplacedPlantIds.push(...toAdd);
    renderUnplacedList();
  }

  function renderSelectedPanel() {
    if (gpsPos) renderGps();
    if (editing && multiSel.size) { renderMultiPanel(); return; }
    if (editing && (selectedAreaId || editBoundary)) { renderSelectedShapePanel(); return; }
    if (!editing || !selectedPlacementId) {
      selectedPanel.innerHTML = `<p class="text-xs text-stone-500 dark:text-stone-400">${t('selectedPanelEmpty')}</p>`;
      return;
    }
    const placement = editing.placements.find(pl => pl.id === selectedPlacementId);
    if (!placement) {
      selectedPanel.innerHTML = `<p class="text-xs text-stone-500 dark:text-stone-400">${t('selectedPanelEmpty')}</p>`;
      return;
    }
    const p = plantsById.get(placement.plantId);
    selectedPanel.innerHTML = `
      ${p ? plantDetailHtml(p, t) : `<p class="mb-2 text-sm font-medium text-stone-800 dark:text-stone-100">${plantLabel(p)}</p>`}
      <label data-feature="phases" class="mb-2 flex items-center gap-2 text-xs"><span class="font-medium text-stone-500 dark:text-stone-400">${t('phaseLabel')}</span>${phaseSelectHtml('placement-phase', phaseOf(placement))}</label>
      <label class="block">
        <span class="text-xs font-medium text-stone-500 dark:text-stone-400">${t('labelPlacementNotes')}</span>
        <textarea id="placement-notes" rows="2" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-xs shadow-inner focus:border-green-500 focus:outline-none">${escapeHtml(placement.notes)}</textarea>
      </label>
      <button id="btn-remove-placement" class="mt-2 rounded-md bg-red-100 dark:bg-red-900/40 px-2.5 py-1 text-xs font-medium text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900/60">${t('btnRemovePlacement')}</button>`;
    document.getElementById('placement-phase')!.addEventListener('change', (e) => {
      setPhase([placement], Number((e.target as HTMLSelectElement).value));
    });
    document.getElementById('placement-notes')!.addEventListener('input', (e) => {
      placement.notes = (e.target as HTMLTextAreaElement).value;
      scheduleAutosave();
    });
    document.getElementById('btn-remove-placement')!.addEventListener('click', () => {
      if (!editing) return;
      editing.placements = editing.placements.filter(pl => pl.id !== selectedPlacementId);
      selectedPlacementId = null;
      renderPlanSvg();
      view3d?.refreshPlacements();
      renderSelectedPanel();
      renderSuggestions();
      scheduleAutosave();
    });
  }

  /** "Ausgewählt" for a multi-selection (lasso / Shift-click): count per
   *  plant, remove all, clear. */
  function renderMultiPanel() {
    if (!editing) return;
    const sel = editing.placements.filter(pl => multiSel.has(pl.id));
    const counts = new Map<string, number>();
    for (const pl of sel) counts.set(pl.plantId, (counts.get(pl.plantId) ?? 0) + 1);
    const rows = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10)
      .map(([id, n]) => `<li class="flex justify-between gap-2"><span class="truncate">${plantLabel(plantsById.get(id))}</span><span class="font-mono">${n}×</span></li>`).join('');
    selectedPanel.innerHTML = `
      <p class="mb-2 text-sm font-medium text-stone-800 dark:text-stone-100">${t('multiSelected', { n: sel.length })}</p>
      <ul class="space-y-0.5 text-xs text-stone-700 dark:text-stone-200">${rows}</ul>
      <label data-feature="phases" class="mt-2 flex items-center gap-2 text-xs"><span class="font-medium text-stone-500 dark:text-stone-400">${t('phaseLabelAll')}</span>${phaseSelectHtml('multi-phase', sel.every(pl => phaseOf(pl) === phaseOf(sel[0])) ? phaseOf(sel[0]) : -1)}</label>
      <p class="mt-2 text-[11px] text-stone-500 dark:text-stone-400">${t('multiHint')}</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <button id="btn-multi-remove" class="rounded-md bg-red-100 dark:bg-red-900/40 px-2.5 py-1 text-xs font-medium text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900/60">${t('multiRemove')}</button>
        <button id="btn-multi-clear" class="rounded-md bg-stone-100 dark:bg-stone-700 px-2.5 py-1 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600">${t('multiClear')}</button>
      </div>`;
    document.getElementById('btn-multi-remove')!.addEventListener('click', () => {
      if (!editing || !confirm(t('multiRemoveConfirm', { n: multiSel.size }))) return;
      editing.placements = editing.placements.filter(pl => !multiSel.has(pl.id));
      multiSel.clear();
      renderPlanSvg();
      renderSelectedPanel();
      renderSuggestions();
      scheduleAutosave();
    });
    document.getElementById('btn-multi-clear')!.addEventListener('click', () => { multiSel.clear(); refreshMarkerHighlight(); renderSelectedPanel(); });
    document.getElementById('multi-phase')!.addEventListener('change', (e) => {
      const v = Number((e.target as HTMLSelectElement).value);
      if (v >= 0) setPhase(sel, v);
    });
  }

  /** "Ausgewählt" for a selected area or the garden outline being edited:
   *  name/color, size, perimeter, corners. */
  function renderSelectedShapePanel() {
    if (!editing) return;
    const area = editing.areas.find(a => a.id === selectedAreaId);
    const pts = area ? area.points : editing.boundary;
    const fmt = (v: number, d = 1) => new Intl.NumberFormat(lang, { maximumFractionDigits: d }).format(v);
    const title = area
      ? `<span class="inline-block h-3.5 w-3.5 shrink-0 rounded-sm ring-1 ring-black/10" style="background:${area.color}"></span><span class="truncate">${escapeHtml(area.name || '—')}</span>`
      : `<span class="inline-block h-3.5 w-3.5 shrink-0 rounded-sm ring-1 ring-black/10" style="background:#15803d"></span><span>${t('selBoundaryTitle')}</span>`;
    selectedPanel.innerHTML = `
      <p class="mb-2 flex items-center gap-2 text-sm font-medium text-stone-800 dark:text-stone-100">${title}</p>
      <dl class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
        <dt class="text-stone-500 dark:text-stone-400">${t(area ? 'selArea' : 'selPlanSize')}</dt><dd class="font-mono text-stone-800 dark:text-stone-100">${fmt(polygonAreaM2(pts))} m²</dd>
        <dt class="text-stone-500 dark:text-stone-400">${t('selPerimeter')}</dt><dd class="font-mono text-stone-800 dark:text-stone-100">${fmt(polygonPerimeterM(pts))} m</dd>
        <dt class="text-stone-500 dark:text-stone-400">${t('selCorners')}</dt><dd class="font-mono text-stone-800 dark:text-stone-100">${pts.length}</dd>
        ${area ? '' : `<dt class="text-stone-500 dark:text-stone-400">${t('selPlanFrame')}</dt><dd class="font-mono text-stone-800 dark:text-stone-100">${fmt(editing.areaWidthM)} × ${fmt(editing.areaHeightM)} m</dd>`}
      </dl>
      <p class="mt-2 text-[11px] text-stone-500 dark:text-stone-400">${t(area ? 'areaEditHint' : 'boundaryEditHint')}</p>
      ${area ? `<button id="btn-remove-area" class="mt-2 rounded-md bg-red-100 dark:bg-red-900/40 px-2.5 py-1 text-xs font-medium text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900/60">${t('areaDelete')}</button>` : ''}`;
    document.getElementById('btn-remove-area')?.addEventListener('click', () => {
      if (!editing || !area || !confirm(t('confirmDeleteArea', { name: area.name || '—' }))) return;
      editing.areas = editing.areas.filter(x => x.id !== area.id);
      selectedAreaId = null;
      renderAreasList();
      scheduleAutosave();
    });
  }

  // ── Plan SVG: grid + boundary + plant markers ───────────────────────────
  // Each placement renders as a <g transform="translate(x,y)"> containing a
  // wobbly "blob" outline (blob-shape.ts — deterministic per placement id,
  // not random per render), a center dot, and an always-visible name label.
  // Layer (tree/shrub/herb) drives the blob's color and irregularity via
  // LAYER_STYLE (plant-layer.ts) — a heuristic classification, not real
  // per-species artwork, see the info box for the caveat shown to users.
  function updateMarkerShape(group: SVGGElement, placement: GardenPlanPlacement, p: PlantData | undefined) {
    const years = editing!.yearsSincePlanting;
    const planted = isPlanted(placement, years);
    const radiusM = p ? displayRadiusM(p, Math.max(0, ageAt(placement, years))) : 0.2;
    // Later construction phase: only a faint dashed outline until it is planted.
    group.style.opacity = planted ? '' : '0.35';
    const radiusU = radiusM * SVG_UNITS_PER_METER;
    const layer = p ? deriveLayer(p) : 'shrub';
    const style = LAYER_STYLE[layer];
    const single = selectedPlacementId === placement.id;
    const selected = single || multiSel.has(placement.id);
    const blob = group.querySelector('.marker-blob') as SVGPathElement;
    blob.setAttribute('d', blobPathD(radiusU, placement.id, style.lobes, style.wobble));
    blob.setAttribute('fill', style.fill);
    const hot = !selected && hoverWarnIds.includes(placement.id);
    const warned = !selected && warnedIds.has(placement.id);
    blob.setAttribute('stroke', selected ? '#facc15' : hot || warned ? '#dc2626' : style.stroke);
    // Like a map: the name shrinks with the plant on screen (max 13 px) and
    // disappears below ~7 px, so zoomed-out plans don't drown in labels.
    // The selected plant always keeps its name.
    const ppu = pxPerUnit();
    const rPx = radiusU * ppu;
    blob.setAttribute('stroke-width', String((selected ? 2.5 : hot ? 3.5 : warned ? 2.5 : 1.2) / ppu));
    blob.setAttribute('stroke-dasharray', !planted ? `${3 / ppu} ${3 / ppu}` : warned && !hot ? `${5 / ppu} ${3 / ppu}` : '');
    if (!planted) blob.setAttribute('fill-opacity', '0.15'); else blob.removeAttribute('fill-opacity');
    group.querySelector('.marker-dot')?.setAttribute('r', String(Math.min(3, Math.max(1, rPx * 0.25)) / ppu));
    const fontPx = single ? 13 : Math.min(13, rPx * 0.7);
    const label = group.querySelector('.marker-label') as SVGTextElement;
    const f = fontPx / ppu;
    label.style.display = single || fontPx >= 7 ? '' : 'none';
    label.setAttribute('y', String(radiusU + f * 1.05));
    label.setAttribute('font-size', String(f));
    label.setAttribute('stroke-width', String(f * 0.25));
    label.textContent = p ? (displayName(p)) : '?';
  }

  function renderPlanSvg() {
    if (!editing) return;
    scheduleAutosave();
    if (!planView.w) resetPlanViewState();
    const w = editing.areaWidthM, h = editing.areaHeightM, k = viewK();
    const pointsAttr = editing.boundary.map(p => `${p.xM * SVG_UNITS_PER_METER},${p.yM * SVG_UNITS_PER_METER}`).join(' ');
    if (!planView.w) resetPlanViewState();
    planSvg.setAttribute('viewBox', `${planView.x} ${planView.y} ${planView.w} ${planView.h}`);
    planSvg.innerHTML = `
      <g class="basemap-layer"></g>
      <g id="contour-layer" pointer-events="none"></g>
      <g id="water-layer" pointer-events="none"></g>
      <g id="coverage-layer" pointer-events="none"></g>
      <g id="plan-grid-layer">${gridDefsAndBackground(w, h, editing.gridSpacingM, 'plan-grid', k, pxPerUnit() * U, editing.gridRotationDeg ?? 0, editing.boundary)}</g>
      <g id="zones-layer" pointer-events="none"></g>
      <polygon id="plan-boundary" points="${pointsAttr}" fill="#15803d" fill-opacity="0.08" stroke="#15803d" stroke-width="${2 * k}"/>
      <g id="plan-areas-layer">${areasSvg(editing.areas, selectedAreaId, k, true)}</g>
      <g id="plan-markers"></g>
      <g id="warn-layer" pointer-events="none"></g>
      <g id="area-handles"></g>
      <g id="zones-handle"></g>
      <g id="area-draft" pointer-events="none"></g>
      <g id="row-draft" pointer-events="none"></g>
      <g id="lasso-layer" pointer-events="none"></g>
      <g id="measure-layer" pointer-events="none"></g>
      <g id="gps-layer" pointer-events="none"></g>
      <g id="plugin-layer" pointer-events="none"></g>`;
    renderBasemap(planSvg);
    renderContours();
    renderCoverage();
    renderAreaDraft();
    renderRowDraft();
    renderAreaHandles();
    renderWarnHover();
    renderZones();
    renderWater();
    renderGps();
    markerMap = new Map();
    const markersGroup = planSvg.querySelector('#plan-markers')!;
    for (const placement of editing.placements) {
      const p = plantsById.get(placement.plantId);
      const group = document.createElementNS(SVG_NS, 'g') as SVGGElement;
      group.setAttribute('transform', `translate(${placement.xM * SVG_UNITS_PER_METER},${placement.yM * SVG_UNITS_PER_METER})`);
      group.setAttribute('data-placement-id', placement.id);
      group.style.cursor = 'grab';
      const blob = document.createElementNS(SVG_NS, 'path');
      blob.setAttribute('class', 'marker-blob');
      blob.setAttribute('fill-opacity', '0.6');
      group.appendChild(blob);
      const dot = document.createElementNS(SVG_NS, 'circle');
      dot.setAttribute('class', 'marker-dot');
      dot.setAttribute('r', String(3 * k));
      dot.setAttribute('fill', '#1c1917');
      dot.style.pointerEvents = 'none';
      group.appendChild(dot);
      const label = document.createElementNS(SVG_NS, 'text');
      label.setAttribute('class', 'marker-label');
      label.setAttribute('text-anchor', 'middle');
      label.setAttribute('font-size', String(13 * k));
      label.setAttribute('fill', '#1c1917');
      label.setAttribute('stroke', '#ffffff');
      label.setAttribute('stroke-width', String(3 * k));
      label.setAttribute('paint-order', 'stroke');
      label.style.pointerEvents = 'none';
      group.appendChild(label);
      updateMarkerShape(group, placement, p);
      wirePlacementDrag(group, placement);
      markersGroup.appendChild(group);
      markerMap.set(placement.id, group);
    }
    renderPluginOverlays();
    renderSimpleGuide();
    notifyPlanChange();
  }

  function wirePlacementDrag(group: SVGGElement, placement: GardenPlanPlacement) {
    let dragging = false;
    let moved = false;
    let startClientX = 0, startClientY = 0;
    let start = { xM: 0, yM: 0 };
    // Dragging a marked plant moves the whole multi-selection along.
    let carried: { pl: GardenPlanPlacement; g: SVGGElement; x0: number; y0: number }[] = [];
    group.addEventListener('pointerdown', (e: PointerEvent) => {
      e.stopPropagation();
      dragging = true;
      moved = false;
      startClientX = e.clientX;
      startClientY = e.clientY;
      start = clientToMeters(planSvg, e.clientX, e.clientY);
      carried = multiSel.has(placement.id)
        ? (editing?.placements ?? []).filter(pl => multiSel.has(pl.id)).map(pl => ({ pl, g: markerMap.get(pl.id)!, x0: pl.xM, y0: pl.yM })).filter(c => c.g)
        : [{ pl: placement, g: group, x0: placement.xM, y0: placement.yM }];
      group.setPointerCapture(e.pointerId);
    });
    group.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      if (Math.hypot(e.clientX - startClientX, e.clientY - startClientY) > 4) moved = true;
      if (!moved) return;
      const pt = clientToMeters(planSvg, e.clientX, e.clientY);
      const dx = pt.xM - start.xM, dy = pt.yM - start.yM;
      for (const c of carried) c.g.setAttribute('transform', `translate(${(c.x0 + dx) * SVG_UNITS_PER_METER},${(c.y0 + dy) * SVG_UNITS_PER_METER})`);
    });
    group.addEventListener('pointerup', (e: PointerEvent) => {
      dragging = false;
      if (moved) {
        const pt = clientToMeters(planSvg, e.clientX, e.clientY);
        const dx = pt.xM - start.xM, dy = pt.yM - start.yM;
        for (const c of carried) { c.pl.xM = c.x0 + dx; c.pl.yM = c.y0 + dy; }
        afterGeometryEdit();
      } else if (e.shiftKey || e.ctrlKey || e.metaKey) {
        // Add to / remove from the multi-selection.
        if (selectedPlacementId) { multiSel.add(selectedPlacementId); selectedPlacementId = null; }
        if (multiSel.has(placement.id)) multiSel.delete(placement.id); else multiSel.add(placement.id);
        refreshMarkerHighlight();
        renderSelectedPanel();
      } else {
        multiSel.clear();
        selectedPlacementId = placement.id;
        setBoundaryEdit(false);
        if (selectedAreaId) { selectedAreaId = null; markSelectedArea(); }
        renderPlanSvg();
        renderSelectedPanel();
      }
    });
  }

  function placeArmedPlant(e: PointerEvent) {
    if (!editing || !armedPlantId) return;
    const pt = clientToMeters(planSvg, e.clientX, e.clientY);
    if (!pointInPolygon(pt, editing.boundary)) return;
    const placement: GardenPlanPlacement = { id: newId(), plantId: armedPlantId, xM: pt.xM, yM: pt.yM, notes: '' };
    editing.placements.push(placement);
    unplacedPlantIds = unplacedPlantIds.filter(id => id !== armedPlantId);
    renderUnplacedList();
    renderSuggestions();
    renderPlanSvg();
  }

  yearsInput.addEventListener('input', () => {
    if (!editing) return;
    editing.yearsSincePlanting = Number(yearsInput.value);
    yearsLabel.textContent = t('yearsSuffix', { years: editing.yearsSincePlanting });
    for (const placement of editing.placements) {
      const group = markerMap.get(placement.id);
      if (!group) continue;
      updateMarkerShape(group, placement, plantsById.get(placement.plantId));
    }
    view3d?.updateYears(editing.yearsSincePlanting);
    scheduleCoverage();
    scheduleAutosave();
  });

  // ── Flächen (benannte, farbige Polygone) ───────────────────────────────
  // Drawn in phase B on the plan itself (plan meters, snapped to the grid like
  // the boundary). Rendering is shared with the PDF export (areasSvg in
  // gartenplan-render.ts); name and color are edited in the "Flächen" list.
  let areaDraft: GardenPlanPoint[] | null = null;
  let selectedAreaId: string | null = null;

  function renderAreasLayer() {
    const layer = planSvg.querySelector('#plan-areas-layer');
    if (layer && editing) layer.innerHTML = areasSvg(editing.areas, selectedAreaId, viewK(), true);
    const boundaryEl = planSvg.querySelector('#plan-boundary');
    if (boundaryEl && editing) boundaryEl.setAttribute('points', editing.boundary.map(p => `${p.xM * SVG_UNITS_PER_METER},${p.yM * SVG_UNITS_PER_METER}`).join(' '));
    renderAreaHandles();
    view3d?.refreshAreas(selectedAreaId);
  }

  /** What the corner handles currently edit: the garden boundary (via
   *  "Umriss bearbeiten") or the selected area. */
  function editTarget(): { id: string; points: GardenPlanPoint[]; color: string } | null {
    if (!editing) return null;
    if (editBoundary) return { id: '__boundary', points: editing.boundary, color: '#15803d' };
    const a = editing.areas.find(x => x.id === selectedAreaId);
    return a ? { id: a.id, points: a.points, color: a.color } : null;
  }

  // ── Flächen bearbeiten: Griffe an den Ecken, ＋ auf den Kanten ─────────
  // Handles take the pointer in the capture phase so the same click can't
  // also place a plant or start/clear a selection further down.
  function renderAreaHandles() {
    const g = planSvg.querySelector('#area-handles');
    if (!g) return;
    const area = editTarget();
    if (!editing || !area || areaDraft) { g.innerHTML = ''; return; }
    const u = SVG_UNITS_PER_METER, k = viewK();
    const n = area.points.length;
    const mids = area.points.map((p, i) => {
      const q = area.points[(i + 1) % n];
      const mx = (p.xM + q.xM) / 2 * u, my = (p.yM + q.yM) / 2 * u;
      return `<g class="area-mid" data-i="${i}" style="cursor:copy"><circle cx="${mx}" cy="${my}" r="${7 * k}" fill="transparent"/><circle cx="${mx}" cy="${my}" r="${2.5 * k}" fill="${area.color}" fill-opacity="0.55" stroke="#ffffff" stroke-width="${0.8 * k}"/></g>`;
    }).join('');
    const verts = area.points.map((p, i) =>
      `<g class="area-vertex" data-i="${i}" style="cursor:move"><circle cx="${p.xM * u}" cy="${p.yM * u}" r="${9 * k}" fill="transparent"/><circle cx="${p.xM * u}" cy="${p.yM * u}" r="${3.5 * k}" fill="#ffffff" stroke="${area.color}" stroke-width="${1.5 * k}"/></g>`).join('');
    g.innerHTML = mids + verts;
  }

  let vertexDrag: { area: { points: GardenPlanPoint[] }; index: number; pointerId: number } | null = null;
  let lastVertexTap: { areaId: string; index: number; t: number } | null = null;
  const DOUBLE_TAP_MS = 400;

  planSvg.addEventListener('pointerdown', (e: PointerEvent) => {
    const target = (e.target as Element).closest('.area-vertex, .area-mid');
    const area = editTarget();
    if (!target || !area || !editing) return;
    e.stopPropagation();
    e.preventDefault();
    let index = Number((target as SVGElement).dataset.i);
    // Double click/tap on a corner removes it. Detected here rather than via
    // 'dblclick': pointer capture retargets that event to the <svg>.
    if (target.classList.contains('area-vertex')) {
      const now = performance.now();
      const last = lastVertexTap;
      lastVertexTap = { areaId: area.id, index, t: now };
      if (last && last.areaId === area.id && last.index === index && now - last.t < DOUBLE_TAP_MS) {
        lastVertexTap = null;
        if (area.points.length > 3) {
          area.points.splice(index, 1);
          renderAreasLayer();
          scheduleAutosave();
        }
        return;
      }
    }
    if (target.classList.contains('area-mid')) {
      const p = area.points[index], q = area.points[(index + 1) % area.points.length];
      area.points.splice(index + 1, 0, { xM: (p.xM + q.xM) / 2, yM: (p.yM + q.yM) / 2 });
      index += 1;
      renderAreasLayer();
    }
    vertexDrag = { area, index, pointerId: e.pointerId };
    planSvg.setPointerCapture(e.pointerId);
  }, { capture: true });

  planSvg.addEventListener('pointermove', (e: PointerEvent) => {
    if (!vertexDrag || !editing || e.pointerId !== vertexDrag.pointerId) return;
    lastVertexTap = null; // a drag is not half of a double tap
    // Not clamped: dragging past the edge grows the plan on release.
    vertexDrag.area.points[vertexDrag.index] = snapIfClose(planSvg, clientToMeters(planSvg, e.clientX, e.clientY), editing.gridSpacingM);
    renderAreasLayer();
    renderSelectedPanel();
  });

  function endVertexDrag(e: PointerEvent) {
    if (!vertexDrag || e.pointerId !== vertexDrag.pointerId) return;
    vertexDrag = null;
    afterGeometryEdit();
  }
  planSvg.addEventListener('pointerup', endVertexDrag);
  planSvg.addEventListener('pointercancel', endVertexDrag);

  // ── Zoom & Verschieben (2D) ────────────────────────────────────────────
  // The viewBox is the camera: planView in SVG units, same aspect as the plan
  // so the canvas never changes height. Dragging on bare ground pans, two
  // fingers pinch-zoom, Ctrl/⌘ + wheel (or a trackpad pinch) zooms at the
  // cursor; plain wheel keeps scrolling the page. Because a drag may become a
  // pan, taps (place plant, add area corner, select) fire on release.
  const U = SVG_UNITS_PER_METER;
  let planView = { x: 0, y: 0, w: 0, h: 0 };
  let basemapViewTimer: ReturnType<typeof setTimeout> | null = null;

  /** Height/width of the 2D canvas; the view (viewBox) always has this
   *  shape, so the map fills the canvas instead of being letterboxed. */
  function canvasAspect(): number {
    const r = planSvg.getBoundingClientRect();
    if (r.width > 0 && r.height > 0) return r.height / r.width;
    return editing ? editing.areaHeightM / editing.areaWidthM : 1;
  }
  /** Whole plan in view, centered; the rest of the canvas shows surroundings. */
  function resetPlanViewState() {
    if (!editing) return;
    const W = editing.areaWidthM * U, H = editing.areaHeightM * U, a = canvasAspect();
    const w = Math.max(W, H / a), h = w * a;
    planView = { x: (W - w) / 2, y: (H - h) / 2, w, h };
  }
  /** Plan rectangle that is actually visible. The viewBox only matches the
   *  canvas shape right after sizing; if the canvas changed since (sidebar
   *  folded, window resized) the SVG letterboxes and shows more than the
   *  viewBox — tiles must cover that, not just the viewBox. */
  function viewRectM(): PlanRect {
    const r = planSvg.getBoundingClientRect();
    if (r.width > 0 && r.height > 0 && planView.w > 0 && planView.h > 0) {
      const s = Math.min(r.width / planView.w, r.height / planView.h);
      const vw = r.width / s, vh = r.height / s;
      const cx = planView.x + planView.w / 2, cy = planView.y + planView.h / 2;
      return { minX: (cx - vw / 2) / U, minY: (cy - vh / 2) / U, maxX: (cx + vw / 2) / U, maxY: (cy + vh / 2) / U };
    }
    return { minX: planView.x / U, minY: planView.y / U, maxX: (planView.x + planView.w) / U, maxY: (planView.y + planView.h) / U };
  }
  function applyPlanView() {
    planSvg.setAttribute('viewBox', `${planView.x} ${planView.y} ${planView.w} ${planView.h}`);
    if (basemapViewTimer) clearTimeout(basemapViewTimer);
    basemapViewTimer = setTimeout(() => renderBasemap(planSvg), 120);
    if (!rescaleQueued) { rescaleQueued = true; requestAnimationFrame(rescaleUi); }
  }

  /** Screen pixels per SVG unit at the current zoom. */
  // The canvas size is read once per task: updateMarkerShape() runs for every
  // marker right after writing attributes, and a fresh getBoundingClientRect()
  // each time forced a layout per marker (≈ 300 ms per slider step at 800 plants).
  function canvasRect(): { width: number; height: number } {
    if (!canvasRectCache) {
      const r = planSvg.getBoundingClientRect();
      canvasRectCache = { width: r.width, height: r.height };
      queueMicrotask(() => { canvasRectCache = null; });
    }
    return canvasRectCache;
  }
  function pxPerUnit(): number {
    const r = canvasRect();
    const w = r.width || 700;
    if (!planView.w) return w / ((editing?.areaWidthM ?? 10) * U);
    return r.height && planView.h ? Math.min(w / planView.w, r.height / planView.h) : w / planView.w;
  }

  // ── Canvas size ──────────────────────────────────────────────────────
  // Width = the map column (grows with the window). Height = the window minus
  // header and legend (so the legend stays visible), or what the user dragged
  // with the grip under the map (remembered per device; double-click resets).
  const PLAN_H_KEY = 'pdk-plan-height';
  const MIN_PLAN_H = 240;
  function storedPlanHeight(): number | null {
    try { const v = Number(localStorage.getItem(PLAN_H_KEY)); return v >= MIN_PLAN_H ? v : null; } catch { return null; }
  }
  function autoPlanHeight(): number {
    const header = document.querySelector<HTMLElement>('.site-header');
    const headerH = header && getComputedStyle(header).position === 'sticky' ? header.getBoundingClientRect().height : 0;
    const legendH = document.getElementById('plan-legend')?.getBoundingClientRect().height ?? 0;
    const gripH = document.getElementById('plan-resize')?.getBoundingClientRect().height ?? 0;
    // gaps + breathing room
    return Math.max(MIN_PLAN_H, Math.round(window.innerHeight - headerH - legendH - gripH - 12 - 12));
  }
  function applyCanvasHeight(heightPx: number) {
    canvasRectCache = null;
    planSvg.style.height = `${heightPx}px`;
    plan3dContainer.style.height = `${heightPx}px`;
  }
  /** Apply a canvas height; keeps the view's center (or the whole plan, if it
   *  was fully in view) and adapts the view to the new canvas shape. */
  function sizePlanCanvas(heightPx = storedPlanHeight() ?? autoPlanHeight()) {
    const wasFit = !!editing && planView.w > 0 && planView.x <= 0.5 && planView.y <= 0.5
      && planView.x + planView.w >= editing.areaWidthM * U - 0.5 && planView.y + planView.h >= editing.areaHeightM * U - 0.5;
    applyCanvasHeight(heightPx);
    if (!editing || !planView.w) return;
    if (wasFit) resetPlanViewState();
    else {
      const cy = planView.y + planView.h / 2;
      const h = planView.w * canvasAspect();
      planView = { ...planView, y: cy - h / 2, h };
    }
    applyPlanView();
  }
  const fitPlanHeight = () => sizePlanCanvas();
  window.addEventListener('resize', fitPlanHeight);

  const planResize = document.getElementById('plan-resize')!;
  let resizeDrag: { id: number; y0: number; h0: number } | null = null;
  planResize.addEventListener('pointerdown', (e: PointerEvent) => {
    resizeDrag = { id: e.pointerId, y0: e.clientY, h0: (plan3dContainer.hidden ? planSvg : plan3dContainer).getBoundingClientRect().height };
    planResize.setPointerCapture(e.pointerId);
    e.preventDefault();
  });
  planResize.addEventListener('pointermove', (e: PointerEvent) => {
    if (!resizeDrag || e.pointerId !== resizeDrag.id) return;
    sizePlanCanvas(Math.max(MIN_PLAN_H, Math.round(resizeDrag.h0 + e.clientY - resizeDrag.y0)));
  });
  const endResize = (e: PointerEvent) => {
    if (!resizeDrag || e.pointerId !== resizeDrag.id) return;
    resizeDrag = null;
    try { localStorage.setItem(PLAN_H_KEY, String(Math.round(planSvg.getBoundingClientRect().height || plan3dContainer.getBoundingClientRect().height))); } catch {}
  };
  planResize.addEventListener('pointerup', endResize);
  planResize.addEventListener('pointercancel', endResize);
  planResize.addEventListener('dblclick', () => {
    try { localStorage.removeItem(PLAN_H_KEY); } catch {}
    sizePlanCanvas();
  });
  planResize.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
    e.preventDefault();
    const cur = (plan3dContainer.hidden ? planSvg : plan3dContainer).getBoundingClientRect().height;
    const next = Math.max(MIN_PLAN_H, Math.round(cur + (e.key === 'ArrowDown' ? 40 : -40)));
    try { localStorage.setItem(PLAN_H_KEY, String(next)); } catch {}
    sizePlanCanvas(next);
  });

  /** Scale for labels, strokes and handles: tied to the *visible* width, so
   *  text stays ~13 px on screen at any zoom (PDF export uses uiScale()). */
  function viewK(): number {
    if (planView.w) return planView.w / U / 7;
    return editing ? uiScale(editing.areaWidthM) : 1;
  }

  let rescaleQueued = false;
  function rescaleUi() {
    rescaleQueued = false;
    if (!editing) return;
    const k = viewK();
    const grid = planSvg.querySelector('#plan-grid-layer');
    if (grid) grid.innerHTML = gridDefsAndBackground(editing.areaWidthM, editing.areaHeightM, editing.gridSpacingM, 'plan-grid', k, pxPerUnit() * U, editing.gridRotationDeg ?? 0, editing.boundary);
    planSvg.querySelector('#plan-boundary')?.setAttribute('stroke-width', String(2 * k));
    renderMeasure();
    renderPluginOverlays();
    for (const pl of editing.placements) {
      const g = markerMap.get(pl.id);
      if (g) updateMarkerShape(g, pl, plantsById.get(pl.plantId));
    }
    renderAreasLayer();
    renderAreaDraft();
    renderRowDraft();
    renderContours();
    renderZones();
    renderWarnHover();
    renderWater();
    renderGps();
  }
  /** `base` zoomed by `factor` (>1 = in) around the SVG point cx/cy. */
  function zoomedView(base: typeof planView, factor: number, cx: number, cy: number): typeof planView {
    if (!editing) return base;
    const full = editing.areaWidthM * U;
    // Zoom out without a practical limit (50 km); tiles get coarser on their own.
    const w = Math.max(Math.min(full, 2 * U), Math.min(50000 * U, base.w / factor));
    const f = w / base.w;
    return { x: cx - (cx - base.x) * f, y: cy - (cy - base.y) * f, w, h: base.h * f };
  }
  function zoomAtCenter(factor: number) {
    planView = zoomedView(planView, factor, planView.x + planView.w / 2, planView.y + planView.h / 2);
    applyPlanView();
  }
  document.getElementById('zoom-in')!.addEventListener('click', () => zoomAtCenter(1.5));
  document.getElementById('zoom-out')!.addEventListener('click', () => zoomAtCenter(1 / 1.5));
  document.getElementById('zoom-fit')!.addEventListener('click', () => { resetPlanViewState(); applyPlanView(); });
  planSvg.addEventListener('wheel', (e: WheelEvent) => {
    if (!(e.ctrlKey || e.metaKey) || !editing) return;
    e.preventDefault();
    const p = clientToMeters(planSvg, e.clientX, e.clientY);
    planView = zoomedView(planView, Math.exp(-e.deltaY * 0.0025), p.xM * U, p.yM * U);
    applyPlanView();
  }, { passive: false });

  const activePointers = new Map<number, { x: number; y: number }>();
  let pan: { id: number; sx: number; sy: number; view: typeof planView; moved: boolean; target: Element | null } | null = null;
  let pinch: { d: number; view: typeof planView; cx: number; cy: number } | null = null;

  // Marker and corner-handle presses never get here: they stop propagation.
  planSvg.addEventListener('pointerdown', (e: PointerEvent) => {
    activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (tool === 'lasso' && activePointers.size === 1 && !areaDraft && !rowDraft && !armedPlantId) { startLasso(e); return; }
    if (activePointers.size === 2) {
      const [a, b] = [...activePointers.values()];
      const mid = clientToMeters(planSvg, (a.x + b.x) / 2, (a.y + b.y) / 2);
      pinch = { d: Math.hypot(a.x - b.x, a.y - b.y) || 1, view: { ...planView }, cx: mid.xM * U, cy: mid.yM * U };
      pan = null;
      return;
    }
    pan = { id: e.pointerId, sx: e.clientX, sy: e.clientY, view: { ...planView }, moved: false, target: e.target as Element };
  });

  planSvg.addEventListener('pointermove', (e: PointerEvent) => {
    if (activePointers.has(e.pointerId)) activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (lasso && e.pointerId === lasso.id) { extendLasso(e); return; }
    if (pinch && activePointers.size === 2) {
      const [a, b] = [...activePointers.values()];
      planView = zoomedView(pinch.view, Math.hypot(a.x - b.x, a.y - b.y) / pinch.d, pinch.cx, pinch.cy);
      applyPlanView();
      return;
    }
    if (!pan || e.pointerId !== pan.id || vertexDrag) return;
    if (!pan.moved && Math.hypot(e.clientX - pan.sx, e.clientY - pan.sy) > 4) {
      pan.moved = true;
      planSvg.setPointerCapture(e.pointerId);
    }
    if (!pan.moved) return;
    const unitsPerPx = 1 / pxPerUnit();
    planView = { ...pan.view, x: pan.view.x - (e.clientX - pan.sx) * unitsPerPx, y: pan.view.y - (e.clientY - pan.sy) * unitsPerPx };
    applyPlanView();
  });

  function endCanvasPointer(e: PointerEvent) {
    activePointers.delete(e.pointerId);
    if (lasso && e.pointerId === lasso.id) { finishLasso(); return; }
    if (activePointers.size < 2) pinch = null;
    if (!pan || e.pointerId !== pan.id) return;
    const p = pan;
    pan = null;
    if (!p.moved && e.type === 'pointerup') onCanvasTap(e, p.target);
  }
  planSvg.addEventListener('pointerup', endCanvasPointer);
  planSvg.addEventListener('pointercancel', endCanvasPointer);

  /** A tap (no pan) on the canvas: add an area corner while drawing, place
   *  the armed plant, otherwise select the tapped area / clear selection. */
  function onCanvasTap(e: PointerEvent, target: Element | null) {
    if (!editing) return;
    if (rowDraft) { addRowPoint(e); return; }
    if (packageArmed) { placePackage(e); return; }
    if (areaDraft) { addAreaDraftPoint(e); return; }
    if (armedPlantId) { placeArmedPlant(e); return; }
    if (tool === 'measure') { addMeasurePoint(e); return; }
    if (tool === 'pan') return; // the hand only moves the map
    if (multiSel.size) { multiSel.clear(); refreshMarkerHighlight(); renderSelectedPanel(); }
    const id = target?.closest<SVGElement>('[data-area-id]')?.dataset.areaId ?? null;
    if (id) setBoundaryEdit(false);
    if (id !== selectedAreaId) { selectedAreaId = id; markSelectedArea(); }
  }

  // ── Umriss bearbeiten ───────────────────────────────────────────────────
  let editBoundary = false;
  function setBoundaryEdit(on: boolean) {
    if (on === editBoundary) return;
    editBoundary = on;
    btnEditBoundary.setAttribute('aria-pressed', String(on));
    boundaryEditBar.classList.toggle('hidden', !on);
    if (on && selectedAreaId) { selectedAreaId = null; markSelectedArea(); }
    renderAreaHandles();
    renderSelectedPanel();
  }
  btnEditBoundary.addEventListener('click', () => {
    if (!plan3dContainer.hidden) btnView2d.click();
    endAreaDraw();
    setBoundaryEdit(!editBoundary);
  });
  document.getElementById('btn-boundary-done')!.addEventListener('click', () => setBoundaryEdit(false));

  /** After any geometry change (corner, area, plant moved): grow the plan if
   *  something now lies outside it, keeping the view on the same spot. */
  function afterGeometryEdit() {
    if (!editing) return;
    const w0 = editing.areaWidthM, h0 = editing.areaHeightM;
    const shift = growPlanToFit(editing, 1);
    if (shift) {
      planView = { ...planView, x: planView.x + shift.dx * U, y: planView.y + shift.dy * U };
      fWidth.value = String(editing.areaWidthM);
      fHeight.value = String(editing.areaHeightM);
      planView.h = planView.w * canvasAspect();
      renderPlanSvg();
      if (!plan3dContainer.hidden) btnView3d.click();
      void loadTerrain();
      showToast(t('toastPlanGrown', { w: editing.areaWidthM, h: editing.areaHeightM, w0, h0 }));
    }
    renderCoverage();
    scheduleAutosave();
  }


  function renderAreaDraft() {
    const g = planSvg.querySelector('#area-draft');
    if (!g) return;
    if (!areaDraft || !editing) { g.innerHTML = ''; return; }
    const u = SVG_UNITS_PER_METER, k = viewK();
    const color = AREA_PALETTE[editing.areas.length % AREA_PALETTE.length];
    const pts = areaDraft.map(p => `${p.xM * u},${p.yM * u}`).join(' ');
    g.innerHTML = `
      ${areaDraft.length >= 3 ? `<polygon points="${pts}" fill="${color}" fill-opacity="0.2" stroke="none"/>` : ''}
      ${areaDraft.length >= 2 ? `<polyline points="${pts}" fill="none" stroke="${color}" stroke-width="${3 * k}" stroke-dasharray="${8 * k} ${5 * k}"/>` : ''}
      ${areaDraft.map((p, i) => `<circle cx="${p.xM * u}" cy="${p.yM * u}" r="${(i === 0 ? 9 : 6) * k}" fill="${i === 0 ? '#ffffff' : color}" stroke="${color}" stroke-width="${3 * k}"/>`).join('')}`;
    btnAreaFinish.disabled = areaDraft.length < 3;
  }

  function markSelectedArea() {
    areasList.querySelectorAll<HTMLElement>('[data-area-id]').forEach(li => {
      const on = li.dataset.areaId === selectedAreaId;
      ['bg-white', 'dark:bg-stone-800', 'ring-1', 'ring-green-500'].forEach(c => li.classList.toggle(c, on));
    });
    areaEditHint.hidden = !editing?.areas.some(a => a.id === selectedAreaId);
    if (selectedAreaId && multiSel.size) multiSel.clear();
    if (selectedAreaId && selectedPlacementId) {
      selectedPlacementId = null;
      for (const pl of editing?.placements ?? []) { const g = markerMap.get(pl.id); if (g) updateMarkerShape(g, pl, plantsById.get(pl.plantId)); }
      view3d?.setSelectedPlacement(null);
    }
    renderAreasLayer();
    renderSelectedPanel();
  }

  function renderAreasList() {
    if (!editing) return;
    areasEmpty.classList.toggle('hidden', editing.areas.length > 0);
    areasList.innerHTML = editing.areas.map(a => `
      <li data-area-id="${a.id}" class="flex items-center gap-1.5 rounded-md p-1">
        <input type="color" value="${a.color}" class="area-color h-7 w-8 shrink-0 cursor-pointer rounded border border-stone-300 dark:border-stone-600 bg-transparent p-0" aria-label="${escapeHtml(t('areaColor'))}" title="${escapeHtml(t('areaColor'))}" />
        <input type="text" value="${escapeHtml(a.name)}" maxlength="80" class="area-name min-w-0 flex-1 rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2 py-1 text-xs" aria-label="${escapeHtml(t('areaName'))}" />
        <button type="button" class="area-delete shrink-0 rounded px-1.5 py-1 text-stone-400 hover:text-red-600 dark:hover:text-red-400" aria-label="${escapeHtml(t('areaDelete'))}" title="${escapeHtml(t('areaDelete'))}">✕</button>
      </li>`).join('');
    markSelectedArea();
  }

  function areaOf(el: EventTarget | null): GardenPlanArea | undefined {
    const id = (el as HTMLElement | null)?.closest<HTMLElement>('[data-area-id]')?.dataset.areaId;
    return id ? editing?.areas.find(a => a.id === id) : undefined;
  }
  areasList.addEventListener('focusin', e => {
    const a = areaOf(e.target);
    if (a && a.id !== selectedAreaId) { setBoundaryEdit(false); selectedAreaId = a.id; markSelectedArea(); }
  });
  areasList.addEventListener('input', e => {
    const a = areaOf(e.target);
    const el = e.target as HTMLInputElement;
    if (!a) return;
    if (el.classList.contains('area-name')) a.name = el.value.slice(0, 80);
    if (el.classList.contains('area-color')) a.color = el.value;
    renderAreasLayer();
    scheduleAutosave();
  });
  areasList.addEventListener('click', e => {
    if (!(e.target as HTMLElement).closest('.area-delete') || !editing) return;
    const a = areaOf(e.target);
    if (!a || !confirm(t('confirmDeleteArea', { name: a.name || '—' }))) return;
    editing.areas = editing.areas.filter(x => x.id !== a.id);
    if (selectedAreaId === a.id) selectedAreaId = null;
    renderAreasList();
    scheduleAutosave();
  });

  function endAreaDraw() {
    areaDraft = null;
    areaDrawBar.classList.add('hidden');
    planSvg.classList.remove('area-drawing');
    btnDrawArea.disabled = false;
    renderAreaDraft();
  }

  function finishAreaDraw() {
    if (!editing || !areaDraft || areaDraft.length < 3) return;
    const area: GardenPlanArea = {
      id: newId(),
      name: t('areaDefaultName', { n: editing.areas.length + 1 }),
      color: AREA_PALETTE[editing.areas.length % AREA_PALETTE.length],
      points: areaDraft.slice(),
    };
    editing.areas.push(area);
    selectedAreaId = area.id;
    endAreaDraw();
    renderAreasList();
    afterGeometryEdit();
    const input = areasList.querySelector<HTMLInputElement>(`[data-area-id="${area.id}"] .area-name`);
    input?.focus();
    input?.select();
  }

  btnDrawArea.addEventListener('click', () => {
    if (!editing) return;
    if (!plan3dContainer.hidden) btnView2d.click();
    armedPlantId = null;
    armedHint.classList.add('hidden');
    renderPlantPicker();
    renderUnplacedList();
    setBoundaryEdit(false);
    endRowDraw();
    areaDraft = [];
    renderAreaHandles();
    areaDrawBar.classList.remove('hidden');
    planSvg.classList.add('area-drawing');
    btnDrawArea.disabled = true;
    renderAreaDraft();
  });
  document.getElementById('btn-area-undo')!.addEventListener('click', () => { areaDraft?.pop(); renderAreaDraft(); });
  document.getElementById('btn-area-cancel')!.addEventListener('click', endAreaDraw);
  btnAreaFinish.addEventListener('click', finishAreaDraw);
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (measurePts.length) clearMeasure();
    else if (rowDraft) endRowDraw();
    else if (packageArmed) setPackageArmed(null);
    else if (multiSel.size) { multiSel.clear(); refreshMarkerHighlight(); renderSelectedPanel(); }
    else if (areaDraft) endAreaDraw();
    else if (editBoundary) setBoundaryEdit(false);
    else if (selectedAreaId && !(e.target as HTMLElement).closest?.('input, textarea, select')) { selectedAreaId = null; markSelectedArea(); }
  });

  function addAreaDraftPoint(e: PointerEvent) {
    if (!editing || !areaDraft) return;
    const raw = clientToMeters(planSvg, e.clientX, e.clientY);
    const first = areaDraft[0];
    const ctm = planSvg.getScreenCTM();
    if (first && areaDraft.length >= 3 && ctm) {
      const pxPerM = Math.hypot(ctm.a, ctm.b) * SVG_UNITS_PER_METER;
      if (Math.hypot(raw.xM - first.xM, raw.yM - first.yM) * pxPerM <= SNAP_TOLERANCE_PX) { finishAreaDraw(); return; }
    }
    areaDraft.push(snapIfClose(planSvg, raw, editing.gridSpacingM));
    renderAreaDraft();
  }

  // ── Reihe pflanzen (Linien-Werkzeug) ───────────────────────────────────
  // The armed plant is placed every `spacing` m along a clicked polyline.
  // Spacing defaults to the plant's mature width. Points snap to the grid;
  // a row past the edge grows the plan like any other geometry edit.
  const rowDrawBar = document.getElementById('row-draw-bar')!;
  const rowSpacingInput = document.getElementById('row-spacing') as HTMLInputElement;
  const btnRowFinish = document.getElementById('btn-row-finish') as HTMLButtonElement;
  let rowDraft: GardenPlanPoint[] | null = null;
  let rowPlantId: string | null = null;

  function rowPositions(): GardenPlanPoint[] {
    if (!rowDraft || rowDraft.length < 2) return rowDraft ? [...rowDraft] : [];
    return pointsAlongPolyline(rowDraft, Math.max(0.1, Number(rowSpacingInput.value) || 1));
  }

  function renderRowDraft() {
    const g = planSvg.querySelector('#row-draft');
    if (!g) return;
    if (!rowDraft || !editing) { g.innerHTML = ''; return; }
    const u = SVG_UNITS_PER_METER, k = viewK();
    const p = rowPlantId ? plantsById.get(rowPlantId) : undefined;
    const fill = p ? LAYER_STYLE[deriveLayer(p)].fill : '#15803d';
    const line = rowDraft.map(q => `${q.xM * u},${q.yM * u}`).join(' ');
    const spots = rowPositions();
    g.innerHTML = `
      ${rowDraft.length >= 2 ? `<polyline points="${line}" fill="none" stroke="#b45309" stroke-width="${2 * k}" stroke-dasharray="${6 * k} ${4 * k}"/>` : ''}
      ${spots.map(q => `<circle cx="${q.xM * u}" cy="${q.yM * u}" r="${5 * k}" fill="${fill}" fill-opacity="0.85" stroke="#ffffff" stroke-width="${1.5 * k}"/>`).join('')}`;
    document.getElementById('row-count')!.textContent = rowDraft.length >= 2 ? t('rowCount', { n: spots.length }) : '';
    btnRowFinish.disabled = rowDraft.length < 2;
  }

  function endRowDraw() {
    if (!rowDraft) return;
    rowDraft = null;
    rowPlantId = null;
    rowDrawBar.classList.add('hidden');
    planSvg.classList.remove('area-drawing');
    renderRowDraft();
  }

  function addRowPoint(e: PointerEvent) {
    if (!editing || !rowDraft) return;
    rowDraft.push(snapIfClose(planSvg, clientToMeters(planSvg, e.clientX, e.clientY), editing.gridSpacingM));
    renderRowDraft();
  }

  document.getElementById('btn-draw-row')!.addEventListener('click', () => {
    if (!editing) return;
    if (!armedPlantId) { alert(t('rowNeedPlant')); return; }
    if (!plan3dContainer.hidden) btnView2d.click();
    endAreaDraw();
    setBoundaryEdit(false);
    rowPlantId = armedPlantId;
    const p = plantsById.get(rowPlantId);
    rowSpacingInput.value = String(Math.max(0.1, Math.round((p?.widthM || 1) * 10) / 10));
    document.getElementById('row-draw-hint')!.textContent = t('rowHint', { name: p ? displayName(p) : '?' });
    rowDraft = [];
    rowDrawBar.classList.remove('hidden');
    planSvg.classList.add('area-drawing');
    renderRowDraft();
  });
  rowSpacingInput.addEventListener('input', renderRowDraft);
  document.getElementById('btn-row-undo')!.addEventListener('click', () => { rowDraft?.pop(); renderRowDraft(); });
  document.getElementById('btn-row-cancel')!.addEventListener('click', endRowDraw);
  btnRowFinish.addEventListener('click', () => {
    if (!editing || !rowDraft || rowDraft.length < 2 || !rowPlantId) return;
    const spots = rowPositions();
    const plantId = rowPlantId;
    for (const q of spots) editing.placements.push({ id: newId(), plantId, xM: q.xM, yM: q.yM, notes: '' });
    unplacedPlantIds = unplacedPlantIds.filter(id => id !== plantId);
    const p = plantsById.get(plantId);
    endRowDraw();
    renderUnplacedList();
    renderSuggestions();
    renderPlanSvg();
    afterGeometryEdit();
    showToast(t('toastRowPlanted', { n: spots.length, name: p ? displayName(p) : '?' }));
  });

  // ── GeoJSON für QGIS: Export & Import ──────────────────────────────────
  document.getElementById('btn-export-geojson')!.addEventListener('click', async () => {
    if (!editing) return;
    if (!editing.geo) { alert(t('geojsonNeedsLocation')); return; }
    syncFormIntoEditing();
    const { planToGeoJson } = await import('../lib/gartenplan-geojson');
    const blob = new Blob([JSON.stringify(planToGeoJson(editing, plantsById), null, 1)], { type: 'application/geo+json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `${(editing.name || 'gartenplan').replace(/[^\p{L}\p{N}_-]+/gu, '_')}.geojson`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });

  (document.getElementById('geojson-input') as HTMLInputElement).addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    try {
      const { planFromGeoJson } = await import('../lib/gartenplan-geojson');
      const r = planFromGeoJson(JSON.parse(await file.text()), plants);
      // A file exported from an existing plan can update it in place.
      const existing = r.sourcePlanId ? plans.find(p => p.id === r.sourcePlanId) : undefined;
      if (existing && confirm(t('confirmGeojsonUpdate', { name: existing.name || t('planUnnamed') }))) {
        r.plan.createdAt = existing.createdAt;
        r.plan.polycultureId = existing.polycultureId;
      } else {
        r.plan.id = newId();
        r.plan.areas.forEach(a => { a.id = newId(); });
        r.plan.placements.forEach(pl => { pl.id = newId(); });
      }
      if (r.newPlants.length) {
        await importPlants(r.newPlants);
        plants = await getAllPlants();
        plantsById = new Map(plants.map(p => [p.id, p]));
      }
      const plan = normalizeGardenPlan(r.plan)!;
      await saveGardenPlan(plan);
      plans = await getAllGardenPlans();
      renderList();
      openEditor(plan.id);
      showToast(t('toastGeojsonImported', { areas: plan.areas.length, plants: plan.placements.length, created: r.newPlants.length }));
    } catch (err) {
      alert(t('alertGeojsonFailed', { msg: err instanceof Error ? err.message : String(err) }));
    }
  });

  // ── Werkzeuge: Bewegen / Markieren einzeln / Markieren als Fläche ───────
  // Pan: every drag moves the map (markers and areas ignore the pointer).
  // Select: the classic behaviour — click selects, drag moves, drag on bare
  // ground pans; Shift/Ctrl-click builds a multi-selection.
  // Lasso: drag around plants to mark them all.
  type Tool = 'pan' | 'select' | 'lasso' | 'measure';
  let tool: Tool = 'select';
  const multiSel = new Set<string>();
  let lasso: { id: number; pts: GardenPlanPoint[]; lastX: number; lastY: number } | null = null;

  function setTool(t: Tool) {
    tool = t;
    document.querySelectorAll<HTMLElement>('[data-tool]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tool === t)));
    planSvg.classList.toggle('tool-pan', t === 'pan');
    planSvg.classList.toggle('tool-lasso', t === 'lasso');
    planSvg.classList.toggle('tool-measure', t === 'measure');
    if (t !== 'measure') clearMeasure();
  }
  document.querySelectorAll<HTMLElement>('[data-tool]').forEach(b => b.addEventListener('click', () => setTool(b.dataset.tool as Tool)));

  function refreshMarkerHighlight() {
    for (const pl of editing?.placements ?? []) {
      const g = markerMap.get(pl.id);
      if (g) updateMarkerShape(g, pl, plantsById.get(pl.plantId));
    }
  }

  function renderLasso() {
    const g = planSvg.querySelector('#lasso-layer');
    if (!g) return;
    if (!lasso || lasso.pts.length < 2) { g.innerHTML = ''; return; }
    const u = SVG_UNITS_PER_METER, k = viewK();
    g.innerHTML = `<polygon points="${lasso.pts.map(p => `${p.xM * u},${p.yM * u}`).join(' ')}" fill="#f59e0b" fill-opacity="0.12" stroke="#d97706" stroke-width="${1.5 * k}" stroke-dasharray="${5 * k} ${4 * k}"/>`;
  }

  function startLasso(e: PointerEvent) {
    lasso = { id: e.pointerId, pts: [clientToMeters(planSvg, e.clientX, e.clientY)], lastX: e.clientX, lastY: e.clientY };
    planSvg.setPointerCapture(e.pointerId);
  }

  function extendLasso(e: PointerEvent) {
    if (!lasso || Math.hypot(e.clientX - lasso.lastX, e.clientY - lasso.lastY) < 3) return;
    lasso.lastX = e.clientX;
    lasso.lastY = e.clientY;
    lasso.pts.push(clientToMeters(planSvg, e.clientX, e.clientY));
    renderLasso();
  }

  function finishLasso() {
    const l = lasso;
    lasso = null;
    renderLasso();
    if (!editing || !l) return;
    multiSel.clear();
    selectedPlacementId = null;
    if (l.pts.length >= 3) {
      for (const pl of editing.placements) if (pointInPolygon(pl, l.pts)) multiSel.add(pl.id);
    }
    if (multiSel.size && selectedAreaId) { selectedAreaId = null; markSelectedArea(); }
    refreshMarkerHighlight();
    renderSelectedPanel();
  }

  // Sidebar panels: collapsible, open/closed state remembered per device.
  const PANELS_KEY = 'pdk-gp-panels';
  let panelState: Record<string, boolean> = {};
  try { panelState = JSON.parse(localStorage.getItem(PANELS_KEY) || '{}'); } catch {}
  document.querySelectorAll<HTMLDetailsElement>('details[data-panel]').forEach(d => {
    const k = d.dataset.panel!;
    if (k in panelState) d.open = panelState[k];
    d.addEventListener('toggle', () => {
      panelState[k] = d.open;
      try { localStorage.setItem(PANELS_KEY, JSON.stringify(panelState)); } catch {}
    });
  });

  // ── Tastenkürzel (Übersicht mit „?“, siehe Layout) ─────────────────────
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const tgt = e.target as HTMLElement | null;
    if (tgt && (tgt.tagName === 'INPUT' || tgt.tagName === 'TEXTAREA' || tgt.tagName === 'SELECT' || tgt.isContentEditable)) return;
    if (document.querySelector('dialog[open]')) return;
    if (!editing || phaseB.classList.contains('hidden')) return;
    if ((e.ctrlKey || e.metaKey) && !e.altKey) {
      const k = e.key.toLowerCase();
      if (k === 'z') { e.preventDefault(); stepHistory(e.shiftKey ? 1 : -1); }
      else if (k === 'y' && !e.shiftKey) { e.preventDefault(); stepHistory(1); }
      return;
    }
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const in2d = plan3dContainer.hidden;
    const click = (id: string) => (document.getElementById(id) as HTMLButtonElement | null)?.click();
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    const keyFeature: Record<string, string> = { l: 'lasso', m: 'measure', f: 'areas', r: 'row', u: 'boundary-edit', t: 'sun-advanced', p: 'sun-advanced', b: 'buildings' };
    if (keyFeature[key] && !featureOn(keyFeature[key])) return;
    let handled = true;
    switch (key) {
      case '2': if (!in2d) btnView2d.click(); break;
      case '3': if (in2d) btnView3d.click(); break;
      case 'h': if (in2d) setTool('pan'); break;
      case 'v': if (in2d) setTool('select'); break;
      case 'l': if (in2d) setTool('lasso'); break;
      case 'm': if (in2d) setTool(tool === 'measure' ? 'select' : 'measure'); break;
      case '+': case '=': if (in2d) zoomAtCenter(1.5); break;
      case '-': if (in2d) zoomAtCenter(1 / 1.5); break;
      case '0': if (in2d) { resetPlanViewState(); applyPlanView(); } break;
      case 'f': btnDrawArea.click(); break;
      case 'r': click('btn-draw-row'); break;
      case 'u': btnEditBoundary.click(); break;
      case 'g': gridInput.click(); break;
      case 't': if (!in2d) setPreset(lastPreset === 'top' ? 'oblique' : 'top'); break;
      case 'i': case 'o': {
        // Years since planting: I fewer, O more (2D and 3D).
        const v = Math.min(Number(yearsInput.max), Math.max(Number(yearsInput.min), Number(yearsInput.value) + (key === 'o' ? 1 : -1)));
        stopGrowth();
        setYears(v);
        break;
      }
      case 'p': if (!in2d) void saveSnapshot(); break;
      case 'b': if (editing.geo) buildingsInput.click(); break;
      case 'j': case 'k':
        // Time of day (3D sun): K later, J earlier; Shift = whole hours.
        if (!in2d && !sunControls.hidden) {
          const step = (e.shiftKey ? 60 : 15) * (key === 'k' ? 1 : -1);
          const v = (Number(sunTimeInput.value) + step + 1440) % 1440;
          stopSunPlay();
          sunTimeInput.value = String(Math.min(1435, v));
          applySun();
        } else handled = false;
        break;
      case 'Delete': case 'Backspace':
        if (multiSel.size) click('btn-multi-remove');
        else if (selectedPlacementId) click('btn-remove-placement');
        else if (selectedAreaId) click('btn-remove-area');
        else handled = false;
        break;
      default: handled = false;
    }
    if (handled) e.preventDefault();
  });

  // ── Gelände (Höhendaten) ───────────────────────────────────────────────
  // Loaded once per plan location/size from the open Terrain Tiles; drives
  // the 3D ground, the 2D contour lines and the slope read-out.
  let terrain: ElevationGrid | null = null;
  let terrainKey = '';
  const contoursToggle = document.getElementById('contours-toggle')!;
  const contoursInput = document.getElementById('g-contours') as HTMLInputElement;
  const terrainInfo = document.getElementById('terrain-info')!;
  try { contoursInput.checked = localStorage.getItem('pgd-contours') !== '0'; } catch {}
  contoursInput.addEventListener('change', () => {
    try { localStorage.setItem('pgd-contours', contoursInput.checked ? '1' : '0'); } catch {}
    renderContours();
  });

  async function loadTerrain() {
    void loadClimate();
    const plan = editing;
    const geo = plan?.geo;
    if (!plan || !geo) { terrain = null; terrainKey = ''; geoGate(contoursToggle, false); terrainInfo.textContent = ''; renderContours(); return; }
    const key = `${plan.id}|${geo.lat}|${geo.lon}|${geo.rotationDeg}|${plan.areaWidthM}|${plan.areaHeightM}`;
    if (key === terrainKey) return;
    terrainKey = key;
    // Never keep showing the previous plan's ground while the new one loads.
    terrain = null;
    renderContours();
    renderWater();
    terrainInfo.textContent = t('terrainLoading');
    const maxDim = Math.max(plan.areaWidthM, plan.areaHeightM);
    // Margin covers the OSM buildings (150 m) so they stand on the same
    // ground as the 3D terrain around them.
    const m = Math.max(160, maxDim);
    // With an official 1 m model (dgm.ts) the grid gets finer and is refined
    // with its heights; elsewhere the Terrain Tiles alone (≈ 25–30 m data).
    const dgm = dgmFor(geo.lat, geo.lon);
    const span = maxDim + 2 * m;
    try {
      let grid = await fetchElevationGrid(geo, { minX: -m, minY: -m, maxX: plan.areaWidthM + m, maxY: plan.areaHeightM + m }, Math.min(4, Math.max(1, span / (dgm ? 300 : 100))));
      if (dgm && terrainKey === key) {
        terrainInfo.textContent = t('terrainLoadingDgm', { region: dgm.region[lang] });
        try { grid = (await refineWithDgm(grid, geo)) ?? grid; } catch { /* keep the coarse grid */ }
      }
      if (terrainKey !== key || editing !== plan) return; // plan changed meanwhile
      terrain = grid;
    } catch {
      if (terrainKey !== key) return;
      terrain = null;
      terrainInfo.textContent = t('terrainUnavailable');
      contoursToggle.hidden = true;
      return;
    }
    geoGate(contoursToggle, true);
    scheduleWarnings(); // terrain shade
    updateTerrainInfo();
    renderContours();
    renderBasemap(planSvg);
    if (!plan3dContainer.hidden) btnView3d.click(); // rebuild 3D on the terrain, camera kept
  }

  function updateTerrainInfo() {
    if (!editing || !terrain) { terrainInfo.textContent = ''; return; }
    const boundary = editing.boundary;
    const s = slopeInfo(terrain, (x, y) => boundary.length >= 3 ? pointInPolygon({ xM: x, yM: y }, boundary) : true, editing.geo?.rotationDeg ?? 0);
    siteSlope = s ? { slopeDeg: s.slopeDeg, aspectDeg: s.aspectDeg } : null;
    renderZones();
    renderWater();
    if (!s) { terrainInfo.textContent = ''; return; }
    const fmt = (v: number, d = 1) => new Intl.NumberFormat(lang, { maximumFractionDigits: d }).format(v);
    terrainInfo.textContent = (s.aspectDeg === null
      ? t('terrainFlat', { elev: fmt(s.meanM, 0), range: fmt(s.maxM - s.minM) })
      : t('terrainInfo', { elev: fmt(s.meanM, 0), slope: fmt(s.slopeDeg), dir: compassLabel(s.aspectDeg, lang), range: fmt(s.maxM - s.minM) }))
      + (terrain.dgm ? ` · ${t('terrainDgmLabel', { region: terrain.dgm.region[lang], res: fmt(terrain.dgm.resolutionM) })}` : '');
  }

  function renderContours() {
    const layer = planSvg.querySelector('#contour-layer');
    if (!layer) return;
    if (!terrain || !contoursInput.checked || !editing?.geo || !featureOn('terrain')) { layer.innerHTML = ''; return; }
    let lo = Infinity, hi = -Infinity;
    for (const h of terrain.heights) { lo = Math.min(lo, h); hi = Math.max(hi, h); }
    const interval = contourInterval(hi - lo);
    const byLevel = new Map<number, string[]>();
    for (const { level, seg } of contourSegments(terrain, interval)) {
      const arr = byLevel.get(level) ?? [];
      arr.push(`M${seg[0] * U} ${seg[1] * U}L${seg[2] * U} ${seg[3] * U}`);
      byLevel.set(level, arr);
    }
    const ppu = pxPerUnit();
    layer.innerHTML = [...byLevel.entries()].map(([level, d]) => {
      const index = Math.abs(level / (interval * 5) - Math.round(level / (interval * 5))) < 1e-6;
      return `<path d="${d.join('')}" fill="none" stroke="#92400e" stroke-opacity="${index ? 0.7 : 0.45}" stroke-width="${(index ? 1.8 : 1) / ppu}"/>`;
    }).join('');
  }

  // ── Funktions-Abdeckung ────────────────────────────────────────────────
  // Map mode: colour the garden by which ecological functions are provided
  // nearby (function-coverage.ts), list gaps and suggest plants for them.
  const coverageSelect = document.getElementById('g-coverage') as HTMLSelectElement;
  const coverageSection = document.getElementById('coverage-section')!;
  const coverageBody = document.getElementById('coverage-body')!;
  const fnLabel = (f: CoverFunc) => BOOL_FIELDS.find(b => b.key === f)?.label[lang] ?? f;
  coverageSelect.innerHTML = `<option value="">${t('coverageOff')}</option>`
    + `<optgroup label="${escapeHtml(t('covGroupFunctions'))}"><option value="all">${t('coverageAll')}</option>`
    + COVER_FUNCS.map(f => `<option value="${f}">${escapeHtml(fnLabel(f))}</option>`).join('') + '</optgroup>'
    + `<optgroup label="${escapeHtml(t('covGroupSun'))}"><option value="sun-day">${escapeHtml(t('sunMapDay'))}</option><option value="sun-season">${escapeHtml(t('sunMapSeason'))}</option></optgroup>`;
  const coverageHeading = document.getElementById('coverage-heading')!;
  coverageSelect.addEventListener('change', renderCoverage);

  let coverageTimer: ReturnType<typeof setTimeout> | null = null;
  function scheduleCoverage() {
    if (coverageTimer) clearTimeout(coverageTimer);
    coverageTimer = setTimeout(renderCoverage, 150);
  }

  /** Red → yellow → green for 0..1. */
  function rampColor(f: number): string {
    const hue = Math.round(f * 125);
    return `hsl(${hue}, 75%, 45%)`; // comma syntax: also parsed by THREE.Color
  }
  /** The same colouring for the 3D view (kept so a newly built 3D view gets it). */
  let coverage3d: import('../lib/gartenplan-3d').CoverageOverlay3D | null = null;

  function renderCoverage() {
    const layer = planSvg.querySelector('#coverage-layer');
    const raw = featureOn('coverage') ? coverageSelect.value : '';
    if (raw === 'sun-day' || raw === 'sun-season') { void renderSunMap(raw); return; }
    sunMapToken++;
    coverageHeading.textContent = t('coverageHeading');
    const mode = raw as '' | 'all' | CoverFunc;
    coverageSection.hidden = !mode || !editing;
    if (!layer) return;
    if (!mode || !editing || editing.boundary.length < 3) { layer.innerHTML = ''; coverage3d = null; view3d?.setCoverage(null); return; }
    const plan = editing;
    const cellM = Math.max(0.5, Math.min(plan.areaWidthM, plan.areaHeightM) / 40);
    const grid = coverageGrid(plan, plantsById, cellM);
    // One path per colour keeps the DOM small.
    const buckets = new Map<string, string[]>();
    const half = cellM * U / 2;
    for (const c of grid.cells) {
      const color = mode === 'all' ? rampColor(funcCount(c.mask) / COVER_FUNCS.length) : hasFunc(c.mask, mode) ? '#16a34a' : '#dc2626';
      const arr = buckets.get(color) ?? [];
      arr.push(`M${c.xM * U - half} ${c.yM * U - half}h${2 * half}v${2 * half}h${-2 * half}z`);
      buckets.set(color, arr);
    }
    let svg = [...buckets.entries()].map(([color, d]) => `<path d="${d.join('')}" fill="${color}" fill-opacity="0.32"/>`).join('');
    const cells3d = grid.cells.map(c => ({ xM: c.xM, yM: c.yM, color: mode === 'all' ? rampColor(funcCount(c.mask) / COVER_FUNCS.length) : hasFunc(c.mask, mode) ? '#16a34a' : '#dc2626' }));
    coverage3d = { cellM, cells: cells3d, gaps: [] };

    const summary = coverageSummary(grid);
    if (mode === 'all') {
      coverageBody.innerHTML = `<p class="text-stone-500 dark:text-stone-400">${t('coverageAllHint')}</p>`
        + COVER_FUNCS.map(f => `
          <button type="button" data-cov-fn="${f}" class="block w-full text-left">
            <span class="flex justify-between"><span>${escapeHtml(fnLabel(f))}</span><span class="font-mono">${Math.round(summary[f] * 100)} %</span></span>
            <span class="mt-0.5 block h-1.5 rounded bg-stone-200 dark:bg-stone-700"><span class="block h-1.5 rounded" style="width:${Math.round(summary[f] * 100)}%;background:${rampColor(summary[f])}"></span></span>
          </button>`).join('');
    } else {
      const gaps = findGaps(grid, mode, 3);
      coverage3d.gaps = gaps.map(g => ({ xM: g.xM, yM: g.yM, rM: Math.sqrt(g.areaM2 / Math.PI) * 0.6 }));
      const k = viewK();
      svg += gaps.map(g => `<g transform="translate(${g.xM * U},${g.yM * U})"><circle r="${Math.sqrt(g.areaM2 / Math.PI) * U * 0.6}" fill="none" stroke="#b91c1c" stroke-width="${2 * k}" stroke-dasharray="${6 * k} ${4 * k}"/><text text-anchor="middle" dominant-baseline="central" font-size="${16 * k}" font-weight="700" fill="#b91c1c" stroke="#fff" stroke-width="${3 * k}" paint-order="stroke">+</text></g>`).join('');
      const gapScene = gaps.length ? sunContext().scene : null;
      const rows = gaps.map((g, gi) => {
        const sunH = sunHoursAt(g.xM, g.yM, gapScene!, seasonSamples());
        const sugg = suggestPlants(mode, plants, plan, plantsById, g, g.areaM2, 3, sunClass(sunH));
        const btns = sugg.length
          ? sugg.map(p => `<button type="button" data-gap="${gi}" data-plant="${p.id}" class="mt-1 block w-full rounded bg-white dark:bg-stone-800 px-2 py-1 text-left ring-1 ring-stone-200 dark:ring-stone-700 hover:bg-green-50 hover:ring-green-500 focus-visible:ring-green-500 dark:hover:bg-green-900/30">
              <span class="block truncate">${escapeHtml(t('coveragePlantHere', { name: displayName(p) }))}</span>
              <span class="block truncate text-[11px] text-stone-500 dark:text-stone-400">${escapeHtml(suggestionMeta(p))}</span></button>`).join('')
          : `<p class="text-stone-500 dark:text-stone-400">${t('coverageNoPlants')}</p>`;
        return `<div class="rounded-md bg-red-50 dark:bg-red-900/20 p-2"><p class="font-medium text-red-800 dark:text-red-200">${t('coverageGap', { area: Math.round(g.areaM2) })} · ${escapeHtml(t('sunAtGap', { h: fmtH(sunH), cls: t(SUN_CLASS_KEY[sunClass(sunH)]) }))}</p>${btns}</div>`;
      }).join('');
      coverageBody.innerHTML = `<p class="text-stone-500 dark:text-stone-400">${escapeHtml(fnLabel(mode))}: ${Math.round(summary[mode] * 100)} % · ${t('coverageFnHint')}</p>`
        + (gaps.length ? rows : `<p class="text-green-700 dark:text-green-400">${t('coverageNoGap')}</p>`);
      coverageBody.querySelectorAll<HTMLButtonElement>('[data-gap]').forEach(b => {
        const show = () => showSuggestionPreview(gaps[Number(b.dataset.gap)], plantsById.get(b.dataset.plant!), mode);
        b.addEventListener('pointerenter', show);
        b.addEventListener('focus', show);
        b.addEventListener('pointerleave', hideSuggestionPreview);
        b.addEventListener('blur', hideSuggestionPreview);
      });
      coverageBody.querySelectorAll<HTMLButtonElement>('[data-gap]').forEach(b => b.addEventListener('click', () => {
        const g = gaps[Number(b.dataset.gap)];
        const p = plantsById.get(b.dataset.plant!);
        if (!g || !p || !editing) return;
        editing.placements.push({ id: newId(), plantId: p.id, xM: g.xM, yM: g.yM, notes: '' });
        renderPlanSvg();
        view3d?.refreshPlacements();
        renderSuggestions();
        scheduleAutosave();
        showToast(t('toastPlantedAtGap', { name: displayName(p) }));
      }));
    }
    coverageBody.querySelectorAll<HTMLButtonElement>('[data-cov-fn]').forEach(b => b.addEventListener('click', () => {
      coverageSelect.value = b.dataset.covFn!;
      renderCoverage();
    }));
    layer.innerHTML = svg;
    view3d?.setCoverage(coverage3d);
  }

  /** "Höhe 4 m · Breite 4 m · Stickstoff-Fixierer, Windschutz" */
  const shortM = (v: number) => `${String(+v.toFixed(1)).replace('.', lang === 'de' ? ',' : '.')} m`;
  function suggestionMeta(p: PlantData): string {
    const parts: string[] = [];
    if (p.heightM) parts.push(t('suggMetaHeight', { m: shortM(p.heightM) }));
    if (p.widthM) parts.push(t('suggMetaWidth', { m: shortM(p.widthM) }));
    const fns = COVER_FUNCS.filter(f => p[f]).map(fnLabel);
    if (fns.length) parts.push(fns.join(', '));
    return parts.join(' · ');
  }

  /** Hover preview of a suggestion at its gap: dashed crown at the current
   *  size, the reach of the function, and the plant name. */
  function showSuggestionPreview(g: { xM: number; yM: number } | undefined, p: PlantData | undefined, fn: CoverFunc) {
    hideSuggestionPreview();
    const layer = planSvg.querySelector('#coverage-layer');
    if (!g || !p || !editing || !layer) return;
    const r = displayRadiusM(p, editing.yearsSincePlanting);
    const h = p.heightM && p.widthM ? p.heightM * Math.min(1, r / (p.widthM / 2)) : r * 2;
    const reach = influenceRadius(fn, r, h);
    view3d?.setPreview({ xM: g.xM, yM: g.yM, plant: p, reachM: reach, label: displayName(p) });
    const k = viewK();
    const ns = 'http://www.w3.org/2000/svg';
    const grp = document.createElementNS(ns, 'g');
    grp.id = 'cov-preview';
    grp.setAttribute('transform', `translate(${g.xM * U},${g.yM * U})`);
    grp.innerHTML = `<circle r="${reach * U}" fill="#16a34a" fill-opacity="0.18" stroke="#15803d" stroke-width="${1.5 * k}" stroke-dasharray="${4 * k} ${4 * k}"/>`
      + `<circle r="${Math.max(0.15, r) * U}" fill="#22c55e" fill-opacity="0.55" stroke="#14532d" stroke-width="${2 * k}" stroke-dasharray="${6 * k} ${3 * k}"/>`
      + `<circle r="${3 * k}" fill="#14532d"/>`
      + `<text y="${Math.max(0.15, r) * U + 16 * k}" text-anchor="middle" font-size="${14 * k}" font-weight="600" fill="#14532d" stroke="#fff" stroke-width="${3 * k}" paint-order="stroke">${escapeHtml(displayName(p))}</text>`;
    layer.appendChild(grp);
  }
  function hideSuggestionPreview() {
    planSvg.querySelector('#cov-preview')?.remove();
    view3d?.setPreview(null);
  }

  // ── Besonnung ──────────────────────────────────────────────────────────
  // Map mode "Sonnenstunden": mean hours of direct sun per day for each spot,
  // shaded by tree crowns (at the slider's age), buildings and terrain
  // (sun-hours.ts). Also feeds the light at a gap into the planting
  // suggestions of the function coverage.
  const SUN_CLASS_KEY: Record<SunClass, string> = { full: 'sunClassFull', mid: 'sunClassMid', shadow: 'sunClassShadow' };
  const fmtH = (h: number) => new Intl.NumberFormat(lang, { maximumFractionDigits: 1, minimumFractionDigits: 1 }).format(h);
  let sunMapToken = 0;
  let seasonCache: { key: string; samples: SunSample[] } | null = null;
  // ── Feldmodus (GPS, lib/field-mode.ts) ──
  // On the phone in the garden: own position on the plan, the way to the
  // selected plant ("noch 2,3 m nach NO"), place the chosen plant right
  // here, or move a selected one to here. Position stays in the browser.
  const gpsBtn = document.getElementById('tool-gps') as HTMLButtonElement;
  const gpsBox = document.getElementById('gps-box')!;
  const gpsStatus = document.getElementById('gps-status')!;
  const gpsWay = document.getElementById('gps-way')!;
  const gpsPlace = document.getElementById('gps-place') as HTMLButtonElement;
  const gpsMove = document.getElementById('gps-move') as HTMLButtonElement;
  let gpsWatch: number | null = null;
  let gpsPos: { xM: number; yM: number; accM: number } | null = null;
  let gpsCentered = false;
  function syncGpsButton() { gpsBtn.hidden = !editing?.geo || !('geolocation' in navigator); }
  function stopGps() {
    if (gpsWatch != null) navigator.geolocation.clearWatch(gpsWatch);
    gpsWatch = null; gpsPos = null; gpsCentered = false;
    gpsBtn.setAttribute('aria-pressed', 'false');
    gpsBox.hidden = true;
    renderGps();
  }
  function centerOnGps() {
    if (!gpsPos || !plan3dContainer.hidden) return;
    const w = Math.min(planView.w, 30 * U), h = w * canvasAspect();
    planView = { x: gpsPos.xM * U - w / 2, y: gpsPos.yM * U - h / 2, w, h };
    applyPlanView();
  }
  gpsBtn.addEventListener('click', () => {
    if (gpsWatch != null) { stopGps(); return; }
    if (!editing?.geo) return;
    gpsBtn.setAttribute('aria-pressed', 'true');
    gpsBox.hidden = false;
    gpsStatus.textContent = t('gpsWaiting');
    gpsWay.textContent = '';
    gpsWatch = navigator.geolocation.watchPosition(pos => {
      if (!editing?.geo) return;
      const p = latLonToPlan(pos.coords.latitude, pos.coords.longitude, editing.geo);
      gpsPos = { xM: p.xM, yM: p.yM, accM: pos.coords.accuracy };
      if (!gpsCentered) { gpsCentered = true; centerOnGps(); }
      renderGps();
    }, err => {
      gpsStatus.textContent = t(err.code === err.PERMISSION_DENIED ? 'gpsDenied' : 'gpsError');
    }, { enableHighAccuracy: true, maximumAge: 2000, timeout: 30000 });
  });
  document.getElementById('gps-stop')!.addEventListener('click', stopGps);
  document.getElementById('gps-center')!.addEventListener('click', centerOnGps);
  gpsPlace.addEventListener('click', () => {
    if (!editing || !gpsPos || !armedPlantId) return;
    editing.placements.push({ id: newId(), plantId: armedPlantId, xM: gpsPos.xM, yM: gpsPos.yM, notes: '' });
    unplacedPlantIds = unplacedPlantIds.filter(id => id !== armedPlantId);
    renderUnplacedList();
    renderSuggestions();
    renderPlanSvg();
    view3d?.refreshPlacements();
    scheduleAutosave();
    showToast(t('gpsPlaced'));
  });
  gpsMove.addEventListener('click', () => {
    if (!editing || !gpsPos || !selectedPlacementId) return;
    const pl = editing.placements.find(x => x.id === selectedPlacementId);
    if (!pl) return;
    pl.xM = gpsPos.xM; pl.yM = gpsPos.yM;
    renderPlanSvg();
    view3d?.refreshPlacements();
    scheduleAutosave();
    showToast(t('gpsMoved'));
  });
  function renderGps() {
    const g = planSvg.querySelector('#gps-layer');
    syncGpsButton();
    if (!g) return;
    if (!gpsPos || !editing) { g.innerHTML = ''; return; }
    const k = viewK();
    const nf = (v: number) => new Intl.NumberFormat(lang, { maximumFractionDigits: v < 10 ? 1 : 0 }).format(v);
    const target = selectedPlacementId ? editing.placements.find(x => x.id === selectedPlacementId) : undefined;
    let line = '';
    if (target) {
      const w = wayTo(gpsPos, target, editing.geo?.rotationDeg ?? 0);
      const p = plantsById.get(target.plantId);
      const name = p ? displayName(p) || p.latinName : '—';
      gpsWay.textContent = arrived(w.distM, gpsPos.accM)
        ? t('gpsArrived', { name })
        : t('gpsWay', { d: nf(w.distM), dir: compassLabel(w.bearingDeg, lang), name });
      line = `<line x1="${gpsPos.xM * U}" y1="${gpsPos.yM * U}" x2="${target.xM * U}" y2="${target.yM * U}" stroke="#0284c7" stroke-width="${2.5 * k}" stroke-dasharray="${8 * k} ${5 * k}"/>`;
    } else {
      gpsWay.textContent = t('gpsPickTarget');
    }
    const inside = editing.boundary.length < 3 || pointInPolygon(gpsPos, editing.boundary);
    gpsStatus.textContent = t(inside ? 'gpsStatus' : 'gpsOutside', { acc: nf(gpsPos.accM) });
    gpsPlace.disabled = !armedPlantId;
    gpsMove.disabled = !target;
    g.innerHTML = line
      + `<circle cx="${gpsPos.xM * U}" cy="${gpsPos.yM * U}" r="${gpsPos.accM * U}" fill="#0ea5e9" fill-opacity="0.12" stroke="#0284c7" stroke-width="${1 * k}"/>`
      + `<circle cx="${gpsPos.xM * U}" cy="${gpsPos.yM * U}" r="${7 * k}" fill="#0284c7" stroke="#fff" stroke-width="${2.5 * k}"/>`;
  }

  // ── Bauabschnitte (lib/phases.ts) ──
  // Each placement can be planted later than the start; the years slider then
  // shows the plan growing phase by phase. plan.startYear only labels them.
  const phasesSection = document.getElementById('phases-section')!;
  const phasesStart = document.getElementById('phases-start') as HTMLInputElement;
  const phasesList = document.getElementById('phases-list')!;
  function phaseSelectHtml(id: string, value: number): string {
    const opts = Array.from({ length: 16 }, (_, i) => i);
    if (value > 15) opts.push(value);
    return `<select id="${id}" class="${'rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-1.5 py-0.5 text-xs'}">${value < 0 ? `<option value="-1" selected>${escapeHtml(t('phaseMixed'))}</option>` : ''}${opts.map(i =>
      `<option value="${i}" ${i === value ? 'selected' : ''}>${escapeHtml(phaseLabel(editing ?? {}, i, t('phaseStartWord')))}</option>`).join('')}</select>`;
  }
  function setPhase(pls: GardenPlanPlacement[], v: number) {
    for (const pl of pls) { if (v > 0) pl.phaseYear = Math.min(MAX_PHASE, v); else delete pl.phaseYear; }
    refreshMarkerHighlight();
    view3d?.refreshPlacements();
    renderPhases();
    scheduleWarnings();
    scheduleCoverage();
    scheduleAutosave();
  }
  function renderPhases() {
    if (!editing) return;
    const groups = phaseGroups(editing);
    phasesSection.hidden = editing.placements.length === 0;
    if (document.activeElement !== phasesStart) phasesStart.value = editing.startYear ? String(editing.startYear) : '';
    phasesStart.placeholder = String(new Date().getFullYear());
    const years = editing.yearsSincePlanting;
    // Rebuilt only when it changed: a re-render right under the pointer would swallow the click.
    const html = groups.map(([ph, pls]) => `
      <li><button type="button" data-phase="${ph}" class="flex w-full items-center justify-between gap-2 rounded px-1.5 py-0.5 text-left hover:bg-stone-100 dark:hover:bg-stone-800 ${ph <= years ? '' : 'text-stone-400'}">
        <span class="font-medium">${escapeHtml(phaseLabel(editing!, ph, t('phaseStartWord')))}</span>
        <span>${escapeHtml(t('phaseCount', { n: pls.length }))}${ph <= years ? '' : ' · ' + escapeHtml(t('phaseLater'))}</span></button></li>`).join('');
    if (phasesList.dataset.html === html) return;
    phasesList.dataset.html = html;
    phasesList.innerHTML = html;
    phasesList.querySelectorAll<HTMLButtonElement>('[data-phase]').forEach(b => b.addEventListener('click', () => {
      // select the phase's plants (to move them to another year at once)
      const ph = Number(b.dataset.phase);
      multiSel.clear();
      editing!.placements.filter(pl => phaseOf(pl) === ph).forEach(pl => multiSel.add(pl.id));
      selectedPlacementId = null;
      refreshMarkerHighlight();
      renderSelectedPanel();
    }));
  }
  phasesStart.addEventListener('change', () => {
    if (!editing) return;
    const v = Number(phasesStart.value);
    if (v >= 1900 && v <= 2200) editing.startYear = Math.round(v); else delete editing.startYear;
    renderPhases();
    renderSelectedPanel();
    renderYield();
    scheduleAutosave();
  });

  // ── Wasser im Gelände (lib/water.ts) ──
  // Flow paths, sinks and swale suggestions from the elevation grid; roof
  // rain from OSM buildings × site precipitation. Computed once per terrain
  // grid (cached) and only while the layer is switched on.
  const waterToggle = document.getElementById('water-toggle')!;
  /** Kept so a newly built 3D view gets the water too. */
  let water3d: import('../lib/gartenplan-3d').Water3D | null = null;
  const waterInput = document.getElementById('g-water') as HTMLInputElement;
  const waterSection = document.getElementById('water-section')!;
  const waterBody = document.getElementById('water-body')!;
  try { waterInput.checked = localStorage.getItem('pgd-water') === '1'; } catch {}
  let waterCache: { grid: unknown; result: WaterAnalysis } | null = null;
  waterInput.addEventListener('change', () => {
    try { localStorage.setItem('pgd-water', waterInput.checked ? '1' : '0'); } catch {}
    renderWater();
  });
  function waterAnalysis(): WaterAnalysis | null {
    if (!editing || !terrain) return null;
    if (waterCache?.grid !== terrain) {
      const plan = editing;
      const b = plan.boundary;
      waterCache = { grid: terrain, result: analyzeWater(terrain, {
        rect: { minX: 0, minY: 0, maxX: plan.areaWidthM, maxY: plan.areaHeightM },
        inside: b.length >= 3 ? (x, y) => pointInPolygon({ xM: x, yM: y }, b) : undefined,
      }) };
    }
    return waterCache.result;
  }
  function renderWater() {
    const layer = planSvg.querySelector('#water-layer');
    geoGate(waterToggle, !!editing?.geo);
    const on = !!editing?.geo && waterInput.checked && featureOn('water');
    waterSection.hidden = !on;
    if (!layer) return;
    if (!on || !editing) { layer.innerHTML = ''; water3d = null; view3d?.setWater(null); return; }
    if (!terrain) { layer.innerHTML = ''; water3d = null; view3d?.setWater(null); waterBody.textContent = t('waterNoTerrain'); return; }
    const fine = !!terrain.dgm;
    const w = waterAnalysis()!;
    const k = viewK();
    const nf = (v: number, d = 0) => new Intl.NumberFormat(lang, { maximumFractionDigits: d }).format(v);
    // Flow: width by catchment (log), one path per width class.
    const byWidth = new Map<number, string[]>();
    for (const f of w.flow) {
      const cls = Math.min(5, Math.max(1, Math.round(Math.log10(f.catchmentM2 / 150) * 2) + 1));
      const arr = byWidth.get(cls) ?? [];
      arr.push(`M${f.x1 * U} ${f.y1 * U}L${f.x2 * U} ${f.y2 * U}`);
      byWidth.set(cls, arr);
    }
    const parts = [...byWidth.entries()].map(([cls, d]) =>
      `<path d="${d.join('')}" fill="none" stroke="#0284c7" stroke-opacity="${0.35 + cls * 0.1}" stroke-width="${(0.6 + cls * 0.7) * k}" stroke-linecap="round"/>`);
    const label = (x: number, y: number, text: string, color: string) =>
      `<text x="${x * U}" y="${y * U}" text-anchor="middle" dominant-baseline="central" font-size="${10 * k}" font-weight="600" fill="${color}" stroke="#fff" stroke-width="${3 * k}" paint-order="stroke">${escapeHtml(text)}</text>`;
    if (fine) {
      for (const s of w.sinks) {
        const r = Math.sqrt(s.areaM2 / Math.PI);
        parts.push(`<circle cx="${s.xM * U}" cy="${s.yM * U}" r="${r * U}" fill="#0ea5e9" fill-opacity="0.25" stroke="#0369a1" stroke-width="${1.2 * k}"/>`);
        parts.push(label(s.xM, s.yM, t('waterSinkLabel', { d: nf(s.depthM, 1) }), '#075985'));
      }
      for (const s of w.swales) {
        parts.push(`<line x1="${s.x1 * U}" y1="${s.y1 * U}" x2="${s.x2 * U}" y2="${s.y2 * U}" stroke="#d97706" stroke-width="${4 * k}" stroke-dasharray="${6 * k} ${3 * k}" stroke-linecap="round"/>`);
        parts.push(label((s.x1 + s.x2) / 2, (s.y1 + s.y2) / 2 - 1.2, t('waterSwaleLabel'), '#b45309'));
      }
    }
    layer.innerHTML = parts.join('');
    // the same in 3D: widths in metres, scaled a little with the plan size
    const wScale = Math.max(1, Math.max(editing.areaWidthM, editing.areaHeightM) / 100);
    water3d = {
      flow: w.flow.map(f => ({ x1: f.x1, y1: f.y1, x2: f.x2, y2: f.y2,
        width: (0.15 + 0.15 * Math.min(5, Math.max(1, Math.round(Math.log10(f.catchmentM2 / 150) * 2) + 1))) * wScale })),
      sinks: fine ? w.sinks.map(s => ({ xM: s.xM, yM: s.yM, rM: Math.sqrt(s.areaM2 / Math.PI), depthM: s.depthM })) : [],
      swales: fine ? w.swales.map(s => ({ x1: s.x1, y1: s.y1, x2: s.x2, y2: s.y2, width: 0.8 * wScale })) : [],
    };
    view3d?.setWater(water3d);

    // Panel
    const rows: string[] = [];
    rows.push(`<p>${escapeHtml(fine ? t('waterBasisFine', { region: terrain.dgm!.region[lang], res: nf(terrain.dgm!.resolutionM) }) : t('waterBasisCoarse'))}</p>`);
    if (fine) {
      rows.push(`<p><span class="font-medium">${escapeHtml(t('waterSinks'))}:</span> ${w.sinks.length ? escapeHtml(w.sinks.slice(0, 4).map(s => t('waterSinkItem', { d: nf(s.depthM, 1), a: nf(s.areaM2), v: nf(s.volumeM3) })).join(' · ')) : escapeHtml(t('waterNone'))}</p>`);
      rows.push(`<p><span class="font-medium">${escapeHtml(t('waterSwales'))}:</span> ${w.swales.length ? escapeHtml(t('waterSwaleItems', { n: w.swales.length })) : escapeHtml(t('waterSwalesNone'))}</p>`);
    }
    // Roof rain (buildings in or right next to the plan)
    const climate = currentClimate();
    if (showBuildings()) {
      const near = buildings.filter(b => b.pts.some(p => p.xM > -10 && p.yM > -10 && p.xM < editing!.areaWidthM + 10 && p.yM < editing!.areaHeightM + 10));
      if (near.length) {
        const area = near.reduce((s, b) => s + polygonAreaM2(b.pts), 0);
        rows.push(`<p><span class="font-medium">${escapeHtml(t('waterRoof'))}:</span> ${escapeHtml(climate
          ? t('waterRoofValue', { n: near.length, a: nf(area), m3: nf(roofRainM3(area, climate.precipMm)), mm: nf(climate.precipMm) })
          : t('waterRoofNoClimate', { n: near.length, a: nf(area) }))}</p>`);
      }
    }
    rows.push(`<p class="text-[10px] text-stone-500 dark:text-stone-400">${escapeHtml(t('waterNote'))}</p>`);
    waterBody.innerHTML = rows.join('');
  }

  // ── Ertrag & Pflege (lib/yield-care.ts) ──
  // Estimated harvest at the slider's age and a yearly care calendar (.ics).
  const yieldSection = document.getElementById('yield-section')!;
  const yieldTotal = document.getElementById('yield-total')!;
  const yieldRows = document.getElementById('yield-rows')!;
  function renderYield() {
    if (!editing) return;
    const years = editing.yearsSincePlanting;
    const { rows, totalKg } = planYield(editing, plantsById, years);
    yieldSection.hidden = rows.length === 0;
    if (!rows.length) return;
    const nf = (v: number) => v > 0 && v < 0.1 ? `< ${new Intl.NumberFormat(lang).format(0.1)}` : new Intl.NumberFormat(lang, { maximumFractionDigits: v < 10 ? 1 : 0 }).format(v);
    yieldTotal.textContent = totalKg >= 0.5
      ? t('yieldTotal', { years, kg: nf(totalKg) })
      : t('yieldNone', { years, year: Math.min(...rows.map(r => r.startYear)) });
    yieldRows.innerHTML = rows.slice(0, 12).map(r => {
      const p = plantsById.get(r.plantId)!;
      const when = r.kgEach > 0 ? `${r.count} × ${nf(r.kgEach)} kg` : t('yieldFrom', { year: r.startYear });
      return `<tr class="border-t border-stone-200/60 dark:border-stone-700/60"><td class="py-0.5 pr-2 text-stone-700 dark:text-stone-200">${escapeHtml(displayName(p) || p.latinName)}${r.generic ? ' <span class="text-stone-400" title="' + escapeHtml(t('yieldGenericTitle')) + '">*</span>' : ''}</td><td class="py-0.5 text-right text-stone-500 dark:text-stone-400">${escapeHtml(when)}</td><td class="py-0.5 pl-2 text-right font-medium">${r.kgTotal > 0 ? escapeHtml(nf(r.kgTotal)) + ' kg' : '–'}</td></tr>`;
    }).join('');
  }
  yearsInput.addEventListener('input', () => { renderYield(); renderPhases(); });

  document.getElementById('btn-care-ics')!.addEventListener('click', () => {
    if (!editing) return;
    const seen = new Set<string>();
    const tasks: CareTask[] = [];
    const climate = currentClimate();
    for (const pl of editing.placements) {
      const p = plantsById.get(pl.plantId);
      if (!p || seen.has(p.id)) continue;
      seen.add(p.id);
      const nm = displayName(p) || p.latinName;
      tasks.push(...careTasks(p, nm, t));
      if (climate && blossomFrostRisk(p, climate) && ['tree', 'shrub'].includes(deriveLayer(p))) {
        tasks.push({ title: t('careFrostProtect', { name: nm }), month: p.flowerMonths.findIndex(Boolean), detail: t('careFrostProtectDetail', { date: doyLabel(climate.lastFrostDoy!, lang) }) });
      }
    }
    if (editing.placements.length) {
      tasks.push({ title: t('careMulchSpring'), month: 3, detail: t('careMulchSpringDetail') });
      tasks.push({ title: t('careMulchAutumn'), month: 9, detail: t('careMulchAutumnDetail') });
    }
    tasks.sort((a, b) => a.month - b.month);
    const name = editing.name || t('planUnnamed');
    const ics = buildIcs(t('careCalName', { name }), tasks, new Date().getFullYear(), editing.id);
    const url = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
    const a = document.createElement('a');
    a.href = url; a.download = `pflegekalender-${name.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-')}.ics`;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    showToast(t('careIcsDone', { n: tasks.length }));
  });

  // ── Zonen & Sektoren (lib/zones-sectors.ts) ──
  // Rings for zones 0–4 around a draggable centre (the house) and wedges for
  // summer/winter sun, the main wind (site climate) and cold air (downhill,
  // from the terrain). Stored with the plan (editing.zones), so it travels in
  // backups and share links.
  const zonesInput = document.getElementById('g-zones') as HTMLInputElement;
  const zonesSection = document.getElementById('zones-section')!;
  const zonesLegend = document.getElementById('zones-legend')!;
  const zoneRadiusInputs = [...document.querySelectorAll<HTMLInputElement>('[data-zone-radius]')];
  let siteSlope: { slopeDeg: number; aspectDeg: number | null } | null = null;
  let zoneDrag: { pointerId: number } | null = null;

  /** Default centre: the OSM building nearest to the plan centre (the house),
   *  else the middle of the outline. */
  function defaultZoneCenter(): { xM: number; yM: number } {
    const plan = editing!;
    const cx = plan.areaWidthM / 2, cy = plan.areaHeightM / 2;
    if (showBuildings()) {
      const near = buildings.map(b => {
        const x = b.pts.reduce((s, p) => s + p.xM, 0) / b.pts.length, y = b.pts.reduce((s, p) => s + p.yM, 0) / b.pts.length;
        return { x, y, d: Math.hypot(x - cx, y - cy) };
      }).filter(b => b.d < Math.max(plan.areaWidthM, plan.areaHeightM)).sort((a, b) => a.d - b.d)[0];
      if (near) return { xM: near.x, yM: near.y };
    }
    const pts = plan.boundary.length >= 3 ? plan.boundary : [{ xM: cx, yM: cy }];
    return { xM: pts.reduce((s, p) => s + p.xM, 0) / pts.length, yM: pts.reduce((s, p) => s + p.yM, 0) / pts.length };
  }

  function syncZonesUi() {
    const z = editing?.zones;
    zonesInput.checked = !!z?.show;
    zonesSection.hidden = !z?.show;
    if (z) zoneRadiusInputs.forEach((inp, i) => { if (document.activeElement !== inp) inp.value = String(Math.round(z.radiiM[i])); });
  }

  zonesInput.addEventListener('change', () => {
    if (!editing) return;
    if (!editing.zones) editing.zones = { show: true, ...(() => { const c = defaultZoneCenter(); return { centerXM: c.xM, centerYM: c.yM }; })(), radiiM: DEFAULT_ZONE_RADII.slice() };
    else editing.zones.show = zonesInput.checked;
    syncZonesUi();
    renderZones();
    scheduleAutosave();
  });
  zoneRadiusInputs.forEach((inp, i) => inp.addEventListener('change', () => {
    const z = editing?.zones;
    const v = Number(inp.value);
    if (!z || !(v > 0)) return;
    z.radiiM[i] = v;
    // keep the rings in order: push the neighbours out/in as needed
    for (let j = i + 1; j < 5; j++) z.radiiM[j] = Math.max(z.radiiM[j], z.radiiM[j - 1] + 1);
    for (let j = i - 1; j >= 0; j--) z.radiiM[j] = Math.min(z.radiiM[j], z.radiiM[j + 1] - 1, z.radiiM[j]);
    z.radiiM = z.radiiM.map(r => Math.max(1, r));
    syncZonesUi();
    renderZones();
    scheduleAutosave();
  }));
  document.getElementById('zones-center-reset')!.addEventListener('click', () => {
    if (!editing?.zones) return;
    const c = defaultZoneCenter();
    editing.zones.centerXM = c.xM;
    editing.zones.centerYM = c.yM;
    renderZones();
    scheduleAutosave();
  });

  function renderZones() {
    const layer = planSvg.querySelector('#zones-layer');
    const handle = planSvg.querySelector('#zones-handle');
    if (!layer || !handle) return;
    const z = editing?.zones;
    if (!editing || !z?.show || !featureOn('zones')) { layer.innerHTML = ''; handle.innerHTML = ''; zonesLegend.innerHTML = ''; return; }
    const k = viewK();
    const cx = z.centerXM * U, cy = z.centerYM * U;
    const rot = editing.geo?.rotationDeg ?? 0;
    const lat = editing.geo?.lat ?? DEFAULT_SUN_LATLON.lat, lon = editing.geo?.lon ?? DEFAULT_SUN_LATLON.lon;
    const R = z.radiiM[3] * U;
    const label = (x: number, y: number, text: string, color: string, size = 11) =>
      `<text x="${x}" y="${y}" text-anchor="middle" dominant-baseline="central" font-size="${size * k}" font-weight="600" fill="${color}" stroke="#fff" stroke-width="${3 * k}" paint-order="stroke">${escapeHtml(text)}</text>`;
    const parts: string[] = [];
    const legend: string[] = [];
    const dot = (c: string) => `<span class="mr-1 inline-block h-2.5 w-2.5 rounded-full align-middle" style="background:${c}"></span>`;

    // Sectors first (under the rings)
    const sun = solsticeSectors(lat, lon);
    const lng = lang === 'en' ? 'en' : 'de';
    if (sun.summer) {
      parts.push(`<path d="${wedgePath(cx, cy, R, sun.summer.rise, sun.summer.set, rot)}" fill="#facc15" fill-opacity="0.10" stroke="#ca8a04" stroke-width="${1.2 * k}" stroke-dasharray="${6 * k} ${4 * k}"/>`);
      legend.push(`${dot('#facc15')}${escapeHtml(t('sectorSummerSun', { rise: compassLabel(sun.summer.rise, lng), set: compassLabel(sun.summer.set, lng) }))}`);
    }
    if (sun.winter) {
      parts.push(`<path d="${wedgePath(cx, cy, R * 0.92, sun.winter.rise, sun.winter.set, rot)}" fill="#f97316" fill-opacity="0.14" stroke="#ea580c" stroke-width="${1.2 * k}"/>`);
      const mid = bearingVector((sun.winter.rise + sun.winter.set) / 2, rot);
      parts.push(label(cx + mid.x * R * 0.8, cy + mid.y * R * 0.8, t('sectorWinterLabel'), '#c2410c'));
      legend.push(`${dot('#f97316')}${escapeHtml(t('sectorWinterSun', { rise: compassLabel(sun.winter.rise, lng), set: compassLabel(sun.winter.set, lng) }))}`);
    }
    if (sun.summer) {
      const mid = bearingVector(((sun.summer.rise + ((sun.summer.set - sun.summer.rise + 360) % 360) / 2) % 360), rot);
      parts.push(label(cx + mid.x * R * 0.97, cy + mid.y * R * 0.97, t('sectorSummerLabel'), '#a16207'));
    }
    const climate = currentClimate();
    if (climate) {
      const w = climate.windFromDeg;
      parts.push(`<path d="${wedgePath(cx, cy, R, w - 22.5, w + 22.5, rot)}" fill="#0ea5e9" fill-opacity="0.13" stroke="#0284c7" stroke-width="${1.2 * k}"/>`);
      const v = bearingVector(w, rot);
      const x1 = cx + v.x * R * 1.08, y1 = cy + v.y * R * 1.08, x2 = cx + v.x * R * 0.7, y2 = cy + v.y * R * 0.7;
      parts.push(`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#0369a1" stroke-width="${3 * k}" marker-end="url(#zones-arrow-wind)"/>`);
      const dir = COMPASS16[lng][Math.round(w / 22.5) % 16];
      parts.push(label(cx + v.x * R * 1.16, cy + v.y * R * 1.16, t('sectorWindLabel', { dir }), '#0369a1'));
      legend.push(`${dot('#0ea5e9')}${escapeHtml(t('sectorWind', { dir, share: Math.round(climate.windRose[Math.round(w / 22.5) % 16] * 100) }))}`);
    } else {
      legend.push(`<span class="text-stone-500 dark:text-stone-400">${escapeHtml(t(editing.geo ? 'sectorWindLoading' : 'sectorNeedsLocation'))}</span>`);
    }
    if (siteSlope && siteSlope.aspectDeg != null && siteSlope.slopeDeg >= 1) {
      const v = bearingVector(siteSlope.aspectDeg, rot);
      const x2 = cx + v.x * R * 0.55, y2 = cy + v.y * R * 0.55;
      parts.push(`<line x1="${cx + v.x * z.radiiM[0] * U}" y1="${cy + v.y * z.radiiM[0] * U}" x2="${x2}" y2="${y2}" stroke="#4f46e5" stroke-width="${3 * k}" stroke-dasharray="${8 * k} ${4 * k}" marker-end="url(#zones-arrow-cold)"/>`);
      parts.push(label(x2 + v.x * 14 * k, y2 + v.y * 14 * k, t('sectorColdLabel'), '#4338ca'));
      legend.push(`${dot('#6366f1')}${escapeHtml(t('sectorCold', { dir: compassLabel(siteSlope.aspectDeg, lng), slope: new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(siteSlope.slopeDeg) }))}`);
    } else if (siteSlope) {
      legend.push(`${dot('#6366f1')}${escapeHtml(t('sectorColdFlat'))}`);
    }

    // Zone rings
    z.radiiM.forEach((r, i) => {
      parts.push(`<circle cx="${cx}" cy="${cy}" r="${r * U}" fill="${ZONE_COLORS[i]}" fill-opacity="${i === 0 ? 0.12 : 0.03}" stroke="${ZONE_COLORS[i]}" stroke-width="${1.6 * k}" stroke-dasharray="${i === 0 ? '' : `${10 * k} ${5 * k}`}"/>`);
      parts.push(label(cx, cy - r * U + 9 * k, t('zonesRingLabel', { n: i }), ZONE_COLORS[i], 10));
    });
    const marker = (id: string, color: string) => `<marker id="${id}" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="${color}"/></marker>`;
    layer.innerHTML = `<defs>${marker('zones-arrow-wind', '#0369a1')}${marker('zones-arrow-cold', '#4338ca')}</defs>${parts.join('')}`;
    // House handle (drag to move the centre)
    const s = 9 * k;
    handle.innerHTML = `<g class="zones-center" style="cursor:move"><circle cx="${cx}" cy="${cy}" r="${s * 1.6}" fill="transparent"/>
      <path d="M${cx - s},${cy} L${cx},${cy - s} L${cx + s},${cy} L${cx + s * 0.7},${cy} L${cx + s * 0.7},${cy + s * 0.8} L${cx - s * 0.7},${cy + s * 0.8} L${cx - s * 0.7},${cy} Z" fill="#7c2d12" stroke="#fff" stroke-width="${1.5 * k}"/>
      <title>${escapeHtml(t('zonesCenterTitle'))}</title></g>`;
    zonesLegend.innerHTML = legend.map(l => `<li>${l}</li>`).join('');
  }

  planSvg.addEventListener('pointerdown', (e: PointerEvent) => {
    if (!(e.target as Element).closest('.zones-center') || !editing?.zones) return;
    e.stopPropagation();
    e.preventDefault();
    zoneDrag = { pointerId: e.pointerId };
    planSvg.setPointerCapture(e.pointerId);
  }, { capture: true });
  planSvg.addEventListener('pointermove', (e: PointerEvent) => {
    if (!zoneDrag || e.pointerId !== zoneDrag.pointerId || !editing?.zones) return;
    const p = clientToMeters(planSvg, e.clientX, e.clientY);
    editing.zones.centerXM = p.xM;
    editing.zones.centerYM = p.yM;
    renderZones();
  });
  const endZoneDrag = (e: PointerEvent) => {
    if (!zoneDrag || e.pointerId !== zoneDrag.pointerId) return;
    zoneDrag = null;
    scheduleAutosave();
  };
  planSvg.addEventListener('pointerup', endZoneDrag);
  planSvg.addEventListener('pointercancel', endZoneDrag);

  // ── Standortklima (Open-Meteo, lib/site-climate.ts) ──
  // Loaded with the terrain for located plans; drives the climate panel, the
  // "not hardy" / "blossom before last frost" hints and the suggestions.
  const climateSection = document.getElementById('climate-section')!;
  const climateBody = document.getElementById('climate-body')!;
  let siteClimate: SiteClimate | null = null;
  let siteClimateKey = '';       // what siteClimate belongs to
  let climateRequestKey = '';
  const climateKeyOf = (plan: GardenPlan | null) => plan?.geo ? `${plan.geo.lat.toFixed(1)}|${plan.geo.lon.toFixed(1)}` : '';
  /** Climate of the open plan — never the previous plan's while loading. */
  const currentClimate = () => (siteClimate && editing && siteClimateKey === climateKeyOf(editing) ? siteClimate : null);
  async function loadClimate() {
    const key = climateKeyOf(editing);
    if (!key) { climateRequestKey = ''; renderClimatePanel(); return; }
    if (key === climateRequestKey) { renderClimatePanel(); return; }
    climateRequestKey = key;
    renderClimatePanel(true);
    try {
      const c = await fetchSiteClimate(editing!.geo!.lat, editing!.geo!.lon);
      if (climateRequestKey !== key) return;
      siteClimate = c;
      siteClimateKey = key;
    } catch {
      if (climateRequestKey === key) { climateRequestKey = ''; renderClimatePanel(false, true); }
      return;
    }
    renderClimatePanel();
    updateAttribution(planSvg);
    renderSuggestions();
    scheduleWarnings();
    renderZones();
  }
  function renderClimatePanel(loading = false, failed = false) {
    climateSection.hidden = !editing?.geo;
    if (!editing?.geo) return;
    if (loading) { climateBody.textContent = t('climateLoading'); return; }
    if (failed) { climateBody.textContent = t('climateFailed'); return; }
    const c = currentClimate();
    if (!c) return;
    const nf = (v: number, d = 0) => new Intl.NumberFormat(lang, { maximumFractionDigits: d }).format(v);
    const dir = COMPASS16[lang === 'en' ? 'en' : 'de'][Math.round(c.windFromDeg / 22.5) % 16];
    const rows: [string, string][] = [
      [t('climateZone'), t('climateZoneValue', { zone: zoneLabel(c.zone), min: nf(c.meanAnnualMinC, 1) })],
      [t('climateLastFrost'), c.lastFrostDoy != null ? t('climateAround', { date: doyLabel(c.lastFrostDoy, lang) }) : '—'],
      [t('climateFirstFrost'), c.firstFrostDoy != null ? t('climateAround', { date: doyLabel(c.firstFrostDoy, lang) }) : '—'],
      [t('climateFrostFree'), c.frostFreeDays != null ? t('climateDays', { n: c.frostFreeDays }) : '—'],
      [t('climateRain'), t('climateMm', { mm: nf(c.precipMm) })],
      [t('climateWind'), t('climateWindValue', { dir, share: nf(c.windRose[Math.round(c.windFromDeg / 22.5) % 16] * 100) })],
    ];
    climateBody.innerHTML = `<dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5">${rows.map(([k, v]) => `<dt class="text-stone-500 dark:text-stone-400">${escapeHtml(k)}</dt><dd>${escapeHtml(v)}</dd>`).join('')}</dl>
      <p class="pt-1 text-[10px] text-stone-500 dark:text-stone-400">${escapeHtml(t('climateNote', { from: c.years[0], to: c.years[1] }))}</p>`;
  }

  // ── Gebäude (OSM) ──
  const buildingsToggle = document.getElementById('buildings-toggle')!;
  const buildingsInput = document.getElementById('g-buildings') as HTMLInputElement;
  try { buildingsInput.checked = localStorage.getItem('pgd-buildings') !== '0'; } catch {}
  // `buildings` always belongs to `buildingsLoadedKey` (location + size of the
  // plan they were fetched for); after switching plans they only show once
  // the new plan's own buildings are in — never the previous plan's.
  let buildings: Building[] = [];
  let buildingsKey = '';        // last requested
  let buildingsLoadedKey = '';  // what `buildings` holds
  const buildingsKeyOf = (plan: GardenPlan | null) => plan?.geo
    ? `${plan.geo.lat}|${plan.geo.lon}|${plan.geo.rotationDeg}|${plan.areaWidthM}|${plan.areaHeightM}` : '';
  const showBuildings = () => !!editing?.geo && buildingsInput.checked && featureOn('buildings') && buildings.length > 0
    && buildingsLoadedKey === buildingsKeyOf(editing);
  buildingsInput.addEventListener('change', () => {
    try { localStorage.setItem('pgd-buildings', buildingsInput.checked ? '1' : '0'); } catch {}
    void loadBuildings();
    afterBuildingsChanged();
  });
  // Same setting from the 3D bar (🏠) and the B key.
  const buildings3dBtn = document.getElementById('btn-buildings-3d') as HTMLButtonElement;
  function syncBuildingsButton() {
    buildings3dBtn.hidden = !editing?.geo;
    buildings3dBtn.setAttribute('aria-pressed', String(buildingsInput.checked));
  }
  buildings3dBtn.addEventListener('click', () => buildingsInput.click());
  buildingsInput.addEventListener('change', syncBuildingsButton);
  async function loadBuildings() {
    const plan = editing;
    const geo = plan?.geo;
    geoGate(buildingsToggle, !!geo);
    syncBuildingsButton();
    if (!plan || !geo || !buildingsInput.checked || !featureOn('buildings')) return;
    const m = 150;
    const key = buildingsKeyOf(plan);
    if (key === buildingsKey) return;
    buildingsKey = key;
    if (buildingsLoadedKey !== key) { buildings = []; buildingsLoadedKey = ''; updateAttribution(planSvg); }
    try {
      const list = await fetchBuildings(geo, { minX: -m, minY: -m, maxX: plan.areaWidthM + m, maxY: plan.areaHeightM + m });
      // A newer request (other plan, moved or resized) superseded this one.
      if (buildingsKey !== key) return;
      buildings = list;
      buildingsLoadedKey = key;
    } catch {
      if (buildingsKey === key) { buildingsKey = ''; buildings = []; buildingsLoadedKey = ''; showToast(t('buildingsUnavailable')); }
      return;
    }
    afterBuildingsChanged();
  }
  function afterBuildingsChanged() {
    updateAttribution(planSvg);
    scheduleWarnings();
    if (coverageSelect.value.startsWith('sun')) scheduleCoverage();
    if (!plan3dContainer.hidden) btnView3d.click(); // rebuild 3D with/without buildings
  }
  /** Building footprints as sun occluders (prisms), heights on the terrain. */
  function buildingOccluders(groundZ: (x: number, y: number) => number): Occluder[] {
    if (!showBuildings()) return [];
    return buildings.map(b => {
      const xs = b.pts.map(p => p.xM), ys = b.pts.map(p => p.yM);
      // Same footing as in 3D (walls from the highest ground point); a pitched
      // roof counts with half its height — the mean height of a gable.
      const top = Math.max(...b.pts.map(p => groundZ(p.xM, p.yM)));
      const roofH = b.roof?.heightM ?? 0;
      return { kind: 'prism' as const, pts: b.pts, z1: top + b.heightM - roofH / 2, minX: Math.min(...xs), minY: Math.min(...ys), maxX: Math.max(...xs), maxY: Math.max(...ys) };
    });
  }

  function sunLatLon() {
    const geo = editing?.geo;
    return geo ? { lat: geo.lat, lon: geo.lon, rot: geo.rotationDeg } : { ...DEFAULT_SUN_LATLON, rot: 0 };
  }
  function seasonSamples(): SunSample[] {
    const ll = sunLatLon();
    const year = new Date().getFullYear();
    const key = `${ll.lat}|${ll.lon}|${ll.rot}|${year}`;
    if (seasonCache?.key !== key) seasonCache = { key, samples: sunSamples(SEASON_DATES(year), ll.lat, ll.lon, ll.rot, 30) };
    return seasonCache.samples;
  }
  function chosenDay(): Date {
    if (sunDateInput.value) {
      const [y, m, d] = sunDateInput.value.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    return new Date();
  }
  let terrainMaxZ: { grid: ElevationGrid; z: number } | null = null;
  function sunContext(): { scene: SunScene } {
    const tg = terrain;
    const groundZ = tg ? (x: number, y: number) => sampleGrid(tg, x, y) : () => 0;
    if (tg && terrainMaxZ?.grid !== tg) terrainMaxZ = { grid: tg, z: gridRange(tg).max };
    const tr = tg ? {
      z: groundZ, minX: tg.minX, minY: tg.minY, maxX: tg.minX + (tg.nx - 1) * tg.cellM, maxY: tg.minY + (tg.ny - 1) * tg.cellM,
      maxZ: terrainMaxZ!.z, stepM: Math.max(1, tg.cellM),
    } : null;
    const occluders = [...planOccluders(editing!, plantsById, editing!.yearsSincePlanting, groundZ), ...buildingOccluders(groundZ), ...pluginOccluders(groundZ)];
    return { scene: { occluders, groundZ, terrain: tr } };
  }

  /** Dark blue (no sun) → yellow (all the sun the sky offers there). */
  function sunColor(h: number, maxH = 8): string {
    const f = Math.min(1, Math.max(0, h / maxH));
    return `hsl(${Math.round(225 - 175 * f)}, 70%, ${Math.round(30 + 22 * f)}%)`;
  }

  async function renderSunMap(mode: 'sun-day' | 'sun-season') {
    const token = ++sunMapToken;
    const layer = planSvg.querySelector('#coverage-layer');
    if (!editing || !layer || editing.boundary.length < 3) return;
    const plan = editing;
    coverageSection.hidden = false;
    coverageHeading.textContent = t('sunMapHeading');
    coverageBody.innerHTML = `<p class="animate-pulse text-stone-500 dark:text-stone-400">${t('sunMapComputing')}</p>`;
    const ll = sunLatLon();
    const day = chosenDay();
    const samples = mode === 'sun-day' ? sunSamples([day], ll.lat, ll.lon, ll.rot, 15) : seasonSamples();
    const { scene } = sunContext();
    const cellM = Math.max(0.5, Math.min(plan.areaWidthM, plan.areaHeightM) / 36);
    const cells = planCells(plan, cellM);
    const hours: number[] = [];
    // In chunks so the page stays responsive on big plans.
    for (let i = 0; i < cells.length; i += 150) {
      for (const c of cells.slice(i, i + 150)) hours.push(sunHoursAt(c.xM, c.yM, scene, samples));
      await new Promise(r => setTimeout(r, 0));
      if (token !== sunMapToken || editing !== plan) return;
    }
    // Colour scale up to the open-sky maximum (day length), so shade shows
    // even in summer when nearly every spot gets more than 6 h.
    const maxH = Math.max(1, samples.reduce((a, s) => a + s.hours, 0));
    const buckets = new Map<string, string[]>();
    const half = cellM * U / 2;
    const cells3d = cells.map((c, i) => {
      const color = sunColor(Math.round(hours[i] * 2) / 2, maxH);
      const arr = buckets.get(color) ?? [];
      arr.push(`M${c.xM * U - half} ${c.yM * U - half}h${2 * half}v${2 * half}h${-2 * half}z`);
      buckets.set(color, arr);
      return { xM: c.xM, yM: c.yM, color };
    });
    layer.innerHTML = [...buckets.entries()].map(([color, d]) => `<path d="${d.join('')}" fill="${color}" fill-opacity="0.45"/>`).join('');
    coverage3d = { cellM, cells: cells3d, gaps: [] };
    view3d?.setCoverage(coverage3d);

    const n = hours.length || 1;
    const mean = hours.reduce((a, b) => a + b, 0) / n;
    const share = (cls: SunClass) => hours.filter(h => sunClass(h) === cls).length / n;
    const when = mode === 'sun-day' ? new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' }).format(day) : t('sunMapWhenSeason');
    const bar = (cls: SunClass, key: string, color: string) => `
      <div><span class="flex justify-between"><span>${escapeHtml(t(key))}</span><span class="font-mono">${Math.round(share(cls) * 100)} %</span></span>
      <span class="mt-0.5 block h-1.5 rounded bg-stone-200 dark:bg-stone-700"><span class="block h-1.5 rounded" style="width:${Math.round(share(cls) * 100)}%;background:${color}"></span></span></div>`;
    const considered = [t('sunMapConsidered', { years: plan.yearsSincePlanting })];
    if (terrain) considered.push(t('sunMapTerrain'));
    if (showBuildings()) considered.push(t('sunMapBuildings'));
    coverageBody.innerHTML = `
      <p class="text-stone-600 dark:text-stone-300">${escapeHtml(t('sunMapMean', { h: fmtH(mean), when }))}</p>
      ${bar('full', 'sunFull', sunColor(Math.max(6, maxH * 0.9), maxH))}${bar('mid', 'sunMid', sunColor(4.5, maxH))}${bar('shadow', 'sunShadow', sunColor(1.5, maxH))}
      <div class="mt-1"><span class="block h-2 rounded" style="background:linear-gradient(90deg, ${[0, 0.25, 0.5, 0.75, 1].map(f => sunColor(f * maxH, maxH)).join(',')})"></span>
        <span class="flex justify-between font-mono text-[10px] text-stone-500">${[0, 0.25, 0.5, 0.75, 1].map((f, i) => `<span>${fmtH(f * maxH)}${i === 0 || i === 4 ? ' h' : ''}</span>`).join('')}</span></div>
      <p class="text-stone-500 dark:text-stone-400">${escapeHtml(considered.join(', '))}.${editing.geo ? '' : ' ' + escapeHtml(t('sunMapNoLoc'))}${mode === 'sun-day' ? ' ' + escapeHtml(t('sunMapDateHint')) : ''}</p>`;
  }


  // ── Hinweise (Abstand / Licht) ─────────────────────────────────────────
  // Looking ahead to full-grown plants (plan-warnings.ts): same-layer plants
  // that will crowd each other, and plants whose light need won't be met.
  const warningsSection = document.getElementById('warnings-section') as HTMLDetailsElement;
  const warningsList = document.getElementById('warnings-list')!;
  const warningsCount = document.getElementById('warnings-count')!;
  let warnedIds = new Set<string>();
  const goodNeighborsHeading = document.getElementById('good-neighbors-heading')!;
  const goodNeighborsList = document.getElementById('good-neighbors-list')!;
  // Placements of the warning under the mouse/keyboard focus: ringed on the map.
  // A hint can be hovered (temporary rings) or pinned by a first click: the
  // map then jumps to it and keeps the affected area marked — the reach of
  // an allelopathic plant, the full-grown crowns that collide … A second
  // click on the same hint selects its plants; Esc clears the pin.
  type WarnMark = { xM: number; yM: number; rM: number; kind: 'zone' | 'crown' };
  type WarnItem = { key: string; ids: string[]; text: string; marks: WarnMark[]; tone: 'bad' | 'good' };
  let hoverWarn: WarnItem | null = null;
  let pinnedWarn: WarnItem | null = null;
  let hoverWarnIds: string[] = [];
  const warnItemsByKey = new Map<string, WarnItem>();
  function syncHotIds() { hoverWarnIds = (hoverWarn ?? pinnedWarn)?.ids ?? []; }
  function setWarnHover(item: WarnItem | null) {
    hoverWarn = item;
    syncHotIds();
    renderWarnHover();
    refreshMarkerHighlight();
  }
  function setWarnPin(item: WarnItem | null) {
    pinnedWarn = item;
    syncHotIds();
    renderWarnHover();
    refreshMarkerHighlight();
    warningsSection.querySelectorAll<HTMLButtonElement>('[data-key]').forEach(b => {
      const on = !!item && b.dataset.key === item.key;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('ring-2', on);
      b.classList.toggle(b.dataset.tone === 'good' ? 'ring-green-500' : 'ring-red-400', on);
    });
  }
  function warnItemSvg(item: WarnItem, k: number, strong: boolean): string {
    const color = item.tone === 'good' ? '#16a34a' : '#dc2626';
    const pls = item.ids.map(id => editing!.placements.find(p => p.id === id)).filter((p): p is GardenPlanPlacement => !!p);
    const marks = item.marks.map(m => m.kind === 'zone'
      ? `<circle cx="${m.xM * U}" cy="${m.yM * U}" r="${m.rM * U}" fill="${color}" fill-opacity="${strong ? 0.1 : 0.06}" stroke="${color}" stroke-width="${2 * k}" stroke-dasharray="${8 * k} ${5 * k}"/>`
      : `<circle cx="${m.xM * U}" cy="${m.yM * U}" r="${m.rM * U}" fill="${color}" fill-opacity="${strong ? 0.16 : 0.1}" stroke="${color}" stroke-width="${(strong ? 3 : 2.5) * k}"/>`).join('');
    const line = pls.length >= 2
      ? pls.slice(1).map(q => `<line x1="${pls[0].xM * U}" y1="${pls[0].yM * U}" x2="${q.xM * U}" y2="${q.yM * U}" stroke="${color}" stroke-width="${2 * k}" stroke-dasharray="${6 * k} ${4 * k}"/>`).join('')
      : '';
    return marks + line;
  }
  function renderWarnHover() {
    const g = planSvg.querySelector('#warn-layer');
    if (!g) return;
    if (!editing) { g.innerHTML = ''; return; }
    const k = viewK();
    g.innerHTML = (pinnedWarn ? warnItemSvg(pinnedWarn, k, true) : '')
      + (hoverWarn && hoverWarn.key !== pinnedWarn?.key ? warnItemSvg(hoverWarn, k, false) : '');
  }
  /** Centres the 2D view on a hint's marks and zooms so they fit (with margin). */
  function focusWarnArea(item: WarnItem) {
    if (!editing || !plan3dContainer.hidden || !planView.w || !item.marks.length) return;
    const pad = 1.5;
    const x0 = Math.min(...item.marks.map(m => m.xM - m.rM)) - pad, x1 = Math.max(...item.marks.map(m => m.xM + m.rM)) + pad;
    const y0 = Math.min(...item.marks.map(m => m.yM - m.rM)) - pad, y1 = Math.max(...item.marks.map(m => m.yM + m.rM)) + pad;
    const aspect = planView.h / planView.w;
    let w = Math.max(8 * U, (x1 - x0) * U * 1.15);
    if ((y1 - y0) * U * 1.15 > w * aspect) w = (y1 - y0) * U * 1.15 / aspect;
    const h = w * aspect;
    const cx = ((x0 + x1) / 2) * U, cy = ((y0 + y1) / 2) * U;
    planView = { x: cx - w / 2, y: cy - h / 2, w, h };
    applyPlanView();
    renderWarnHover();
  }
  /** Pans (and zooms out if needed) so the given placements are in view. */
  function focusPlacements(ids: string[]) {
    if (!editing || plan3dContainer.hidden === false || !planView.w) return;
    const pls = ids.map(id => editing!.placements.find(p => p.id === id)).filter((p): p is GardenPlanPlacement => !!p);
    if (!pls.length) return;
    const pad = 1.5; // m around the plants
    const x0 = Math.min(...pls.map(p => p.xM)) - pad, x1 = Math.max(...pls.map(p => p.xM)) + pad;
    const y0 = Math.min(...pls.map(p => p.yM)) - pad, y1 = Math.max(...pls.map(p => p.yM)) + pad;
    const v = viewRectM();
    if (x0 >= v.minX && x1 <= v.maxX && y0 >= v.minY && y1 <= v.maxY) return;
    let w = planView.w, h = planView.h;
    const needW = (x1 - x0) * U, needH = (y1 - y0) * U;
    if (needW > w || needH > h) { const f = Math.max(needW / w, needH / h); w *= f; h *= f; }
    const cx = ((x0 + x1) / 2) * U, cy = ((y0 + y1) / 2) * U;
    planView = { x: cx - w / 2, y: cy - h / 2, w, h };
    applyPlanView();
  }
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Escape' || !pinnedWarn || document.querySelector('dialog[open]')) return;
    const tgt = e.target as HTMLElement | null;
    if (tgt && (tgt.tagName === 'INPUT' || tgt.tagName === 'TEXTAREA')) return;
    setWarnPin(null);
  });
  let warnTimer: ReturnType<typeof setTimeout> | null = null;
  function scheduleWarnings() {
    if (warnTimer) clearTimeout(warnTimer);
    warnTimer = setTimeout(renderWarnings, 600);
  }
  function renderWarnings() {
    warnTimer = null;
    if (!editing || phaseB.classList.contains('hidden')) return;
    const plan = editing;
    const name = (id: string) => {
      const pl = plan.placements.find(p => p.id === id);
      const p = pl ? plantsById.get(pl.plantId) : undefined;
      return p ? displayName(p) : '—';
    };
    const crowd = crowdingWarnings(plan, plantsById);
    const { scene } = sunContext();
    const grown = { ...scene, occluders: [...grownOccluders(plan, plantsById, scene.groundZ), ...buildingOccluders(scene.groundZ), ...pluginOccluders(scene.groundZ)] };
    const shade = shadeWarnings(plan, plantsById, grown, seasonSamples());
    const fmt1 = (v: number) => new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(v);
    // Site climate: per plant (all its placements), not per placement.
    const climate = currentClimate();
    const climateItems: { ids: string[]; text: string }[] = [];
    if (climate) {
      const byPlant = new Map<string, string[]>();
      for (const pl of plan.placements) byPlant.set(pl.plantId, [...(byPlant.get(pl.plantId) ?? []), pl.id]);
      for (const [plantId, ids] of byPlant) {
        const p = plantsById.get(plantId);
        if (!p) continue;
        const nm = displayName(p) || p.latinName;
        if (notHardy(p, climate)) {
          climateItems.push({ ids, text: t('warnNotHardy', { name: nm, zone: zoneLabel(climate.zone), need: String(plantZoneRange(p.climateZone)![0]) }) });
        } else if (blossomFrostRisk(p, climate) && ['tree', 'shrub'].includes(deriveLayer(p))) {
          const m = p.flowerMonths.findIndex(Boolean);
          climateItems.push({ ids, text: t('warnBlossomFrost', {
            name: nm, month: new Intl.DateTimeFormat(lang, { month: 'long' }).format(new Date(2001, m, 1)), date: doyLabel(climate.lastFrostDoy!, lang),
          }) });
        }
      }
    }
    renderYield();
    renderPhases();
    const neighbors = neighborHints(plan, plantsById);
    // Full-grown crown of a placement (the hints look 30 years ahead).
    const crown = (id: string): WarnMark[] => {
      const pl = plan.placements.find(p => p.id === id);
      const p = pl ? plantsById.get(pl.plantId) : undefined;
      return pl ? [{ xM: pl.xM, yM: pl.yM, rM: p ? displayRadiusM(p, WARN_YEARS) : 0.5, kind: 'crown' }] : [];
    };
    const at = (id: string) => plan.placements.find(p => p.id === id);
    const item = (key: string, ids: string[], text: string, marks: WarnMark[], tone: 'bad' | 'good' = 'bad'): WarnItem => ({ key, ids, text, marks, tone });
    const items: WarnItem[] = [
      ...neighbors.bad.map(w => item(`nb:${w.source}:${w.target}`, [w.source, w.target], t('warnBadNeighbor', {
        a: name(w.source), b: name(w.target), d: fmt1(w.distM), r: fmt1(w.radiusM), why: w.reason.label[lang === 'en' ? 'en' : 'de'],
      }), [{ xM: at(w.source)!.xM, yM: at(w.source)!.yM, rM: w.radiusM, kind: 'zone' }, ...crown(w.target)])),
      ...climateItems.map(c => item(`cl:${c.ids.join(',')}:${c.text.slice(0, 12)}`, c.ids, c.text, c.ids.flatMap(crown))),
      ...shade.map(w => item(`sh:${w.id}`, [w.id], t('warnShade', { name: name(w.id), h: fmt1(w.hours), need: t(w.need === 'full' ? 'warnNeedFull' : 'warnNeedMid') }), crown(w.id))),
      ...crowd.map(w => item(`cr:${w.a}:${w.b}`, [w.a, w.b], t('warnCrowded', { a: name(w.a), b: name(w.b), d: fmt1(w.distM), min: fmt1(w.minM) }), [...crown(w.a), ...crown(w.b)])),
    ];
    const before = warnedIds;
    warnedIds = new Set(items.flatMap(i => i.ids));
    // Good neighbours: one line per fruiting plant with its helpers.
    const roleLabel = (r: string) => t(r === 'nitrogen' ? 'roleNitrogen' : r === 'nutrients' ? 'roleNutrients' : 'roleInsects');
    const goodItems = neighbors.good.map(g => item(`gn:${g.target}`, [g.target, ...g.helpers.map(h => h.id)],
      t('goodNeighbor', { name: name(g.target), helpers: g.helpers.slice(0, 4).map(h => `${name(h.id)} (${roleLabel(h.role)})`).join(', ') }),
      [g.target, ...g.helpers.map(h => h.id)].flatMap(crown), 'good'));
    warnItemsByKey.clear();
    for (const i of [...items, ...goodItems]) warnItemsByKey.set(i.key, i);
    warningsSection.hidden = items.length === 0 && goodItems.length === 0;
    warningsCount.textContent = String(items.length);
    warningsList.innerHTML = items.slice(0, 30).map(i => `
      <li><button type="button" data-key="${escapeHtml(i.key)}" data-tone="bad" aria-pressed="false" class="w-full rounded px-1.5 py-1 text-left hover:bg-red-50 dark:hover:bg-red-900/30">${escapeHtml(i.text)}</button></li>`).join('');
    goodNeighborsHeading.hidden = goodItems.length === 0;
    goodNeighborsList.innerHTML = goodItems.slice(0, 20).map(i => `
      <li><button type="button" data-key="${escapeHtml(i.key)}" data-tone="good" aria-pressed="false" class="w-full rounded px-1.5 py-1 text-left hover:bg-green-50 dark:hover:bg-green-900/30"><span aria-hidden="true" class="text-green-700 dark:text-green-400">✓ </span>${escapeHtml(i.text)}</button></li>`).join('');
    warningsSection.querySelectorAll<HTMLButtonElement>('[data-key]').forEach(b => {
      const it = () => warnItemsByKey.get(b.dataset.key!) ?? null;
      b.addEventListener('mouseenter', () => setWarnHover(it()));
      b.addEventListener('focus', () => setWarnHover(it()));
      b.addEventListener('mouseleave', () => setWarnHover(null));
      b.addEventListener('blur', () => setWarnHover(null));
    });
    // Keep a pinned hint across re-renders (positions may have changed).
    setWarnPin(pinnedWarn ? warnItemsByKey.get(pinnedWarn.key) ?? null : null);
    warningsSection.querySelectorAll<HTMLButtonElement>('[data-key]').forEach(b => b.addEventListener('click', () => {
      const it = warnItemsByKey.get(b.dataset.key!);
      if (!it) return;
      // First click: jump there and mark the area (2D); second click: select the plants.
      if (pinnedWarn?.key !== it.key && plan3dContainer.hidden) {
        setWarnPin(it);
        focusWarnArea(it);
        return;
      }
      const ids = it.ids;
      focusPlacements(ids);
      multiSel.clear();
      if (ids.length > 1) { ids.forEach(id => multiSel.add(id)); selectedPlacementId = null; }
      else selectedPlacementId = ids[0];
      view3d?.setSelectedPlacement(selectedPlacementId);
      refreshMarkerHighlight();
      renderSelectedPanel();
    }));
    if (before.size !== warnedIds.size || [...warnedIds].some(id => !before.has(id))) refreshMarkerHighlight();
    guideWarnings = items;
    renderSimpleGuide();
  }

  // ── Einfacher Modus: drei Schritte, Schichten sammeln, ein Tipp ─────────
  // Only drawn while the 'simple-guide' feature is on (lib/features.ts). The
  // tip shows the most important hint (same list as "Hinweise") or, without
  // one, the next empty layer; layers fill up as plants of that layer land.
  const guideSteps = document.getElementById('guide-steps')!;
  const guideLayers = document.getElementById('guide-layers')!;
  const guideStats = document.getElementById('guide-stats')!;
  const guideTip = document.getElementById('guide-tip')!;
  const GUIDE_LAYERS: PlantLayer[] = ['tree', 'shrub', 'herb', 'climber', 'rhizo'];
  const GUIDE_TIP_LAYER: Record<PlantLayer, string> = {
    tree: 'guideTipTree', shrub: 'guideTipShrub', herb: 'guideTipHerb', climber: 'guideTipClimber', rhizo: 'guideTipRhizo',
  };
  const GUIDE_LAYER_SHORT: Record<PlantLayer, string> = {
    tree: 'guideLayerTree', shrub: 'guideLayerShrub', herb: 'guideLayerHerb', climber: 'guideLayerClimber', rhizo: 'guideLayerRhizo',
  };
  const guide3dSeen = new Set<string>();
  let guideWarnings: WarnItem[] = [];
  let guideFilledBefore = new Set<PlantLayer>();
  let guideWarn: WarnItem | null = null;

  function renderSimpleGuide() {
    if (!editing || !featureOn('simple-guide')) return;
    const inB = !phaseB.classList.contains('hidden');
    const placed = editing.placements;
    const seen3d = guide3dSeen.has(editing.id);
    const states = [inB ? 'done' : 'now', !inB ? 'todo' : placed.length ? 'done' : 'now', !inB || !placed.length ? 'todo' : seen3d ? 'done' : 'now'];
    guideSteps.querySelectorAll<HTMLElement>('[data-step]').forEach((b, i) => {
      b.dataset.state = states[i];
      b.querySelector('.guide-num')!.textContent = states[i] === 'done' ? '✓' : String(i + 1);
    });
    const counts = new Map<PlantLayer, number>();
    for (const pl of placed) {
      const p = plantsById.get(pl.plantId);
      if (p) counts.set(deriveLayer(p), (counts.get(deriveLayer(p)) ?? 0) + 1);
    }
    guideLayers.innerHTML = GUIDE_LAYERS.map(l => {
      const n = counts.get(l) ?? 0;
      const pop = n && !guideFilledBefore.has(l) ? ' guide-pop' : '';
      return `<div class="text-center text-[10px] leading-tight text-stone-600 dark:text-stone-300">
        <span class="mb-1 block h-8 rounded-md transition-opacity duration-500${pop}" style="background:${LAYER_STYLE[l].fill};opacity:${n ? 1 : 0.18}"></span>
        ${escapeHtml(t(GUIDE_LAYER_SHORT[l]))}${n ? `<span class="block font-semibold text-stone-800 dark:text-stone-100">${n}</span>` : ''}</div>`;
    }).join('');
    guideFilledBefore = new Set(counts.keys());
    guideStats.textContent = t('guideStats', { n: placed.length, layers: counts.size });
    guideWarn = null;
    let tip: string;
    if (!inB) tip = t('guideTipDraw');
    else if (!plantsById.size) tip = t('guideTipNoPlants');
    else if (!placed.length) tip = t('guideTipStart');
    else if (guideWarnings.length) { guideWarn = guideWarnings[0]; tip = guideWarn.text; }
    else {
      const missing = GUIDE_LAYERS.find(l => !counts.has(l));
      tip = missing ? t(GUIDE_TIP_LAYER[missing]) : t(seen3d ? 'guideTipDone' : 'guideTipAll');
    }
    guideTip.innerHTML = `<span class="font-semibold">${escapeHtml(t('guideTipLabel'))}</span> ${escapeHtml(tip)}`
      + (guideWarn ? ` <button type="button" id="guide-tip-show" class="font-semibold underline underline-offset-2 hover:no-underline">${escapeHtml(t('guideTipShow'))}</button>` : '');
  }
  guideTip.addEventListener('click', e => {
    if (!guideWarn || !(e.target as HTMLElement).closest('#guide-tip-show')) return;
    if (!plan3dContainer.hidden) btnView2d.click();
    setWarnPin(guideWarn);
    focusWarnArea(guideWarn);
  });
  guideSteps.addEventListener('click', e => {
    const step = (e.target as HTMLElement).closest<HTMLElement>('[data-step]')?.dataset.step;
    if (!editing || phaseB.classList.contains('hidden')) return;
    if (step === '2') {
      const filter = document.getElementById(plantsById.size ? 'picker-filter' : 'plant-search') as HTMLInputElement | null;
      filter?.focus();
    } else if (step === '3' && editing.placements.length && plan3dContainer.hidden) btnView3d.click();
  });
  btnView3d.addEventListener('click', () => {
    if (!editing) return;
    guide3dSeen.add(editing.id);
    renderSimpleGuide();
  });

  // Mode switched (header menu) or the admin changed the feature table:
  // drop tools and overlays that are now off, redraw what depends on them.
  onFeaturesChange(() => {
    if ((tool === 'lasso' && !featureOn('lasso')) || (tool === 'measure' && !featureOn('measure'))) setTool('select');
    if (!featureOn('gps') && gpsWatch != null) stopGps();
    if (!editing || phaseB.classList.contains('hidden')) { renderSimpleGuide(); return; }
    renderPlanSvg();
    void loadBuildings();
    afterBuildingsChanged();
    scheduleWarnings();
  });

  // ── Schnittstelle für private Experten-Module (lib/expert-api.ts) ───────
  const planChangeListeners: ((plan: GardenPlan | null) => void)[] = [];
  // Plugin hooks (expert-api.ts): extra 3D content and shade casters.
  const pluginLayers: { featureId: string; layer: Scene3DLayer }[] = [];
  const pluginOccluderFns: { featureId: string; fn: (groundZ: (x: number, y: number) => number) => Occluder[] }[] = [];
  const pluginOverlays: { featureId: string; draw: (px: number) => string }[] = [];
  /** Plugin drawings on the 2D plan: markup in metres, `px` = metres per screen pixel. */
  function renderPluginOverlays() {
    const g = planSvg.querySelector('#plugin-layer');
    if (!g || !editing) return;
    const px = viewK() / U;
    g.innerHTML = pluginOverlays.filter(o => featureOn(o.featureId)).map(o => {
      try { return `<g transform="scale(${U})">${o.draw(px)}</g>`; } catch { return ''; }
    }).join('');
  }
  function pluginOccluders(groundZ: (x: number, y: number) => number): Occluder[] {
    return pluginOccluderFns.filter(o => featureOn(o.featureId)).flatMap(o => { try { return o.fn(groundZ); } catch { return []; } });
  }
  function notifyPlanChange() {
    for (const cb of planChangeListeners) {
      try { cb(editing); } catch (err) { console.warn('expert plan listener failed', err); }
    }
  }
  providePageApi('gartenplan', {
    getPlan: () => editing,
    add3dLayer(featureId, layer) {
      pluginLayers.push({ featureId, layer });
      if (!plan3dContainer.hidden && featureOn(featureId)) btnView3d.click();
    },
    addSunOccluders(featureId, fn) { pluginOccluderFns.push({ featureId, fn }); },
    addPlanOverlay(featureId, draw) { pluginOverlays.push({ featureId, draw }); renderPluginOverlays(); return renderPluginOverlays; },
    plantsById: () => plantsById,
    groundAt: (xM, yM) => (terrain && editing?.geo ? sampleGrid(terrain, xM, yM) : null),
    refresh() {
      if (!editing) return;
      renderPluginOverlays();
      scheduleWarnings();
      if (coverageSelect.value.startsWith('sun')) scheduleCoverage();
      if (!plan3dContainer.hidden) btnView3d.click();
    },
    onPlanChange: cb => { planChangeListeners.push(cb); },
    addPanel(featureId, title) {
      const panel = document.createElement('details');
      panel.open = true;
      panel.dataset.feature = featureId;
      panel.dataset.panel = featureId;
      panel.className = 'group/panel rounded-xl bg-stone-50 dark:bg-stone-900 p-4 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700';
      panel.innerHTML = `<summary class="flex cursor-pointer list-none items-center justify-between gap-2 group-open/panel:mb-2"><h2 class="text-sm font-semibold text-stone-800 dark:text-stone-100"></h2><span aria-hidden="true" class="text-[10px] font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400">${escapeHtml(t('expertBadge'))}</span></summary><div></div>`;
      panel.querySelector('h2')!.textContent = title;
      document.querySelector('#phase-b aside')!.appendChild(panel);
      return panel.querySelector('div')!;
    },
  });


  // ── Messen ─────────────────────────────────────────────────────────────
  // Measure tool (M): taps add points (drags still pan), each segment and the
  // total show their length; tapping the first point or Enter closes the
  // shape and shows area + perimeter. Backspace drops the last point, Esc
  // clears. Not saved with the plan.
  const measureReadout = document.getElementById('measure-readout')!;
  let measurePts: GardenPlanPoint[] = [];
  let measureClosed = false;
  function clearMeasure() { measurePts = []; measureClosed = false; renderMeasure(); }
  function addMeasurePoint(e: PointerEvent) {
    const p = clientToMeters(planSvg, e.clientX, e.clientY);
    if (measureClosed) { measurePts = []; measureClosed = false; }
    // Tap near the first point (≤ 12 px) closes the shape.
    if (measurePts.length >= 3) {
      const f = measurePts[0];
      if (Math.hypot(f.xM - p.xM, f.yM - p.yM) * U * pxPerUnit() <= 12) { measureClosed = true; renderMeasure(); return; }
    }
    measurePts.push(p);
    renderMeasure();
  }
  function renderMeasure() {
    const g = planSvg.querySelector('#measure-layer');
    const n = measurePts.length;
    measureReadout.hidden = n === 0;
    if (!g) return;
    if (n === 0) { g.innerHTML = ''; return; }
    const k = viewK();
    const pts = measurePts.map(p => `${p.xM * U},${p.yM * U}`).join(' ');
    const label = (x: number, y: number, text: string, size = 12) =>
      `<text x="${x * U}" y="${y * U}" text-anchor="middle" dominant-baseline="central" font-size="${size * k}" font-weight="600" fill="#7c2d12" stroke="#fff" stroke-width="${3 * k}" paint-order="stroke">${escapeHtml(text)}</text>`;
    let svg = measureClosed
      ? `<polygon points="${pts}" fill="#f97316" fill-opacity="0.15" stroke="#ea580c" stroke-width="${2 * k}"/>`
      : `<polyline points="${pts}" fill="none" stroke="#ea580c" stroke-width="${2 * k}" stroke-dasharray="${6 * k} ${3 * k}"/>`;
    const segs = measureClosed ? n : n - 1;
    let total = 0;
    for (let i = 0; i < segs; i++) {
      const a = measurePts[i], b = measurePts[(i + 1) % n];
      const d = Math.hypot(b.xM - a.xM, b.yM - a.yM);
      total += d;
      svg += label((a.xM + b.xM) / 2, (a.yM + b.yM) / 2, formatMeters(d, lang), 11);
    }
    svg += measurePts.map((p, i) => `<circle cx="${p.xM * U}" cy="${p.yM * U}" r="${(i === 0 && n >= 3 && !measureClosed ? 6 : 4) * k}" fill="#fff" stroke="#ea580c" stroke-width="${2 * k}"/>`).join('');
    const fmt1 = (v: number) => new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(v);
    if (measureClosed) {
      const c = polygonCentroid(measurePts);
      const area = polygonAreaM2(measurePts);
      svg += label(c.xM, c.yM, `${fmt1(area)} m²`, 14);
      measureReadout.textContent = t('measureArea', { area: fmt1(area), perim: formatMeters(polygonPerimeterM(measurePts), lang) });
    } else {
      measureReadout.textContent = n === 1 ? t('measureStart') : t('measureLength', { len: formatMeters(total, lang) });
    }
    g.innerHTML = svg;
  }
  document.addEventListener('keydown', e => {
    if (tool !== 'measure' || !measurePts.length) return;
    const tg = e.target as HTMLElement | null;
    if (tg?.closest?.('input, textarea, select')) return;
    if (e.key === 'Enter' && measurePts.length >= 3) { measureClosed = true; renderMeasure(); e.preventDefault(); }
    else if (e.key === 'Backspace' || e.key === 'Delete') { if (measureClosed) measureClosed = false; else measurePts.pop(); renderMeasure(); e.preventDefault(); e.stopImmediatePropagation(); }
  }, true);


  // ── Pflanzliste / Einkaufszettel ───────────────────────────────────────
  const shoppingDialog = document.getElementById('shopping-dialog') as HTMLDialogElement;
  const shoppingBody = document.getElementById('shopping-body')!;
  const shoppingFoot = document.getElementById('shopping-foot')!;
  const money = (v: number) => new Intl.NumberFormat(lang, { style: 'currency', currency: 'EUR' }).format(v);
  const shopLabels = (): ShoppingLabels => ({
    plant: t('shopPlant'), latin: t('shopLatin'), layer: t('shopLayer'), count: t('shopCount'), spacing: t('shopSpacingM'),
    height: t('shopHeightM'), price: t('shopPriceEur'), sum: t('shopSumEur'), total: t('shopTotal'), layerName: l => t(LAYER_I18N[l]),
    countShort: t('shopCountShort'), spacingShort: t('shopSpacingShort'), priceShort: '€/Stk', sumShort: '€',
  });
  function currentShoppingRows() { return editing ? shoppingRows(editing, plantsById, displayName) : []; }
  function renderShopping() {
    if (!editing) return;
    const rows = currentShoppingRows();
    const prices = editing.plantPrices ?? {};
    const m1 = (v: number) => v ? formatMeters(v, lang).replace(/,00 m$|\.00 m$/, ' m') : '—';
    shoppingBody.innerHTML = rows.length ? rows.map(r => `
      <tr>
        <td class="py-1.5 pr-2"><span class="block">${escapeHtml(r.name)}</span><span class="block text-xs italic text-stone-500 dark:text-stone-400">${escapeHtml(r.latinName)}</span></td>
        <td class="py-1.5 pr-2 text-xs">${escapeHtml(t(LAYER_I18N[r.layer]))}</td>
        <td class="py-1.5 pr-2 text-right font-mono">${r.count}</td>
        <td class="py-1.5 pr-2 text-right font-mono text-xs">${m1(r.widthM)}</td>
        <td class="py-1.5 pr-2 text-right"><input type="text" inputmode="decimal" autocomplete="off" data-price="${escapeHtml(r.plantId)}" value="${prices[r.plantId] != null ? new Intl.NumberFormat(lang, { minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: false }).format(prices[r.plantId]) : ''}" aria-label="${escapeHtml(t('shopPrice'))} ${escapeHtml(r.name)}" class="w-20 rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-1.5 py-0.5 text-right text-xs" /></td>
        <td class="py-1.5 text-right font-mono text-xs">${prices[r.plantId] ? money(prices[r.plantId] * r.count) : '—'}</td>
      </tr>`).join('') : `<tr><td colspan="6" class="py-3 text-center text-stone-500">${escapeHtml(t('shopEmpty'))}</td></tr>`;
    const tot = shoppingTotal(rows, prices);
    shoppingFoot.innerHTML = `<tr><td class="pt-2" colspan="2">${escapeHtml(t('shopTotal'))}</td><td class="pt-2 text-right font-mono">${tot.count}</td><td></td><td></td><td class="pt-2 text-right font-mono">${tot.priced ? money(tot.cost) : '—'}</td></tr>`;
    shoppingBody.querySelectorAll<HTMLInputElement>('[data-price]').forEach(inp => inp.addEventListener('change', () => {
      if (!editing) return;
      const v = Number(inp.value.replace(',', '.'));
      const next = { ...(editing.plantPrices ?? {}) };
      if (inp.value.trim() === '' || !Number.isFinite(v) || v < 0) delete next[inp.dataset.price!];
      else next[inp.dataset.price!] = Math.round(v * 100) / 100;
      editing.plantPrices = next;
      scheduleAutosave();
      renderShopping();
    }));
  }
  const shopFile = (ext: string) => `${(editing?.name || t('planUnnamed')).replace(/[\\/:*?"<>|]+/g, '_')} – ${t('shopTitle')}.${ext}`;
  document.getElementById('btn-shopping')!.addEventListener('click', () => { renderShopping(); shoppingDialog.showModal(); });
  // "Kalender": the calendar page filtered to this plan's plants.
  document.getElementById('btn-plan-calendar')!.addEventListener('click', e => {
    if (!editing) return;
    e.preventDefault();
    location.href = `/kalender?plan=${encodeURIComponent(editing.id)}`;
  });
  document.getElementById('shopping-close')!.addEventListener('click', () => shoppingDialog.close());
  shoppingDialog.addEventListener('click', e => { if (e.target === shoppingDialog) shoppingDialog.close(); });
  document.getElementById('shopping-csv')!.addEventListener('click', () => {
    if (!editing) return;
    downloadText(shoppingCsv(currentShoppingRows(), editing.plantPrices, shopLabels(), lang), shopFile('csv'), 'text/csv;charset=utf-8');
  });
  document.getElementById('shopping-pdf')!.addEventListener('click', async e => {
    if (!editing) return;
    const plan = editing;
    await withButtonSpinner(e.currentTarget as HTMLButtonElement, () =>
      exportShoppingPDF(`${plan.name || t('planUnnamed')} – ${t('shopTitle')}`, currentShoppingRows(), plan.plantPrices, shopLabels(), lang, shopFile('pdf')));
  });

  // ── 3D-Bild ────────────────────────────────────────────────────────────
  // PNG of the current 3D view with plan name, date and the source credits
  // burnt in (the licenses of map, aerial photo and elevation data ask for it).
  async function saveSnapshot() {
    if (!view3d || !editing) return;
    const c = view3d.snapshot();
    const ctx = c.getContext('2d')!;
    const dpr = Math.max(1, c.width / Math.max(1, plan3dContainer.clientWidth));
    const credits = (document.querySelector('#plan-wrap .basemap-attrib')?.textContent ?? '').trim();
    const font = (px: number, w = 400) => `${w} ${Math.round(px * dpr)}px system-ui, sans-serif`;
    // title
    const title = `${editing.name || t('planUnnamed')} · ${new Intl.DateTimeFormat(lang, { dateStyle: 'medium' }).format(new Date())}`;
    ctx.font = font(15, 600);
    const tw = ctx.measureText(title).width;
    ctx.fillStyle = 'rgba(255,255,255,0.8)';
    ctx.fillRect(8 * dpr, 8 * dpr, tw + 16 * dpr, 26 * dpr);
    ctx.fillStyle = '#1c1917';
    ctx.textBaseline = 'middle';
    ctx.fillText(title, 16 * dpr, 21 * dpr);
    // credits, wrapped to the width
    if (credits) {
      ctx.font = font(10);
      const maxW = c.width - 16 * dpr;
      const lines: string[] = [];
      let line = '';
      for (const w of credits.split(' ')) {
        const next = line ? `${line} ${w}` : w;
        if (ctx.measureText(next).width > maxW && line) { lines.push(line); line = w; } else line = next;
      }
      if (line) lines.push(line);
      const lh = 13 * dpr;
      ctx.fillStyle = 'rgba(255,255,255,0.8)';
      ctx.fillRect(0, c.height - lines.length * lh - 6 * dpr, c.width, lines.length * lh + 6 * dpr);
      ctx.fillStyle = '#44403c';
      lines.forEach((l, i) => ctx.fillText(l, 8 * dpr, c.height - (lines.length - i) * lh + lh / 2 - 3 * dpr));
    }
    const blob = await new Promise<Blob | null>(r => c.toBlob(r, 'image/png'));
    if (!blob) return;
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${(editing.name || t('planUnnamed')).replace(/[\\/:*?"<>|]+/g, '_')} – 3D.png`;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
  }
  document.getElementById('btn-snapshot')!.addEventListener('click', () => void saveSnapshot());

  // ── Zeitraffer (Wachstum) ──────────────────────────────────────────────
  // Plays the years slider from 0 to its end (one year per 0.35 s — shorter
  // than the undo debounce, so a whole run is one undo step). At the end a
  // click starts over; moving the slider by hand stops it.
  const growthBtn = document.getElementById('growth-play') as HTMLButtonElement;
  let growthTimer: ReturnType<typeof setInterval> | null = null;
  function stopGrowth() {
    if (growthTimer) clearInterval(growthTimer);
    growthTimer = null;
    growthBtn.textContent = t('growthPlay');
  }
  function setYears(v: number) {
    yearsInput.value = String(v);
    yearsInput.dispatchEvent(new Event('input', { bubbles: true }));
  }
  growthBtn.addEventListener('click', () => {
    if (growthTimer) { stopGrowth(); return; }
    const max = Number(yearsInput.max);
    if (Number(yearsInput.value) >= max) setYears(0);
    growthBtn.textContent = t('growthStop');
    growthTimer = setInterval(() => {
      const next = Number(yearsInput.value) + 1;
      if (next > max) { stopGrowth(); return; }
      setYears(next);
      if (next >= max) stopGrowth();
    }, 350);
  });
  yearsInput.addEventListener('pointerdown', stopGrowth);
  yearsInput.addEventListener('keydown', stopGrowth);

  // ── Polykultur als Paket ───────────────────────────────────────────────
  const pcPackage = document.getElementById('pc-package') as HTMLSelectElement;
  const pkgHint = document.getElementById('pkg-hint')!;
  let packageArmed: string | null = null;

  function fillPackageSelect() {
    const usable = polycultures.filter(pc => pc.anchorPlantId || pc.members.length);
    pcPackage.innerHTML = `<option value="">${escapeHtml(t(usable.length ? 'pkgPlaceholder' : 'pkgNone'))}</option>`
      + usable.map(pc => `<option value="${pc.id}">${escapeHtml(pc.name || t('planUnnamed'))}</option>`).join('');
    pcPackage.disabled = usable.length === 0;
    (document.getElementById('btn-pc-package') as HTMLButtonElement).disabled = usable.length === 0;
  }

  function setPackageArmed(id: string | null) {
    packageArmed = id;
    pkgHint.classList.toggle('hidden', !id);
    planSvg.classList.toggle('area-drawing', !!id);
    if (id) { armedPlantId = null; armedHint.classList.add('hidden'); renderPlantPicker(); }
  }

  document.getElementById('btn-pc-package')!.addEventListener('click', () => {
    if (!pcPackage.value) { pcPackage.focus(); return; }
    if (!plan3dContainer.hidden) btnView2d.click();
    endAreaDraw();
    endRowDraw();
    setPackageArmed(pcPackage.value);
  });

  function placePackage(e: PointerEvent) {
    const pc = polycultures.find(p => p.id === packageArmed);
    setPackageArmed(null);
    if (!editing || !pc) return;
    const at = clientToMeters(planSvg, e.clientX, e.clientY);
    const spots = layoutPolyculture(pc, plantsById, at, editing.yearsSincePlanting);
    const ids = new Set<string>();
    for (const sp of spots) {
      const id = newId();
      ids.add(id);
      editing.placements.push({ id, plantId: sp.plantId, xM: sp.xM, yM: sp.yM, notes: '' });
    }
    // Mark the new group so it can be moved together right away.
    multiSel.clear();
    ids.forEach(id => multiSel.add(id));
    selectedPlacementId = null;
    renderPlanSvg();
    renderSelectedPanel();
    renderSuggestions();
    afterGeometryEdit();
    showToast(t('toastPkgPlaced', { name: pc.name || t('planUnnamed'), n: spots.length }));
  }

  // ── Pflanzensuche (wie auf der Pflanzenseite) ─────────────────────────────
  // Visible only in the placement view: follows the editor / phase B state.
  const searchHero = document.getElementById('plan-search-hero')!;
  const syncSearchHero = () => { searchHero.hidden = editorView.hidden || phaseB.classList.contains('hidden'); };
  const heroObserver = new MutationObserver(syncSearchHero);
  heroObserver.observe(editorView, { attributes: true, attributeFilter: ['hidden'] });
  heroObserver.observe(phaseB, { attributes: true, attributeFilter: ['class'] });
  syncSearchHero();
  // A found plant goes into the collection; with a plan open it is armed
  // right away, so the next click on the map places it.
  initPlantSearchUi({
    input: document.getElementById('plant-search') as HTMLInputElement,
    button: document.getElementById('btn-search') as HTMLButtonElement,
    results: document.getElementById('search-results')!,
    plants: () => plants,
    onAdded: async (plant) => {
      plants = await getAllPlants();
      plantsById = new Map(plants.map(p => [p.id, p]));
      if (editing && !phaseB.classList.contains('hidden')) {
        armedPlantId = plant.id;
        armedHint.classList.remove('hidden');
        view3d?.setArmedPlant(armedPlantId);
        renderPlantPicker();
        renderSuggestions();
        showToast(tSearch('searchAddedArmed', { name: displayName(plant) || plant.latinName }));
      }
    },
  });
  const tSearch = createT(searchDict);

  // ── Init + save/delete ──────────────────────────────────────────────────
  async function init() {
    plants = await getAllPlants();
    plantsById = new Map(plants.map(p => [p.id, p]));
    polycultures = await getAllPolycultures();
    polyculturesById = new Map(polycultures.map(pc => [pc.id, pc]));
    plans = await getAllGardenPlans();
    renderList();

    // Resume the plan that was open when the page was last left (reload,
    // crash, accidental tab close) — but only if the user didn't explicitly
    // go back to the list (closeEditor clears this key), so "back to list"
    // stays a real navigation, not something a reload undoes.
    let lastId: string | null = null;
    try { lastId = localStorage.getItem(LAST_PLAN_KEY); } catch {}
    if (lastId && plans.some(p => p.id === lastId)) openEditor(lastId);
  }

  document.getElementById('btn-new-plan')!.addEventListener('click', () => openEditor(null));
  document.getElementById('btn-empty-new')!.addEventListener('click', () => openEditor(null));
  document.getElementById('btn-back-to-list')!.addEventListener('click', closeEditor);
  // Alt+4 or the „Waldgartenplan“ nav link while a plan is open: back to the
  // project list instead of reloading into the same plan (Layout.astro).
  document.addEventListener('pdk:nav-same', (e) => {
    if (!editing) return;
    e.preventDefault();
    closeEditor();
    renderList();   // names and counts as just edited
    window.scrollTo({ top: 0 });
  });

  /** Form fields sync into `editing` on every change (for autosave) as well
   *  as on save/export — export can happen without saving first, so it
   *  needs the same sync or it'd silently ignore a typed-but-unsaved
   *  name/description in the PDF title. */
  function syncFormIntoEditing() {
    if (!editing) return;
    editing.name = fName.value.trim();
    editing.description = fDescription.value.trim();
    editing.notes = fNotes.value;
    editing.polycultureId = fPolyculture.value || null;
  }

  [fName, fDescription, fNotes].forEach(el => {
    el.addEventListener('input', () => { syncFormIntoEditing(); scheduleAutosave(); });
  });
  fPolyculture.addEventListener('change', () => { syncFormIntoEditing(); scheduleAutosave(); });

  document.getElementById('btn-save-plan')!.addEventListener('click', async () => {
    if (!editing) return;
    if (!fName.value.trim()) { alert(t('alertEnterName')); return; }
    // Corners set but the outline not closed yet (still drawing a new plan):
    // ask before saving instead of silently dropping the drawn points.
    const pending = editing.boundary.length === 0 && phaseB.classList.contains('hidden')
      ? (mapDrawer ? mapDrawer.points().length : drawingPoints.length) : 0;
    if (pending >= 3) {
      if (!confirm(t('confirmCloseAreaBeforeSave', { n: pending }))) return; // keep drawing
      finishBoundary();
      if (editing.boundary.length < 3) return; // e.g. area too large — finishBoundary told why
    } else if (pending > 0) {
      if (!confirm(t('confirmSaveWithoutArea', { n: pending }))) return;
    }
    syncFormIntoEditing();
    await saveGardenPlan(editing);
    plans = await getAllGardenPlans();
    renderList();
    closeEditor();
    showToast(t('toastPlanSaved'));
  });

  document.getElementById('btn-delete-plan')!.addEventListener('click', async () => {
    if (!editing) return;
    if (!confirm(t('confirmDeletePlan', { name: editing.name || t('planUnnamed') }))) return;
    await deleteGardenPlan(editing.id);
    plans = await getAllGardenPlans();
    renderList();
    closeEditor();
    showToast(t('toastPlanDeleted'));
  });

  // "Mitglieder übernehmen" lives next to the polyculture select but is only
  // meaningful once one is chosen — inserted here rather than as static
  // markup so its i18n string can include the button semantics cleanly.
  (function insertImportMembersButton() {
    const wrap = document.createElement('div');
    wrap.className = 'mt-1';
    wrap.innerHTML = `<button id="btn-import-members" type="button" class="rounded-md bg-blue-100 dark:bg-blue-900/40 px-2.5 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 hover:bg-blue-200 dark:hover:bg-blue-900/60">${t('btnImportMembers')}</button>
      <p class="mt-1 text-[10px] text-stone-500 dark:text-stone-400">${t('importMembersHint')}</p>`;
    fPolyculture.closest('label')!.after(wrap);
    wrap.querySelector('#btn-import-members')!.addEventListener('click', importPolycultureMembers);
  })();

  init();
</script>
