---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Perma Design Kit — Gartenplan">
  <!-- ── Listenansicht ─────────────────────────────────────────────────── -->
  <section id="plan-list-view">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-2xl font-bold text-stone-900 dark:text-stone-100" data-i18n="pageTitle">Gartenplan</h1>
      <button id="btn-new-plan" data-i18n="btnNewPlan" class="rounded-lg bg-green-700 px-3.5 py-2 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">+ Neuer Gartenplan</button>
    </div>
    <p class="mb-4 text-sm text-stone-500 dark:text-stone-400" data-i18n="introText">Zeichne eine Fläche, platziere Pflanzen darauf und sieh mit dem Schieberegler, wie groß sie nach x Jahren ungefähr werden.</p>
    <p class="mb-4 rounded-lg bg-amber-50 dark:bg-amber-900/30 px-3 py-2 text-sm text-amber-800 dark:text-amber-200 ring-1 ring-amber-200 dark:ring-amber-800" data-i18n="experimentalNotice">Experimentell — diese Funktion befindet sich noch in der Entwicklung.</p>
    <div id="plan-list" class="grid gap-4 sm:grid-cols-2"></div>
    <div id="plan-empty" class="hidden rounded-xl border-2 border-dashed border-stone-300 dark:border-stone-600 py-16 text-center">
      <p class="text-stone-500 dark:text-stone-400" data-i18n="emptyStateText">Noch keine Gartenpläne angelegt.</p>
      <button id="btn-empty-new" data-i18n="btnEmptyNew" class="mt-3 inline-block rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow hover:bg-green-800">Ersten Gartenplan anlegen</button>
    </div>
  </section>

  <!-- ── Editor ────────────────────────────────────────────────────────── -->
  <section id="plan-editor-view" hidden>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <button id="btn-back-to-list" data-i18n="btnBackToList" class="text-sm font-medium text-stone-600 dark:text-stone-300 hover:text-green-700 dark:hover:text-green-400">← Zurück zur Liste</button>
      <div class="flex items-center gap-2">
        <button id="btn-delete-plan" data-i18n="btnDeletePlan" class="rounded-lg bg-red-100 dark:bg-red-900/40 px-3 py-1.5 text-sm font-medium text-red-700 dark:text-red-300 ring-1 ring-red-300 dark:ring-red-800 hover:bg-red-200 dark:hover:bg-red-900/60">Löschen</button>
      </div>
    </div>

    <!-- Karte: Standort, Ausrichtung, Hintergrund — gilt für beide Phasen -->
    <div id="map-bar" class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl bg-stone-50 dark:bg-stone-900 px-3 py-2 text-xs text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700">
      <button id="btn-locate" type="button" data-i18n="mapBarLocate" class="rounded-md bg-white dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700">📍 Standort festlegen…</button>
      <label class="inline-flex items-center gap-1.5">
        <span data-i18n="mapBarBackground">Hintergrund</span>
        <select id="g-basemap" class="rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-1.5 py-0.5 text-xs disabled:opacity-50">
          <option value="none" data-i18n="mapBgNone">Kein</option>
          <option value="osm" data-i18n="mapBgOsm">Karte (OpenStreetMap)</option>
          <option value="sat" data-i18n="mapBgSat">Satellit (grob, 10 m)</option>
        </select>
      </label>
      <label class="inline-flex items-center gap-1.5">
        <span data-i18n="mapBarOpacity">Deckkraft</span>
        <input id="g-basemap-opacity" type="range" min="0.1" max="1" step="0.05" value="0.6" class="w-24 disabled:opacity-50" />
      </label>
      <span id="map-status" class="text-stone-500 dark:text-stone-400"></span>
    </div>

    <!-- Phase A: Grunddaten + Fläche zeichnen -->
    <div id="phase-a">
      <div class="grid gap-6 lg:grid-cols-3">
        <div class="lg:col-span-1 space-y-4">
          <div class="rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 space-y-3">
            <label class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelName">Name</span>
              <input id="g-name" type="text" data-i18n-placeholder="placeholderName" placeholder="z.B. Vorgarten Süd" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
            </label>
            <label class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelDescription">Beschreibung</span>
              <input id="g-description" type="text" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
            </label>
            <label class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelLinkedPolyculture">Bestehende Polykultur verknüpfen (optional)</span>
              <select id="g-polyculture" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none"></select>
            </label>
            <fieldset>
              <legend class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelDrawOn">Fläche zeichnen auf</legend>
              <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-stone-700 dark:text-stone-200">
                <label class="inline-flex items-center gap-1.5"><input type="radio" name="draw-mode" value="map" checked class="accent-green-600" /> <span data-i18n="drawOnMap">Karte</span></label>
                <label class="inline-flex items-center gap-1.5"><input type="radio" name="draw-mode" value="grid" class="accent-green-600" /> <span data-i18n="drawOnGrid">Raster (ohne Standort)</span></label>
              </div>
              <p id="size-from-map-hint" class="mt-1 text-[11px] text-stone-500 dark:text-stone-400" data-i18n="sizeFromMapHint">Größe und Ausrichtung ergeben sich aus der gezeichneten Fläche.</p>
            </fieldset>
            <div id="size-fields" class="hidden grid grid-cols-2 gap-3">
              <label class="block">
                <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelAreaWidth">Breite (m)</span>
                <input id="g-width" type="number" min="2" max="50" step="0.5" value="10" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
              </label>
              <label class="block">
                <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelAreaHeight">Tiefe (m)</span>
                <input id="g-height" type="number" min="2" max="50" step="0.5" value="10" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
              </label>
            </div>
            <label class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelGridSpacing">Rastergröße</span>
              <select id="g-grid-spacing" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none">
                <option value="0.5">0.5 m</option>
                <option value="1" selected>1 m</option>
                <option value="2">2 m</option>
              </select>
            </label>
            <label class="block">
              <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelNotes">Notizen</span>
              <textarea id="g-notes" rows="2" data-i18n-placeholder="placeholderNotes" placeholder="Standort, Boden, Beobachtungen…" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none"></textarea>
            </label>
            <button id="btn-start-drawing" data-i18n="btnStartDrawing" class="w-full rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow hover:bg-green-800">Fläche zeichnen starten</button>
          </div>
        </div>

        <div class="lg:col-span-2 space-y-3">
          <div id="drawing-hint" class="hidden text-sm text-stone-600 dark:text-stone-300">
            <span id="drawing-hint-text" data-i18n="hintDrawing">Klicke auf die Fläche, um Eckpunkte zu setzen (mind. 3).</span>
            <span id="vertex-count" class="ml-1 font-medium"></span>
          </div>
          <div id="drawing-wrap" class="relative hidden rounded-xl bg-white dark:bg-stone-800 p-3 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
            <svg id="drawing-svg" class="w-full touch-none" style="touch-action:none"></svg>
            <div aria-hidden="true" class="cursor-readout pointer-events-none absolute hidden rounded bg-stone-900/80 px-1.5 py-0.5 font-mono text-[11px] text-white"></div>
            <div class="basemap-attrib absolute bottom-3 right-3 hidden rounded-tl bg-white/80 px-1 text-[10px] text-stone-600"></div>
          </div>
          <div id="mapdraw-wrap" class="hidden space-y-2 rounded-xl bg-white dark:bg-stone-800 p-3 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
            <div class="flex flex-wrap items-center gap-2">
              <form id="mapdraw-search-form" class="flex min-w-0 flex-1 gap-2">
                <input id="mapdraw-query" type="search" data-i18n-placeholder="locateSearchPlaceholder" data-i18n-aria-label="locateSearchPlaceholder" aria-label="Adresse oder Ort suchen…" placeholder="Adresse oder Ort suchen…" class="min-w-0 flex-1 rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
                <button id="mapdraw-search-btn" type="submit" data-i18n="locateSearchBtn" class="rounded-md bg-green-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-green-800 disabled:opacity-50">Suchen</button>
              </form>
              <button id="mapdraw-mypos" type="button" data-i18n="locateMyPosition" class="rounded-md bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Mein Standort</button>
            </div>
            <p id="mapdraw-status" class="min-h-[1rem] truncate text-xs text-stone-500 dark:text-stone-400"></p>
            <div id="mapdraw-map" class="h-[60vh] w-full rounded-lg ring-1 ring-stone-200 dark:ring-stone-700"></div>
            <div class="flex flex-wrap items-center gap-3 text-xs">
              <label class="inline-flex items-center gap-1"><input type="radio" name="mapdraw-layer" value="osm" checked /> <span data-i18n="locateLayerOsm">Karte</span></label>
              <label class="inline-flex items-center gap-1" data-i18n-title="locateSatNote" title="Satellitenbild nur zur groben Orientierung (10 m pro Pixel)."><input type="radio" name="mapdraw-layer" value="sat" /> <span data-i18n="locateLayerSat">Satellit (grob, 10 m)</span></label>
            </div>
          </div>
          <div id="drawing-controls" class="hidden flex flex-wrap gap-2">
            <button id="btn-undo-point" data-i18n="btnUndoPoint" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-700">Letzten Punkt entfernen</button>
            <button id="btn-clear-points" data-i18n="btnClearPoints" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-700">Neu beginnen</button>
            <button id="btn-finish-boundary" data-i18n="btnFinishBoundary" disabled class="rounded-lg bg-green-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-green-800 disabled:cursor-not-allowed disabled:opacity-40">Fläche abschließen</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Phase B: Platzierung + Wachstums-Schieberegler -->
    <div id="phase-b" class="hidden">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <label class="text-sm font-medium text-stone-600 dark:text-stone-300" for="g-years" data-i18n="labelYearsSincePlanting">Jahre seit Pflanzung</label>
          <input id="g-years" type="range" min="0" max="30" step="1" value="0" class="w-48" />
          <span id="years-label" class="w-20 text-sm font-medium text-stone-700 dark:text-stone-200"></span>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1 rounded-lg bg-stone-100 dark:bg-stone-800 p-0.5 text-xs">
            <button id="btn-view-2d" data-i18n="btnView2d" class="rounded-md bg-white dark:bg-stone-700 px-2.5 py-1 font-medium text-stone-800 dark:text-stone-100 shadow-sm">2D</button>
            <button id="btn-view-3d" data-i18n="btnView3d" class="rounded-md px-2.5 py-1 font-medium text-stone-500 dark:text-stone-400">3D</button>
          </div>
          <button id="btn-edit-boundary" type="button" aria-pressed="false" data-i18n="btnEditBoundary" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-700 hover:bg-stone-200 dark:hover:bg-stone-700 aria-pressed:bg-amber-100 aria-pressed:ring-amber-400 dark:aria-pressed:bg-amber-900/40">✎ Umriss bearbeiten</button>
          <button id="btn-draw-area" type="button" data-i18n="btnDrawArea" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-700 hover:bg-stone-200 dark:hover:bg-stone-700">▱ Fläche einzeichnen</button>
          <button id="btn-export-pdf" data-i18n="btnExportPdf" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-700 hover:bg-stone-200 dark:hover:bg-stone-700">PDF exportieren</button>
          <button id="btn-redraw-area" data-i18n="btnRedrawArea" class="text-xs font-medium text-stone-500 dark:text-stone-400 hover:text-red-600 dark:hover:text-red-400">Fläche neu zeichnen</button>
        </div>
      </div>

      <details class="mb-3 rounded-lg bg-stone-50 dark:bg-stone-900 px-3 py-1.5 text-xs text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700">
        <summary class="cursor-pointer select-none font-medium text-stone-500 dark:text-stone-400" data-i18n="infoToggle">ℹ️ Wie funktioniert das?</summary>
        <div class="mt-2 space-y-1.5">
          <p data-i18n="infoHowItWorks">Fläche zeichnen (Eckpunkte anklicken) → Pflanze in der Liste anklicken → auf die Fläche tippen zum Platzieren → platzierte Pflanzen per Ziehen frei verschieben.</p>
          <p data-i18n="infoGrowthModel">Die Größe der Pflanzen mit dem Regler ist ein <strong>Schätzmodell</strong>, keine Artdaten: PFAF liefert nur die finale Größe plus grob „langsam/mittel/schnell" — daraus wird eine Wachstumskurve angenähert (Reifealter schnell≈6, mittel≈15, langsam≈30 Jahre).</p>
          <p data-i18n="infoShapeModel">Baum/Strauch/Kraut werden aus der Höhe abgeleitet (keine echte Datenbank-Angabe) und als stilisierte, unregelmäßige Form dargestellt — keine artgenauen Umrisse.</p>
          <p data-i18n="infoView3d">Die 3D-Ansicht ist ebenso stilisiert wie die 2D-Formen — kein artgenaues Modell, nur zur räumlichen Orientierung.</p>
        </div>
      </details>

      <div class="grid gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2 space-y-2">
          <div id="area-draw-bar" class="hidden flex flex-wrap items-center gap-2 rounded-lg bg-amber-50 dark:bg-amber-900/30 px-3 py-2 text-xs text-amber-900 dark:text-amber-100 ring-1 ring-amber-200 dark:ring-amber-800">
            <span class="mr-auto" data-i18n="areaDrawHint">Eckpunkte anklicken; Klick auf den ersten Punkt oder „Fertig“ schließt die Fläche. Esc bricht ab.</span>
            <button id="btn-area-undo" type="button" data-i18n="btnUndoPoint" class="rounded-md bg-white dark:bg-stone-800 px-2.5 py-1 font-medium ring-1 ring-amber-300 dark:ring-amber-700">Letzten Punkt entfernen</button>
            <button id="btn-area-cancel" type="button" data-i18n="btnAreaCancel" class="rounded-md bg-white dark:bg-stone-800 px-2.5 py-1 font-medium ring-1 ring-amber-300 dark:ring-amber-700">Abbrechen</button>
            <button id="btn-area-finish" type="button" data-i18n="btnAreaFinish" disabled class="rounded-md bg-green-700 px-2.5 py-1 font-medium text-white disabled:opacity-40">Fertig</button>
          </div>
          <div id="boundary-edit-bar" class="hidden flex flex-wrap items-center gap-2 rounded-lg bg-amber-50 dark:bg-amber-900/30 px-3 py-2 text-xs text-amber-900 dark:text-amber-100 ring-1 ring-amber-200 dark:ring-amber-800">
            <span class="mr-auto" data-i18n="boundaryEditHint">Umriss bearbeiten: Ecken ziehen, ＋ auf einer Kante fügt einen Punkt ein, Doppelklick entfernt ihn. Über den Rand ziehen vergrößert den Plan.</span>
            <button id="btn-boundary-done" type="button" data-i18n="btnAreaFinish" class="rounded-md bg-green-700 px-2.5 py-1 font-medium text-white">Fertig</button>
          </div>
          <div id="plan-wrap" class="relative rounded-xl bg-white dark:bg-stone-800 p-3 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
            <svg id="plan-svg" class="w-full touch-none" style="touch-action:none"></svg>
            <div id="plan-3d-container" hidden class="h-[480px] w-full touch-none" style="touch-action:none"></div>
            <div id="zoom-controls" class="absolute left-5 top-5 flex flex-col gap-1">
              <button id="zoom-in" type="button" data-i18n-aria-label="zoomIn" data-i18n-title="zoomIn" aria-label="Hineinzoomen" title="Hineinzoomen" class="flex h-8 w-8 items-center justify-center rounded-md bg-white/90 dark:bg-stone-800/90 text-base font-semibold text-stone-700 dark:text-stone-200 shadow ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-white dark:hover:bg-stone-700">+</button>
              <button id="zoom-out" type="button" data-i18n-aria-label="zoomOut" data-i18n-title="zoomOut" aria-label="Herauszoomen" title="Herauszoomen" class="flex h-8 w-8 items-center justify-center rounded-md bg-white/90 dark:bg-stone-800/90 text-base font-semibold text-stone-700 dark:text-stone-200 shadow ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-white dark:hover:bg-stone-700">−</button>
              <button id="zoom-fit" type="button" data-i18n-aria-label="zoomFit" data-i18n-title="zoomFit" aria-label="Ganzen Plan zeigen" title="Ganzen Plan zeigen" class="flex h-8 w-8 items-center justify-center rounded-md bg-white/90 dark:bg-stone-800/90 text-base font-semibold text-stone-700 dark:text-stone-200 shadow ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-white dark:hover:bg-stone-700 text-sm">⤢</button>
            </div>
            <div aria-hidden="true" class="cursor-readout pointer-events-none absolute hidden rounded bg-stone-900/80 px-1.5 py-0.5 font-mono text-[11px] text-white"></div>
            <div class="basemap-attrib absolute bottom-3 right-3 hidden rounded-tl bg-white/80 px-1 text-[10px] text-stone-600"></div>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-1 text-xs text-stone-500 dark:text-stone-400">
            <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background-color:#166534"></span><span data-i18n="layerTree">Baum</span></span>
            <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background-color:#65a30d"></span><span data-i18n="layerShrub">Strauch</span></span>
            <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background-color:#a3e635"></span><span data-i18n="layerHerb">Kraut/Bodendecker</span></span>
            <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background-color:#0d9488"></span><span data-i18n="layerClimber">Kletterpflanze</span></span>
            <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background-color:#a16207"></span><span data-i18n="layerRhizo">Rhizom/Wurzel</span></span>
          </div>
        </div>

        <aside class="space-y-4">
          <div class="rounded-xl bg-stone-50 dark:bg-stone-900 p-4 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
            <h2 class="mb-2 text-sm font-semibold text-stone-800 dark:text-stone-100" data-i18n="pickerHeading">Pflanzen</h2>
            <input id="picker-filter" type="search" data-i18n-placeholder="pickerFilterPlaceholder" placeholder="Pflanze filtern…" class="mb-2 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-xs shadow-inner focus:border-green-500 focus:outline-none" />
            <div id="plant-picker" class="max-h-56 space-y-0.5 overflow-y-auto"></div>
            <p id="armed-hint" class="mt-2 hidden text-xs font-medium text-green-700 dark:text-green-400" data-i18n="hintArmed">Auf die Fläche tippen zum Platzieren.</p>
          </div>

          <div class="rounded-xl bg-stone-50 dark:bg-stone-900 p-4 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
            <h2 class="mb-2 text-sm font-semibold text-stone-800 dark:text-stone-100" data-i18n="areasHeading">Flächen</h2>
            <p id="areas-empty" class="text-xs text-stone-400 dark:text-stone-500" data-i18n="areasEmpty">Noch keine Flächen. Mit „Fläche einzeichnen“ Beete, Teich, Wege … einzeichnen.</p>
            <ul id="areas-list" class="space-y-1.5"></ul>
            <p id="area-edit-hint" hidden class="mt-2 text-[11px] text-stone-500 dark:text-stone-400" data-i18n="areaEditHint">Ausgewählte Fläche: Eckpunkte ziehen (auch in 3D), ＋ auf einer Kante fügt einen Punkt ein, Doppelklick auf einen Punkt entfernt ihn. Esc hebt die Auswahl auf.</p>
          </div>

