            <div id="suggestions-list" class="space-y-0.5"></div>
          </div>

          <div id="unplaced-section" class="hidden rounded-xl bg-stone-50 dark:bg-stone-900 p-4 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
