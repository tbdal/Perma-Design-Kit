---
import Layout from '../layouts/Layout.astro';
const field = 'mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-200';
const btn = 'rounded-lg px-3.5 py-2 text-sm font-medium shadow-sm';
---
<Layout title="Perma Design Kit — Fehler melden">
  <article class="mx-auto max-w-2xl space-y-5 text-stone-800 dark:text-stone-100">
    <h1 class="text-2xl font-bold" data-i18n="rpTitle">Fehler melden</h1>
    <p class="text-sm text-stone-600 dark:text-stone-300" data-i18n="rpIntro">Danke, dass du hilfst! Beschreib kurz, was passiert ist. Die App sendet selbst nichts: Du schickst die Meldung per GitHub oder E-Mail, und die Debug-Datei hängst du bei Bedarf selbst an.</p>

    <form id="rp-form" class="space-y-4 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
      <label class="block text-sm font-medium"><span data-i18n="rpPage">Auf welcher Seite?</span>
        <input id="rp-page" class={field} required />
      </label>
      <label class="block text-sm font-medium"><span data-i18n="rpWhat">Was ist passiert?</span>
        <textarea id="rp-what" rows="5" class={field} required data-i18n-placeholder="rpWhatPlaceholder" placeholder="Was hast du gemacht, und was ist dann passiert?"></textarea>
      </label>
      <label class="block text-sm font-medium"><span data-i18n="rpExpected">Was hast du erwartet?</span>
        <textarea id="rp-expected" rows="2" class={field}></textarea>
      </label>
      <p class="text-xs text-stone-500 dark:text-stone-400"><span data-i18n="rpEnv">Wird automatisch ergänzt:</span> <code id="rp-env" class="break-all"></code></p>

      <div id="rp-filebox" class="rounded-lg bg-stone-50 dark:bg-stone-900 p-3 text-sm">
        <p class="font-medium" data-i18n="rpFileTitle">Debug-Datei (optional)</p>
        <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="rpFileBody">Enthält Version, Browser, Fenstergröße, Einstellungen ohne Zugangsdaten, die Anzahl deiner Pflanzen und Pläne und die letzten Fehlermeldungen dieses Tabs.</p>
        <label class="mt-2 inline-flex items-start gap-2 text-xs"><input type="checkbox" id="rp-project" class="mt-0.5 accent-green-600" /> <span data-i18n="rpIncludeProject">Auch mein Projekt beilegen (Pflanzen, Polykulturen, Pläne mit Standort und Notizen) – nur, wenn der Fehler damit zu tun hat.</span></label>
        <div class="mt-2"><p id="rp-status" role="status" class="mb-1 text-xs text-stone-600 dark:text-stone-300 break-all"></p><button type="button" id="rp-download" data-i18n="rpDownload" class={`${btn} bg-white dark:bg-stone-800 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700`}>Debug-Datei herunterladen</button></div>
      </div>

      <p class="text-xs text-stone-500 dark:text-stone-400" data-i18n="rpScreenshot">Ein Bildschirmfoto hilft oft: Windows Win+Umschalt+S, macOS Cmd+Umschalt+4, Android/iOS Ein-/Aus- und Leiser-Taste. Anhängen kannst du es in GitHub oder in der Mail.</p>

      <label id="rp-shotbox" hidden class="block text-sm font-medium"><span data-i18n="rpShot">Bildschirmfoto anhängen (optional)</span>
        <input type="file" id="rp-shot" accept="image/*" class="mt-1 block text-xs" />
      </label>
      <div class="flex flex-wrap gap-2">
        <button type="submit" id="rp-werkstatt" data-action="werkstatt" hidden data-i18n="rpWerkstatt" class={`${btn} bg-sky-700 text-white hover:bg-sky-800`}>Direkt in die Werkstatt</button>
        <button type="submit" id="rp-beta" data-action="beta" hidden data-i18n="rpBeta" class={`${btn} bg-amber-600 text-white hover:bg-amber-700`}>Direkt an das Beta-Team</button>
        <button type="submit" data-action="github" data-i18n="rpGithub" class={`${btn} bg-green-700 text-white hover:bg-green-800`}>Auf GitHub melden</button>
        <button type="submit" data-action="mail" data-i18n="rpMail" class={`${btn} bg-white dark:bg-stone-800 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-100 dark:hover:bg-stone-700`}>Per E-Mail senden</button>
      </div>
      <p class="text-xs text-stone-500 dark:text-stone-400" data-i18n="rpGithubNote">GitHub braucht ein kostenloses Konto; Meldungen dort sind öffentlich. Ohne Konto: E-Mail an info@permadesignkit.org.</p>
    </form>
  </article>

  <script>
    import { applyStaticI18n, getLang } from '../lib/i18n/core';
    import { reportDict } from '../lib/i18n/dict-report';
    import { saveFile } from '../lib/save-file';
    import { currentMode } from '../lib/ui-mode';
    import { buildDebugInfo, environmentLine, issueUrl, mailtoUrl, APP_VERSION, REPORT_MAIL, type ReportText } from '../lib/bug-report';

    // ?art=idee (Feedback → "Idee einreichen"): the same form for an idea; no debug file.
    const idea = new URLSearchParams(location.search).get('art') === 'idee';
    if (idea) {
      for (const [from, to] of [['rpTitle', 'rpIdeaTitle'], ['rpIntro', 'rpIdeaIntro'], ['rpWhat', 'rpIdeaWhat'], ['rpWhatPlaceholder', 'rpIdeaWhatPlaceholder'], ['rpExpected', 'rpIdeaWhy'], ['rpGithub', 'rpIdeaGithub']]) {
        document.querySelectorAll(`[data-i18n="${from}"]`).forEach(el => el.setAttribute('data-i18n', to));
        document.querySelectorAll(`[data-i18n-placeholder="${from}"]`).forEach(el => el.setAttribute('data-i18n-placeholder', to));
      }
      document.getElementById('rp-filebox')!.hidden = true;
      document.title = document.title.replace(/Fehler melden|Report a problem/, getLang() === 'de' ? 'Idee einreichen' : 'Suggest an idea');
    }
    applyStaticI18n(reportDict);
    const page = document.getElementById('rp-page') as HTMLInputElement;
    const what = document.getElementById('rp-what') as HTMLTextAreaElement;
    const expected = document.getElementById('rp-expected') as HTMLTextAreaElement;
    const withProject = document.getElementById('rp-project') as HTMLInputElement;
    const form = document.getElementById('rp-form') as HTMLFormElement;

    // The page the person came from: ?from= (footer link) or the referrer path.
    const from = new URLSearchParams(location.search).get('from');
    let refPath = '';
    try { if (document.referrer && new URL(document.referrer).origin === location.origin) refPath = new URL(document.referrer).pathname; } catch {}
    page.value = from || refPath || '/';
    // Feedback → "Stelle markieren": the popup's text and the marked spot arrive here.
    {
      const q = new URLSearchParams(location.search), spot = q.get('spot');
      what.value = [q.get('what'), spot && `${getLang() === 'de' ? 'Stelle' : 'Spot'}: ${spot}`].filter(Boolean).join('\n\n');
    }
    const env = environmentLine();
    document.getElementById('rp-env')!.textContent = env;

    // Beta mode: the report (bug or idea) can also go straight into the team's Werkstatt.
    const beta = currentMode() === 'expert';
    document.getElementById('rp-beta')!.hidden = !beta;
    // Team: straight into the Werkstatt, with the debug file and a screenshot if wanted (#556).
    const team = currentMode() === 'team';
    document.getElementById('rp-werkstatt')!.hidden = !team;
    document.getElementById('rp-shotbox')!.hidden = !team;
    const text = (): ReportText => ({ page: page.value.trim(), what: what.value.trim(), expected: expected.value.trim(), ...(idea ? { idea } : {}), ...(beta ? { beta } : {}) });

    const status = document.getElementById('rp-status')!;
    const makeFile = async () => {
      const info = await buildDebugInfo(text(), withProject.checked);
      return new File([JSON.stringify(info, null, 2)], `pdk-debug-${APP_VERSION}-${new Date().toISOString().slice(0, 10)}.json`, { type: 'application/json' });
    };
    function download(f: File) {
      void saveFile(f, f.name);
      status.textContent = `${f.name} (${(f.size / 1024).toFixed(0)} kB)`;
    }
    const failed = (err: unknown) => { status.textContent = `${getLang() === 'de' ? 'Die Datei konnte nicht erzeugt werden' : 'The file could not be created'}: ${err instanceof Error ? err.message : String(err)}`; };
    document.getElementById('rp-download')!.addEventListener('click', async () => {
      status.textContent = '…';
      try { download(await makeFile()); } catch (err) { failed(err); }
    });

    /** A photo made small (≤ 1400 px, JPEG), as the Werkstatt keeps its pictures. */
    async function shrinkJpeg(file: File): Promise<Blob> {
      const bmp = await createImageBitmap(file);
      const k = Math.min(1, 1400 / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas');
      c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
      c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
      return await new Promise<Blob>((res, rej) => c.toBlob(b => (b ? res(b) : rej(new Error('jpeg'))), 'image/jpeg', 0.82));
    }

    // A link can't carry a file: the debug file is made on sending and either handed to the phone's
    // share sheet (mail app with attachment) or downloaded, ready to drag into the GitHub issue / mail.
    form.addEventListener('submit', async e => {
      e.preventDefault();
      const action = ((e as SubmitEvent).submitter as HTMLButtonElement | null)?.dataset.action;
      const de = getLang() === 'de';
      if (action === 'werkstatt') {
        status.textContent = '…';
        const label = (el: HTMLElement) => el.closest('label')!.querySelector('span')!.textContent!.trim();
        const answers = [page, what, expected].filter(f => f.value.trim()).map(f => `**${label(f)}** ${f.value.trim()}`).join('\n\n');
        try {
          const lines: string[] = [];
          // screenshot: made small as JPEG (like the Werkstatt's own pictures) and stored with the entry
          const shotFile = (document.getElementById('rp-shot') as HTMLInputElement).files?.[0];
          if (shotFile) {
            // a picture the browser can't read must not stop the report
            const jpeg = await shrinkJpeg(shotFile).catch(() => null);
            const r = jpeg ? await fetch('/api/x/big/entwicklung/bild', { method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'image/jpeg' }, body: jpeg }) : null;
            if (r?.ok) lines.unshift(`![Screenshot](/api/x/big/entwicklung/bild?id=${(await r.json()).id})`);
          }
          if (!idea) {
            const file = await makeFile();
            const r = await fetch('/api/x/big/entwicklung/datei', { method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-Filename': file.name }, body: file });
            if (r.ok) lines.push(`Debug-Datei: [📎 ${file.name}](/api/x/big/entwicklung/datei?id=${(await r.json()).id})`);
          }
          const body = [lines[0]?.startsWith('![') ? lines.shift()! : '', answers, env, ...lines].filter(Boolean).join('\n\n');
          const res = await fetch('/api/x/entwicklung/aufgaben', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: `${body} ${idea ? '#idee' : '#fehler'}` }) });
          const nr = res.ok ? (await res.json()).task?.nr : null;
          status.textContent = res.ok ? (de ? `In der Werkstatt als #${nr ?? '?'}.` : `In the Werkstatt as #${nr ?? '?'}.`) : (de ? 'Das hat nicht geklappt. Bist du im Team angemeldet?' : 'That did not work. Are you logged in as team?');
          if (res.ok) { what.value = ''; expected.value = ''; }
        } catch (err) { status.textContent = `${de ? 'Das hat nicht geklappt' : 'That did not work'}: ${err instanceof Error ? err.message : String(err)}`; }
        return;
      }
      if (action === 'beta') {
        // Straight into the team's task list, no mail address involved: each answer under its question
        // as the form showed it, the debug file (bugs; with the project if ticked) attached to the entry.
        status.textContent = '…';
        const label = (el: HTMLElement) => el.closest('label')!.querySelector('span')!.textContent!.trim();
        const answers = [page, what, expected].filter(f => f.value.trim()).map(f => `**${label(f)}** ${f.value.trim()}`).join('\n\n');
        try {
          const debug = idea ? undefined : await buildDebugInfo(text(), withProject.checked);
          const res = await fetch('/api/x/big/beta/feedback', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: answers, idea, debug }) });
          status.textContent = res.ok ? (de ? 'Danke! Deine Rückmeldung ist beim Team angekommen.' : 'Thank you! Your feedback reached the team.') : (de ? 'Das hat nicht geklappt. Bist du angemeldet?' : 'That did not work. Are you logged in?');
          if (res.ok) { what.value = ''; expected.value = ''; }
        } catch { status.textContent = de ? 'Der Server ist gerade nicht erreichbar.' : 'The server can’t be reached right now.'; }
        return;
      }
      let file: File | null = null;
      status.textContent = '…';
      if (!idea) { try { file = await makeFile(); } catch (err) { failed(err); } }
      else status.textContent = '';
      // A link can't attach the file: the text names it, so it isn't forgotten.
      const envF = file ? `${env}\n${de ? 'Debug-Datei (heruntergeladen, bitte anhängen)' : 'Debug file (downloaded, please attach)'}: ${file.name}` : env;
      if (action === 'mail') {
        const share = { files: file ? [file] : [] };
        if (file && navigator.canShare?.(share)) {
          try { await navigator.share({ ...share, title: `[${page.value.trim()}] PDK`, text: `${REPORT_MAIL}\n\n${what.value.trim()}\n\n${env}` }); status.textContent = file.name; return; } catch (err) { if ((err as Error).name === 'AbortError') return; }
        }
        if (file) download(file);
        location.href = mailtoUrl(text(), envF, de);
      } else {
        if (file) download(file);
        if (!window.open(issueUrl(text(), envF), '_blank', 'noopener')) location.href = issueUrl(text(), envF);
      }
    });
  </script>
</Layout>
