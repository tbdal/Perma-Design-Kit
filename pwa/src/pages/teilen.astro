---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Perma Design Kit — Geteiltes Projekt">
  <article class="mx-auto max-w-3xl space-y-4 text-stone-800 dark:text-stone-100">
    <h1 id="sh-title" class="text-2xl font-bold" data-i18n="shTitle">Geteiltes Projekt</h1>
    <p id="sh-example-intro" hidden class="text-sm text-stone-600 dark:text-stone-300" data-i18n="shExampleIntro">Ein Beispielprojekt mit Pflanzen, Polykulturen und Waldgartenplänen. Übernimm es in deine App, um es anzusehen und damit zu experimentieren – deine eigenen Daten bleiben unverändert.</p>
    <p id="sh-status" class="text-sm text-stone-600 dark:text-stone-300" data-i18n="shLoading">Link wird gelesen…</p>

    <section id="sh-present" hidden class="space-y-3 rounded-xl bg-green-50 dark:bg-green-900/30 p-5 ring-1 ring-green-200 dark:ring-green-800">
      <p class="text-sm" data-i18n="shAlreadyPresent">Dieses Projekt ist schon in deiner App.</p>
      <div class="flex flex-wrap gap-2">
        <button id="sh-open-existing" type="button" data-i18n="shOpenProject" class="rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow hover:bg-green-800">Öffnen</button>
        <button id="sh-import-copy" type="button" data-i18n="shImportCopy" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-4 py-2 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Trotzdem als Kopie übernehmen</button>
      </div>
    </section>

    <section id="sh-content" hidden class="space-y-4 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
      <p id="sh-summary" class="text-base font-semibold"></p>
      <div id="sh-lists" class="grid gap-4 text-sm sm:grid-cols-3"></div>
      <p class="text-xs text-stone-500 dark:text-stone-400" data-i18n="shPrivacy">Die Daten werden nur in deinem Browser gespeichert, wie alles in dieser App.</p>
      <div class="flex flex-wrap gap-2">
        <button id="sh-import" type="button" data-i18n="shImport" class="rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow hover:bg-green-800">In meine App übernehmen</button>
        <a href="/" data-i18n="shCancel" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-4 py-2 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Abbrechen</a>
      </div>
    </section>

    <section id="sh-done" hidden class="space-y-3 rounded-xl bg-green-50 dark:bg-green-900/30 p-5 ring-1 ring-green-200 dark:ring-green-800">
      <p id="sh-done-text" role="status" class="text-sm"></p>
      <div class="flex flex-wrap gap-2">
        <a href="/" data-i18n="shToPlants" class="rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow hover:bg-green-800">Zu den Pflanzen</a>
        <a id="sh-to-plans" href="/gartenplan" data-i18n="shToPlans" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-4 py-2 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Zu den Waldgartenplänen</a>
      </div>
    </section>
  </article>

  <!-- Nach dem Übernehmen: fehlende Pflanzendaten gleich nachladen? -->
  <dialog id="sh-enrich-dialog" aria-labelledby="sh-enrich-title" class="m-auto w-[min(32rem,calc(100vw-2rem))] rounded-xl bg-white dark:bg-stone-800 p-0 text-stone-800 dark:text-stone-100 shadow-2xl backdrop:bg-black/50">
    <div class="space-y-3 p-5">
      <h2 id="sh-enrich-title" class="text-base font-semibold" data-i18n="shEnrichTitle">Fehlende Daten laden?</h2>
      <p id="sh-enrich-text" class="text-sm text-stone-600 dark:text-stone-300"></p>
      <div id="sh-enrich-progress" hidden class="space-y-1">
        <progress id="sh-enrich-bar" value="0" max="1" class="h-2 w-full accent-green-600"></progress>
        <p id="sh-enrich-status" role="status" class="truncate text-xs text-stone-500 dark:text-stone-400"></p>
      </div>
      <div class="flex justify-end gap-2 pt-1">
        <button id="sh-enrich-later" type="button" data-i18n="shEnrichLater" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Später</button>
        <button id="sh-enrich-now" type="button" data-i18n="shEnrichNow" class="rounded-lg bg-green-700 px-4 py-1.5 text-sm font-medium text-white shadow hover:bg-green-800">Jetzt laden</button>
      </div>
    </div>
  </dialog>

  <script>
    // Receiving end of "Projekt als Link teilen" (src/lib/share.ts): decode the
    // #fragment, show what's inside, import on request. The fragment is
    // removed after importing so a reload can't import twice.
    import { applyStaticI18n, createT } from '../lib/i18n/core';
    import { teilenDict } from '../lib/i18n/dict-teilen';
    import { decodeShare, mergeShared, shareDataFromHash } from '../lib/share';
    import { getAllPlants, getAllPolycultures, getAllGardenPlans, importPlants, importPolycultures, importGardenPlans, savePlant } from '../lib/db';
    import { enrichPlant, needsEnrichment } from '../lib/enrich';
    import { getLang } from '../lib/i18n/core';
    import type { PlantData } from '../lib/types';
    import { escapeHtml, withButtonSpinner } from '../lib/html';
    import { displayName } from '../lib/plant-name';
    import { LAST_PLAN_KEY, writePlanView } from '../lib/plan-view';
    import type { DecodedShare } from '../lib/share';

    applyStaticI18n(teilenDict);
    const t = createT(teilenDict);
    const status = document.getElementById('sh-status')!;
    const content = document.getElementById('sh-content')!;
    const LIST_MAX = 25;

    function listHtml(title: string, names: string[]): string {
      if (names.length === 0) return '';
      const shown = names.slice(0, LIST_MAX).map(n => `<li class="truncate">${escapeHtml(n)}</li>`).join('');
      const more = names.length > LIST_MAX ? `<li class="text-stone-500 dark:text-stone-400">${t('shMore', { n: names.length - LIST_MAX })}</li>` : '';
      return `<div><h2 class="mb-1 font-semibold">${title}</h2><ul class="space-y-0.5 text-stone-700 dark:text-stone-200">${shown}${more}</ul></div>`;
    }

    async function main() {
      const data = shareDataFromHash(location.hash);
      if (!data) { status.textContent = t('shNoLink'); return; }
      let shared: DecodedShare;
      try {
        shared = await decodeShare(data);
      } catch {
        status.textContent = t('shBroken');
        return;
      }
      status.hidden = true;
      content.hidden = false;
      // /example → /teilen/?beispiel=1#d=…: same import, friendlier wording.
      const isExample = new URLSearchParams(location.search).has('beispiel');
      if (isExample) {
        document.getElementById('sh-title')!.textContent = t('shExampleTitle');
        document.getElementById('sh-example-intro')!.hidden = false;
        document.getElementById('sh-import')!.textContent = t('shExampleImport');
      }
      /** Saved camera/section/sun per plan + the plan /gartenplan opens. */
      const applyViews = (views: DecodedShare['views'], start: DecodedShare['start']) => {
        for (const [id, v] of Object.entries(views ?? {})) writePlanView(id, v);
        if (start) { try { localStorage.setItem(LAST_PLAN_KEY, start.planId); } catch {} }
      };
      const taken = async () => ({
        polycultureIds: (await getAllPolycultures()).map(x => x.id),
        gardenPlanIds: (await getAllGardenPlans()).map(x => x.id),
      });
      // Opened before and already imported (same ids): open it instead of
      // stacking up copies; a copy stays possible.
      if (mergeShared(shared, await getAllPlants(), await taken()).alreadyPresent) {
        document.getElementById('sh-present')!.hidden = false;
        content.hidden = true;
        document.getElementById('sh-open-existing')!.addEventListener('click', () => {
          applyViews(shared.views, shared.start);
          location.href = shared.gardenPlans.length ? '/gartenplan' : '/';
        });
        document.getElementById('sh-import-copy')!.addEventListener('click', () => {
          document.getElementById('sh-present')!.hidden = true;
          content.hidden = false;
        });
      }
      document.getElementById('sh-summary')!.textContent = t('shSummary', {
        plants: shared.plants.length, polycultures: shared.polycultures.length, plans: shared.gardenPlans.length,
      });
      document.getElementById('sh-lists')!.innerHTML =
        listHtml(t('shPlants'), shared.plants.map(p => displayName(p) || p.latinName)) +
        listHtml(t('shPolycultures'), shared.polycultures.map(p => p.name || '—')) +
        listHtml(t('shGardenPlans'), shared.gardenPlans.map(g => g.name || '—'));

      document.getElementById('sh-import')!.addEventListener('click', async (e) => {
        await withButtonSpinner(e.currentTarget as HTMLButtonElement, async () => {
          try {
            // Never overwrites: plants you have win, plans/polycultures with an id you
            // already use come in as copies (see mergeShared).
            const merged = mergeShared(shared, await getAllPlants(), await taken(), t('shCopySuffix'));
            await importPlants(merged.plants);
            if (merged.polycultures.length) await importPolycultures(merged.polycultures);
            if (merged.gardenPlans.length) await importGardenPlans(merged.gardenPlans);
            applyViews(merged.views, merged.start);
            history.replaceState(null, '', location.pathname);
            content.hidden = true;
            document.getElementById('sh-done')!.hidden = false;
            const toPlans = document.getElementById('sh-to-plans') as HTMLAnchorElement;
            toPlans.hidden = merged.gardenPlans.length === 0;
            const startPlan = merged.start && merged.gardenPlans.find(g => g.id === merged.start!.planId);
            if (startPlan) {
              // The start plan opens directly (LAST_PLAN_KEY), so make that the main button.
              toPlans.textContent = t('shOpenPlan', { name: startPlan.name || '—' });
              toPlans.className = 'rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow hover:bg-green-800';
              toPlans.parentElement!.prepend(toPlans);
            }
            document.getElementById('sh-done-text')!.textContent = t('shDone', {
              plants: merged.plants.length, reused: merged.reusedPlants,
              polycultures: merged.polycultures.length, plans: merged.gardenPlans.length,
            }) + (merged.copiedPolycultures + merged.copiedGardenPlans ? ' ' + t('shCopies', { n: merged.copiedPolycultures + merged.copiedGardenPlans }) : '');
            offerEnrichment(merged.plants.filter(p => needsEnrichment(p, getLang())));
          } catch (err) {
            alert(t('shFailed', { msg: err instanceof Error ? err.message : String(err) }));
          }
        });
      });
    }
    // ── Fehlende Daten nachladen ─────────────────────────────────────────
    // Shared projects often carry bare plants (only names). Offer to fill the
    // gaps right away — same enrichPlant() as "Lade alle fehlenden Daten" on
    // the plant page, limited to the plants just imported.
    function offerEnrichment(plants: PlantData[]) {
      if (plants.length === 0) return;
      const dialog = document.getElementById('sh-enrich-dialog') as HTMLDialogElement;
      const text = document.getElementById('sh-enrich-text')!;
      const progress = document.getElementById('sh-enrich-progress')!;
      const bar = document.getElementById('sh-enrich-bar') as HTMLProgressElement;
      const statusEl = document.getElementById('sh-enrich-status')!;
      const btnNow = document.getElementById('sh-enrich-now') as HTMLButtonElement;
      const btnLater = document.getElementById('sh-enrich-later') as HTMLButtonElement;
      let running = false, aborted = false;

      text.textContent = t('shEnrichText', { n: plants.length });
      dialog.showModal();
      dialog.addEventListener('cancel', e => { if (running) { e.preventDefault(); aborted = true; } });
      btnLater.addEventListener('click', () => { if (running) aborted = true; else dialog.close(); });

      btnNow.addEventListener('click', async () => {
        running = true;
        btnNow.hidden = true;
        btnLater.textContent = t('shEnrichAbort');
        progress.hidden = false;
        bar.max = plants.length;
        let updated = 0, fields = 0, failed = 0, done = 0;
        for (const p of plants) {
          if (aborted) break;
          statusEl.textContent = t('shEnrichProgress', { i: done + 1, n: plants.length, name: p.latinName });
          try {
            const filled = await enrichPlant(p);
            if (filled > 0) { await savePlant(p); updated++; fields += filled; }
          } catch (err) {
            failed++;
            console.error(`Anreicherung fehlgeschlagen für ${p.latinName}:`, err);
          }
          done++;
          bar.value = done;
        }
        running = false;
        text.textContent = t('shEnrichSummary', { updated, total: done, fields })
          + (failed ? ' ' + t('shEnrichFailed', { failed }) : '')
          + (aborted ? ' ' + t('shEnrichAborted') : '');
        statusEl.textContent = '';
        progress.hidden = true;
        btnLater.textContent = t('shEnrichClose');
        btnLater.onclick = () => dialog.close();
      }, { once: true });
    }

    // A second link pasted into this tab only changes the #fragment, which
    // doesn't reload the page — do it explicitly so the new project shows.
    window.addEventListener('hashchange', () => { if (shareDataFromHash(location.hash)) location.reload(); });

    main();
  </script>
</Layout>
