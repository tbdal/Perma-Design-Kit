# build output
dist/
# generated types
.astro/

# dependencies
# without a trailing slash, so a node_modules symlink (worktrees) is ignored too
node_modules

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# local dev TLS cert (self-signed, machine-specific)
.certs/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
test-results/
playwright-report/

# expert mode: accounts, session secret, feature table (server/auth.mjs)
server/data/private/
# private expert module — its own git repo on the VPS (src/lib/expert-loader.ts)
src/expert/
